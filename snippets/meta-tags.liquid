{% comment %}
  Meta tags snippet for SEO
{% endcomment %}

{%- assign meta_description = page_description -%}
{%- if template.name == 'product' -%}
  {%- capture meta_description -%}{% render 'product-meta-description', product: product %}{%- endcapture -%}
  {%- assign meta_description = meta_description | strip -%}
{%- endif -%}

{%- if template.name == 'index' -%}
  <meta property="og:type" content="website">
{%- elsif template.name == 'product' -%}
  <meta property="og:type" content="product">
{%- elsif template.name == 'article' -%}
  <meta property="og:type" content="article">
{%- else -%}
  <meta property="og:type" content="website">
{%- endif -%}

<meta property="og:title" content="{{ page_title | escape }}">
{%- if meta_description != blank -%}
  <meta property="og:description" content="{{ meta_description | escape }}">
{%- endif -%}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">

{%- if template.name == 'product' -%}
  {%- if product.featured_image -%}
    <meta property="og:image" content="http:{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
  {%- endif -%}
  <meta property="og:price:amount" content="{{ product.price | default: 0 | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if meta_description != blank -%}
  <meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif -%}

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": "{{ shop.url }}{{ product.url }}",
    {%- if product.featured_image -%}
    "image": "http:{{ product.featured_image | image_url: width: 1024 }}",
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": {%- if product.price_varies -%}
    {
      "@type": "AggregateOffer",
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "lowPrice": {{ product.price_min | default: 0 | divided_by: 100.0 | json }},
      "highPrice": {{ product.price_max | default: 0 | divided_by: 100.0 | json }},
      "offerCount": {{ product.variants.size | json }},
      "availability": "http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
    }
    {%- else -%}
    {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "price": {{ product.selected_or_first_available_variant.price | default: product.price | default: 0 | divided_by: 100.0 | json }},
      "availability": "http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
    }
    {%- endif -%}
  }
  </script>
{%- endif -%}
