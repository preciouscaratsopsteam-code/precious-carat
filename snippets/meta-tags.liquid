{% comment %}
  Meta tags snippet for SEO
{% endcomment %}

{%- assign meta_description = page_description -%}
{%- if template.name == 'product' -%}
  {%- capture meta_description -%}{% render 'product-meta-description', product: product %}{%- endcapture -%}
  {%- assign meta_description = meta_description | strip -%}
{%- endif -%}

{%- if template.name == 'index' -%}
  <meta property="og:type" content="website">
{%- elsif template.name == 'product' -%}
  <meta property="og:type" content="product">
{%- elsif template.name == 'article' -%}
  <meta property="og:type" content="article">
{%- else -%}
  <meta property="og:type" content="website">
{%- endif -%}

{%- comment -%}
  Absolute https share image: product photo on PDPs, brand logo everywhere else.
  asset_url returns a root-relative path on this store while image_url is
  protocol-relative — normalize both. escape_once (not escape) everywhere:
  admin-entered descriptions already containing entities were double-escaping
  ("&amp;amp;" showed up in search snippets).
{%- endcomment -%}
{%- capture og_image_src -%}{%- if template.name == 'product' and product.featured_image -%}{{ product.featured_image | image_url: width: 1200 }}{%- else -%}{{ 'logo.png' | asset_url }}{%- endif -%}{%- endcapture -%}
{%- if og_image_src contains '//' -%}
  {%- assign og_image_abs = og_image_src | prepend: 'https:' | replace: 'https:https:', 'https:' -%}
{%- else -%}
  {%- assign og_image_abs = shop.url | append: og_image_src -%}
{%- endif -%}

<meta property="og:title" content="{{ page_title | replace: 'Srilankan', 'Sri Lankan' | escape_once }}">
{%- if meta_description != blank -%}
  <meta property="og:description" content="{{ meta_description | escape_once }}">
{%- endif -%}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:image" content="{{ og_image_abs }}">

{%- if template.name == 'product' -%}
  <meta property="og:image:width" content="1200">
  <meta property="og:price:amount" content="{{ product.price | default: 0 | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | replace: 'Srilankan', 'Sri Lankan' | escape_once }}">
{%- if meta_description != blank -%}
  <meta name="twitter:description" content="{{ meta_description | escape_once }}">
{%- endif -%}
<meta name="twitter:image" content="{{ og_image_abs }}">

{%- comment -%}
  Organization sitewide (SEO brief H1) + WebSite with the sitelinks searchbox on
  the homepage. The Organization node lives in snippets/organization-jsonld.liquid
  and reads Theme settings → Business details / Social Media. The About page and
  the gem-guide pages emit their own Organization node inside their @graph, so
  they are skipped here to avoid a duplicate.
{%- endcomment -%}
{%- assign org_own_page = false -%}
{%- if template.name == 'page' -%}
  {%- if page.handle == 'about' or page.handle contains '-gem-guide' -%}{%- assign org_own_page = true -%}{%- endif -%}
{%- endif -%}
{%- unless org_own_page -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {%- render 'organization-jsonld' -%}
      {%- if template.name == 'index' -%},
      {
        "@type": "WebSite",
        "@id": "{{ shop.url }}/#website",
        "name": {{ settings.business_brand_name | default: shop.name | json }},
        "alternateName": [{{ shop.name | json }}, {{ shop.domain | json }}],
        "url": {{ shop.url | json }},
        "publisher": { "@id": "{{ shop.url }}/#organization" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endunless -%}
{%- assign store_page_handle = settings.store_page_handle | default: 'contact-us' -%}
{%- if template.name == 'page' and page.handle == store_page_handle -%}
  {%- render 'store-jsonld' -%}
{%- endif -%}

{%- if template.name == 'product' -%}
  {%- comment -%}
    Schema description is built from the same custom.* metafields the product
    page specs render, so it always matches visible content. Fallback order:
    metafields -> "{Origin} {Gemstone} {N} Carat" title parse -> product
    description -> title. Gem-name pairs mirror planetary-alignment.liquid.
  {%- endcomment -%}
  {%- assign sd_gem = product.metafields.custom.gem_type | default: product.type | strip -%}
  {%- capture sd_origin -%}{%- render 'origin-clean', origin: product.metafields.custom.origin -%}{%- endcapture -%}
  {%- assign sd_origin = sd_origin | strip -%}
  {%- assign sd_carat = product.metafields.custom.weight_carats | strip -%}
  {%- assign sd_treatment = product.metafields.custom.treatment_status | strip -%}
  {%- assign sd_lab = product.metafields.custom.cert_lab | strip -%}

  {%- assign sd_title_words = product.title | strip | split: ' ' -%}
  {%- assign sd_last_word = sd_title_words | last | downcase -%}
  {%- if sd_title_words.size >= 4 and sd_last_word == 'carat' or sd_last_word == 'carats' -%}
    {%- if sd_carat == blank -%}
      {%- assign sd_carat_idx = sd_title_words.size | minus: 2 -%}
      {%- assign sd_carat = sd_title_words[sd_carat_idx] -%}
    {%- endif -%}
    {%- comment -%} First title word is only an origin when it isn't part of the gem name
        or a colour / descriptor: "White Sapphire 5.4 Carat" must not claim origin "White". {%- endcomment -%}
    {%- if sd_origin == blank -%}
      {%- assign sd_first_word = sd_title_words | first -%}
      {%- assign sd_first_lc = sd_first_word | downcase -%}
      {%- assign sd_gem_lc = sd_gem | downcase -%}
      {%- assign sd_not_origin = '|white|blue|yellow|pink|green|red|black|golden|purple|orange|natural|certified|star|bi-colour|bicolour|bi-color|neelambari|peetambari|pitambari|loose|premium|' -%}
      {%- assign sd_first_tok = '|' | append: sd_first_lc | append: '|' -%}
      {%- unless sd_gem_lc contains sd_first_lc or sd_not_origin contains sd_first_tok -%}
        {%- assign sd_origin = sd_first_word -%}
      {%- endunless -%}
    {%- endif -%}
    {%- if sd_gem == blank -%}
      {%- assign sd_gem_word_count = sd_title_words.size | minus: 3 -%}
      {%- assign sd_gem = sd_title_words | slice: 1, sd_gem_word_count | join: ' ' -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign sd_gem_en = sd_gem -%}
  {%- assign sd_gem_hi = '' -%}
  {%- assign sd_gem_handle = sd_gem | handleize -%}
  {%- case sd_gem_handle -%}
    {%- when 'ruby', 'manik' -%}{%- assign sd_gem_en = 'Ruby' -%}{%- assign sd_gem_hi = 'Manik' -%}
    {%- when 'pearl', 'moti' -%}{%- assign sd_gem_en = 'Pearl' -%}{%- assign sd_gem_hi = 'Moti' -%}
    {%- when 'coral', 'red-coral', 'moonga' -%}{%- assign sd_gem_en = 'Red Coral' -%}{%- assign sd_gem_hi = 'Moonga' -%}
    {%- when 'emerald', 'panna' -%}{%- assign sd_gem_en = 'Emerald' -%}{%- assign sd_gem_hi = 'Panna' -%}
    {%- when 'yellow-sapphire', 'pukhraj' -%}{%- assign sd_gem_en = 'Yellow Sapphire' -%}{%- assign sd_gem_hi = 'Pukhraj' -%}
    {%- when 'blue-sapphire', 'neelam' -%}{%- assign sd_gem_en = 'Blue Sapphire' -%}{%- assign sd_gem_hi = 'Neelam' -%}
    {%- when 'iolite', 'neeli' -%}{%- assign sd_gem_en = 'Iolite' -%}{%- assign sd_gem_hi = 'Neeli' -%}
    {%- when 'hessonite-garnet', 'hessonite', 'gomed' -%}{%- assign sd_gem_en = 'Hessonite Garnet' -%}{%- assign sd_gem_hi = 'Gomed' -%}
    {%- when 'cat-s-eye', 'cats-eye', 'cateye', 'lehsunia' -%}{%- assign sd_gem_en = "Cat's Eye" -%}{%- assign sd_gem_hi = 'Lehsunia' -%}
    {%- when 'turquoise', 'firoza' -%}{%- assign sd_gem_en = 'Turquoise' -%}{%- assign sd_gem_hi = 'Firoza' -%}
    {%- when 'lapis', 'lapis-lazuli', 'lajward' -%}{%- assign sd_gem_en = 'Lapis Lazuli' -%}{%- assign sd_gem_hi = 'Lajward' -%}
  {%- endcase -%}

  {%- assign sd_carat_num = sd_carat | times: 1.0 -%}
  {%- assign sd_ratti_num = product.metafields.custom.weight_ratti | times: 1.0 | round: 2 -%}
  {%- if sd_ratti_num == 0 and sd_carat_num > 0 -%}
    {%- assign sd_ratti_num = sd_carat_num | divided_by: 0.91 | round: 2 -%}
  {%- endif -%}

  {%- capture sd_gem_label -%}{%- if sd_gem_hi != blank -%}{{ sd_gem_en }} ({{ sd_gem_hi }}){%- else -%}{{ sd_gem_en }}{%- endif -%}{%- endcapture -%}
  {%- capture sd_weight_clause -%}{%- if sd_carat_num > 0 and sd_ratti_num > 0 -%}, {{ sd_carat }} ct / {{ sd_ratti_num }} ratti{%- elsif sd_carat_num > 0 -%}, {{ sd_carat }} ct{%- elsif sd_ratti_num > 0 -%}, {{ sd_ratti_num }} ratti{%- endif -%}{%- endcapture -%}
  {%- capture sd_provenance -%}{%- if sd_treatment != blank and sd_lab != blank -%}{{ sd_treatment }}, certified by {{ sd_lab }}, from Precious Carats.{%- elsif sd_treatment != blank -%}{{ sd_treatment }}, from Precious Carats.{%- elsif sd_lab != blank -%}Certified by {{ sd_lab }}, from Precious Carats.{%- else -%}From Precious Carats.{%- endif -%}{%- endcapture -%}

  {%- if sd_gem != blank -%}
    {%- capture sd_description -%}Buy this natural {{ sd_gem_label }}{{ sd_weight_clause }}{% if sd_origin != blank %}, from {{ sd_origin }}{% endif %}. {{ sd_provenance }}{%- endcapture -%}
  {%- else -%}
    {%- assign sd_description = product.description | strip_html | strip -%}
    {%- if sd_description == blank -%}
      {%- capture sd_description -%}Buy {{ product.title | strip }} from Precious Carats.{%- endcapture -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign sd_description = sd_description | strip | replace: '  ', ' ' -%}

  {%- comment -%}
    Shipping / returns figures mirror store policy: free shipping within IN,
    1-2 day handling, 3-7 day transit, 10-day free returns on loose gems (the
    trust badges, PLP trust tile and About copy all say 10 days; brief I.3).
    Update here if the store policy changes.
  {%- endcomment -%}
  {%- capture sd_offer_extras -%}
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "INR" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" },
          "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 7, "unitCode": "DAY" }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 10,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
  {%- endcapture -%}
  {%- assign sd_title = product.title | replace: 'Srilankan', 'Sri Lankan' | replace: 'srilankan', 'Sri Lankan' -%}
  {%- assign sd_brand = settings.business_brand_name | default: product.vendor -%}
  {%- assign sd_variant = product.selected_or_first_available_variant -%}
  {%- assign sd_shape = product.metafields.custom.shape_cut | strip -%}
  {%- assign sd_dims = product.metafields.custom.dimensions | strip -%}
  {%- assign sd_cert_no = product.metafields.custom.cert_number | strip -%}
  {%- assign sd_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' -%}
  {%- comment -%} Gem attributes as PropertyValue (brief H2), only the ones the product actually has {%- endcomment -%}
  {%- capture sd_props -%}
    {%- if sd_carat != blank -%}{ "@type": "PropertyValue", "name": "Carat weight", "value": {{ sd_carat | json }}, "unitCode": "CTM" },{%- endif -%}
    {%- if sd_ratti_num > 0 -%}{ "@type": "PropertyValue", "name": "Ratti", "value": {{ sd_ratti_num | json }} },{%- endif -%}
    {%- if sd_origin != blank -%}{ "@type": "PropertyValue", "name": "Origin", "value": {{ sd_origin | json }} },{%- endif -%}
    {%- if sd_treatment != blank -%}{ "@type": "PropertyValue", "name": "Treatment", "value": {{ sd_treatment | json }} },{%- endif -%}
    {%- if sd_shape != blank -%}{ "@type": "PropertyValue", "name": "Shape / cut", "value": {{ sd_shape | json }} },{%- endif -%}
    {%- if sd_dims != blank -%}{ "@type": "PropertyValue", "name": "Dimensions (mm)", "value": {{ sd_dims | json }} },{%- endif -%}
    {%- if sd_lab != blank -%}{ "@type": "PropertyValue", "name": "Certifying lab", "value": {{ sd_lab | json }} },{%- endif -%}
    {%- if sd_cert_no != blank -%}{ "@type": "PropertyValue", "name": "Certificate number", "value": {{ sd_cert_no | json }} },{%- endif -%}
  {%- endcapture -%}
  {%- assign sd_props = sd_props | strip -%}
  {%- if sd_props != blank -%}{%- assign sd_props_len = sd_props.size | minus: 1 -%}{%- assign sd_props = sd_props | slice: 0, sd_props_len -%}{%- endif -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": "{{ shop.url }}{{ product.url }}#product",
    "name": {{ sd_title | json }},
    "url": "{{ shop.url }}{{ product.url }}",
    {%- if product.images.size > 0 -%}
    "image": [{%- for img in product.images limit: 6 -%}{{ img | image_url: width: 1600 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}],
    {%- endif -%}
    "description": {{ sd_description | json }},
    {%- if sd_variant.sku != blank -%}
    "sku": {{ sd_variant.sku | json }},
    {%- endif -%}
    {%- if product.type != blank -%}
    "category": {{ product.type | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ sd_brand | json }}
    },
    {%- if sd_props != blank -%}
    "additionalProperty": [ {{ sd_props }} ],
    {%- endif -%}
    "offers": {%- if product.price_varies -%}
    {
      "@type": "AggregateOffer",
      "url": "{{ shop.url }}{{ product.url }}",
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "lowPrice": {{ product.price_min | default: 0 | divided_by: 100.0 | json }},
      "highPrice": {{ product.price_max | default: 0 | divided_by: 100.0 | json }},
      "offerCount": {{ product.variants.size | json }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}SoldOut{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@id": "{{ shop.url }}/#organization" },
      {{ sd_offer_extras }}
    }
    {%- else -%}
    {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}",
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "price": {{ sd_variant.price | default: product.price | default: 0 | divided_by: 100.0 | json }},
      "priceValidUntil": {{ sd_valid_until | json }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}SoldOut{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@id": "{{ shop.url }}/#organization" },
      {{ sd_offer_extras }}
    }
    {%- endif -%}
  }
  </script>
  {%- comment -%}
    VideoObject (brief H7) for product videos: Vimeo links in custom.video and
    native / external videos in product media. uploadDate falls back to the
    product's publish date because Shopify does not expose the upload date.
  {%- endcomment -%}
  {%- capture sd_videos -%}
    {%- if product.metafields.custom.video != blank -%}
      {%- assign sd_vids = product.metafields.custom.video | split: ',' -%}
      {%- for v in sd_vids -%}
        {%- assign vid = v | strip | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
        {%- if vid == blank -%}{%- continue -%}{%- endif -%}
        { "@type": "VideoObject", "name": {{ sd_title | append: ' — video' | json }}, "description": {{ sd_description | json }}, "thumbnailUrl": "https://vumbnail.com/{{ vid }}.jpg", "uploadDate": {{ product.published_at | date: '%Y-%m-%d' | json }}, "embedUrl": "https://player.vimeo.com/video/{{ vid }}", "publisher": { "@id": "{{ shop.url }}/#organization" } },
      {%- endfor -%}
    {%- endif -%}
    {%- for m in product.media -%}
      {%- if m.media_type == 'external_video' -%}
        { "@type": "VideoObject", "name": {{ sd_title | append: ' — video' | json }}, "description": {{ sd_description | json }}, "thumbnailUrl": {{ m.preview_image | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}, "uploadDate": {{ product.published_at | date: '%Y-%m-%d' | json }}, "embedUrl": {% if m.host == 'youtube' %}"https://www.youtube.com/embed/{{ m.external_id }}"{% else %}"https://player.vimeo.com/video/{{ m.external_id }}"{% endif %}, "publisher": { "@id": "{{ shop.url }}/#organization" } },
      {%- elsif m.media_type == 'video' -%}
        {%- assign sd_src = m.sources | first -%}
        { "@type": "VideoObject", "name": {{ sd_title | append: ' — video' | json }}, "description": {{ sd_description | json }}, "thumbnailUrl": {{ m.preview_image | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}, "uploadDate": {{ product.published_at | date: '%Y-%m-%d' | json }}, "contentUrl": {{ sd_src.url | json }}, "publisher": { "@id": "{{ shop.url }}/#organization" } },
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign sd_videos = sd_videos | strip -%}
  {%- if sd_videos != blank -%}
    {%- assign sd_videos_len = sd_videos.size | minus: 1 -%}
    {%- assign sd_videos = sd_videos | slice: 0, sd_videos_len -%}
  <script type="application/ld+json">
  { "@context": "https://schema.org", "@graph": [ {{ sd_videos }} ] }
  </script>
  {%- endif -%}
{%- endif -%}
