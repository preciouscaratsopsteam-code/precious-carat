{%- comment -%}
  Empty collection / no-filter-results fallback.
  Usage: {% render 'collection-empty-state', results: collection %}
  When storefront filters are active, leads with a "clear filters" prompt
  (users who over-filter, e.g. a high price floor, previously got a blank
  grid); always shows the contact enquiry form beneath.
{%- endcomment -%}
{%- assign _active_filter_count = 0 -%}
{%- if results != blank -%}
  {%- for f in results.filters -%}
    {%- assign _active_filter_count = _active_filter_count | plus: f.active_values.size -%}
    {%- if f.type == 'price_range' -%}
      {%- if f.min_value.value != blank or f.max_value.value != blank -%}
        {%- assign _active_filter_count = _active_filter_count | plus: 1 -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<div class="collection-page__empty">
  {%- if _active_filter_count > 0 -%}
    <div class="collection-empty__filters-note">
      <p class="collection-empty__filters-text">No gemstones match your current filters. Try widening your budget or removing a filter.</p>
      <a href="{{ results.url }}" class="collection-empty__clear-btn">Clear all filters ({{ _active_filter_count }})</a>
    </div>
  {%- endif -%}
  <div class="contact-enquiry-form">
    <div class="contact-enquiry-form__icon-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
    </div>
    <h2 class="contact-enquiry-form__title">Didn't find what you want? Contact us.</h2>

    {%- form 'contact', id: 'CollectionContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">Thank you for your enquiry. We will contact you shortly.</p>
      {%- endif -%}

      <div class="contact-enquiry-form__grid">
        <div class="field">
          <input type="text" name="contact[name]" id="ContactFormName" placeholder="Your Name" required>
        </div>
        <div class="field">
          <input type="email" name="contact[email]" id="ContactFormEmail" placeholder="Your Email" required>
        </div>
        <div class="field contact-enquiry-form__phone-group">
          <div class="country-code-mock">(+91) <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="#282c3f" stroke-width="1.5"/></svg></div>
          <input type="tel" name="contact[phone]" id="ContactFormPhone" placeholder="Phone" required>
        </div>
      </div>

      <div class="field">
        <textarea rows="4" name="contact[body]" id="ContactFormMessage" placeholder="Please enter at least 20 characters" minlength="20" required></textarea>
      </div>

      <div class="contact-enquiry-form__actions">
        <a href="tel:+919876543210" class="btn-call">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          CALL US
        </a>
        <button type="submit" class="btn-submit">SUBMIT ENQUIRY</button>
      </div>
    {%- endform -%}
  </div>
</div>

{%- style -%}
  .collection-empty__filters-note {
    text-align: center;
    padding: 24px 16px 8px;
  }
  .collection-empty__filters-text {
    margin: 0 0 12px;
    font-size: 15px;
    color: #555;
  }
  .collection-empty__clear-btn {
    display: inline-block;
    padding: 10px 22px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
{%- endstyle -%}
