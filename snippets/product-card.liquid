{% comment %}
  Product Card Snippet - Myntra-style compact card
  Usage: {% render 'product-card', product: product %}
  Pass show_cta: true to append a "View details" link under the price.
  Pass trim_carat: true to drop a trailing "N Carat" from the title (the spec line carries it).
  Cards whose catalogue shot is a JPEG (a baked-in white ground, e.g. strands) get the
  product-card--flat class so listings can give them a white tile instead of a tinted stage.
  Pass card_index (1-based position in an above-the-fold grid) so the first
  cards load eagerly: index 1-2 also get fetchpriority=high (likely LCP),
  3-4 load eager, everything else lazy-loads.
{% endcomment %}

{%- assign _pc_src = product.featured_image.src | default: '' | downcase -%}
{%- assign _pc_flat = false -%}
{%- if _pc_src contains '.jpg' or _pc_src contains '.jpeg' -%}{%- assign _pc_flat = true -%}{%- endif -%}
{%- assign _pc_name = product.title | default: "Product Name" -%}
{%- if trim_carat and _pc_name contains ' Carat' -%}
  {%- assign _pc_stem = _pc_name | split: ' Carat' | first | strip -%}
  {%- assign _pc_words = _pc_stem | split: ' ' -%}
  {%- assign _pc_lastword = _pc_words | last -%}
  {%- assign _pc_lastnum = _pc_lastword | times: 1.0 -%}
  {%- if _pc_lastnum > 0 -%}
    {%- assign _pc_name = _pc_stem | remove: _pc_lastword | strip -%}
  {%- endif -%}
{%- endif -%}
<div class="product-card{% unless product.available %} product-card--soldout{% endunless %}{% if _pc_flat %} product-card--flat{% endif %}" id="product-card-{{ product.id }}" data-weight-carats="{{ product.metafields.custom.weight_carats | default: 0 }}" data-weight-ratti="{{ product.metafields.custom.weight_ratti | default: 0 }}">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title }}">
      {%- if product.featured_image -%}
        {%- assign _pc_img = product.featured_image -%}
        {%- assign _pc_index = card_index | default: 0 | plus: 0 -%}
        <img
          src="{{ _pc_img | image_url: width: 420 }}"
          srcset="{{ _pc_img | image_url: width: 280 }} 280w, {{ _pc_img | image_url: width: 420 }} 420w, {{ _pc_img | image_url: width: 600 }} 600w"
          sizes="(max-width: 768px) 45vw, 280px"
          width="420"
          height="{{ 420 | divided_by: _pc_img.aspect_ratio | round }}"
          alt="{{ _pc_img.alt | default: product.title | escape }}"
          {% if _pc_index >= 1 and _pc_index <= 2 %}loading="eager" fetchpriority="high"{% elsif _pc_index >= 3 and _pc_index <= 4 %}loading="eager"{% else %}loading="lazy"{% endif %}
          decoding="async"
          class="product-card__image"
        >
      {%- else -%}
        <div class="product-card__placeholder">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
        </div>
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- unless product.available -%}
        <span class="product-card__badge product-card__badge--soldout">Sold Out</span>
      {%- endunless -%}
    </div>

    <div class="product-card__media-actions">
      <button
        class="product-card__action-btn product-card__quick-view"
        aria-label="Quick View"
        data-quick-view
        data-product-handle="{{ product.handle }}"
        data-gem-type="{{ product.metafields.custom.gem_type | default: product.type | escape }}"
        data-gem-origin="{{ product.metafields.custom.origin | escape }}"
        data-gem-weight-carats="{{ product.metafields.custom.weight_carats }}"
        data-gem-weight-ratti="{{ product.metafields.custom.weight_ratti }}"
        data-gem-shape-cut="{{ product.metafields.custom.shape_cut | escape }}"
        data-gem-cutting-style="{{ product.metafields.custom.cutting_style | escape }}"
        data-gem-transparency="{{ product.metafields.custom.transparency | escape }}"
        data-gem-color="{{ product.metafields.custom.color_description | escape }}"
        data-gem-planet="{{ product.metafields.custom.planetary_alignment | escape }}"
        data-gem-cert-lab="{{ product.metafields.custom.cert_lab | escape }}"
        data-gem-cert-number="{{ product.metafields.custom.cert_number | escape }}"
        data-gem-cert-link="{{ product.metafields.custom.cert_link | escape }}"
        data-gem-treatment="{{ product.metafields.custom.treatment_status | escape }}"
        data-gem-dimensions="{{ product.metafields.custom.dimensions | escape }}"
        data-gem-species="{{ product.metafields.custom.gems_title | escape }}"
      >
        {% render 'icon', name: 'eye' %}
      </button>

      {%- assign video_media = product.media | where: 'media_type', 'video' | first -%}
      {%- if video_media == nil -%}
        {%- assign video_media = product.media | where: 'media_type', 'external_video' | first -%}
      {%- endif -%}

      {%- if product.metafields.custom.video != blank -%}
        {%- assign card_vimeo_url = product.metafields.custom.video | split: ',' | first | strip -%}
        {%- assign card_vimeo_id = card_vimeo_url | split: 'vimeo.com/' | last | split: '?' | first -%}
        <button
          class="product-card__action-btn product-card__play"
          aria-label="Play Video"
          data-video-play
          onclick="event.preventDefault(); event.stopPropagation(); openCardVideoPopup('{{ card_vimeo_id }}');"
        >
          {% render 'icon', name: 'play' %}
        </button>
      {%- elsif video_media -%}
        <button
          class="product-card__action-btn product-card__play"
          aria-label="Play Video"
          data-video-play
          onclick="event.preventDefault(); window.location.href='{{ product.url }}?media={{ video_media.id }}';"
        >
          {% render 'icon', name: 'play' %}
        </button>
      {%- endif -%}
    </div>

    <button
      class="product-card__compare"
      aria-label="Compare product"
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle }}"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ product.url }}"
      data-product-price="{{ product.price | money }}"
      data-product-image="{{ product.featured_image | image_url: width: 420 }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-product-type="{{ product.type | escape }}"
      data-product-vendor="{{ product.vendor | escape }}"
      data-gem-type="{{ product.metafields.custom.gem_type | default: product.type | escape }}"
      data-gem-origin="{{ product.metafields.custom.origin | escape }}"
      data-gem-weight-carats="{{ product.metafields.custom.weight_carats }}"
      data-gem-weight-ratti="{{ product.metafields.custom.weight_ratti }}"
      data-gem-shape-cut="{{ product.metafields.custom.shape_cut | escape }}"
      data-gem-cutting-style="{{ product.metafields.custom.cutting_style | escape }}"
      data-gem-transparency="{{ product.metafields.custom.transparency | escape }}"
      data-gem-color="{{ product.metafields.custom.color_description | escape }}"
      data-gem-planet="{{ product.metafields.custom.planetary_alignment | escape }}"
      data-gem-cert-lab="{{ product.metafields.custom.cert_lab | escape }}"
      data-gem-cert-number="{{ product.metafields.custom.cert_number | escape }}"
      data-gem-cert-link="{{ product.metafields.custom.cert_link | escape }}"
      data-gem-treatment="{{ product.metafields.custom.treatment_status | escape }}"
      data-gem-dimensions="{{ product.metafields.custom.dimensions | escape }}"
      data-gem-species="{{ product.metafields.custom.gems_title | escape }}"
      onclick="event.preventDefault(); event.stopPropagation(); CompareApp.toggle(this);"
    >
      <img src="{{ 'balance.svg' | asset_url }}" alt="" width="18" height="18">
    </button>

    <button
      class="product-card__wishlist-btn product-card__wishlist-btn--overlay"
      aria-label="Add to wishlist"
      data-wishlist-toggle
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle }}"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ product.url }}"
      data-product-price="{{ product.price | money }}"
      data-variant-price="{{ product.selected_or_first_available_variant.price }}"
      data-product-image="{{ product.featured_image | image_url: width: 600 }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      onclick="event.preventDefault(); WishlistApp.toggle(this);"
    >
      {% render 'icon', name: 'heart' %}
    </button>
  </div>

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ _pc_name }}</h3>
    </a>
    {%- assign _pc_carats = product.metafields.custom.weight_carats -%}
    {%- assign _pc_origin = product.metafields.custom.origin -%}
    {%- assign _pc_lab = product.metafields.custom.cert_lab -%}
    {%- if _pc_carats != blank or _pc_origin != blank or _pc_lab != blank -%}
      <p class="product-card__specs">
        {%- if _pc_carats != blank -%}{{ _pc_carats }} ct{%- endif -%}
        {%- if _pc_carats != blank and _pc_origin != blank %} &middot; {% endif -%}
        {%- if _pc_origin != blank -%}{{ _pc_origin }}{%- endif -%}
        {%- if _pc_lab != blank -%}{%- if _pc_carats != blank or _pc_origin != blank %} &middot; {% endif -%}{{ _pc_lab }}{%- endif -%}
      </p>
    {%- endif -%}
    {%- comment -%} Show price only when product price is ₹10,00,000 (10 lacs) or more. product.price is in paise. {%- endcomment -%}
    {%- if product.price <= 100000000 -%}
      <div class="product-card__price">
        {{ product.price | money }}
      </div>
    {%- endif -%}

    {%- if product.price > 100000000 -%}
      {%- comment -%} Same WhatsApp enquiry shape as the PDP: bold title + SKU, then the product URL (gives WhatsApp its link thumbnail) {%- endcomment -%}
      {%- assign wa_price_sku = product.metafields.custom.sku_number | default: product.selected_or_first_available_variant.sku -%}
      {%- capture wa_price_text -%}Hi, I would like to know the price of this gemstone:
*{{ product.title }}*{% if wa_price_sku != blank %} (SKU: {{ wa_price_sku }}){% endif %}
{{ shop.url }}/products/{{ product.handle }}{%- endcapture -%}
      {%- assign wa_price_enc = wa_price_text | url_encode -%}
      <div class="product-card__price">
        <a href="https://wa.me/919908190811?text={{ wa_price_enc }}" target="_blank" rel="noopener" style="color: inherit; text-decoration: none;">Price on request</a>
      </div>
    {%- endif -%}

    {%- comment -%} Opt-in "View details" CTA (collection listings). Off by default so
        search results and PDP recommendations keep their compact card. {%- endcomment -%}
    {%- if show_cta -%}
      <a class="product-card__cta" href="{{ product.url }}">View details
        <svg width="14" height="8" viewBox="0 0 16 9" fill="none" aria-hidden="true"><path d="M0 4.5h13M9.5 1L13 4.5 9.5 8" stroke="currentColor" stroke-width="1.3"/></svg>
      </a>
    {%- endif -%}

  </div>
</div>
