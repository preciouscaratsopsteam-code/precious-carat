{%- comment -%}
  Gem icon for menu links (Mega Menu Changes doc, Issue 2: "it should be a real
  image with appropriate height/width"). Each gem has a 64 px square PNG in
  assets/menu-icon-<handle>.png, cut from the icons the earlier header used
  (nav-*.png, up-*.png …), rendered at 28 px. Gems without an image (new
  collections such as Topaz, Yellow Topaz, Fire Opal, Alexandrite, Jade) get a
  coloured oval so the row still lines up; drop a menu-icon-<handle>.png into
  assets/ and the image is used instead — no code change needed.

  Usage: {%- render 'gem-icon', handle: 'ruby' -%}
{%- endcomment -%}
{%- liquid
  assign gi_h = handle | default: '' | strip
  assign gi_img = ''
  assign gi_c = ''
  assign gi_with_img = 'ruby,pearl,red-coral,emerald,yellow-sapphire,white-sapphire,blue-sapphire,hessonite,cats-eye,amethyst,citrine,garnet,lapis-lazuli,malachite,moonstone,peridot,turquoise,natural-zircon,iolite,opal,agate,aquamarine,sphatik-rock-crystal,tiger-eye,blue-topaz,tourmaline,white-coral,pitambari,purple-sapphire,padparadscha-sapphire,colour-change-sapphire,peach-sapphire,pink-sapphire,spinel,star-sapphire' | split: ','
  for h in gi_with_img
    if h == gi_h
      assign gi_img = 'menu-icon-' | append: h | append: '.png'
      break
    endif
  endfor
  if gi_img == ''
    case gi_h
      when 'topaz'
        assign gi_c = '#E0C98A'
      when 'yellow-topaz'
        assign gi_c = '#D4B24C'
      when 'fire-opal'
        assign gi_c = '#E2601F'
      when 'alexandrite'
        assign gi_c = '#4C7A5A'
      when 'jade'
        assign gi_c = '#4E8C5A'
      when 'khooni-neelam', 'indraneelam'
        assign gi_c = '#1B3A93'
      when 'natural-pearl', 'basra-pearl', 'south-sea-pearl'
        assign gi_c = '#E9E4DB'
      when 'italian-red-coral', 'japanese-red-coral'
        assign gi_c = '#C0392B'
      when 'ceylon-hessonite'
        assign gi_c = '#C05621'
      when 'irani-turquoise'
        assign gi_c = '#3E9AA3'
    endcase
  endif
-%}
{%- if gi_img != blank -%}<img class="pc-gem pc-gem--img" src="{{ gi_img | asset_url }}" width="28" height="28" alt="" loading="lazy" decoding="async">{%- elsif gi_c != blank -%}<svg class="pc-gem" width="20" height="15" viewBox="0 0 20 15" aria-hidden="true" focusable="false"><ellipse cx="10" cy="7.5" rx="9" ry="6.6" fill="{{ gi_c }}" stroke="#33302C" stroke-width=".7"/><ellipse cx="10" cy="7.5" rx="5" ry="3.4" fill="none" stroke="rgba(255,255,255,.55)" stroke-width=".7"/></svg>{%- endif -%}
