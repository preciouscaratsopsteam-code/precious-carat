{%- comment -%}
  Small gem "dot" icon for menu links (Mega Menu Changes doc, Issue 2 — the
  earlier layout had gem icons). Colours follow the homepage reference's
  .gemdot marks so every gem has an icon without depending on an asset file.
  Outputs nothing for an unknown handle.

  Usage: {%- render 'gem-icon', handle: 'ruby' -%}
{%- endcomment -%}
{%- liquid
  assign gi_h = handle | default: '' | strip
  assign gi_c = ''
  case gi_h
    when 'ruby'
      assign gi_c = '#9B1B30'
    when 'pearl', 'natural-pearl', 'basra-pearl', 'south-sea-pearl'
      assign gi_c = '#E9E4DB'
    when 'red-coral', 'italian-red-coral', 'japanese-red-coral'
      assign gi_c = '#C0392B'
    when 'emerald'
      assign gi_c = '#10603C'
    when 'yellow-sapphire'
      assign gi_c = '#C9A227'
    when 'white-sapphire'
      assign gi_c = '#E4E7EB'
    when 'blue-sapphire', 'khooni-neelam', 'indraneelam'
      assign gi_c = '#1B3A93'
    when 'hessonite', 'ceylon-hessonite'
      assign gi_c = '#C05621'
    when 'cats-eye', 'cateye'
      assign gi_c = '#8C8352'
    when 'opal'
      assign gi_c = '#E6E0D6'
    when 'natural-zircon', 'zircon'
      assign gi_c = '#E7EAEE'
    when 'topaz'
      assign gi_c = '#E0C98A'
    when 'moonstone'
      assign gi_c = '#DDE3E8'
    when 'turquoise', 'irani-turquoise'
      assign gi_c = '#3E9AA3'
    when 'amethyst'
      assign gi_c = '#6B4E9B'
    when 'yellow-topaz'
      assign gi_c = '#D4B24C'
    when 'tourmaline'
      assign gi_c = '#2F6B45'
    when 'fire-opal'
      assign gi_c = '#E2601F'
    when 'alexandrite'
      assign gi_c = '#4C7A5A'
    when 'jade'
      assign gi_c = '#4E8C5A'
    when 'iolite'
      assign gi_c = '#3F4E8C'
    when 'white-coral'
      assign gi_c = '#F0EBE3'
    when 'blue-topaz'
      assign gi_c = '#4E86B0'
    when 'aquamarine'
      assign gi_c = '#7FB6C4'
    when 'tiger-eye'
      assign gi_c = '#8A6A2B'
    when 'garnet'
      assign gi_c = '#7B1E23'
    when 'peridot'
      assign gi_c = '#7C9A2E'
    when 'citrine'
      assign gi_c = '#C9902A'
    when 'lapis-lazuli'
      assign gi_c = '#22439B'
    when 'malachite'
      assign gi_c = '#2E8B57'
    when 'agate'
      assign gi_c = '#B57F6A'
    when 'sphatik-rock-crystal', 'sphatik'
      assign gi_c = '#E8EEF2'
    when 'pitambari'
      assign gi_c = '#D9B64A'
    when 'purple-sapphire'
      assign gi_c = '#6E3FA3'
    when 'pink-sapphire'
      assign gi_c = '#D86A8A'
    when 'peach-sapphire'
      assign gi_c = '#E8A98A'
    when 'star-sapphire'
      assign gi_c = '#4A5F8A'
    when 'padparadscha-sapphire'
      assign gi_c = '#E99A7A'
    when 'spinel'
      assign gi_c = '#B03050'
    when 'colour-change-sapphire'
      assign gi_c = '#6C5B9B'
  endcase
-%}
{%- if gi_c != blank -%}<svg class="pc-gem" width="20" height="15" viewBox="0 0 20 15" aria-hidden="true" focusable="false"><ellipse cx="10" cy="7.5" rx="9" ry="6.6" fill="{{ gi_c }}" stroke="#33302C" stroke-width=".7"/><ellipse cx="10" cy="7.5" rx="5" ry="3.4" fill="none" stroke="rgba(255,255,255,.55)" stroke-width=".7"/></svg>{%- endif -%}
