<!doctype html>
  <html class="no-js" lang="{{ request.locale.iso_code }}">
    <head>
      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="theme-color" content="{{ settings.color_primary }}">
      <link rel="canonical" href="{{ canonical_url }}">

      <!-- Shopify CDN serves the render-blocking CSS and every LCP image -->
      <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  
      {%- if settings.favicon != blank -%}
        <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      {%- endif -%}
  
      <title>
        {{ page_title }}
        {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      </title>
  
      {%- if template.name == 'product' -%}
        {%- capture meta_description -%}{% render 'product-meta-description', product: product %}{%- endcapture -%}
      {%- else -%}
        {%- assign meta_description = page_description -%}
      {%- endif -%}
      {%- if meta_description == blank -%}
        {%- assign meta_description = settings.default_meta_description -%}
      {%- endif -%}
      {%- if meta_description == blank -%}
        {%- assign meta_description = shop.name | append: ' — natural, certified gemstones' -%}
      {%- endif -%}
      <meta name="description" content="{{ meta_description | strip | escape_once }}">
  
      <!-- Google Fonts (loaded async to avoid render-blocking; display=swap shows fallback text immediately) -->
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      {%- assign google_fonts_href = "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" -%}
      <link rel="preload" as="style" href="{{ google_fonts_href }}">
      <link href="{{ google_fonts_href }}" rel="stylesheet" media="print" onload="this.media='all'">
      <noscript><link href="{{ google_fonts_href }}" rel="stylesheet"></noscript>
  
      {% render 'meta-tags' %}
  
      {{ 'base.css' | asset_url | stylesheet_tag }}
      {{ 'component-header.css' | asset_url | stylesheet_tag }}
      {{ 'sections.css' | asset_url | stylesheet_tag }}
  
      {{ content_for_header }}
  
      <script>
        document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      </script>
  
      <!-- Analytics: async, placed after the critical CSS so they never sit ahead of first render -->
      {%- comment -%}
        Hardcoded gtag.js for G-912S7K851X removed 2026-08-11: the Google tag
        container (GT-K54NRTZG, injected by the Google & YouTube app) already
        chain-loads the same measurement ID, so this was a duplicate ~370KB load
        on every page. Verify GA4 real-time data after deploy before deleting
        this note.
      {%- endcomment -%}

      <!-- Microsoft Clarity -->
      <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "wtb8p2176y");
      </script>

      <script>
        if ("navigation" in window) {
          // Modern path — catches everything
          navigation.addEventListener("navigate", (event) => {
            if (!event.canIntercept) return;
            if (event.hashChange || event.downloadRequest !== null) return;
  
            const url = new URL(event.destination.url);
  
            if (url.pathname === "/cart" || url.pathname.startsWith("/cart/")) {
              event.preventDefault();
              triggerFloCart();
            }
          });
  
        } else {
          // Fallback — covers older browsers
          // useCapture: true fires before the theme's own click listeners
          document.addEventListener("click", (e) => {
            const anchor = e.target.closest("a[href]");
            if (!anchor) return;
  
            try {
              const url = new URL(anchor.href, location.origin);
              if (url.pathname === "/cart" || url.pathname.startsWith("/cart/")) {
                e.preventDefault();
                e.stopImmediatePropagation();
                triggerFloCart();
              }
            } catch {}
          }, true);
        }
  
        function triggerFloCart() {
          console.log(":shopflo: opening cart");
          window.handleFloCartBtn?.();
        }
      </script>
    </head>
  
    <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{ "accessibility.skip_to_text" | t }}
      </a>
  
      {% sections 'header-group' %}
  
      <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>
  
      {% sections 'footer-group' %}
  
      {% render 'quick-view-modal' %}
  
      <!-- Global Video Popup for Product Cards -->
      <div class="video-popup-overlay" id="card-video-popup-overlay" onclick="closeCardVideoPopup()" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.85);z-index:10000;align-items:center;justify-content:center;">
        <div style="position:relative;width:90vw;max-width:900px;aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;" onclick="event.stopPropagation()">
          <button onclick="closeCardVideoPopup()" aria-label="Close video" style="position:absolute;top:-44px;right:0;width:36px;height:36px;background:rgba(255,255,255,0.15);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:10;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          <div id="card-video-popup-content" style="width:100%;height:100%;"></div>
        </div>
      </div>
      <script>
        function openCardVideoPopup(vimeoId) {
          var overlay = document.getElementById('card-video-popup-overlay');
          var content = document.getElementById('card-video-popup-content');
          content.innerHTML = '<iframe src="https://player.vimeo.com/video/' + vimeoId + '?autoplay=1&outro=nothing" style="width:100%;height:100%;border:none;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
          overlay.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
        function closeCardVideoPopup() {
          var overlay = document.getElementById('card-video-popup-overlay');
          var content = document.getElementById('card-video-popup-content');
          overlay.style.display = 'none';
          document.body.style.overflow = '';
          setTimeout(function() { content.innerHTML = ''; }, 300);
        }
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') closeCardVideoPopup();
        });
      </script>
  
      <script src="{{ 'compare.js' | asset_url }}" defer></script>
      <script src="{{ 'theme.js' | asset_url }}" defer></script>
      <!-- Shopflo cart bundle: not render-critical, so it loads from the body instead of the head -->
      <script src='https://bridge.shopflo.com/js/shopflo.bundle.js' async></script>
      {%- render 'shopflo-sso-add-button' -%}
      {%- comment -%}
        Snapmint EMI widget (self-injecting; also pulls jQuery from aspnetcdn).
        Loaded only where EMI display matters instead of on every page — it was
        previously duplicated in this file and site-wide, taxing the main
        thread everywhere (field INP 424ms). Widen the condition if EMI
        messaging is ever needed on other templates.
      {%- endcomment -%}
      {%- if template contains 'product' or template contains 'cart' -%}
        <script type="text/javascript">var mid = '9696';</script>
        <script src="https://checkout-merchant.snapmint.com/js/v1/9696" defer></script>
      {%- endif -%}
    </body>
  </html>
  