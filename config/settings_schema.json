[
  {
    "name": "theme_info",
    "theme_name": "Precious Carats",
    "theme_version": "1.0.0",
    "theme_author": "StoreApp",
    "theme_documentation_url": "https://shopify.com/help",
    "theme_support_url": "https://shopify.com/contact"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary / Gold accent",
        "default": "#c9a96e"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#faf7f2"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#1a1a1a"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_font_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "default": 100,
        "label": "Heading font scale (%)"
      },
      {
        "type": "range",
        "id": "body_font_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "default": 100,
        "label": "Body font scale (%)"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "32 x 32px recommended."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social accounts"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter",
        "info": "https://twitter.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://pinterest.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_threads_link",
        "label": "Threads",
        "info": "https://threads.com/@yourshop"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "page", "label": "Page" },
          { "value": "drawer", "label": "Drawer" }
        ],
        "default": "page"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Show cart note",
        "default": true
      },
      {
        "type": "product",
        "id": "fee_product",
        "label": "Customization fee product",
        "info": "Hidden Rs. 10 product used to charge making/certification fees at checkout (Shopflo included). Added to the cart automatically at the right quantity and kept in sync with the customized item. Until this is set, fees are display-only and NOT charged."
      }
    ]
  },
  {
    "name": "Currency",
    "settings": [
      {
        "type": "header",
        "content": "Currency format"
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency codes",
        "default": false
      }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      {
        "type": "textarea",
        "id": "default_meta_description",
        "label": "Default meta description",
        "info": "Fallback for pages without their own description. The homepage description is set in Shopify admin under Settings > Preferences and takes priority when present."
      }
    ]
  },
  {
    "name": "Tracking",
    "settings": [
      {
        "type": "header",
        "content": "Microsoft Advertising (Bing) UET"
      },
      {
        "type": "text",
        "id": "bing_uet_tag_id",
        "label": "UET tag ID",
        "info": "Numeric ID from Microsoft Advertising > Tools > UET tag. Leave blank if UET is already installed as a Shopify custom pixel, otherwise page views double-count. Enhanced conversions (hashed email/phone) are attached automatically when set."
      }
    ]
  },
  {
    "name": "Business details",
    "settings": [
      {
        "type": "paragraph",
        "content": "Used for the Organization structured data (homepage, About page, gem guides), the About page and WhatsApp links on the gem guide pages."
      },
      {
        "type": "header",
        "content": "Legal entity"
      },
      {
        "type": "text",
        "id": "business_brand_name",
        "label": "Brand name",
        "default": "Precious Carats",
        "info": "Emitted as the Organization name. The Shopify store name is emitted as alternateName when it differs."
      },
      {
        "type": "text",
        "id": "business_legal_name",
        "label": "Legal name",
        "default": "Precious Carats Pvt Ltd"
      },
      {
        "type": "textarea",
        "id": "business_description",
        "label": "One-line description",
        "default": "Natural, certified gemstones for Vedic astrology, jewellery and collecting — every treatment disclosed, every certificate verifiable, honest unfiltered photos, 10-day returns on loose gemstones."
      },
      {
        "type": "text",
        "id": "business_founding_year",
        "label": "Founding year",
        "default": "2025",
        "info": "Taken from the CIN (…DL2025…). Change it if the brand predates the company."
      },
      {
        "type": "text",
        "id": "business_cin",
        "label": "CIN",
        "default": "U32112DL2025PTC458346"
      },
      {
        "type": "text",
        "id": "business_gstin",
        "label": "GSTIN",
        "default": "07AAQCP3798M1ZD"
      },
      {
        "type": "header",
        "content": "Contact"
      },
      {
        "type": "text",
        "id": "business_phone",
        "label": "Phone (displayed)",
        "default": "+91 99081 90811",
        "info": "The number wired into the theme's WhatsApp buttons. The contact page shows +91 99801 98011 — confirm which is right and fix the other."
      },
      {
        "type": "text",
        "id": "business_whatsapp",
        "label": "WhatsApp number (digits only, with country code)",
        "default": "919908190811"
      },
      {
        "type": "text",
        "id": "business_email",
        "label": "Contact email",
        "info": "Leave blank to use the store's sender email."
      },
      {
        "type": "header",
        "content": "Address"
      },
      {
        "type": "text",
        "id": "business_street",
        "label": "Street address",
        "default": "S. No. 1175 GF, Kucha Mahajani, Chandni Chowk"
      },
      {
        "type": "text",
        "id": "business_locality",
        "label": "City / locality",
        "default": "North Delhi"
      },
      {
        "type": "text",
        "id": "business_region",
        "label": "State / region",
        "default": "Delhi"
      },
      {
        "type": "text",
        "id": "business_postal_code",
        "label": "Postal code",
        "default": "110006"
      },
      {
        "type": "text",
        "id": "business_country",
        "label": "Country code",
        "default": "IN"
      }
    ]
  }
]
