{%- comment -%}
  Trust Badges Section
  Horizontal strip showing trust/value propositions
{%- endcomment -%}

{%- comment -%}
  Product pages carry these six promises in their own "Our Promise" band
  (sections/main-product.liquid, under Easy Buying Process), so the footer-group
  instance of this strip stays off there — it was showing twice in a row.
{%- endcomment -%}
{%- assign _tb_hide = false -%}
{%- if template.name == 'product' and section.settings.hide_on_product -%}{%- assign _tb_hide = true -%}{%- endif -%}
{%- unless _tb_hide -%}
<section class="trust-badges" id="trust-badges">
  <div class="page-width">
    <div class="trust-badges__wrapper">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '/pages/coming-soon' }}" class="trust-badge" {{ block.shopify_attributes }}>
          <div class="trust-badge__icon">
            {% render 'icon', name: block.settings.icon %}
          </div>
          <span class="trust-badge__text">{{ block.settings.text }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_on_product",
      "label": "Hide on product pages",
      "default": true,
      "info": "Product pages already show these six promises in their own \"Our Promise\" band under Easy Buying Process."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "certificate",
          "options": [
            { "value": "certificate", "label": "Certificate" },
            { "value": "returns", "label": "Returns" },
            { "value": "transparent", "label": "Transparent" },
            { "value": "full-treatment", "label": "Full Treatment" },
            { "value": "eye", "label": "Eye" },
            { "value": "custom", "label": "Custom Jewellery" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "heart", "label": "Heart" },
            { "value": "gem", "label": "Gem" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "Trust Badge"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "certificate", "text": "Verifiable Certificates" } },
        { "type": "badge", "settings": { "icon": "returns", "text": "Easy Returns" } },
        { "type": "badge", "settings": { "icon": "transparent", "text": "Transparent Operations" } },
        { "type": "badge", "settings": { "icon": "custom", "text": "Customised Jewellery" } },
        { "type": "badge", "settings": { "icon": "shipping", "text": "Worldwide Shipping" } }
      ]
    }
  ]
}
{% endschema %}
