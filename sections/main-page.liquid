{%- comment -%}
  Main Page Section
{%- endcomment -%}

{%- comment -%}
  Gem guide pages (/pages/<gem>-gem-guide) render from the gem's editorial copy
  (snippets/gem-guide.liquid) with the admin image as the hero; the About page
  renders snippets/about-body.liquid when its admin body is empty. Every other
  page renders its admin content as before.
{%- endcomment -%}
{%- assign mp_gem = '' -%}
{%- if page.handle contains '-gem-guide' -%}
  {%- capture mp_gem -%}{%- render 'gem-guide-map', part: 'gem', page_handle: page.handle -%}{%- endcapture -%}
  {%- assign mp_gem = mp_gem | strip -%}
{%- endif -%}
{%- if mp_gem != blank -%}
  {%- render 'gem-guide', page: page, gem_handle: mp_gem -%}
{%- elsif page.handle == 'about' and page.content == blank -%}
  <section class="page-section section-padding">
    <div class="page-width page-width--narrow">
      {%- render 'about-body', page: page -%}
    </div>
  </section>
{%- elsif request.page_type == '404' -%}
  {%- comment -%} 404 template renders this section with no page object — give it real content instead of an empty heading {%- endcomment -%}
  <section class="page-section section-padding page-404">
    <div class="page-width page-width--narrow">
      <p class="page-404__eyebrow">Error 404</p>
      <h1 class="section-heading">Page not found</h1>
      <p class="page-404__text">The page you were looking for has moved or no longer exists. The gemstone you want is probably still here — try a search, or browse the collection.</p>
      <form class="page-404__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <input type="search" name="q" placeholder="Search gemstones…" aria-label="Search gemstones">
        <button type="submit" class="btn btn--primary">Search</button>
      </form>
      <div class="page-404__actions">
        <a href="/collections/all" class="btn btn--secondary">Browse all gemstones</a>
        <a href="{{ routes.root_url }}" class="btn btn--secondary">Back to home</a>
      </div>
    </div>
  </section>
{%- else -%}
<section class="page-section section-padding">
  <div class="page-width page-width--narrow">
    <h1 class="section-heading">{{ page.title }}</h1>
    <div class="page-section__content">
      {{ page.content }}
    </div>
  </div>
</section>
{%- endif -%}

<style>
  .page-section__content {
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--color-text-light);
  }

  /* body headings must sit below the 36px page title (they rendered at 48px) */
  .page-section__content h2,
  .page-section__content h3,
  .page-section__content h4 {
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-primary);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }
  .page-section__content h2 { font-size: 1.75rem; }
  .page-section__content h3 { font-size: 1.35rem; }
  .page-section__content h4 { font-size: 1.15rem; }
  .page-section__content hr { border: 0; border-top: 1px solid var(--color-border); margin: var(--space-2xl) 0; }
  .page-404 { text-align: center; }
  .page-404__eyebrow { font-family: var(--font-accent); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-gold-dark); margin: 0 0 8px; }
  .page-404__text { max-width: 540px; margin: 0 auto var(--space-xl); color: var(--color-text-light); line-height: 1.7; }
  .page-404__search { display: flex; gap: 8px; max-width: 480px; margin: 0 auto var(--space-xl); }
  .page-404__search input { flex: 1; min-width: 0; padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 4px; font-family: var(--font-body); font-size: 15px; background: #fff; }
  .page-404__actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  .page-section__content p {
    margin-bottom: var(--space-lg);
  }

  .page-section__content ul,
  .page-section__content ol {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
    list-style: disc;
  }

  .page-section__content img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-xl) 0;
    cursor: zoom-in;
  }

  .page-section__content a {
    color: var(--color-gold-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Tap-to-zoom overlay for page-content images (Clarity showed heavy dead
     clicks on these images — taps previously did nothing) */
  .page-content-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.88);
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    padding: 16px;
  }

  .page-content-lightbox.is-open {
    display: flex;
  }

  .page-content-lightbox img {
    max-width: 94vw;
    max-height: 90vh;
    border-radius: 4px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var imgs = document.querySelectorAll('.page-section__content img');
    if (!imgs.length) return;

    var overlay = document.createElement('div');
    overlay.className = 'page-content-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', 'Image preview');
    overlay.innerHTML = '<img alt="">';
    document.body.appendChild(overlay);
    var overlayImg = overlay.querySelector('img');

    function close() {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    imgs.forEach(function (img) {
      img.addEventListener('click', function () {
        overlayImg.src = img.currentSrc || img.src;
        overlayImg.alt = img.alt || '';
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
    });

    overlay.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  });
</script>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
