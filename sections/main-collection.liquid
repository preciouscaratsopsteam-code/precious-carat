{%- comment -%}
  Main Collection — Jewel Box PLP (Sep 6 2026 build of the approved design canvas
  "Ruby Collection Page": theme font stacks, ivory stages + soft shadows, gold for
  selected states, ink reserved for the primary CTA).

  Page order: breadcrumb → full-bleed collection photo with an overlapping white
  panel (eyebrow · h1 with Indian name · one factual line · links · three trust
  tiles) → ONE sticky bar (count · Filters button · active-filter tags · quick
  chips: Unheated only + budget bands · sort) → white filter rail (drawer ≤899px;
  Weight is one group with a Ratti/Carat switch, Budget min/max, plain-language
  treatment labels, colour swatches, shape chips) + 4-across grid of ivory-stage
  cards with a WhatsApp help tile in slot 8 → single "Show more" loader with a
  progress line on every breakpoint (the numbered pager stays in the DOM for
  crawlers) → editorial lead + accordions (#about).

  Business logic preserved verbatim: grouped gem-type rows for curated & planet
  collections, Sacred Essentials ≤₹50K identity, Sanctum ≥₹10L floor, Strand Edit
  scoping, strand hiding on gem listings, price presets, client-side weight sort,
  collection JSON-LD. Per-collection copy lives in snippets/collection-copy.liquid.
{%- endcomment -%}

{%- assign show_grouped = false -%}
{%- assign is_curated = false -%}
{%- assign is_planet = false -%}
{%- comment -%} Sacred Essentials: flat grid with a single "Below ₹50K" price filter only {%- endcomment -%}
{%- assign is_sacred = false -%}
{%- if collection.handle == 'sacred-essentials' -%}
  {%- assign is_sacred = true -%}
{%- endif -%}
{%- comment -%} Per-gem Sacred Essentials subcollections (handle starts with sacred-essentials-): no price-preset pills in the toolbar {%- endcomment -%}
{%- assign is_sacred_gem = false -%}
{%- if collection.handle contains 'sacred-essentials-' -%}
  {%- assign is_sacred_gem = true -%}
{%- endif -%}
{%- comment -%} Sanctum: ultra-luxury identity — only gems priced ₹10 lakh and above. ₹10,00,000 = 100,000,000 in the storefront's subunit. {%- endcomment -%}
{%- assign is_sanctum = false -%}
{%- if collection.handle == 'sanctum' -%}
  {%- assign is_sanctum = true -%}
{%- endif -%}
{%- comment -%} Strand Edit: curated editorial collection (Editorial = "Strand Edit") — gem sections must show only its own products, never the full gem-type collections {%- endcomment -%}
{%- assign is_strand = false -%}
{%- if collection.handle == 'strand-edit' -%}
  {%- assign is_strand = true -%}
{%- endif -%}
{%- comment -%} Strand products (only marker: "Strand" in the title) stay off
    gem listings — they belong on strand collections only. {%- endcomment -%}
{%- assign hide_strands = true -%}
{%- assign coll_title_dc = collection.title | downcase -%}
{%- if is_strand or coll_title_dc contains 'strand' -%}{%- assign hide_strands = false -%}{%- endif -%}
{%- assign grouped_handles = 'sacred-essentials,navratna,upratnas,beyond-nine,strand-edit,sanctum,crush-worthy-delights,mangal,shukra,budh,rahu,ketu,surya,chandra,shani,guru' -%}
{%- assign curated_handles = 'beyond-nine,strand-edit,crush-worthy-delights,sanctum' -%}
{%- assign planet_handles = 'surya,chandra,mangal,budh,shukra,guru,shani,rahu,ketu' -%}
{%- assign grouped_handles_arr = grouped_handles | split: ',' -%}
{%- for h in grouped_handles_arr -%}
  {%- if collection.handle == h -%}
    {%- assign show_grouped = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign planet_handles_arr = planet_handles | split: ',' -%}
{%- for h in planet_handles_arr -%}
  {%- if collection.handle == h -%}
    {%- assign is_planet = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign curated_handles_arr = curated_handles | split: ',' -%}
{%- for h in curated_handles_arr -%}
  {%- if collection.handle == h -%}
    {%- assign is_curated = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} ── Editorial copy (shared with nothing else; single source in collection-copy) ── {%- endcomment -%}
{%- capture gem_handle -%}{%- render 'collection-copy', part: 'handle' -%}{%- endcapture -%}
{%- assign gem_handle = gem_handle | strip -%}
{%- capture copy_welcome -%}{%- render 'collection-copy', part: 'welcome' -%}{%- endcapture -%}
{%- assign copy_welcome = copy_welcome | strip -%}
{%- capture copy_tagline -%}{%- render 'collection-copy', part: 'tagline' -%}{%- endcapture -%}
{%- assign copy_tagline = copy_tagline | strip -%}
{%- capture copy_description -%}{%- render 'collection-copy', part: 'description' -%}{%- endcapture -%}
{%- assign copy_description = copy_description | strip -%}
{%- assign copy_paragraphs = copy_description | split: '||' -%}
{%- capture copy_hindi -%}{%- render 'collection-copy', part: 'hindi' -%}{%- endcapture -%}
{%- assign copy_hindi = copy_hindi | strip -%}
{%- capture copy_benefits -%}{%- render 'collection-copy', part: 'benefits' -%}{%- endcapture -%}
{%- assign copy_benefits = copy_benefits | strip -%}
{%- assign benefit_lines = copy_benefits | split: '\n' -%}

{%- comment -%} Hero copy: the description's first paragraph, else the tagline (also feeds the JSON-LD description) {%- endcomment -%}
{%- assign intro_line = copy_paragraphs[0] | default: '' | strip -%}
{%- if intro_line == blank -%}{%- assign intro_line = copy_tagline -%}{%- endif -%}
{%- capture copy_planet -%}{%- render 'collection-copy', part: 'planet' -%}{%- endcapture -%}
{%- assign copy_planet = copy_planet | strip -%}
{%- comment -%} Indian name from the welcome copy: "Pearl (Moti)" → Moti {%- endcomment -%}
{%- assign alt_name = '' -%}
{%- if copy_welcome contains '(' -%}
  {%- assign alt_name = copy_welcome | split: '(' | last | split: ')' | first | strip -%}
{%- endif -%}

{%- comment -%} Breadcrumb parent {%- endcomment -%}
{%- assign crumb_parent_title = '' -%}
{%- assign crumb_parent_url = '' -%}
{%- assign _navratna_gems = 'ruby,emerald,blue-sapphire,yellow-sapphire,white-sapphire,pearl,red-coral,hessonite,cateye' | split: ',' -%}
{%- assign _upratna_gems = 'opal,amethyst,citrine,iolite,garnet,turquoise,peridot,tourmaline,white-coral,agate,chalcedony,pitambari,aquamarine,natural-zircon,moonstone,lapis-lazuli,malachite,sphatik,blue-topaz,tiger-eye' | split: ',' -%}
{%- for h in _navratna_gems -%}
  {%- if collection.handle == h -%}{%- assign crumb_parent_title = 'Navratna' -%}{%- assign crumb_parent_url = '/collections/navratna' -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{%- if crumb_parent_title == '' -%}
  {%- for h in _upratna_gems -%}
    {%- if collection.handle == h -%}{%- assign crumb_parent_title = 'Upratnas' -%}{%- assign crumb_parent_url = '/collections/upratnas' -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if crumb_parent_title == '' and is_sacred_gem -%}
  {%- assign crumb_parent_title = 'Sacred Essentials' -%}{%- assign crumb_parent_url = '/collections/sacred-essentials' -%}
{%- endif -%}

{%- comment -%} Which editorial set: curated overviews use the cht-co-* snippets, planets show the planet summary, gems the full tab set {%- endcomment -%}
{%- assign is_overview = false -%}
{%- assign _overview_handles = 'navratna,upratnas,sanctum,sacred-essentials,beyond-nine,strand-edit,crush-worthy-delights,crushworthy-delights' | split: ',' -%}
{%- for h in _overview_handles -%}
  {%- if collection.handle == h -%}{%- assign is_overview = true -%}{%- break -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} Active filter count for the mobile button badge {%- endcomment -%}
{%- assign plp_active = 0 -%}
{%- for filter in collection.filters -%}
  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value or filter.max_value.value -%}{%- assign plp_active = plp_active | plus: 1 -%}{%- endif -%}
  {%- else -%}
    {%- assign plp_active = plp_active | plus: filter.active_values.size -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Price facet + current preset values (bar chips, rail Budget fields) {%- endcomment -%}
{%- assign price_filter = collection.filters | where: 'type', 'price_range' | first -%}
{%- assign min_val = 0 -%}{%- assign max_val = 0 -%}
{%- if price_filter -%}
  {%- assign min_val = price_filter.min_value.value | money_without_currency | replace: ',', '' | plus: 0 -%}
  {%- assign max_val = price_filter.max_value.value | money_without_currency | replace: ',', '' | plus: 0 -%}
{%- endif -%}

{%- comment -%} Trust tile: labs present in this collection; quick chip: the "Unheated" treatment value {%- endcomment -%}
{%- assign plp_labs = '' -%}
{%- assign plp_unheated_url = '' -%}
{%- assign plp_unheated_on = false -%}
{%- for filter in collection.filters -%}
  {%- assign _fl2 = filter.label | handleize -%}
  {%- if _fl2 contains 'certification' -%}
    {%- for v in filter.values -%}
      {%- if v.count > 0 or v.active -%}
        {%- if plp_labs != '' -%}{%- assign plp_labs = plp_labs | append: ' · ' -%}{%- endif -%}
        {%- assign plp_labs = plp_labs | append: v.label -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif _fl2 contains 'treatment' -%}
    {%- for v in filter.values -%}
      {%- assign _vl = v.label | downcase -%}
      {%- if _vl contains 'unheated' or _vl contains 'no indications' -%}
        {%- if v.active -%}{%- assign plp_unheated_on = true -%}{%- assign plp_unheated_url = v.url_to_remove -%}{%- else -%}{%- assign plp_unheated_url = v.url_to_add -%}{%- endif -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{%- if plp_labs == '' -%}{%- assign plp_labs = 'ITLGR · GFCO' -%}{%- endif -%}

{% style %}
/* ═══════════ PLP — Jewel Box ═══════════ */
:root{
  --plp-ink:#231F20; --plp-ink-soft:#3B322A;
  --plp-gold:#B08D4F; --plp-gold-deep:#96733A;
  --plp-charcoal:#4A443D; --plp-charcoal-2:#7A7268;
  --plp-paper:#FDFBF7; --plp-card:#FFFFFF;
  --plp-ivory:#F6EFE4; --plp-ivory-2:#EFE5D2; --plp-sand:#DCCFB4; --plp-stage:#F3ECE0;
  --plp-display:var(--font-heading,'Cormorant Garamond',Georgia,serif);
  --plp-body:var(--font-body,'Inter','Helvetica Neue',sans-serif);
  --plp-accent:var(--font-accent,'Outfit','Helvetica Neue',sans-serif);
  --plp-wrap:1320px; --plp-gut:14px;
  --plp-s1:8px; --plp-s2:12px; --plp-s3:16px; --plp-s4:24px; --plp-s5:32px;
  --plp-r:4px; --plp-rl:8px;
  --plp-shadow:0 14px 34px -20px rgba(120,96,58,.5);
  --plp-shadow-sm:0 4px 12px -6px rgba(120,96,58,.35);
  --plp-sticky-top:0px; --plp-bar-h:58px;
}
@media (min-width:900px){:root{--plp-gut:32px}}

.plp{background:var(--plp-paper);font-family:var(--plp-body);font-weight:400;font-size:15px;line-height:1.6;color:var(--plp-charcoal);overflow-x:clip}
.plp *,.plp *::before,.plp *::after{box-sizing:border-box}
/* Neutralize the theme's global element styles inside the PLP. :where() keeps
   specificity at 0-1-0 so the component classes below always win. */
.plp :where(button){margin:0;padding:0;background:none;border:0;border-radius:0;box-shadow:none;font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;line-height:inherit;cursor:pointer;text-align:inherit}
.plp :where(input,select,textarea){margin:0;border-radius:0;box-shadow:none;font:inherit;color:inherit}
.plp :where(button,a,input,select,summary):focus-visible{outline:2px solid var(--plp-gold);outline-offset:2px}
.plp img{max-width:100%;display:block}
.plp a{color:inherit;text-decoration:none}
.plp a:hover{color:inherit}
.plp h1,.plp h2,.plp h3,.plp h4{font-family:var(--plp-display);font-weight:600;color:var(--plp-ink);margin:0;line-height:1.15}
.plp p{margin:0}
.plp ul,.plp ol{list-style:none;margin:0;padding:0}
.plp-wrap{max-width:var(--plp-wrap);margin:0 auto;padding:0 var(--plp-gut)}

/* ── breadcrumb ── */
.plp-crumbs{display:flex;gap:var(--plp-s1);align-items:center;overflow-x:auto;white-space:nowrap;padding:12px 0 4px;font-size:11.5px;color:var(--plp-charcoal-2);scrollbar-width:none}
.plp-crumbs::-webkit-scrollbar{display:none}
.plp-crumbs a:hover{color:var(--plp-gold-deep)}
.plp-crumbs .plp-cur{color:var(--plp-ink)}

/* ── hero: full-bleed collection photo + overlapping white panel ── */
.plp-photo{margin-top:6px;height:210px;overflow:hidden;background:#D9B778}
@media (min-width:900px){.plp-photo{height:400px;margin-top:8px}}
.plp-photo img{width:100%;height:100%;object-fit:cover;object-position:center 50%}
@media (min-width:900px){.plp-photo img{object-position:center 58%}}
.plp-hero{display:flex;flex-direction:column;gap:12px;padding:10px 0 4px}
.plp-hero--panel{position:relative;z-index:2;margin-top:-30px;background:var(--plp-card);border-radius:var(--plp-rl);box-shadow:var(--plp-shadow);padding:18px 16px 16px}
@media (min-width:900px){
  .plp-hero{display:grid;grid-template-columns:minmax(0,1fr) 440px;gap:48px;align-items:center;padding:18px 0 22px}
  .plp-hero--panel{margin-top:-48px;padding:26px 32px 24px}
}
.plp-hero__text{min-width:0;display:flex;flex-direction:column;gap:8px}
@media (min-width:900px){.plp-hero__text{gap:10px}}
.plp-eyebrow{font-family:var(--plp-accent);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--plp-gold-deep);display:flex;gap:10px;align-items:center}
@media (min-width:900px){.plp-eyebrow{font-size:10.5px}}
.plp-eyebrow::before{content:"";width:18px;height:1px;background:var(--plp-gold);flex:0 0 auto}
.plp-hero h1{font-size:34px;line-height:1;margin:0}
@media (min-width:900px){.plp-hero h1{font-size:42px}}
.plp-hero h1 span{font-style:italic;font-weight:400;font-size:.5em;color:var(--plp-gold-deep);margin-left:6px;white-space:nowrap}
.plp-hero__desc{font-size:13.5px;line-height:1.55;color:var(--plp-charcoal);max-width:58ch}
@media (min-width:900px){.plp-hero__desc{font-size:14.5px;line-height:1.6}}
.plp-hero__links{display:flex;gap:20px;flex-wrap:wrap;margin-top:2px}
.plp-goldlink{font-family:var(--plp-accent);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--plp-gold-deep);display:inline-flex;align-items:center;gap:6px;transition:color .18s}
.plp-goldlink:hover{color:var(--plp-ink)}
.plp-goldlink svg{flex:0 0 auto}
.plp-hero__trust{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin:2px -16px 0;padding:0 16px}
.plp-hero__trust::-webkit-scrollbar{display:none}
.plp-hero__trust li{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;background:var(--plp-ivory);border-radius:20px;padding:8px 12px;font-size:11.5px;color:var(--plp-ink);white-space:nowrap}
.plp-hero__trust svg{flex:0 0 auto;color:var(--plp-gold)}
.plp-hero__trust b{font-weight:500}
.plp-hero__trust small{display:none}
@media (min-width:900px){
  .plp-hero__trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;overflow:visible;margin:0;padding:0}
  .plp-hero__trust li{display:flex;flex-direction:column;align-items:flex-start;gap:8px;border-radius:var(--plp-r);padding:14px 14px 12px;white-space:normal;font-size:12.5px}
  .plp-hero__trust svg{width:20px;height:20px}
  .plp-hero__trust b{display:block}
  .plp-hero__trust small{display:block;font-size:11px;color:var(--plp-charcoal-2);margin-top:2px}
}

/* ── sticky filter bar: one row (desktop) / lead row + scroll row (mobile) ── */
.plp-bar{position:sticky;top:var(--plp-sticky-top);z-index:40;background:var(--plp-paper);box-shadow:0 10px 24px -20px rgba(120,96,58,.6);margin-top:10px}
@media (min-width:900px){.plp-bar{margin-top:22px}}
.plp-bar__in{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;padding:8px 0 10px}
.plp-bar__lead{display:flex;align-items:center;gap:10px;min-width:0}
.plp-bar__scroll{grid-column:1/-1;display:flex;align-items:center;gap:8px;overflow-x:auto;scrollbar-width:none;min-width:0}
.plp-bar__scroll::-webkit-scrollbar{display:none}
.plp-bar__scroll:empty{display:none}
@media (min-width:900px){
  .plp-bar__in{display:flex;gap:14px;padding:11px 0}
  .plp-bar__lead{flex:0 0 auto}
  .plp-bar__scroll{flex:1 1 auto}
}
.plp-fcount{flex:0 0 auto;font-size:13px;color:var(--plp-charcoal-2);white-space:nowrap}
.plp-fcount b{font-weight:500;color:var(--plp-ink)}
.plp-fbtn{flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;background:var(--plp-ivory);color:var(--plp-ink);padding:11px 14px;border-radius:var(--plp-r);font-family:var(--plp-accent);font-size:11.5px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;transition:background .18s}
.plp-fbtn:hover{background:var(--plp-ivory-2)}
@media (min-width:900px){.plp-fbtn{display:none}}
.plp-fbtn__n{min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--plp-gold);color:#fff;font-size:10px;line-height:18px;text-align:center;letter-spacing:0}
.plp-chip{flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;background:var(--plp-card);color:var(--plp-charcoal-2);border-radius:20px;box-shadow:var(--plp-shadow-sm);padding:10px var(--plp-s3);font-family:var(--plp-accent);font-size:12px;white-space:nowrap;outline:1.5px solid transparent;outline-offset:1px;transition:color .16s,outline-color .16s}
.plp-chip:hover{color:var(--plp-ink)}
.plp-chip[aria-pressed="true"]{color:var(--plp-ink);outline-color:var(--plp-gold)}
.plp-sort{flex:0 0 auto;display:flex;align-items:center;gap:7px}
@media (min-width:900px){.plp-sort{margin-left:auto}}
.plp-sort label{display:none;font-family:var(--plp-accent);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--plp-charcoal-2);white-space:nowrap}
@media (min-width:900px){.plp-sort label{display:block}}
.plp-sort select{max-width:150px;background:var(--plp-card);border:0;box-shadow:var(--plp-shadow-sm);border-radius:var(--plp-r);padding:10px 30px 10px 12px;font-size:13px;color:var(--plp-ink);-webkit-appearance:none;appearance:none;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,var(--plp-ink) 50%),linear-gradient(135deg,var(--plp-ink) 50%,transparent 50%);background-position:calc(100% - 17px) calc(50% - 1px),calc(100% - 12px) calc(50% - 1px);background-size:5px 5px;background-repeat:no-repeat;text-overflow:ellipsis}
@media (min-width:900px){.plp-sort select{max-width:none;font-size:13.5px;padding:10px 32px 10px 12px}}
.plp-tags{display:flex;gap:6px;align-items:center;flex:0 0 auto}
.plp-tags:not(:last-child)::after{content:"";width:1px;height:22px;background:var(--plp-ivory-2);margin:0 4px}
.plp-tag{background:var(--plp-stage);border-radius:20px;padding:6px 8px 6px 11px;font-size:12px;color:var(--plp-ink);display:inline-flex;gap:7px;align-items:center;white-space:nowrap;transition:background .16s}
.plp-tag:hover{background:var(--plp-ivory-2);color:var(--plp-ink)}
.plp-tag svg{color:var(--plp-charcoal-2)}
.plp-tags__clear{font-family:var(--plp-accent);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--plp-gold-deep);white-space:nowrap;margin-left:4px}
.plp-tags__clear:hover{color:var(--plp-ink)}

/* ── layout: rail + results ── */
.plp-layout{padding-top:var(--plp-s2)}
.plp-layout>*{min-width:0}
@media (min-width:900px){.plp-layout{display:grid;grid-template-columns:224px minmax(0,1fr);gap:28px;align-items:start;padding-top:28px}}
@media (min-width:1200px){.plp-layout{grid-template-columns:236px minmax(0,1fr);gap:36px}}

/* ── filter rail (desktop) / drawer (mobile) ── */
.plp-filters__head{display:flex;align-items:center;justify-content:space-between;padding:var(--plp-s3) var(--plp-gut);border-bottom:1px solid var(--plp-ivory-2)}
.plp-filters__head b{font-family:var(--plp-accent);font-size:12px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--plp-ink)}
.plp-filters__close{width:36px;height:36px;display:grid;place-items:center;color:var(--plp-ink);border-radius:50%;transition:background .18s}
.plp-filters__close:hover{background:var(--plp-ivory)}
.plp-filters__body{flex:1;overflow-y:auto;padding:0 var(--plp-gut) var(--plp-s4);overscroll-behavior:contain}
.plp-filters__foot{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:var(--plp-s2) var(--plp-gut);padding-bottom:calc(var(--plp-s2) + env(safe-area-inset-bottom));border-top:1px solid var(--plp-ivory-2)}
.plp-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 16px;font-family:var(--plp-accent);font-size:11.5px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;border-radius:var(--plp-r);transition:background .18s,color .18s;text-align:center;line-height:1.4}
.plp-btn--solid{background:var(--plp-ink);color:#fff}
.plp-btn--solid:hover{background:var(--plp-ink-soft);color:#fff}
.plp-btn--ghost{background:var(--plp-ivory);color:var(--plp-ink)}
.plp-btn--ghost:hover{background:var(--plp-ivory-2);color:var(--plp-ink)}
@media (max-width:899px){
  .plp-filters{position:fixed;inset:0;z-index:1200;visibility:hidden;pointer-events:none}
  .plp-filters[data-open="true"]{visibility:visible;pointer-events:auto}
  .plp-filters__scrim{position:absolute;inset:0;background:rgba(35,31,32,.5);opacity:0;transition:opacity .25s}
  .plp-filters[data-open="true"] .plp-filters__scrim{opacity:1}
  .plp-filters__panel{position:absolute;top:0;bottom:0;left:0;width:min(430px,90%);background:var(--plp-card);transform:translateX(-100%);transition:transform .28s ease;display:flex;flex-direction:column;box-shadow:var(--plp-shadow)}
  .plp-filters[data-open="true"] .plp-filters__panel{transform:none}
}
@media (min-width:900px){
  .plp-filters{position:sticky;top:calc(var(--plp-sticky-top) + var(--plp-bar-h) + var(--plp-s3))}
  .plp-filters__scrim,.plp-filters__head,.plp-filters__foot{display:none}
  .plp-filters__panel{background:var(--plp-card);border-radius:var(--plp-rl);box-shadow:var(--plp-shadow-sm);padding:4px var(--plp-s3) var(--plp-s1)}
  .plp-filters__body{padding:0;max-height:calc(100vh - var(--plp-sticky-top) - var(--plp-bar-h) - 48px);overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
}
/* facets snippet inside the rail: the rail/drawer replaces the snippet's own mobile toggle */
.plp-filters .facets-container{padding-right:0;margin-bottom:0}
.plp-filters .facets__mobile-toggle{display:none}
.plp-filters #FacetsItems{display:block;padding-top:0}
.plp-filters .active-facets{margin-top:var(--plp-s3)}
@media (max-width:899px){.plp-filters .facets__mobile-sort{display:block}}
@media (min-width:900px){.plp-filters .facets__mobile-sort{display:none}.plp-filters .active-facets{display:none}}
.plp-filters .facets__weight-presets{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.plp-filters .facets__price-preset{background:var(--plp-ivory);box-shadow:none;padding:7px 4px;font-size:11.5px;min-height:0}
.plp-filters .facets__price-preset.is-active{background:var(--plp-card);color:var(--plp-ink);outline-color:var(--plp-gold)}
.plp-filters .facets__price-preset[disabled]{background:var(--plp-ivory)}
/* desktop rail head */
.plp-filters__rhead{display:none}
@media (min-width:900px){
  .plp-filters__rhead{display:flex;align-items:center;justify-content:space-between;padding:12px 0 8px}
  .plp-filters__rhead b{font-family:var(--plp-accent);font-size:11px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--plp-ink)}
}
/* facet order: Weight · Budget · Origin · Treatment · Lab · Shape · Colour · Cutting style · (other) */
.plp-filters #FacetsItems{display:flex;flex-direction:column}
.plp-filters #FacetsItems>*{order:8}
.plp-filters .facets__mobile-sort{order:0;margin:0 0 4px;padding:0 0 14px;border-top:0;border-bottom:1px solid var(--plp-ivory-2)}
.plp-filters .plp-weight,.plp-filters .plp-budget{order:1}
.plp-filters details[id^="Details-origin"]{order:2}
.plp-filters details[id^="Details-treatment"]{order:3}
.plp-filters details[id^="Details-certification"]{order:4}
.plp-filters details[id^="Details-shape"]{order:5}
.plp-filters details[id^="Details-color"],.plp-filters details[id^="Details-colour"]{order:6}
.plp-filters details[id^="Details-cutting"]{order:9}
.plp-filters details[id^="Details-transparency"]{order:10}
.plp-filters .facets__disclosure{border-bottom:1px solid var(--plp-ivory-2)}
.plp-filters .facets__disclosure:last-of-type{border-bottom:1px solid var(--plp-ivory-2)}
/* Weight: one group, Ratti | Carat switch */
.plp-seg{display:flex;background:var(--plp-ivory);border-radius:20px;padding:3px;gap:2px;margin:2px 0 10px}
.plp-seg button{flex:1;text-align:center;padding:7px 0;border-radius:20px;font-family:var(--plp-accent);font-size:11.5px;letter-spacing:.06em;color:var(--plp-charcoal-2);transition:color .16s}
.plp-seg button[aria-selected="true"]{background:var(--plp-card);color:var(--plp-ink);box-shadow:var(--plp-shadow-sm);outline:1.5px solid var(--plp-gold);outline-offset:-1px}
.plp-weight__pane[hidden]{display:none}
.plp-hint{font-size:11.5px;line-height:1.5;color:var(--plp-charcoal-2);margin:10px 0 0}
/* Budget min / max */
.plp-budget__row{display:flex;align-items:center;gap:8px;margin-top:4px}
.plp-budget__field{flex:1;min-width:0;display:flex;align-items:center;gap:6px;background:var(--plp-card);box-shadow:var(--plp-shadow-sm);border-radius:var(--plp-r);padding:9px 10px;font-size:13px;color:var(--plp-ink);cursor:text}
.plp-budget__field:focus-within{outline:1.5px solid var(--plp-gold);outline-offset:1px}
.plp-budget__field input{width:100%;min-width:0;border:0;background:none;padding:0;font-size:13px;color:var(--plp-ink);outline:none;-moz-appearance:textfield}
.plp-budget__field input::-webkit-outer-spin-button,.plp-budget__field input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.plp-budget__field input::placeholder{color:var(--plp-charcoal-2)}
.plp-budget__dash{color:var(--plp-sand)}
.plp-budget__go{flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:var(--plp-ivory);color:var(--plp-ink);display:grid;place-items:center;transition:background .18s}
.plp-budget__go:hover{background:var(--plp-ivory-2)}
/* colour swatches, shape chips */
.plp-sw{width:14px;height:14px;border-radius:50%;flex:0 0 auto;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)}
.plp-filters details[id^="Details-shape"] .facets__list-unstyled{display:flex;flex-wrap:wrap;gap:6px;padding-top:4px}
.plp-filters details[id^="Details-shape"] .facets__item{margin:0}
.plp-filters details[id^="Details-shape"] .facet-checkbox{background:var(--plp-card);box-shadow:var(--plp-shadow-sm);border-radius:20px;padding:8px 12px;gap:5px;font-family:var(--plp-accent);font-size:11.5px;color:var(--plp-charcoal-2);outline:1.5px solid transparent;outline-offset:1px;transition:color .16s,outline-color .16s}
.plp-filters details[id^="Details-shape"] .facet-checkbox:hover{background:var(--plp-card);color:var(--plp-ink)}
.plp-filters details[id^="Details-shape"] .facet-checkbox__box{display:none}
.plp-filters details[id^="Details-shape"] .facet-checkbox__label{flex:0 0 auto}
.plp-filters details[id^="Details-shape"] .facet-checkbox__count{font-size:10.5px;opacity:.8}
.plp-filters details[id^="Details-shape"] .facet-checkbox--active,.plp-filters details[id^="Details-shape"] .facet-checkbox:has(input:checked){color:var(--plp-ink);outline-color:var(--plp-gold)}

/* ── results grid ── */
.plp-results{padding-bottom:var(--plp-s2)}
.plp-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px 10px}
@media (min-width:720px){.plp-grid{grid-template-columns:repeat(3,1fr);gap:var(--plp-s3)}}
@media (min-width:900px){.plp-grid{grid-template-columns:repeat(4,1fr);gap:30px 22px}}
.plp-grid>*{min-width:0}

/* product cards (shared snippet, restyled in scope): the stone sits on an ivory stage,
   the photo shown as shot (the catalogue PNGs are cut-outs), no card chrome, info on the page ground */
.plp .product-card{position:relative;background:transparent;border:0;border-radius:0;box-shadow:none;overflow:visible;display:flex;flex-direction:column;height:100%;margin:0;content-visibility:auto;contain-intrinsic-size:auto 300px auto 400px}
.plp .product-card:hover{box-shadow:none;border-color:transparent}
.plp .product-card__image-wrapper{position:relative;aspect-ratio:1/1;background:var(--plp-stage);border-radius:var(--plp-r);padding:14%;display:grid;place-items:center;overflow:hidden;transition:background .25s,box-shadow .25s}
@media (min-width:900px){.plp .product-card__image-wrapper{padding:16%}}
.plp .product-card:hover .product-card__image-wrapper{background:var(--plp-ivory-2);box-shadow:var(--plp-shadow-sm)}
/* JPEG catalogue shots (strands) carry their own white ground: give them a white tile instead */
.plp .product-card--flat .product-card__image-wrapper{background:var(--plp-card);box-shadow:inset 0 0 0 1px var(--plp-ivory-2);padding:0}
.plp .product-card--flat:hover .product-card__image-wrapper{background:var(--plp-card);box-shadow:inset 0 0 0 1px var(--plp-ivory-2),var(--plp-shadow-sm)}
.plp .product-card__link{display:block;width:100%;height:100%}
.plp .product-card__image{width:100%;height:100%;object-fit:contain;transform:none;transition:none}
.plp .product-card:hover .product-card__image{transform:none}
.plp .product-card--soldout .product-card__image{opacity:.45;filter:none}
.plp .product-card--soldout:hover .product-card__image{transform:none}
.plp .product-card__placeholder{width:100%;height:100%;display:grid;place-items:center}
/* badges: "Unheated" (white pill, gold text) / "Sold out" (ink pill) */
.plp .product-card__badges{top:10px;left:10px;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.plp .product-card--soldout .product-card__badges{top:10px;left:10px}
.plp .product-card__badge{display:inline-flex;align-items:center;background:var(--plp-card);color:var(--plp-gold-deep);font-family:var(--plp-accent);font-size:10px;font-weight:400;letter-spacing:.12em;text-transform:uppercase;padding:5px 9px;border-radius:20px;box-shadow:var(--plp-shadow-sm);line-height:1.3;clip-path:none;filter:none}
.plp .product-card__badge--soldout{background:var(--plp-ink);color:#fff;background-image:none}
/* video → "▶ Video" pill; quick view → "Quick view" pill on hover (pointer devices) */
.plp .product-card__media-actions{display:contents}
.plp .product-card__action-btn{position:absolute;left:10px;bottom:10px;z-index:2;height:24px;padding:0 8px 0 6px;border-radius:20px;background:rgba(255,255,255,.92);box-shadow:none;display:inline-flex;align-items:center;gap:4px;color:var(--plp-charcoal);font-family:var(--plp-accent);font-size:10px;letter-spacing:.1em;text-transform:uppercase;transition:color .18s,background .18s}
.plp .product-card__action-btn svg{width:10px;height:10px}
.plp .product-card__action-btn:hover{color:var(--plp-ink);background:var(--plp-card)}
.plp .product-card__play::after{content:"Video"}
.plp .product-card__quick-view{display:none}
@media (hover:hover) and (min-width:900px){
  .plp .product-card__quick-view{display:inline-flex;left:50%;right:auto;bottom:12px;transform:translateX(-50%);height:auto;padding:9px 14px;background:var(--plp-card);box-shadow:var(--plp-shadow);color:var(--plp-ink);font-size:11px;letter-spacing:.12em;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .18s;z-index:3}
  .plp .product-card__quick-view svg{width:14px;height:14px}
  .plp .product-card__quick-view::after{content:"Quick view"}
  .plp .product-card:hover .product-card__quick-view,.plp .product-card:focus-within .product-card__quick-view{opacity:1;pointer-events:auto}
  .plp .product-card__play{bottom:12px}
}
/* heart always visible; compare joins it on hover (pointer devices) */
.plp .product-card__wishlist-btn--overlay,.plp .product-card__compare{position:absolute;right:10px;z-index:2;width:28px;height:28px;border:0;border-radius:50%;background:var(--plp-card);box-shadow:var(--plp-shadow-sm);display:grid;place-items:center;color:var(--plp-charcoal);opacity:1;transform:none;transition:color .18s,box-shadow .18s,background .18s,opacity .2s}
@media (min-width:900px){.plp .product-card__wishlist-btn--overlay,.plp .product-card__compare{width:30px;height:30px}}
.plp .product-card__wishlist-btn--overlay{top:10px}
.plp .product-card__compare{top:44px}
@media (min-width:900px){.plp .product-card__compare{top:46px}}
.plp .product-card__wishlist-btn--overlay svg{width:15px;height:15px}
.plp .product-card__compare img{width:14px;height:14px;padding:0}
.plp .product-card__wishlist-btn--overlay:hover,.plp .product-card__compare:hover{color:var(--plp-gold-deep);transform:none;background:var(--plp-card)}
.plp .product-card__wishlist-btn--overlay.is-wishlisted,.plp .product-card__compare.is-active{background:var(--plp-card);color:var(--plp-gold-deep);box-shadow:var(--plp-shadow-sm);outline:1.5px solid var(--plp-gold);outline-offset:1px}
@media (hover:hover) and (min-width:900px){
  .plp .product-card__compare{opacity:0}
  .plp .product-card:hover .product-card__compare,.plp .product-card:focus-within .product-card__compare,.plp .product-card__compare.is-active{opacity:1}
}
/* info: title · weight (ct · ratti) · shape / lab · price */
.plp .product-card__info{padding:10px 2px 0;display:flex;flex-direction:column;gap:3px;flex:1;background:transparent}
@media (min-width:900px){.plp .product-card__info{padding:12px 2px 0;gap:4px}}
.plp .product-card__title{font-family:var(--plp-display);font-size:16px;font-weight:600;line-height:1.15;color:var(--plp-ink);margin:0}
@media (min-width:900px){.plp .product-card__title{font-size:19px}}
.plp .product-card__title-link:hover .product-card__title{color:var(--plp-gold-deep)}
.plp .product-card__weight{font-size:12.5px;font-weight:500;color:var(--plp-ink);margin:0;line-height:1.4}
@media (min-width:900px){.plp .product-card__weight{font-size:13px}}
.plp .product-card__specs{font-family:var(--plp-body);font-size:11.5px;letter-spacing:0;text-transform:none;color:var(--plp-charcoal-2);margin:0;line-height:1.4;white-space:normal}
@media (min-width:900px){.plp .product-card__specs{font-size:12px}}
.plp .product-card__price{font-family:var(--plp-display);font-size:17px;font-weight:600;color:var(--plp-ink);margin-top:auto;padding-top:4px;letter-spacing:.01em}
@media (min-width:900px){.plp .product-card__price{font-size:20px;padding-top:6px}}
.plp .product-card--soldout .product-card__price{color:var(--plp-charcoal-2)}
.plp .price-inr__sym{font-family:var(--plp-body);font-size:.78em;font-weight:500;margin-right:1px}
.plp .product-card__cta{display:none}
/* WhatsApp help tile (slot 8 of the grid) */
.plp-help{background:var(--plp-ivory);border-radius:var(--plp-r);padding:16px 14px;display:flex;flex-direction:column;gap:8px;min-width:0;min-height:100%}
@media (min-width:900px){.plp-help{padding:24px 22px;gap:12px}}
.plp-help svg{color:var(--plp-gold)}
.plp-help__title{font-size:17px;line-height:1.1}
@media (min-width:900px){.plp-help__title{font-size:22px}}
.plp-help p{font-size:12px;line-height:1.55;color:var(--plp-charcoal)}
@media (min-width:900px){.plp-help p{font-size:13.5px;max-width:22ch}}
.plp-help__cta{margin-top:auto;padding-top:4px}
@media (min-width:900px){.plp-help__cta{padding-top:8px}}
.plp-help__btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px 8px;background:var(--plp-card);box-shadow:var(--plp-shadow-sm);border-radius:var(--plp-r);font-family:var(--plp-accent);font-size:10.5px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--plp-ink);white-space:nowrap;transition:background .18s}
@media (min-width:900px){.plp-help__btn{padding:13px 10px;font-size:11px}}
.plp-help__btn:hover{background:var(--plp-ivory-2);color:var(--plp-ink)}
.plp-help__btn svg{color:#25D366;flex:0 0 auto}

/* single loader on every breakpoint: progress line + "Show more"; the numbered pager stays in the DOM for crawlers */
.plp-infinite{display:flex;flex-direction:column;align-items:center;gap:12px;padding:28px 0 8px}
@media (min-width:900px){.plp-infinite{padding:40px 0 8px}}
.plp-progress{display:flex;flex-direction:column;align-items:center;gap:10px;font-size:12px;color:var(--plp-charcoal-2);margin:0}
.plp-progress b{font-weight:500;color:var(--plp-ink)}
.plp-progress__bar{display:block;width:220px;max-width:60vw;height:2px;background:var(--plp-sand);border-radius:2px;overflow:hidden}
.plp-progress__bar i{display:block;height:100%;width:0;background:var(--plp-gold);transition:width .3s}
.plp-loading{display:flex;align-items:center;justify-content:center;gap:10px;font-size:13.5px;color:var(--plp-charcoal-2)}
.plp-spin{width:17px;height:17px;border:2px solid var(--plp-ivory-2);border-top-color:var(--plp-gold);border-radius:50%;animation:plpSpin .8s linear infinite}
@keyframes plpSpin{to{transform:rotate(360deg)}}
.plp-end{text-align:center;font-size:13.5px;color:var(--plp-charcoal-2)}
.plp-loadmore{width:100%;max-width:260px;margin:4px 0 0;padding:15px 18px}
.plp-pager{display:none!important}

/* grouped-by-gem-type rows (curated & planet collections) */
.plp .collection-page__grouped{display:flex;flex-direction:column;gap:var(--plp-s5)}
.plp .gem-section{display:flex;flex-direction:column;gap:var(--plp-s3)}
.plp .gem-section__header{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--plp-s3)}
.plp .gem-section__titles{display:flex;flex-direction:column;gap:2px}
.plp .gem-section__title{font-size:clamp(22px,4.6vw,30px);text-transform:capitalize;letter-spacing:.01em}
.plp .gem-section__subtitle{font-size:12.5px;color:var(--plp-charcoal-2)}
.plp .gem-section__view-all{font-family:var(--plp-accent);font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--plp-gold-deep);white-space:nowrap;padding-bottom:4px}
.plp .gem-section__view-all:hover{color:var(--plp-ink)}
.plp .gem-section__row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
@media (max-width:1199px){.plp .gem-section__row{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:899px){.plp .gem-section__row{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}}
@media (max-width:640px){
  .plp .gem-section__row{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;gap:10px;padding:2px 2px var(--plp-s1)}
  .plp .gem-section__row::-webkit-scrollbar{display:none}
  .plp .gem-section__row>*{flex:0 0 58%;scroll-snap-align:start}
}
.plp .collection-page__curated-cta{text-align:center;padding:var(--plp-s5) 0 var(--plp-s2)}
.plp .curated-cta__btn{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;background:var(--plp-ink);color:#fff;border-radius:var(--plp-r);font-family:var(--plp-accent);font-size:11.5px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;transition:background .18s}
.plp .curated-cta__btn:hover{background:var(--plp-ink-soft);color:#fff}

/* empty state + enquiry form (snippet collection-empty-state) */
.plp .collection-page__empty{grid-column:1/-1;text-align:center;padding:var(--plp-s4) 0}
.plp .collection-empty__filters-note{padding:0 0 var(--plp-s2)}
.plp .collection-empty__filters-text{font-size:15px;color:var(--plp-charcoal);margin:0 0 var(--plp-s2)}
.plp .collection-empty__clear-btn{display:inline-flex;padding:12px 22px;background:var(--plp-ivory);color:var(--plp-ink);border:0;border-radius:var(--plp-r);font-family:var(--plp-accent);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase}
.plp .collection-empty__clear-btn:hover{background:var(--plp-ivory-2);color:var(--plp-ink)}
.plp .contact-enquiry-form{max-width:800px;margin:56px auto var(--plp-s4);background:var(--plp-card);border-radius:var(--plp-rl);padding:56px 32px 32px;box-shadow:var(--plp-shadow);border:0;position:relative;text-align:center}
.plp .contact-enquiry-form__icon-badge{position:absolute;top:-36px;left:50%;transform:translateX(-50%);width:72px;height:72px;background:var(--plp-ivory);border-radius:50%;display:grid;place-items:center;box-shadow:var(--plp-shadow-sm);color:var(--plp-gold-deep)}
.plp .contact-enquiry-form__icon-badge svg{width:30px;height:30px}
.plp .contact-enquiry-form__title{font-size:clamp(22px,4.6vw,28px);font-weight:600;margin:0 0 var(--plp-s4)}
.plp .contact-enquiry-form__grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:var(--plp-s2);margin-bottom:var(--plp-s2)}
.plp .contact-enquiry-form .field{text-align:left;margin-bottom:var(--plp-s2)}
.plp .contact-enquiry-form .field input,.plp .contact-enquiry-form .field textarea{width:100%;padding:13px 16px;border:0;border-radius:var(--plp-r);font-size:14px;background:var(--plp-ivory);color:var(--plp-ink);box-shadow:none}
.plp .contact-enquiry-form .field input:focus,.plp .contact-enquiry-form .field textarea:focus{outline:2px solid var(--plp-gold);outline-offset:0;background:var(--plp-card)}
.plp .contact-enquiry-form__phone-group{display:flex;gap:0}
.plp .country-code-mock{padding:13px 12px;background:var(--plp-ivory-2);border:0;font-size:13px;color:var(--plp-charcoal);display:flex;align-items:center;gap:6px;border-radius:var(--plp-r) 0 0 var(--plp-r);white-space:nowrap}
.plp .contact-enquiry-form__phone-group input{border-radius:0 var(--plp-r) var(--plp-r) 0!important}
.plp .contact-enquiry-form__actions{display:grid;grid-template-columns:1fr 1fr;gap:var(--plp-s2);margin-top:var(--plp-s1)}
.plp .btn-call,.plp .btn-submit{display:flex;align-items:center;justify-content:center;gap:10px;padding:15px;font-family:var(--plp-accent);font-size:11.5px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;border-radius:var(--plp-r);border:0;transition:background .18s}
.plp .btn-call{background:var(--plp-ivory);color:var(--plp-ink)}
.plp .btn-call:hover{background:var(--plp-ivory-2);color:var(--plp-ink);opacity:1}
.plp .btn-submit{background:var(--plp-ink);color:#fff}
.plp .btn-submit:hover{background:var(--plp-ink-soft);color:#fff;opacity:1}
.plp .form-success{margin-bottom:var(--plp-s3);color:var(--plp-gold-deep)}
@media (max-width:768px){
  .plp .contact-enquiry-form{padding:48px 18px 24px;margin:48px 0 var(--plp-s3)}
  .plp .contact-enquiry-form__grid,.plp .contact-enquiry-form__actions{grid-template-columns:1fr}
  .plp .contact-enquiry-form__grid{gap:0}
}
/* iOS: 16px fields stop focus-zoom */
@media (max-width:639px){.plp select,.plp input:not([type=checkbox]):not([type=radio]),.plp textarea{font-size:16px}}

/* ── editorial (below the listings) ── */
.plp-edi{margin-top:var(--plp-s5);background:var(--plp-ivory);padding:var(--plp-s5) 0;scroll-margin-top:calc(var(--plp-sticky-top) + var(--plp-bar-h) + 12px)}
@media (min-width:900px){.plp-edi{padding:44px 0 52px}.plp-edi .plp-wrap{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:start}.plp-edi .plp-acc{margin-top:0}}
.plp-edi__lead{max-width:76ch}
.plp-edi__lead h2{font-size:clamp(24px,5.6vw,34px)}
.plp-edi__lead p{font-size:16px;line-height:1.65;color:var(--plp-charcoal);margin-top:var(--plp-s2);max-width:68ch}
.plp-edi__tagline{font-family:var(--plp-display);font-size:19px;font-style:italic;color:var(--plp-gold-deep)}
.plp-edi__hin{color:var(--plp-ink)}
.plp-edi__hin strong{font-weight:500}
.plp-edi__note{font-style:italic;color:var(--plp-charcoal-2)}
.plp-edi__ticks{display:grid;gap:8px;margin-top:var(--plp-s3)}
.plp-edi__ticks li{display:flex;gap:9px;align-items:center;font-size:14.5px;color:var(--plp-ink)}
.plp-edi__ticks svg{flex:0 0 auto;color:var(--plp-gold)}

.plp-acc{margin-top:var(--plp-s4);background:var(--plp-card);border-radius:var(--plp-rl);box-shadow:var(--plp-shadow-sm);padding:0 var(--plp-s3)}
@media (min-width:900px){.plp-acc{padding:0 var(--plp-s4)}}
.plp-acc>details+details{border-top:1px solid var(--plp-ivory-2)}
.plp-acc>details>summary{list-style:none;cursor:pointer;padding:var(--plp-s3) 36px var(--plp-s3) 0;position:relative;font-family:var(--plp-display);font-size:19px;font-weight:600;color:var(--plp-ink);transition:color .18s}
@media (min-width:900px){.plp-acc>details>summary{padding:18px 36px 18px 0;font-size:21px}}
.plp-acc>details>summary:hover{color:var(--plp-gold-deep)}
.plp-acc>details>summary::-webkit-details-marker{display:none}
.plp-acc>details>summary::after{content:"";position:absolute;right:4px;top:50%;width:9px;height:9px;border-right:1.4px solid var(--plp-gold);border-bottom:1.4px solid var(--plp-gold);transform:translateY(-70%) rotate(45deg);transition:transform .2s}
.plp-acc>details[open]>summary::after{transform:translateY(-30%) rotate(-135deg)}
.plp-acc__body{padding:0 0 var(--plp-s4);font-size:14.5px;line-height:1.7;color:var(--plp-charcoal);max-width:76ch}
.plp-acc__body p{margin:0 0 var(--plp-s2)}
.plp-acc__body p:last-child{margin-bottom:0}
.plp-acc__body strong,.plp-acc__body b{color:var(--plp-ink);font-weight:500}
.plp-acc__body h2,.plp-acc__body h3,.plp-acc__body h4,.plp-acc__body .gem-tab>b,.plp-acc__body .gem-about>b{display:block;font-family:var(--plp-accent);font-size:11.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--plp-ink);margin:var(--plp-s4) 0 var(--plp-s2);line-height:1.4}
.plp-acc__body>div>h2:first-child,.plp-acc__body>div>h3:first-child,.plp-acc__body>div>h4:first-child,.plp-acc__body>div>b:first-child{margin-top:0}
.plp-acc__body ul,.plp-acc__body ol{margin:0 0 var(--plp-s2);padding:0;display:grid;gap:8px}
.plp-acc__body li{position:relative;padding-left:16px;font-size:14.5px;line-height:1.6;color:var(--plp-charcoal)}
.plp-acc__body li::before{content:"";position:absolute;left:0;top:10px;width:5px;height:5px;background:var(--plp-gold);border-radius:1px}
.plp-acc__body ul>p{position:relative;padding-left:16px}
.plp-acc__body ul>p::before{content:"";position:absolute;left:0;top:10px;width:5px;height:5px;background:var(--plp-gold);border-radius:1px}
.plp-acc__body a{color:var(--plp-gold-deep);text-decoration:underline;text-underline-offset:3px}
.plp-acc__body a:hover{color:var(--plp-ink)}
/* Planet / Governs rows built from the About copy's leading "Label: value" lines */
.plp-kv{display:flex;gap:var(--plp-s2);padding:10px 0;border-bottom:1px solid var(--plp-ivory-2);font-size:14.5px}
.plp-kv .k{flex:0 0 34%;color:var(--plp-charcoal-2)}
.plp-kv .v{color:var(--plp-ink)}
.plp-kv--last{border-bottom:0;margin-bottom:var(--plp-s2)}
/* hand-authored warning boxes carry inline red styling — repaint in the ivory/gold language */
.plp-acc__body div[style*="border-left"]{background:var(--plp-ivory)!important;border-left:2px solid var(--plp-gold)!important;border-radius:0 var(--plp-r) var(--plp-r) 0;padding:12px 16px!important;margin:var(--plp-s3) 0 0!important;font-size:14px;color:var(--plp-charcoal)}
.plp-acc__body div[style*="border-left"] p{margin:0}
.plp-tblwrap{overflow-x:auto;margin:var(--plp-s2) 0 var(--plp-s3);border-radius:var(--plp-r);box-shadow:var(--plp-shadow-sm)}
.plp-acc__body table{border-collapse:collapse;width:100%;min-width:480px;font-size:14px;background:var(--plp-card)}
.plp-acc__body th,.plp-acc__body td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--plp-ivory-2);vertical-align:top}
.plp-acc__body th{background:var(--plp-ivory);font-family:var(--plp-accent);font-weight:500;color:var(--plp-ink);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.plp-acc__body th strong{font-weight:500}
.plp-acc__body tr:last-child td{border-bottom:0}
/* FAQ rows */
.plp-faq__item{border-top:1px solid var(--plp-ivory-2)}
.plp-faq__item:first-of-type{border-top:0}
.plp-faq__item summary{list-style:none;cursor:pointer;position:relative;padding:13px 30px 13px 0;font-size:14.5px;font-weight:500;color:var(--plp-ink)}
.plp-faq__item summary::-webkit-details-marker{display:none}
.plp-faq__item summary::after{content:"+";position:absolute;right:4px;top:11px;font-size:17px;color:var(--plp-gold)}
.plp-faq__item[open] summary::after{content:"\2013"}
.plp-faq__item p{padding:0 30px var(--plp-s3) 0;margin:0;font-size:14px;line-height:1.7;color:var(--plp-charcoal)}
/* planet pages: the planet summary is the editorial lead */
.plp-edi .planet-summary{max-width:68ch;color:var(--plp-charcoal)}
.plp-edi .planet-summary__title{font-family:var(--plp-display);font-size:clamp(24px,5.6vw,34px);font-weight:600;color:var(--plp-ink);margin:0 0 var(--plp-s2);letter-spacing:0}
.plp-edi .planet-summary__qualities{font-family:var(--plp-accent);font-size:11.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--plp-gold-deep);margin:0 0 var(--plp-s3)}
.plp-edi .planet-summary__text p,.plp-edi .planet-summary__represents,.plp-edi .planet-summary__gem,.plp-edi .planet-summary__mantra-label{font-size:15px;line-height:1.65;color:var(--plp-charcoal);margin:0 0 var(--plp-s2)}
.plp-edi .planet-summary__mantra{margin-top:var(--plp-s3);background:var(--plp-card);border-radius:var(--plp-r);box-shadow:var(--plp-shadow-sm);padding:var(--plp-s3)}
.plp-edi .planet-summary__mantra-sanskrit{font-size:17px;color:var(--plp-ink);margin:0 0 4px}
.plp-edi .planet-summary__mantra-translit{font-style:italic;font-weight:500;font-size:14.5px;color:var(--plp-charcoal);margin:0}

@media (prefers-reduced-motion:reduce){.plp *{transition:none!important;animation:none!important}}
{% endstyle %}

<section class="plp" id="plp-{{ section.id }}" data-collection="{{ collection.handle }}">

  <div class="plp-wrap">
    <nav class="plp-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> ›
      {%- if crumb_parent_title != '' -%}
        <a href="{{ crumb_parent_url }}">{{ crumb_parent_title }}</a> ›
      {%- endif -%}
      <span class="plp-cur">{{ collection.title }}</span>
    </nav>

  </div>

  {%- if collection.image -%}
    <div class="plp-photo">
      <img
        src="{{ collection.image | image_url: width: 1800 }}"
        srcset="{{ collection.image | image_url: width: 800 }} 800w, {{ collection.image | image_url: width: 1200 }} 1200w, {{ collection.image | image_url: width: 1800 }} 1800w, {{ collection.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        width="1800" height="{{ 1800 | divided_by: collection.image.aspect_ratio | round }}"
        alt="{{ collection.image.alt | default: collection.title | escape }}"
        loading="eager" fetchpriority="high" decoding="async"
      >
    </div>
  {%- endif -%}

  <div class="plp-wrap">
    <div class="plp-hero{% if collection.image %} plp-hero--panel{% endif %}">
      <div class="plp-hero__text">
        <p class="plp-eyebrow">
          {%- if crumb_parent_title != '' -%}{{ crumb_parent_title }}{%- endif -%}
          {%- if copy_planet != blank -%}{% if crumb_parent_title != '' %} · {% endif %}gem of {{ copy_planet }}{%- endif -%}
          {%- if crumb_parent_title == '' and copy_planet == blank -%}Precious Carats{%- endif -%}
        </p>
        <h1>{{ collection.title }}{% if alt_name != blank and alt_name != collection.title %}<span>{{ alt_name }}</span>{% endif %}</h1>
        <p class="plp-hero__desc">
          {%- if is_planet -%}
            Gemstones aligned with {{ collection.title }} — certified natural, with full treatment disclosure.
          {%- elsif is_overview -%}
            {{ intro_line | default: copy_tagline }}
          {%- else -%}
            {{ collection.products_count }} certified natural gemstone{% if collection.products_count != 1 %}s{% endif %}, every treatment disclosed. Shop by the weight your astrologer prescribed, your budget or origin.
          {%- endif -%}
        </p>
        <div class="plp-hero__links">
          <a class="plp-goldlink" href="#about">About {{ copy_welcome | default: collection.title }}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          {%- if is_planet == false and is_overview == false -%}
            <a class="plp-goldlink" href="#acc-awareness" data-plp-open-acc="awareness">How to choose<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          {%- endif -%}
        </div>
      </div>
      <ul class="plp-hero__trust" aria-label="Our assurance">
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg><span><b>Lab certified</b><small>{{ plp_labs }}</small></span></li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 8h6M9 12h6M9 16h4"/></svg><span><b>Treatment disclosed</b><small>on every gem</small></span></li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg><span><b>10-day returns</b><small>on loose gems</small></span></li>
      </ul>
    </div>
  </div>

  <!-- ═══════════ STICKY FILTER BAR ═══════════ -->
  <div class="plp-bar">
    <div class="plp-wrap plp-bar__in">
      <div class="plp-bar__lead">
        <button type="button" class="plp-fbtn" id="plpOpenFilters" aria-controls="plpFilters" aria-expanded="false">
          <svg width="15" height="13" viewBox="0 0 16 14" fill="none" aria-hidden="true"><path d="M0 2h16M3 7h10M6 12h4" stroke="currentColor" stroke-width="1.4"/></svg>
          Filters
          {%- if plp_active > 0 -%}<span class="plp-fbtn__n">{{ plp_active }}</span>{%- endif -%}
        </button>
        <span class="plp-fcount"><b>{{ collection.products_count }}</b> piece{% if collection.products_count != 1 %}s{% endif %}</span>
      </div>

      <div class="plp-bar__scroll">
        {%- if plp_active > 0 -%}
          <div class="plp-tags" aria-label="Active filters">
            {%- for filter in collection.filters -%}
              {%- assign _fl = filter.label | handleize -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value or filter.max_value.value -%}
                  <a class="plp-tag" href="{{ filter.url_to_remove }}">
                    {%- if filter.min_value.value -%}{{ filter.min_value.value | money_without_trailing_zeros }}{%- else -%}{{ 0 | money_without_trailing_zeros }}{%- endif %} – {% if filter.max_value.value -%}{{ filter.max_value.value | money_without_trailing_zeros }}{%- else -%}{{ filter.range_max | money_without_trailing_zeros }}{%- endif -%}
                    <svg width="8" height="8" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4"/></svg>
                  </a>
                {%- endif -%}
              {%- elsif _fl contains 'weight' -%}
                {%- if filter.active_values.size > 0 -%}
                  <a class="plp-tag" href="{{ filter.url_to_remove }}">{{ filter.label | escape }}
                    <svg width="8" height="8" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4"/></svg>
                  </a>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  {%- assign _tag_label = value.label -%}
                  {%- assign _tag_dc = value.label | downcase -%}
                  {%- if _tag_dc contains 'unheated' or _tag_dc contains 'no indications' -%}{%- assign _tag_label = 'Unheated' -%}
                  {%- elsif _tag_dc contains 'glass' -%}{%- assign _tag_label = 'Glass-filled' -%}
                  {%- elsif _tag_label contains '(' -%}{%- assign _tag_label = _tag_label | split: '(' | first | strip -%}{%- endif -%}
                  <a class="plp-tag" href="{{ value.url_to_remove }}">{{ _tag_label | escape }}
                    <svg width="8" height="8" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4"/></svg>
                  </a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <a class="plp-tags__clear" href="{{ collection.url }}">Clear all</a>
          </div>
        {%- endif -%}

        {%- unless show_grouped -%}
          {%- if plp_unheated_url != '' -%}
            <a class="plp-chip" href="{{ plp_unheated_url }}" aria-pressed="{% if plp_unheated_on %}true{% else %}false{% endif %}">Unheated only</a>
          {%- endif -%}
          {%- if price_filter and is_sacred_gem == false -%}
            <button type="button" class="plp-chip" data-min="0" data-max="50000" aria-pressed="{% if min_val == 0 and max_val == 50000 %}true{% else %}false{% endif %}">Under ₹50K</button>
            {%- unless is_sacred -%}
              <button type="button" class="plp-chip" data-min="50000" data-max="200000" aria-pressed="{% if min_val == 50000 and max_val == 200000 %}true{% else %}false{% endif %}">₹50K – ₹2 lac</button>
              <button type="button" class="plp-chip" data-min="200000" data-max="1000000" aria-pressed="{% if min_val == 200000 and max_val == 1000000 %}true{% else %}false{% endif %}">₹2 – ₹10 lac</button>
              <button type="button" class="plp-chip" data-min="1000000" data-max="" aria-pressed="{% if min_val == 1000000 and max_val == 0 %}true{% else %}false{% endif %}">Above ₹10 lac</button>
            {%- endunless -%}
          {%- endif -%}
        {%- endunless -%}
      </div>

      {%- unless show_grouped -%}
        <div class="plp-sort">
          <label for="sort-select">Sort by</label>
          <select id="sort-select" aria-label="Sort by" onchange="const searchParams = new URLSearchParams(window.location.search); if (this.value === 'manual') { searchParams.delete('sort_by'); } else { searchParams.set('sort_by', this.value); } searchParams.delete('page'); const qs = searchParams.toString(); window.location.href = window.location.pathname + (qs ? '?' + qs : '');">
            <option value="manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}selected{% endif %}>Featured</option>
            <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="weight-ascending" {% if collection.sort_by == 'weight-ascending' %}selected{% endif %}>Weight: Low to High</option>
            <option value="weight-descending" {% if collection.sort_by == 'weight-descending' %}selected{% endif %}>Weight: High to Low</option>
          </select>
        </div>
      {%- endunless -%}
    </div>
  </div>

  <!-- ═══════════ RAIL + RESULTS ═══════════ -->
  <div class="plp-wrap plp-layout">

    <aside class="plp-filters" id="plpFilters" data-open="false">
      <div class="plp-filters__scrim" data-plp-close></div>
      <div class="plp-filters__panel" aria-labelledby="plpFiltersTitle">
        <div class="plp-filters__head">
          <b id="plpFiltersTitle">Filters &amp; sort</b>
          <button type="button" class="plp-filters__close" data-plp-close aria-label="Close filters">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
        </div>
        <div class="plp-filters__body" id="main-collection-filters" data-id="{{ section.id }}">
          <div class="plp-filters__rhead"><b>Filters</b>{% if plp_active > 0 %}<a class="plp-goldlink" href="{{ collection.url }}">Clear all</a>{% endif %}</div>
          {%- if show_grouped == false and price_filter and is_sacred_gem == false -%}
            {%- comment -%} Budget min / max (the price facet itself is kept out of the rail; the bands live in the bar) {%- endcomment -%}
            <details class="facets__disclosure plp-budget" id="plpBudget" open>
              <summary class="facets__summary"><span class="facets__summary-label">Budget</span><svg viewBox="0 0 24 24" width="14" height="14" class="icon-caret" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
              <div class="facets__display">
                <div class="plp-budget__row">
                  <label class="plp-budget__field"><span>₹</span><input type="number" inputmode="numeric" min="0" step="1000" placeholder="Min" id="plpBudgetMin" aria-label="Minimum budget in rupees" value="{% if min_val > 0 %}{{ min_val }}{% endif %}"></label>
                  <span class="plp-budget__dash">–</span>
                  <label class="plp-budget__field"><span>₹</span><input type="number" inputmode="numeric" min="0" step="1000" placeholder="Max" id="plpBudgetMax" aria-label="Maximum budget in rupees" value="{% if max_val > 0 %}{{ max_val }}{% endif %}"></label>
                  <button type="button" class="plp-budget__go" id="plpBudgetGo" aria-label="Apply budget"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
                </div>
              </div>
            </details>
          {%- endif -%}
          {% render 'facets', results: collection, enable_filtering: true, open_count: 8 %}
        </div>
        <div class="plp-filters__foot">
          <a class="plp-btn plp-btn--ghost" href="{{ collection.url }}">Clear all</a>
          <button type="button" class="plp-btn plp-btn--solid" data-plp-close>Show {{ collection.products_count }} piece{% if collection.products_count != 1 %}s{% endif %}</button>
        </div>
      </div>
    </aside>

    <main class="plp-results">
      {%- if show_grouped -%}
        {%- comment -%} Build the gem-type list. For navratna/upratnas use a hardcoded
           list so we don't depend on collection.products (capped at 50). {%- endcomment -%}
        {%- if collection.handle == 'sacred-essentials' -%}
          {%- assign types_list = 'Ruby||Emerald||Yellow Sapphire||White Sapphire||Blue Sapphire||Pearl||Red Coral||Hessonite||Cateye||Opal||' -%}
        {%- elsif collection.handle == 'navratna' -%}
          {%- assign types_list = 'Ruby||Pearl||Coral||Emerald||Yellow Sapphire||White Sapphire||Blue Sapphire||Hessonite||Cats Eye||Diamond||Other||' -%}
        {%- elsif collection.handle == 'beyond-nine' -%}
          {%- assign types_list = 'Peach Sapphire||Star Sapphire||Padparadscha Sapphire||Pink Sapphire||Spinel||Colour Change Sapphire||Other||' -%}
        {%- elsif collection.handle == 'crush-worthy-delights' -%}
          {%- assign types_list = 'Amethyst||Tourmaline||Peridot||Citrine||Blue Topaz||Other||' -%}
        {%- elsif collection.handle == 'upratnas' -%}
          {%- assign types_list = 'Garnet||Amethyst||Citrine||Iolite||Turquoise||Peridot||Tourmaline||Moonstone||Lapis Lazuli||Malachite||Natural Zircon||Blue Topaz||Aquamarine||Tiger Eye||Bi-colour Sapphire||Purple Sapphire||Agate||Green Onyx||White Coral||Sphatik||Opal||Other||' -%}
        {%- else -%}
          {%- assign types_list = '' -%}
          {%- assign has_untyped = false -%}
          {%- for product in collection.products -%}
            {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
            {%- assign gem_val = product.metafields.custom.gem_type | default: '' -%}
            {%- if gem_val != blank -%}
              {%- assign type_token = gem_val | append: '||' -%}
              {%- unless types_list contains type_token -%}
                {%- assign types_list = types_list | append: type_token -%}
              {%- endunless -%}
            {%- else -%}
              {%- assign has_untyped = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if has_untyped -%}
            {%- assign types_list = types_list | append: 'Other||' -%}
          {%- endif -%}
        {%- endif -%}
        {%- assign gem_types = types_list | split: '||' -%}

        {%- comment -%} If the Gem Type facet is active, restrict the rendered gem sections to the selected values. {%- endcomment -%}
        {%- assign _active_gem_filter = '' -%}
        {%- for filter in collection.filters -%}
          {%- if filter.label == 'Gem Type' and filter.active_values.size > 0 -%}
            {%- for v in filter.active_values -%}
              {%- assign _active_gem_filter = _active_gem_filter | append: v.label | append: '||' -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if _active_gem_filter != '' -%}
          {%- assign _filtered_list = '' -%}
          {%- for gt in gem_types -%}
            {%- if gt == blank -%}{%- continue -%}{%- endif -%}
            {%- assign _tok = gt | append: '||' -%}
            {%- if _active_gem_filter contains _tok -%}
              {%- assign _filtered_list = _filtered_list | append: _tok -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign gem_types = _filtered_list | split: '||' -%}
        {%- endif -%}

        {%- comment -%} With the Gem Type facet active, collection.products is already
           narrowed to the selection, so drop the 4-card teaser cap — otherwise
           "View All" lands back here and still hides items past the cap. {%- endcomment -%}
        {%- assign show_all_in_sections = false -%}
        {%- if _active_gem_filter != '' -%}
          {%- assign show_all_in_sections = true -%}
        {%- endif -%}

        <div class="collection-page__grouped" id="ProductGridContainer" data-per-page="{{ section.settings.products_per_page }}">
          {%- assign _rendered_sections = 0 -%}
          {%- for gem_type in gem_types -%}
            {%- if gem_type == blank -%}{%- continue -%}{%- endif -%}

            {%- comment -%} Gem types whose collection handle differs from the handleized name
                (Coral -> red-coral, Sphatik -> sphatik-rock-crystal, ...) live in the shared snippet {%- endcomment -%}
            {%- capture type_handle -%}{%- render 'gem-collection-handle', gem_type: gem_type -%}{%- endcapture -%}
            {%- assign type_handle = type_handle | strip -%}
            {%- assign type_collection = collections[type_handle] -%}

            {%- comment -%}
              Pull products and count from the gem-type's own collection so we
              aren't bound by the 50-product cap on collection.products.
              Fall back to filtering the parent collection only for "Other"
              or when no matching gem-type collection exists.
            {%- endcomment -%}
            {%- assign gem_type_dc = gem_type | downcase -%}
            {%- assign use_type_collection = false -%}
            {%- if gem_type != 'Other' and type_collection != blank and type_collection.id -%}
              {%- assign use_type_collection = true -%}
            {%- endif -%}
            {%- comment -%} Sanctum and Strand Edit show only their own curated products, never the full gem-type collections {%- endcomment -%}
            {%- if is_sanctum or is_strand -%}
              {%- assign use_type_collection = false -%}
            {%- endif -%}

            {%- if is_sacred -%}
              {%- comment -%} Sacred Essentials: keep the ≤₹50K identity — count and link with the price cap. ₹50,000 = 5,000,000 in the storefront's subunit. {%- endcomment -%}
              {%- assign gem_total = 0 -%}
              {%- if use_type_collection -%}
                {%- for product in type_collection.products -%}
                  {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                  {%- if product.price <= 5000000 -%}
                    {%- assign gem_total = gem_total | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign view_all_url = type_collection.url | append: '?filter.v.price.lte=50000' -%}
              {%- else -%}
                {%- for product in collection.products -%}
                  {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                  {%- assign product_gem = product.metafields.custom.gem_type | default: '' | downcase -%}
                  {%- assign product_type_dc = product.type | downcase -%}
                  {%- if product_gem == gem_type_dc or product_type_dc == gem_type_dc -%}
                    {%- if product.price <= 5000000 -%}
                      {%- assign gem_total = gem_total | plus: 1 -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign view_all_url = '/collections/' | append: type_handle | append: '?filter.v.price.lte=50000' -%}
              {%- endif -%}
            {%- elsif use_type_collection -%}
              {%- assign gem_total = type_collection.all_products_count -%}
              {%- assign view_all_url = type_collection.url -%}
            {%- else -%}
              {%- assign gem_total = 0 -%}
              {%- for product in collection.products -%}
                {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                {%- if is_sanctum and product.price < 100000000 -%}{%- continue -%}{%- endif -%}
                {%- assign product_gem = product.metafields.custom.gem_type | default: '' | downcase -%}
                {%- assign product_type_dc = product.type | downcase -%}
                {%- if gem_type == 'Other' -%}
                  {%- if product_gem == blank and product_type_dc == blank -%}
                    {%- assign gem_total = gem_total | plus: 1 -%}
                  {%- endif -%}
                {%- else -%}
                  {%- if product_gem == gem_type_dc or product_type_dc == gem_type_dc -%}
                    {%- assign gem_total = gem_total | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign view_all_url = '/collections/' | append: type_handle -%}
              {%- if is_sanctum -%}
                {%- assign view_all_url = view_all_url | append: '?filter.v.price.gte=1000000' -%}
              {%- endif -%}
              {%- comment -%} Strand Edit: stay inside the curated collection, filtered to the gem type, instead of jumping to /collections/pearl etc. {%- endcomment -%}
              {%- if is_strand -%}
                {%- if gem_type == 'Other' -%}
                  {%- assign view_all_url = collection.url -%}
                {%- else -%}
                  {%- assign _gt_enc = gem_type | url_encode -%}
                  {%- assign view_all_url = collection.url | append: '?filter.p.m.custom.gem_type=' | append: _gt_enc -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}

            {%- if gem_total == 0 -%}{%- continue -%}{%- endif -%}
            {%- assign _rendered_sections = _rendered_sections | plus: 1 -%}

            <section class="gem-section" data-gem-type="{{ gem_type | escape }}">
              <header class="gem-section__header">
                <div class="gem-section__titles">
                  <h2 class="gem-section__title">{{ gem_type }}</h2>
                  <p class="gem-section__subtitle">{{ gem_total }} item{% if gem_total != 1 %}s{% endif %}</p>
                </div>
                {%- comment -%} On Strand Edit the link points back to this same filtered page — hide it once everything is already shown {%- endcomment -%}
                {%- unless is_strand and show_all_in_sections -%}
                  <a href="{{ view_all_url }}" class="gem-section__view-all">View All <span aria-hidden="true">→</span></a>
                {%- endunless -%}
              </header>
              <div class="gem-section__row">
                {%- if is_sacred -%}
                  {%- assign gem_shown = 0 -%}
                  {%- if use_type_collection -%}
                    {%- for product in type_collection.products -%}
                      {%- if gem_shown >= 4 -%}{%- break -%}{%- endif -%}
                      {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                      {%- if product.price <= 5000000 -%}
                        {%- if _rendered_sections == 1 -%}{%- assign _ci = gem_shown | plus: 1 -%}{%- else -%}{%- assign _ci = 0 -%}{%- endif -%}
                        {% render 'product-card', product: product, card_index: _ci, trim_carat: true, rich: true %}
                        {%- assign gem_shown = gem_shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for product in collection.products -%}
                      {%- if show_all_in_sections == false and gem_shown >= 4 -%}{%- break -%}{%- endif -%}
                      {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                      {%- assign product_gem = product.metafields.custom.gem_type | default: '' | downcase -%}
                      {%- assign product_type_dc = product.type | downcase -%}
                      {%- if product_gem == gem_type_dc or product_type_dc == gem_type_dc -%}
                        {%- if product.price <= 5000000 -%}
                          {%- if _rendered_sections == 1 -%}{%- assign _ci = gem_shown | plus: 1 -%}{%- else -%}{%- assign _ci = 0 -%}{%- endif -%}
                          {% render 'product-card', product: product, card_index: _ci, trim_carat: true, rich: true %}
                          {%- assign gem_shown = gem_shown | plus: 1 -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- elsif use_type_collection -%}
                  {%- assign gem_shown = 0 -%}
                  {%- for product in type_collection.products -%}
                    {%- if gem_shown >= 4 -%}{%- break -%}{%- endif -%}
                    {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                    {%- if _rendered_sections == 1 -%}{%- assign _ci = gem_shown | plus: 1 -%}{%- else -%}{%- assign _ci = 0 -%}{%- endif -%}
                    {% render 'product-card', product: product, hide_details: is_planet, card_index: _ci, trim_carat: true, rich: true %}
                    {%- assign gem_shown = gem_shown | plus: 1 -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- assign gem_shown = 0 -%}
                  {%- for product in collection.products -%}
                    {%- if show_all_in_sections == false and gem_shown >= 4 -%}{%- break -%}{%- endif -%}
                    {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                    {%- if is_sanctum and product.price < 100000000 -%}{%- continue -%}{%- endif -%}
                    {%- assign product_gem = product.metafields.custom.gem_type | default: '' | downcase -%}
                    {%- assign product_type_dc = product.type | downcase -%}
                    {%- if _rendered_sections == 1 -%}{%- assign _ci = gem_shown | plus: 1 -%}{%- else -%}{%- assign _ci = 0 -%}{%- endif -%}
                    {%- if gem_type == 'Other' -%}
                      {%- if product_gem == blank and product_type_dc == blank -%}
                        {% render 'product-card', product: product, hide_details: is_planet, card_index: _ci, trim_carat: true, rich: true %}
                        {%- assign gem_shown = gem_shown | plus: 1 -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product_gem == gem_type_dc or product_type_dc == gem_type_dc -%}
                        {% render 'product-card', product: product, hide_details: is_planet, card_index: _ci, trim_carat: true, rich: true %}
                        {%- assign gem_shown = gem_shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </section>
          {%- endfor -%}
          {%- comment -%}
            Filters (e.g. a high price floor) can eliminate every gem-type
            section; without this the grouped view rendered a blank page.
          {%- endcomment -%}
          {%- if _rendered_sections == 0 -%}
            {% render 'collection-empty-state', results: collection %}
          {%- endif -%}
        </div>
        {%- if is_curated -%}
          <div class="collection-page__curated-cta">
            <a href="/collections" class="curated-cta__btn">View All Curated Collections <span aria-hidden="true">→</span></a>
          </div>
        {%- endif -%}
      {%- else -%}
        {%- paginate collection.products by section.settings.products_per_page -%}
          <div class="plp-grid" id="ProductGridContainer" data-per-page="{{ section.settings.products_per_page }}">
            {%- if collection.products.size == 0 -%}
              {% render 'collection-empty-state', results: collection %}
            {%- else -%}
              {%- assign _plp_shown = 0 -%}
              {%- for product in collection.products -%}
                {%- if hide_strands -%}{%- assign pt_dc = product.title | downcase -%}{%- if pt_dc contains 'strand' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                {%- assign _plp_shown = _plp_shown | plus: 1 -%}
                {% render 'product-card', product: product, card_index: forloop.index, trim_carat: true, rich: true %}
                {%- if _plp_shown == 7 and paginate.current_page == 1 -%}{%- render 'plp-help-tile', collection: collection -%}{%- endif -%}
              {%- endfor -%}
              {%- if _plp_shown > 0 and _plp_shown < 7 and paginate.current_page == 1 -%}{%- render 'plp-help-tile', collection: collection -%}{%- endif -%}
            {%- endif -%}
          </div>

          {%- if collection.products.size > 0 -%}
            {%- comment -%} One loader on every breakpoint: phones append on scroll, desktop clicks "Show more"; the numbered pager below stays in the DOM for crawlers only {%- endcomment -%}
            <div class="plp-infinite" id="plpInfinite" data-next-url="{% if paginate.next %}{{ paginate.next.url }}{% endif %}" data-total="{{ collection.products_count }}">
              <p class="plp-progress"><span>Showing <b id="plpShown">{{ collection.products.size }}</b> of {{ collection.products_count }} piece{% if collection.products_count != 1 %}s{% endif %}</span><i class="plp-progress__bar" aria-hidden="true"><i id="plpBar"></i></i></p>
              <div class="plp-loading" id="plpLoader" hidden><span class="plp-spin" aria-hidden="true"></span> Loading more…</div>
              <button type="button" class="plp-btn plp-btn--ghost plp-loadmore" id="plpLoadMore" hidden>Show {{ section.settings.products_per_page }} more</button>
              <p class="plp-end" id="plpEnd" hidden>You have seen all {{ collection.products_count }} piece{% if collection.products_count != 1 %}s{% endif %}.</p>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            {%- assign _cur_page = paginate.current_page | append: '' -%}
            <nav class="plp-pager" id="plpPager" aria-label="Pagination">
              <span class="plp-pager__count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              <div class="plp-pager__pages">
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}">{{ part.title }}</a>
                  {%- elsif part.title == _cur_page -%}
                    <span class="current" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="deco">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <div class="plp-pager__nav">
                {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Prev</a>{%- endif -%}
                {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
              </div>
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    </main>
  </div>

  <!-- ═══════════ EDITORIAL, BELOW THE LISTINGS ═══════════ -->
  {%- capture acc_1 -%}{%- if is_overview -%}{%- render 'cht-about', gem_handle: gem_handle -%}{%- elsif is_planet == false -%}{%- render 'cht-about', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- capture acc_2 -%}{%- if is_overview -%}{%- render 'cht-co-who-for', gem_handle: gem_handle -%}{%- elsif is_planet == false -%}{%- render 'cht-who-wear', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- capture acc_3 -%}{%- if is_overview -%}{%- render 'cht-co-why-exists', gem_handle: gem_handle -%}{%- elsif is_planet == false -%}{%- render 'cht-benefits', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- capture acc_4 -%}{%- if is_overview -%}{%- render 'cht-co-belongs-here', gem_handle: gem_handle -%}{%- elsif is_planet == false -%}{%- render 'cht-pricing', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- capture acc_5 -%}{%- if is_overview -%}{%- render 'cht-co-what-it-is-not', gem_handle: gem_handle -%}{%- elsif is_planet == false -%}{%- render 'cht-buyer-awareness', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- capture acc_6 -%}{%- if is_overview -%}{%- render 'cht-co-our-promise', gem_handle: gem_handle -%}{%- elsif is_planet == false -%}{%- render 'cht-care', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- capture acc_7 -%}{%- if is_overview == false and is_planet == false -%}{%- render 'cht-faq', gem_handle: gem_handle -%}{%- endif -%}{%- endcapture -%}
  {%- assign acc_1 = acc_1 | strip -%}{%- assign acc_2 = acc_2 | strip -%}{%- assign acc_3 = acc_3 | strip -%}{%- assign acc_4 = acc_4 | strip -%}
  {%- assign acc_5 = acc_5 | strip -%}{%- assign acc_6 = acc_6 | strip -%}{%- assign acc_7 = acc_7 | strip -%}
  {%- if is_overview -%}
    {%- assign acc_labels = 'What it is|Who is it for|Why it exists|What belongs here|What it is not|Our promise|' | split: '|' -%}
    {%- assign acc_keys = 'about|who|why|belongs|not|promise|' | split: '|' -%}
  {%- else -%}
    {%- assign acc_labels = 'About|Who should wear|Benefits|Pricing &amp; origins|Buyer awareness|Care guide|FAQ' | split: '|' -%}
    {%- assign acc_keys = 'about|who|benefits|pricing|awareness|care|faq' | split: '|' -%}
  {%- endif -%}
  {%- assign has_acc = false -%}
  {%- if acc_1 != blank or acc_2 != blank or acc_3 != blank or acc_4 != blank or acc_5 != blank or acc_6 != blank or acc_7 != blank -%}{%- assign has_acc = true -%}{%- endif -%}

  <section class="plp-edi" id="about" aria-label="About {{ collection.title | escape }}">
    <div class="plp-wrap">
      <div class="plp-edi__lead">
        {%- if is_planet -%}
          {%- render 'planet-summary', planet_handle: collection.handle -%}
        {%- else -%}
          <h2>About {{ copy_welcome | default: collection.title }}</h2>
          {%- if copy_tagline != blank -%}<p class="plp-edi__tagline">{{ copy_tagline }}</p>{%- endif -%}
          {%- for para in copy_paragraphs -%}
            {%- assign _p = para | strip -%}
            {%- if _p == blank -%}{%- continue -%}{%- endif -%}
            {%- if forloop.last and forloop.index > 1 and copy_paragraphs.size > 2 -%}
              <p class="plp-edi__note">{{ _p }}</p>
            {%- else -%}
              <p>{{ _p }}</p>
            {%- endif -%}
          {%- endfor -%}
          {%- if copy_hindi != blank -%}<p class="plp-edi__hin">{{ copy_hindi }}</p>{%- endif -%}
        {%- endif -%}
      </div>

      {%- if has_acc -%}
        <div class="plp-acc" id="plpAcc">
          {%- assign _acc_open = false -%}
          {%- for i in (1..7) -%}
            {%- case i -%}
              {%- when 1 -%}{%- assign _body = acc_1 -%}
              {%- when 2 -%}{%- assign _body = acc_2 -%}
              {%- when 3 -%}{%- assign _body = acc_3 -%}
              {%- when 4 -%}{%- assign _body = acc_4 -%}
              {%- when 5 -%}{%- assign _body = acc_5 -%}
              {%- when 6 -%}{%- assign _body = acc_6 -%}
              {%- when 7 -%}{%- assign _body = acc_7 -%}
            {%- endcase -%}
            {%- assign _idx = i | minus: 1 -%}
            {%- assign _label = acc_labels[_idx] -%}
            {%- if _body == blank or _label == blank -%}{%- continue -%}{%- endif -%}
            <details id="acc-{{ acc_keys[_idx] }}"{% if _acc_open == false %} open{% endif %}>
              <summary>{{ _label }}</summary>
              <div class="plp-acc__body" data-acc="{{ acc_keys[_idx] }}">{{ _body }}</div>
            </details>
            {%- assign _acc_open = true -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</section>

{%- comment -%}
  Collection JSON-LD: BreadcrumbList + CollectionPage with an ItemList of only
  the products on the current page — no nested Product/offers markup, since
  Google does not grant merchant-listing rich results to category pages. The
  paginate block mirrors the product grid's above, so schema always matches
  visible content. Grouped displays (show_grouped) render filtered, unpaginated
  layouts, so they emit CollectionPage without an ItemList rather than a list
  that mismatches the page.
{%- endcomment -%}
{%- if collection != blank -%}
  {%- assign cs_url = shop.url | append: collection.url -%}
  {%- assign cs_desc = collection.description | strip_html | strip | truncate: 300 -%}
  {%- if cs_desc == blank -%}{%- assign cs_desc = intro_line -%}{%- endif -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
          {%- if crumb_parent_title != '' -%},
          { "@type": "ListItem", "position": 2, "name": {{ crumb_parent_title | json }}, "item": {{ shop.url | append: crumb_parent_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": {{ cs_url | json }} }
          {%- else -%},
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ cs_url | json }} }
          {%- endif -%}
        ]
      },
      {
        "@type": "CollectionPage",
        "name": {{ collection.title | json }},
        "url": {{ cs_url | json }}
        {%- if cs_desc != blank -%},
        "description": {{ cs_desc | json }}
        {%- endif -%}
        {%- unless show_grouped -%},
        "mainEntity": {
          "@type": "ItemList",
          {%- paginate collection.products by section.settings.products_per_page %}
          "numberOfItems": {{ collection.products.size | json }},
          "itemListElement": [
            {%- for product in collection.products %}
            {
              "@type": "ListItem",
              "position": {{ forloop.index | plus: paginate.current_offset }},
              "url": {{ shop.url | append: '/products/' | append: product.handle | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor %}
          ]
          {%- endpaginate %}
        }
        {%- endunless -%}
      }
    ]
  }
  </script>
{%- endif -%}

<script>
(function () {
  'use strict';
  var root = document.getElementById('plp-{{ section.id }}');
  if (!root) return;

  var MQ_MOBILE = window.matchMedia('(max-width: 899px)');
  var MQ_DESKTOP = window.matchMedia('(min-width: 900px)');
  function onMQ(mq, fn) { if (mq.addEventListener) mq.addEventListener('change', fn); else if (mq.addListener) mq.addListener(fn); }
  function isMobile() { return MQ_MOBILE.matches; }

  /* ── sticky offsets: only the header section actually pins (mobile). Measure what sticks. ── */
  function measureSticky() {
    var top = 0, cands = [];
    try { cands.push(document.querySelector('.shopify-section:has(.site-header)')); } catch (e) { /* :has unsupported */ }
    cands.push(document.querySelector('.site-header'), document.querySelector('.nav-bar'));
    cands.forEach(function (el) {
      if (!el) return;
      var cs = getComputedStyle(el);
      if (cs.position !== 'sticky' && cs.position !== 'fixed') return;
      var h = el.getBoundingClientRect().height;
      if (!h) return;
      // a sticky box can only pin while its parent extends below it (the theme's
      // .site-header / .nav-bar sit flush at the bottom of their wrappers, so they never do)
      if (cs.position === 'sticky' && el.parentElement) {
        var pr = el.parentElement.getBoundingClientRect(), er = el.getBoundingClientRect();
        if (pr.bottom - er.bottom <= 1) return;
      }
      var t = parseFloat(cs.top); if (isNaN(t)) t = 0;
      if (t + h > top) top = t + h;
    });
    root.style.setProperty('--plp-sticky-top', Math.round(top) + 'px');
    var bar = root.querySelector('.plp-bar');
    if (bar) root.style.setProperty('--plp-bar-h', Math.round(bar.getBoundingClientRect().height) + 'px');
  }
  measureSticky();
  window.addEventListener('resize', measureSticky);
  window.addEventListener('load', measureSticky);

  /* ── filter drawer (mobile) ── */
  var filters = document.getElementById('plpFilters');
  var openBtn = document.getElementById('plpOpenFilters');
  function setDrawer(open) {
    if (!filters) return;
    var panel = filters.querySelector('.plp-filters__panel');
    filters.setAttribute('data-open', open ? 'true' : 'false');
    document.body.style.overflow = open ? 'hidden' : '';
    if (panel) {
      if (open) { panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); }
      else { panel.removeAttribute('role'); panel.removeAttribute('aria-modal'); }
    }
    if (openBtn) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) {
      var c = filters.querySelector('.plp-filters__close');
      if (c) setTimeout(function () { c.focus(); }, 60);
    } else if (openBtn && document.activeElement && filters.contains(document.activeElement)) {
      openBtn.focus();
    }
  }
  if (openBtn) openBtn.addEventListener('click', function () { setDrawer(true); });
  if (filters) {
    filters.querySelectorAll('[data-plp-close]').forEach(function (el) {
      el.addEventListener('click', function () { setDrawer(false); });
    });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && filters && filters.getAttribute('data-open') === 'true') setDrawer(false);
  });
  onMQ(MQ_DESKTOP, function (e) { if (e.matches) setDrawer(false); });

  /* ── budget min / max fields (rail) ── */
  (function () {
    var go = document.getElementById('plpBudgetGo'), mn = document.getElementById('plpBudgetMin'), mx = document.getElementById('plpBudgetMax');
    if (!go || !mn || !mx) return;
    function apply() {
      var sp = new URLSearchParams(window.location.search);
      var a = parseInt(mn.value, 10), b = parseInt(mx.value, 10);
      if (!isNaN(a) && !isNaN(b) && b < a) { var t = a; a = b; b = t; }
      if (!isNaN(a) && a > 0) sp.set('filter.v.price.gte', a); else sp.delete('filter.v.price.gte');
      if (!isNaN(b) && b > 0) sp.set('filter.v.price.lte', b); else sp.delete('filter.v.price.lte');
      sp.delete('page');
      var qs = sp.toString();
      window.location.href = window.location.pathname + (qs ? '?' + qs : '');
    }
    go.addEventListener('click', apply);
    [mn, mx].forEach(function (i) { i.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); apply(); } }); });
  })();

  /* ── hero "How to choose" → open that accordion before the scroll ── */
  root.querySelectorAll('[data-plp-open-acc]').forEach(function (a) {
    a.addEventListener('click', function () {
      var d = document.getElementById('acc-' + a.getAttribute('data-plp-open-acc'));
      if (d && d.tagName === 'DETAILS') d.open = true;
    });
  });

  /* ── facets, post-render (runs before the snippet's DOMContentLoaded init; nodes stay inside #FacetFiltersForm) ──
     • Weight Ratti + Weight Carats → one "Weight" group with a Ratti | Carat switch
     • treatment values → plain-language labels + a one-line glass-filled explainer
     • colour values → swatch dots
     • the rail's Budget group moves in after Weight */
  (function () {
    var form = root.querySelector('#FacetFiltersForm');
    if (!form) return;
    var items = form.querySelector('#FacetsItems') || form;
    var CARET = '<svg viewBox="0 0 24 24" width="14" height="14" class="icon-caret" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';

    var ratti = form.querySelector('details[id^="Details-weight-ratti"]');
    var carat = form.querySelector('details[id^="Details-weight-carat"]');
    if (ratti && carat) {
      var caratOn = !!carat.querySelector('.facets__price-preset.is-active, input:checked');
      var unit = caratOn ? 'carat' : 'ratti';
      if (!caratOn && !ratti.querySelector('.facets__price-preset.is-active, input:checked')) {
        try { unit = sessionStorage.getItem('plpWeightUnit') || 'ratti'; } catch (e) {}
      }
      var wrap = document.createElement('details');
      wrap.className = 'facets__disclosure plp-weight';
      wrap.id = 'plpWeight';
      wrap.open = true;
      var badge = (caratOn ? carat : ratti).querySelector('.facets__selected-count');
      wrap.innerHTML = '<summary class="facets__summary"><span class="facets__summary-label">Weight' + (badge ? ' ' + badge.outerHTML : '') + '</span>' + CARET + '</summary>'
        + '<div class="facets__display"><div class="plp-seg" role="tablist" aria-label="Weight unit">'
        + '<button type="button" role="tab" data-unit="ratti" aria-selected="' + (unit === 'ratti') + '">Ratti</button>'
        + '<button type="button" role="tab" data-unit="carat" aria-selected="' + (unit === 'carat') + '">Carat</button></div>'
        + '<div class="plp-weight__pane" data-unit="ratti"' + (unit === 'ratti' ? '' : ' hidden') + '></div>'
        + '<div class="plp-weight__pane" data-unit="carat"' + (unit === 'carat' ? '' : ' hidden') + '></div>'
        + '<p class="plp-hint">1 ratti ≈ 0.9 ct. Use the weight your astrologer prescribed.</p></div>';
      ratti.parentNode.insertBefore(wrap, ratti);
      [['ratti', ratti], ['carat', carat]].forEach(function (pair) {
        var pane = wrap.querySelector('.plp-weight__pane[data-unit="' + pair[0] + '"]');
        var disp = pair[1].querySelector('.facets__display');
        while (disp && disp.firstChild) pane.appendChild(disp.firstChild);
        pair[1].parentNode.removeChild(pair[1]);
      });
      wrap.querySelectorAll('.plp-seg button').forEach(function (b) {
        b.addEventListener('click', function () {
          var u = b.getAttribute('data-unit');
          wrap.querySelectorAll('.plp-seg button').forEach(function (x) { x.setAttribute('aria-selected', x === b ? 'true' : 'false'); });
          wrap.querySelectorAll('.plp-weight__pane').forEach(function (p) { p.hidden = p.getAttribute('data-unit') !== u; });
          try { sessionStorage.setItem('plpWeightUnit', u); } catch (e) {}
        });
      });
    }
    var budget = document.getElementById('plpBudget');
    if (budget) {
      var w = document.getElementById('plpWeight');
      if (w && w.parentNode) w.parentNode.insertBefore(budget, w.nextSibling); else items.insertBefore(budget, items.firstChild);
    }

    form.querySelectorAll('details[id^="Details-treatment"]').forEach(function (d) {
      var hasGlass = false;
      d.querySelectorAll('.facet-checkbox__label').forEach(function (l) {
        var t = l.textContent.trim(), dc = t.toLowerCase();
        if (dc.indexOf('unheated') === 0 || dc.indexOf('no indications') > -1) t = 'Unheated & untreated';
        else if (dc.indexOf('glass') === 0) { t = 'Glass-filled'; hasGlass = true; }
        else t = t.replace(/\s*\(.*\)\s*$/, '').replace(/\s+[–-]\s+.*$/, '');
        l.textContent = t;
      });
      if (hasGlass) {
        var hint = document.createElement('p');
        hint.className = 'plp-hint';
        hint.textContent = 'Glass-filled stones are fracture-filled to improve clarity — always disclosed on the product page.';
        var disp = d.querySelector('.facets__display');
        if (disp) disp.appendChild(hint);
      }
    });

    var SWATCH = { 'red': '#B3202B', 'pinkish red': '#C43B5A', 'purplish red': '#9E2B63', 'reddish pink': '#D2506F', 'pink': '#E58AA3', 'deep red': '#8E1B23', 'dark red': '#8E1B23', 'pigeon blood': '#9B111E', 'orangy red': '#D4452F', 'reddish orange': '#D9532B', 'orange': '#E0762A', 'peach': '#F1A98D', 'yellow': '#E4B83A', 'golden yellow': '#D9A52C', 'light yellow': '#F0D67A', 'honey': '#D69A2E', 'green': '#1F7A4D', 'bluish green': '#1E8A7A', 'yellowish green': '#8DB33A', 'greenish blue': '#1C7FA3', 'teal': '#1C7F7A', 'blue': '#2B4C9B', 'royal blue': '#1F3A93', 'cornflower blue': '#5B7FD1', 'light blue': '#7FB2E5', 'dark blue': '#1B2F6E', 'violet': '#5A3E9E', 'purple': '#6B3FA0', 'bluish violet': '#4B45B0', 'brown': '#8B5A2B', 'black': '#231F20', 'grey': '#8A8A8A', 'gray': '#8A8A8A', 'white': '#F2EFE9', 'colourless': '#F2EFE9', 'colorless': '#F2EFE9', 'cream': '#F3E6C8', 'golden': '#D4A64A', 'multi': 'linear-gradient(135deg,#C43B5A,#E4B83A,#1F7A4D,#2B4C9B)' };
    form.querySelectorAll('details[id^="Details-color"] .facet-checkbox, details[id^="Details-colour"] .facet-checkbox').forEach(function (lab) {
      var l = lab.querySelector('.facet-checkbox__label'); if (!l) return;
      var t = l.textContent.trim().toLowerCase().replace(/\s+/g, ' ');
      var c = SWATCH[t];
      if (!c) { var parts = t.split(' '); c = SWATCH[parts[parts.length - 1]]; }
      if (!c) return;
      var sw = document.createElement('span');
      sw.className = 'plp-sw';
      sw.setAttribute('aria-hidden', 'true');
      sw.style.background = c;
      l.parentNode.insertBefore(sw, l);
    });
  })();

  /* ── price preset chips ── */
  root.querySelectorAll('.plp-chip[data-min]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var min = btn.dataset.min, max = btn.dataset.max;
      var searchParams = new URLSearchParams(window.location.search);
      if (btn.getAttribute('aria-pressed') === 'true') {
        searchParams.delete('filter.v.price.gte');
        searchParams.delete('filter.v.price.lte');
      } else {
        searchParams.set('filter.v.price.gte', min);
        if (max) searchParams.set('filter.v.price.lte', max); else searchParams.delete('filter.v.price.lte');
      }
      searchParams.delete('page');
      window.location.search = searchParams.toString();
    });
  });

  /* ── editorial copy: normalize the hand-authored cht-* markup ──
     • the leading h2 duplicates the accordion title → hidden
     • About: leading "Label: value" lines become key/value rows
     • FAQ: "Question? Answer" items become <details> rows
     • other panels: "* " paragraphs → lists, stray markers removed, lead labels bolded
     • tables get a horizontal-scroll wrapper */
  function looksLikeTitle(s) {
    var words = s.trim().split(/\s+/);
    var skip = { of: 1, the: 1, and: 1, to: 1, a: 1, an: 1, in: 1, 'for': 1, '&': 1 };
    var significant = 0, capped = 0;
    for (var i = 0; i < words.length; i++) {
      var w = words[i].replace(/[^A-Za-z&'-]/g, '');
      if (!w || skip[w.toLowerCase()]) continue;
      significant++;
      if (/^[A-Z]/.test(w)) capped++;
    }
    return significant >= 1 && capped === significant;
  }
  function formatAbout(panel) {
    var wrap = panel.firstElementChild || panel;
    var rows = [];
    var node = wrap.firstElementChild;
    if (node && node.tagName === 'H2') node = node.nextElementSibling;
    while (node && node.tagName === 'P' && node.firstElementChild && node.firstElementChild.tagName === 'STRONG' && /:\s*$/.test(node.firstElementChild.textContent)) {
      rows.push(node);
      node = node.nextElementSibling;
    }
    rows.forEach(function (p, i) {
      var strong = p.firstElementChild;
      var key = strong.textContent.replace(/:\s*$/, '').trim();
      strong.parentNode.removeChild(strong);
      var val = p.innerHTML.replace(/^\s+/, '');
      var row = document.createElement('div');
      row.className = 'plp-kv' + (i === rows.length - 1 ? ' plp-kv--last' : '');
      row.innerHTML = '<span class="k"></span><span class="v"></span>';
      row.firstChild.textContent = key;
      row.lastChild.innerHTML = val;
      p.parentNode.replaceChild(row, p);
    });
  }
  function formatFaq(panel) {
    var candidates = panel.querySelectorAll('li, p');
    candidates.forEach(function (el) {
      var raw = el.textContent.replace(/\s+/g, ' ').trim();
      var qIdx = raw.indexOf('?');
      if (qIdx === -1) return;
      if (raw.indexOf('The PreciousCarats') === 0 || raw.indexOf('A Final Note') === 0) return;
      var q = raw.substring(0, qIdx + 1).trim();
      var a = raw.substring(qIdx + 1).trim();
      if (!a) return;
      var d = document.createElement('details');
      d.className = 'plp-faq__item';
      var s = document.createElement('summary'); s.textContent = q;
      var p = document.createElement('p'); p.textContent = a;
      d.appendChild(s); d.appendChild(p);
      el.parentNode.insertBefore(d, el);
      el.parentNode.removeChild(el);
    });
    panel.querySelectorAll('ul').forEach(function (ul) {
      if (!ul.children.length) { ul.parentNode.removeChild(ul); return; }
      // lift converted rows out of the list so the bullets don't apply
      if (!ul.querySelector('li')) {
        while (ul.firstChild) ul.parentNode.insertBefore(ul.firstChild, ul);
        ul.parentNode.removeChild(ul);
      }
    });
  }
  function normalizeGeneric(panel) {
    var paras = Array.prototype.slice.call(panel.querySelectorAll('p'));
    for (var i = 0; i < paras.length; i++) {
      if (!/^\s*\*\s+/.test(paras[i].textContent)) continue;
      var ul = document.createElement('ul');
      var j = i, last = paras[i];
      while (j < paras.length) {
        if (j > i && paras[j].previousElementSibling !== last) break;
        if (!/^\s*\*\s+/.test(paras[j].textContent)) break;
        var li = document.createElement('li');
        li.innerHTML = paras[j].innerHTML.replace(/^\s*\*\s+/, '');
        ul.appendChild(li);
        last = paras[j];
        j++;
      }
      paras[i].parentNode.insertBefore(ul, paras[i]);
      for (var k = i; k < j; k++) paras[k].parentNode.removeChild(paras[k]);
      i = j - 1;
    }
    panel.querySelectorAll('p, li').forEach(function (el) {
      if (el.firstElementChild && el.firstElementChild.tagName === 'STRONG') return;
      var first = el.firstChild;
      if (!first || first.nodeType !== 3) return;
      var cleaned = first.nodeValue.replace(/^\s*\*\*\s*/, '').replace(/→/g, ' ').replace(/\s{2,}/g, ' ').replace(/^\s+/, '');
      if (cleaned !== first.nodeValue) first.nodeValue = cleaned;
      var lead = first.nodeValue, matchStr = null;
      var c = lead.match(/^([A-Z][^:<>]{0,38}?:)(\s|$)/);
      if (c && c[1].replace(/:$/, '').trim().split(/\s+/).length <= 6) {
        matchStr = c[1];
      } else {
        var d = lead.match(/^(\S.{0,40}?)\s—\s/);
        if (d && looksLikeTitle(d[1])) matchStr = d[1];
      }
      if (!matchStr) return;
      var rest = document.createTextNode(first.nodeValue.slice(matchStr.length));
      var strong = document.createElement('strong');
      strong.textContent = matchStr;
      el.replaceChild(rest, first);
      el.insertBefore(strong, rest);
    });
  }
  function normalizeEditorial() {
    root.querySelectorAll('.plp-acc__body[data-acc]').forEach(function (panel) {
      var kind = panel.getAttribute('data-acc');
      var wrap = panel.firstElementChild;
      var lead = wrap && wrap.firstElementChild;
      if (lead && lead.tagName === 'H2') lead.style.display = 'none';
      if (kind === 'faq') formatFaq(panel);
      else if (kind === 'about') formatAbout(panel);
      else normalizeGeneric(panel);
      panel.querySelectorAll('table').forEach(function (t) {
        if (t.parentElement && t.parentElement.classList.contains('plp-tblwrap')) return;
        var w = document.createElement('div');
        w.className = 'plp-tblwrap';
        t.parentNode.insertBefore(w, t);
        w.appendChild(t);
      });
    });
  }
  normalizeEditorial();

  /* ── results: grid, pager, mobile loader ── */
  var grid = document.getElementById('ProductGridContainer');
  var pager = document.getElementById('plpPager');
  var inf = document.getElementById('plpInfinite');
  var loaderEl = document.getElementById('plpLoader');
  var moreBtn = document.getElementById('plpLoadMore');
  var endEl = document.getElementById('plpEnd');
  var shownEl = document.getElementById('plpShown');
  var barEl = document.getElementById('plpBar');
  var helpTile = grid ? grid.querySelector('.plp-help') : null;
  var parser = new DOMParser();

  function updateProgress() {
    if (!grid || !inf) return;
    var shown = grid.querySelectorAll('.product-card').length;
    var total = parseInt(inf.getAttribute('data-total'), 10) || shown;
    if (shownEl) shownEl.textContent = Math.min(shown, total);
    if (barEl) barEl.style.width = Math.max(4, Math.min(100, Math.round(shown / Math.max(total, 1) * 100))) + '%';
  }
  /* keep the WhatsApp help tile in slot 8 after the grid is rebuilt */
  function placeHelpTile() {
    if (!helpTile || !grid) return;
    var cards = grid.querySelectorAll('.product-card');
    if (cards.length >= 8) grid.insertBefore(helpTile, cards[7]); else grid.appendChild(helpTile);
  }
  function afterAppend() {
    try { if (window.WishlistApp && WishlistApp.syncButtons) WishlistApp.syncButtons(); } catch (e) {}
    try { if (window.CompareApp && CompareApp.highlightButtons) CompareApp.highlightButtons(); } catch (e) {}
    updateProgress();
  }

  var Loader = {
    busy: false, done: false, ready: true, loadedAny: false,
    mode: 'remote',                       // 'remote' fetches ?page=N; 'memory' drains a pre-sorted array
    nextUrl: inf ? (inf.getAttribute('data-next-url') || '') : '',
    queue: [],
    pageSize: grid ? (parseInt(grid.dataset.perPage, 10) || 16) : 16,
    setDone: function () {
      this.done = true;
      if (loaderEl) loaderEl.hidden = true;
      if (moreBtn) moreBtn.hidden = true;
      if (endEl) endEl.hidden = !this.loadedAny;
      updateProgress();
    },
    showButton: function () {
      if (moreBtn && !this.done && !this.busy) moreBtn.hidden = false;
    },
    append: function (cards) {
      if (!grid || !cards.length) return;
      cards.forEach(function (c) { grid.appendChild(c); });
      this.loadedAny = true;
      afterAppend();
      var self = this;
      requestAnimationFrame(function () { self.kick(); });
    },
    next: function () {
      var self = this;
      if (self.busy || self.done || !grid) return;
      if (self.mode === 'memory') {
        if (!self.ready) return;
        self.append(self.queue.splice(0, self.pageSize));
        if (!self.queue.length) self.setDone();
        return;
      }
      if (!self.nextUrl) { self.setDone(); return; }
      self.busy = true;
      if (loaderEl) loaderEl.hidden = false;
      if (moreBtn) moreBtn.hidden = true;
      fetch(self.nextUrl, { headers: { 'X-Requested-With': 'fetch' } })
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var doc = parser.parseFromString(html, 'text/html');
          var cards = Array.prototype.map.call(doc.querySelectorAll('#ProductGridContainer .product-card'), function (c) { return document.importNode(c, true); });
          var nextInf = doc.getElementById('plpInfinite');
          self.nextUrl = nextInf ? (nextInf.getAttribute('data-next-url') || '') : '';
          self.append(cards);
          if (!self.nextUrl || !cards.length) self.setDone();
        })
        .catch(function () { if (moreBtn) moreBtn.hidden = false; })
        .then(function () { self.busy = false; if (loaderEl) loaderEl.hidden = true; if (!isMobile()) self.showButton(); });
    },
    kick: function () {
      if (!inf) return;
      if (!isMobile()) { this.showButton(); return; }
      if (inf.getBoundingClientRect().top < window.innerHeight + 400) this.next();
    }
  };
  if (moreBtn) moreBtn.addEventListener('click', function () { Loader.next(); });
  if (inf) {
    /* phones append on scroll; desktop shows the "Show more" button */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting && isMobile()) Loader.next();
      }, { rootMargin: '400px' });
      io.observe(inf);
    } else if (moreBtn) {
      moreBtn.hidden = false;
    }
    if (!Loader.nextUrl && Loader.mode === 'remote') Loader.setDone(); else if (!isMobile()) Loader.showButton();
    onMQ(MQ_DESKTOP, function (e) { if (e.matches) Loader.showButton(); });
    updateProgress();
  }

  /* ── Client-side Weight Sort (Shopify sort_by cannot target metafields) ──
     Weight: Low to High  → data-weight-carats ASC  (fallback: data-weight-ratti × 0.8806)
     Weight: High to Low  → data-weight-carats DESC (same fallback)
     Fetches every page, sorts the global set, then streams it through Loader
     (auto on phones, "Show more" on desktop) — the numbered pager stays hidden. */
  (async function sortByWeight() {
    var params = new URLSearchParams(window.location.search);
    var sortVal = params.get('sort_by');
    if (!sortVal) return;

    var select = document.getElementById('sort-select');
    if (select) select.value = sortVal;
    var mobileSelect = document.getElementById('Mobile-SortBy');
    if (mobileSelect) mobileSelect.value = sortVal;

    if (sortVal !== 'weight-ascending' && sortVal !== 'weight-descending') return;
    if (!grid) return;

    var weightOf = function (el) {
      var c = parseFloat(el.dataset.weightCarats) || 0;
      if (c > 0) return c;
      var r = parseFloat(el.dataset.weightRatti) || 0;
      if (r > 0) return r * 0.8806;
      var titleEl = el.querySelector('.product-card__title');
      if (titleEl) {
        var m = titleEl.textContent.match(/([\d.]+)\s*carat/i);
        if (m) return parseFloat(m[1]) || 0;
      }
      return 0;
    };
    var dir = sortVal === 'weight-descending' ? -1 : 1;

    // Grouped-by-gem-type layout: sort each row independently.
    if (grid.classList.contains('collection-page__grouped')) {
      grid.querySelectorAll('.gem-section__row').forEach(function (row) {
        var cards = Array.prototype.slice.call(row.querySelectorAll('.product-card'));
        if (cards.length < 2) return;
        cards.sort(function (a, b) { return (weightOf(a) - weightOf(b)) * dir; });
        cards.forEach(function (c) { row.appendChild(c); });
      });
      return;
    }

    // Hold the loader until the sorted set is ready (it then streams the sorted set on every breakpoint).
    Loader.mode = 'memory';
    Loader.ready = false;
    Loader.done = false;
    if (endEl) endEl.hidden = true;

    var pageSize = Loader.pageSize;
    var currentPage = Math.max(1, parseInt(params.get('page') || '1', 10));
    if (helpTile && helpTile.parentNode) helpTile.parentNode.removeChild(helpTile);

    var maxPage = currentPage;
    if (pager) {
      pager.querySelectorAll('a').forEach(function (a) {
        var m = (a.getAttribute('href') || '').match(/[?&]page=(\d+)/);
        if (m) maxPage = Math.max(maxPage, parseInt(m[1], 10));
      });
    }

    if (maxPage > 1) {
      try {
        var reqs = [];
        for (var p = 1; p <= maxPage; p++) {
          if (p === currentPage) continue;
          var u = new URL(window.location.href);
          u.searchParams.set('page', p);
          reqs.push(fetch(u.toString(), { headers: { 'X-Requested-With': 'fetch' } }).then(function (r) { return r.text(); }));
        }
        var pages = await Promise.all(reqs);
        pages.forEach(function (html) {
          var doc = parser.parseFromString(html, 'text/html');
          doc.querySelectorAll('#ProductGridContainer .product-card').forEach(function (c) {
            grid.appendChild(document.importNode(c, true));
          });
        });
      } catch (err) {
        console.warn('Weight sort: failed to fetch additional pages', err);
      }
    }

    var seen = new Set();
    var allCards = Array.prototype.slice.call(grid.querySelectorAll('.product-card')).filter(function (c) {
      var key = c.id || (c.querySelector('a') && c.querySelector('a').getAttribute('href')) || '';
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
    if (!allCards.length) { Loader.ready = true; Loader.setDone(); return; }
    allCards.sort(function (a, b) { return (weightOf(a) - weightOf(b)) * dir; });
    grid.querySelectorAll('.product-card').forEach(function (c) { c.remove(); });

    allCards.slice(0, pageSize).forEach(function (c) { grid.appendChild(c); });
    placeHelpTile();
    afterAppend();
    Loader.queue = allCards.slice(pageSize);
    Loader.ready = true;
    if (pager) pager.hidden = true;
    if (!Loader.queue.length) Loader.setDone(); else Loader.kick();
  })();
})();
</script>

