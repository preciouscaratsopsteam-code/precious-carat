{%- comment -%}
  Story Section
  Brand story with text + video/image
{%- endcomment -%}

<section class="story-section reveal" id="story-section">
  <div class="story-section__wrapper">
      <!-- Text Content -->
      <div class="story-section__content">
        {%- if section.settings.subtitle != blank -%}
          <p class="story-section__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <h2 class="story-section__title">{{ section.settings.heading }}</h2>
        <div class="story-section__text">
          {{ section.settings.text }}
        </div>
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_url | default: '/pages/coming-soon' }}" class="btn btn--secondary">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>

      <!-- Media -->
      <div class="story-section__media">
        {%- if section.settings.asset_name != blank -%}
          <img
            src="{{ section.settings.asset_name | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            width="800"
            height="500"
            loading="lazy"
          >
        {%- elsif section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="800"
            height="500"
            loading="lazy"
          >
        {%- else -%}
          <div style="width:100%;height:100%;background:linear-gradient(135deg, #c9a96e 0%, #8b7355 100%);"></div>
        {%- endif -%}

        {%- if section.settings.video_url != blank -%}
          <button class="story-section__play-btn" aria-label="Play video" data-video-url="{{ section.settings.video_url | escape }}" onclick="brandStoryPlay(this)">
            {% render 'icon', name: 'play' %}
          </button>
        {%- endif -%}

        {%- if section.settings.caption != blank -%}
          <div class="story-section__caption">{{ section.settings.caption }}</div>
        {%- endif -%}
      </div>
  </div>
</section>

{%- comment -%}
  VideoObject (SEO brief H7 / Appendix I.9). Google requires name, thumbnailUrl
  and uploadDate, so the block is emitted only once "Video upload date" is set
  in the section settings. The embed URL is derived from the Vimeo / YouTube link.
{%- endcomment -%}
{%- if section.settings.video_url != blank and section.settings.video_upload_date != blank -%}
  {%- assign bs_url = section.settings.video_url | strip -%}
  {%- assign bs_embed = '' -%}
  {%- if bs_url contains 'vimeo.com/' -%}
    {%- assign bs_id = bs_url | split: 'vimeo.com/' | last | replace: 'video/', '' | split: '?' | first | split: '/' | first -%}
    {%- assign bs_embed = 'https://player.vimeo.com/video/' | append: bs_id -%}
  {%- elsif bs_url contains 'youtu' -%}
    {%- assign bs_id = bs_url | split: 'v=' | last | split: '&' | first | split: '/' | last -%}
    {%- assign bs_embed = 'https://www.youtube.com/embed/' | append: bs_id -%}
  {%- endif -%}
  {%- capture bs_thumb -%}
    {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' }}
    {%- elsif section.settings.asset_name != blank -%}{{ section.settings.asset_name | asset_url }}
    {%- elsif bs_id != blank and bs_url contains 'vimeo' -%}https://vumbnail.com/{{ bs_id }}.jpg
    {%- endif -%}
  {%- endcapture -%}
  {%- assign bs_thumb = bs_thumb | strip -%}
  {%- unless bs_thumb contains '//' -%}{%- assign bs_thumb = shop.url | append: bs_thumb -%}{%- endunless -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": {{ section.settings.video_name | default: section.settings.heading | strip_html | strip | json }},
    "description": {{ section.settings.video_description | default: section.settings.text | strip_html | strip | json }},
    "thumbnailUrl": {{ bs_thumb | json }},
    "uploadDate": {{ section.settings.video_upload_date | json }}
    {%- if section.settings.video_duration != blank -%},
    "duration": {{ section.settings.video_duration | json }}
    {%- endif -%}
    {%- if bs_embed != blank -%},
    "embedUrl": {{ bs_embed | json }}
    {%- endif -%},
    "publisher": { "@id": "{{ shop.url }}/#organization" }
  }
  </script>
{%- endif -%}

{%- if section.settings.video_url != blank -%}
<script>
  // Lazy video facade: build an embed URL from a Vimeo/YouTube link (incl. unlisted Vimeo hash)
  // and play inline on click. Falls back to opening the link if it can't be parsed.
  function brandStoryPlay(btn) {
    var url = btn.getAttribute('data-video-url') || '';
    var media = btn.closest('.story-section__media');
    if (!media) { window.open(url, '_blank'); return; }
    var embed = '';
    var vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/([0-9a-zA-Z]+))?/);
    if (vm) {
      embed = 'https://player.vimeo.com/video/' + vm[1] + '?autoplay=1&title=0&byline=0&portrait=0';
      var h = vm[2];
      if (!h) { var hm = url.match(/[?&]h=([0-9a-zA-Z]+)/); if (hm) h = hm[1]; }
      if (h) embed += '&h=' + h;
    } else {
      var ym = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]+)/);
      if (ym) embed = 'https://www.youtube.com/embed/' + ym[1] + '?autoplay=1';
    }
    if (!embed) { window.open(url, '_blank'); return; }
    var ifr = document.createElement('iframe');
    ifr.src = embed;
    ifr.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
    ifr.setAttribute('allowfullscreen', '');
    ifr.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;z-index:5;';
    media.appendChild(ifr);
    btn.style.display = 'none';
    var cap = media.querySelector('.story-section__caption');
    if (cap) cap.style.display = 'none';
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Journey of a Gem — Rough To Ring"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>From careful selection and expert cutting to treatment disclosure, certification, photography and final quality checks—discover the journey every gemstone takes before it reaches you.</p>"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "asset_name",
      "label": "Asset Name (e.g. brand-1.jpg)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Video/image caption",
      "default": "Brief Heading of Video"
    },
    {
      "type": "header",
      "content": "Video structured data (VideoObject)"
    },
    {
      "type": "text",
      "id": "video_name",
      "label": "Video title",
      "default": "Rough to ring: how a Precious Carats gemstone is chosen, cut and certified"
    },
    {
      "type": "textarea",
      "id": "video_description",
      "label": "Video description",
      "default": "One Sri Lankan sapphire from rough to finished ring: cutting, daylight photography, lab certification and the checks that reject most stones."
    },
    {
      "type": "text",
      "id": "video_upload_date",
      "label": "Video upload date (YYYY-MM-DD)",
      "info": "Required by Google — the VideoObject markup is emitted only once this is filled."
    },
    {
      "type": "text",
      "id": "video_duration",
      "label": "Duration (ISO 8601, e.g. PT3M20S)"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
