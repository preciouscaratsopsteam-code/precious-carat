{%- comment -%}
  Main Product Section — editorial PDP.
  Customization is an open on-page section (#customise), not a modal.
  Business logic preserved: certification fees, customization fee product line
  (+ Shopflo reconciler nudge), dispatch estimate, CDN design probing,
  wishlist/compare, recommendations.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_request_price = false -%}
{%- if product.price > 100000000 -%}{%- assign is_request_price = true -%}{%- endif -%}
{%- assign is_purchasable = false -%}
{%- if current_variant.available and is_request_price == false -%}{%- assign is_purchasable = true -%}{%- endif -%}

{%- assign mf = product.metafields.custom -%}
{%- assign gem_type_label = mf.gem_type | default: product.type | default: 'gemstone' -%}

{%- comment -%} Short flag labels for the gallery {%- endcomment -%}
{%- assign flag_treatment = mf.treatment_status | split: '–' | first | split: '(' | first | strip -%}

{{ 'product.css' | asset_url | stylesheet_tag }}

{% style %}
/* ═══════════ PDP — Direction B "Jewel Box" ═══════════
   Warm ivory stages + soft shadows instead of hairline borders,
   rounded pills/cards, gold accents, ink reserved for the primary CTA. */
:root{
  --pdp-ink:#231F20; --pdp-ink-soft:#3B322A;
  --pdp-gold:#B08D4F; --pdp-gold-deep:#96733A;
  --pdp-charcoal:#4A443D; --pdp-charcoal-2:#7A7268;
  --pdp-paper:#FDFBF7; --pdp-card:#FFFFFF;
  --pdp-ivory:#F6EFE4; --pdp-ivory-2:#EFE5D2; --pdp-sand:#DCCFB4;
  --pdp-display:var(--font-heading,'Cormorant Garamond',Georgia,serif);
  --pdp-body:var(--font-body,'Inter','Helvetica Neue',sans-serif);
  --pdp-accent:var(--font-accent,'Outfit','Helvetica Neue',sans-serif);
  --pdp-wrap:1220px; --pdp-gut:16px;
  --pdp-s1:8px; --pdp-s2:12px; --pdp-s3:16px; --pdp-s4:24px; --pdp-s5:32px;
  --pdp-r:4px; --pdp-rl:8px;
  --pdp-shadow:0 14px 34px -20px rgba(120,96,58,.5);
  --pdp-shadow-sm:0 4px 12px -6px rgba(120,96,58,.35);
  --pdp-sticky-h:0px;
}
@media (min-width:900px){:root{--pdp-gut:32px}}
body{padding-bottom:var(--pdp-sticky-h)}
#customise{scroll-margin-top:96px}

.pdp-wrap{max-width:var(--pdp-wrap);margin:0 auto;padding:0 var(--pdp-gut)}
.pdp *,.pdp *::before,.pdp *::after,
.pdp-custom *,.pdp-proc-section *,.pdp-stickybuy *{box-sizing:border-box}

/* Neutralize the theme's global element styles inside the PDP scopes.
   :where() keeps specificity at 0-1-0 so component classes below win. */
.pdp :where(button),
.pdp-custom :where(button),
.pdp-stickybuy :where(button),
.pdp-modal :where(button){
  margin:0;padding:0;background:none;border:0;border-radius:0;box-shadow:none;
  font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;
  line-height:inherit;cursor:pointer;text-align:inherit;
}
.pdp :where(input,select,textarea),
.pdp-custom :where(input,select,textarea){
  margin:0;border-radius:0;box-shadow:none;font:inherit;color:inherit;
}
.pdp :where(button):focus-visible,
.pdp-custom :where(button):focus-visible,
.pdp-stickybuy :where(button):focus-visible{outline:2px solid var(--pdp-gold);outline-offset:2px}

/* overflow guard (clip keeps position:sticky working) */
.pdp,.pdp-custom,.pdp-proc-section{overflow-x:clip}

.pdp{background:var(--pdp-paper);font-family:var(--pdp-body);font-weight:400;font-size:var(--font-size-base,15px);line-height:1.6;color:var(--pdp-charcoal);padding-bottom:var(--pdp-s5)}
.pdp img{max-width:100%;display:block}
.pdp a{color:inherit;text-decoration:none}
.pdp h1,.pdp h2,.pdp h3,.pdp h4{font-family:var(--pdp-display);font-weight:600;color:var(--pdp-ink);margin:0;line-height:1.15}
.pdp p{margin:0}

/* ── breadcrumb ── */
.pdp-crumbs{background:var(--pdp-paper);font-family:var(--pdp-body)}
.pdp-crumbs .pdp-wrap{display:flex;gap:var(--pdp-s1);align-items:center;overflow-x:auto;white-space:nowrap;padding-top:12px;padding-bottom:4px;font-size:11.5px;color:var(--pdp-charcoal-2);scrollbar-width:none}
.pdp-crumbs .pdp-wrap::-webkit-scrollbar{display:none}
.pdp-crumbs a{color:inherit;text-decoration:none}
.pdp-crumbs a:hover{color:var(--pdp-gold-deep)}
.pdp-crumbs .pdp-cur{color:var(--pdp-ink)}

/* ── layout ── */
.pdp-cols>*{min-width:0}
@media (min-width:900px){
  .pdp .pdp-cols{display:grid;grid-template-columns:1.06fr .94fr;gap:48px;align-items:start;padding-top:var(--pdp-s4)}
  /* gallery side pins while the details column scrolls; it releases where
     the hero grid ends (just above the certification/customizer cards) */
  .pdp-cols>div:first-child{position:sticky;top:96px;align-self:start}
}

/* ── wishlist / compare icons (share row) ── */
.pdp-share__acts{margin-left:auto;display:flex;gap:6px;flex:0 0 auto}
.pdp-gal__act{width:32px;height:32px;display:grid;place-items:center;background:none;border:0;border-radius:50%;color:var(--pdp-charcoal);cursor:pointer;padding:0;margin:0;transition:color .18s,box-shadow .18s,background .18s}
.pdp-gal__act:hover{color:var(--pdp-gold-deep)}
.pdp-gal__act img{width:15px;height:15px;padding:0}
.pdp-gal__act.is-active,.pdp-gal__act.is-wishlisted{background:var(--pdp-ivory);color:var(--pdp-gold-deep);box-shadow:inset 0 0 0 1.5px var(--pdp-gold)}

/* ── gallery: white stage card on an ivory tray ── */
.pdp-media{background:var(--pdp-ivory);border-radius:var(--pdp-rl);padding:var(--pdp-s3);margin:var(--pdp-s2) calc(var(--pdp-gut) * -1) 0}
@media (max-width:899px){.pdp-media{border-radius:0}}
@media (min-width:900px){.pdp-media{margin:0;display:flex;gap:var(--pdp-s3);align-items:stretch}}
.pdp-gal{position:relative;background:var(--pdp-card);border-radius:var(--pdp-r);box-shadow:var(--pdp-shadow);overflow:hidden}
@media (min-width:900px){.pdp-media .pdp-gal{flex:1;min-width:0;order:2}}
.pdp-gal__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.pdp-gal__track::-webkit-scrollbar{display:none}
.pdp-gal__slide{flex:0 0 100%;min-width:0;scroll-snap-align:center;background:var(--pdp-card);position:relative;display:flex;align-items:center;justify-content:center;height:min(44vh,380px);padding:var(--pdp-s3) var(--pdp-s3) var(--pdp-s4)}
@media (min-width:900px){.pdp-gal__slide{height:520px;padding:var(--pdp-s4) var(--pdp-s4) var(--pdp-s5)}}
.pdp-gal__slide img{width:auto;height:auto;max-width:100%;max-height:100%;object-fit:contain;padding:0}
.pdp-gal__slide .product-page__video-preview{display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;max-width:100%;max-height:100%}
.pdp-gal__play{position:absolute;inset:0;display:grid;place-items:center;color:#fff;pointer-events:none}
.pdp-gal__play span{width:52px;height:52px;border-radius:50%;background:rgba(35,31,32,.78);display:grid;place-items:center}
.pdp-gal__dots{position:absolute;bottom:var(--pdp-s2);left:0;right:0;display:flex;justify-content:center;gap:6px;z-index:2;pointer-events:none}
.pdp-gal__dots i{width:6px;height:6px;border-radius:50%;background:var(--pdp-sand)}
.pdp-gal__dots i.on{background:var(--pdp-gold)}
.pdp-thumbs{display:flex;gap:var(--pdp-s2);overflow-x:auto;padding:var(--pdp-s3) 2px 2px;scrollbar-width:none}
.pdp-thumbs::-webkit-scrollbar{display:none}
.pdp-thumb{flex:0 0 auto;width:56px;height:56px;background:var(--pdp-card);border:0;border-radius:var(--pdp-r);box-shadow:var(--pdp-shadow-sm);padding:0;margin:0;transition:outline-color .18s;position:relative;cursor:pointer;overflow:hidden;outline:1.5px solid transparent;outline-offset:1px}
.pdp-thumb img{width:100%;height:100%;object-fit:cover;padding:0}
.pdp-thumb[aria-current="true"]{outline-color:var(--pdp-gold)}
.pdp-thumb__vid{position:absolute;inset:0;display:grid;place-items:center;color:#fff}
.pdp-thumb__vid span{width:18px;height:18px;border-radius:50%;background:rgba(35,31,32,.72);display:grid;place-items:center}
@media (min-width:900px){
  .pdp-thumbs{order:1;flex:0 0 64px;flex-direction:column;padding:2px;max-height:568px;overflow-y:auto;overscroll-behavior:contain}
  .pdp-thumb{width:60px;height:60px}
}

/* ── title / price ── */
.pdp-head{padding-top:var(--pdp-s3)}
@media (min-width:900px){.pdp-head{padding-top:0}}
.pdp-head .pdp-vendor{font-family:var(--pdp-accent);font-size:10.5px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--pdp-gold-deep)}
.pdp-head h1{font-size:clamp(26px,5.4vw,38px);margin:var(--pdp-s1) 0 var(--pdp-s2)}
.pdp-soldflag{display:inline-block;vertical-align:middle;margin-left:10px;background:var(--pdp-ink);color:#fff;border-radius:20px;font-family:var(--pdp-accent);font-size:10px;letter-spacing:.14em;text-transform:uppercase;padding:5px 11px}
.pdp-metaline{display:flex;flex-wrap:wrap;gap:var(--pdp-s1);margin-bottom:var(--pdp-s4)}
.pdp-metaline span{font-family:var(--pdp-accent);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--pdp-charcoal-2);background:var(--pdp-ivory);border-radius:20px;padding:6px 12px}
.pdp-metaline span b{color:var(--pdp-ink);font-weight:500}
.pdp-metaline .pdp-metaline__flag{color:var(--pdp-gold-deep)}
.pdp-price-zone{display:block;margin:0}
.pdp-price-zone .product-page__price-widget{display:block;margin:0}
.pdp-price{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:0}
.pdp-price b{font-family:var(--pdp-display);font-size:clamp(26px,5vw,32px);font-weight:600;color:var(--pdp-ink);letter-spacing:.01em}
.pdp-price s{font-size:15px;color:var(--pdp-charcoal-2)}
.pdp-price span{font-size:11px;color:var(--pdp-charcoal-2)}
.pdp-price-rule{width:64px;border:0;border-top:2px solid var(--pdp-gold);margin:var(--pdp-s2) 0 0}
.pdp-tagline{margin-top:var(--pdp-s3);padding:var(--pdp-s2) var(--pdp-s3);background:var(--pdp-ivory);border-radius:var(--pdp-r)}
.pdp-tagline p{font-size:14px;color:var(--pdp-ink);line-height:1.5}
.pdp-tagline p+p{margin-top:4px;font-size:13px;color:var(--pdp-charcoal-2)}

/* ── buy box ── */
.pdp-buy{margin-top:var(--pdp-s4)}
.pdp-field{display:grid;gap:var(--pdp-s1)}
.pdp-field label{font-family:var(--pdp-accent);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink)}
.pdp-field label .pdp-req{color:var(--pdp-charcoal-2);font-weight:400;letter-spacing:0;text-transform:none}
.pdp-field select,.pdp-field input,.pdp-field textarea{width:100%;border:1px solid var(--pdp-sand);background:var(--pdp-card);padding:var(--pdp-s2);font:inherit;font-size:14px;color:var(--pdp-ink);border-radius:var(--pdp-r);-webkit-appearance:none;appearance:none}
.pdp-field select{background-image:linear-gradient(45deg,transparent 50%,var(--pdp-ink) 50%),linear-gradient(135deg,var(--pdp-ink) 50%,transparent 50%);background-position:calc(100% - 19px) calc(50% - 1px),calc(100% - 13px) calc(50% - 1px);background-size:6px 6px;background-repeat:no-repeat;cursor:pointer;padding-right:36px}
@media (max-width:639px){.pdp-field select,.pdp-field input,.pdp-field textarea{font-size:16px}}
.pdp-hint{font-size:11.5px;color:var(--pdp-charcoal-2)}

.pdp-chip{margin-top:var(--pdp-s2);background:var(--pdp-ivory);border-radius:var(--pdp-r);padding:var(--pdp-s2) var(--pdp-s3);display:flex;gap:var(--pdp-s1) var(--pdp-s2);align-items:center;flex-wrap:wrap}
.pdp-chip .k{font-family:var(--pdp-accent);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-gold-deep)}
.pdp-chip .v{font-size:13.5px;color:var(--pdp-ink);min-width:0;overflow-wrap:anywhere}
.pdp-chip .pdp-reset{margin-left:auto;font-family:var(--pdp-accent);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-gold-deep);cursor:pointer}
.pdp-chip .pdp-reset:hover{color:var(--pdp-ink)}

.pdp-actions{display:grid;gap:10px;margin-top:var(--pdp-s4)}
.pdp-btn{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:15px 18px;font-family:var(--pdp-accent);font-size:12px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;border:0;background:var(--pdp-ivory);color:var(--pdp-ink);transition:background .18s,color .18s;text-align:center;cursor:pointer;border-radius:var(--pdp-r);line-height:1.4}
.pdp-btn--solid{background:var(--pdp-ink);color:#fff}
.pdp-btn--solid:hover{background:var(--pdp-ink-soft)}
.pdp-btn--ghost{background:var(--pdp-ivory);color:var(--pdp-ink)}
.pdp-btn--ghost:hover{background:var(--pdp-ivory-2)}
.pdp-btn--line{background:var(--pdp-ivory);color:var(--pdp-ink)}
.pdp-btn--line:hover{background:var(--pdp-ivory-2)}
.pdp-btn[disabled]{opacity:.5;cursor:not-allowed}
.pdp-actions .pdp-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}
/* legacy Snapmint anchor classes: keep Jewel Box styling in charge */
/* style Snapmint's injected EMI line as a white Jewel Box card */
.pdp .snapmint_lowest_emi,.pdp .snap_emi_txt_wrapper{display:block;background:var(--pdp-card);border-radius:var(--pdp-r);box-shadow:var(--pdp-shadow-sm);padding:var(--pdp-s2) var(--pdp-s3);margin-top:var(--pdp-s2);font-family:var(--pdp-body);font-size:12.5px;color:var(--pdp-charcoal)}
.pdp .snapmint_lowest_emi .snap_emi_txt_wrapper{background:none;box-shadow:none;padding:0;margin:0}
.pdp .pdp-buy-col.product-page__info{padding:0;width:auto}
#pdp-form .pdp-btn--solid{border:0;border-radius:var(--pdp-r);background:var(--pdp-ink);color:#fff;font-family:var(--pdp-accent);font-size:12px;font-weight:500;letter-spacing:.15em;padding:15px 18px}
#pdp-form .pdp-btn--solid:hover{background:var(--pdp-ink-soft);color:#fff;border-color:transparent}
.pdp .shopify-payment-button__button--unbranded{all:unset;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:15px 18px;font-family:var(--pdp-accent);font-size:12px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;border-radius:var(--pdp-r);background:var(--pdp-ivory);color:var(--pdp-ink);transition:background .18s;cursor:pointer;text-align:center;line-height:1.4}
.pdp .shopify-payment-button__button--unbranded:hover{background:var(--pdp-ivory-2)}
.pdp-soldout-note{display:block;margin-top:var(--pdp-s1);font-size:12.5px;color:var(--pdp-charcoal-2);text-decoration:underline}
.pdp-dispatch{margin-top:var(--pdp-s5);font-size:12.5px;color:var(--pdp-charcoal-2);display:flex;align-items:center;gap:var(--pdp-s1)}
.pdp-dispatch svg{flex:0 0 auto}
.pdp-dispatch b{color:var(--pdp-ink);font-weight:500}
.pdp-assure{list-style:none;margin:var(--pdp-s4) 0 0;padding:var(--pdp-s3);background:var(--pdp-ivory);border-radius:var(--pdp-r);display:grid;gap:var(--pdp-s1)}
.pdp-assure li{font-size:12.5px;color:var(--pdp-charcoal);display:flex;gap:var(--pdp-s1);align-items:center;margin:0}
.pdp-assure svg{color:var(--pdp-gold);flex:0 0 auto}

/* ── accordions: one white card, ivory dividers inside ── */
.pdp-acc{margin-top:var(--pdp-s4);background:var(--pdp-card);border-radius:var(--pdp-rl);box-shadow:var(--pdp-shadow-sm);padding:0 var(--pdp-s3)}
.pdp-acc>details+details{border-top:1px solid var(--pdp-ivory-2)}
.pdp-acc>details>summary{list-style:none;cursor:pointer;padding:var(--pdp-s3) 36px var(--pdp-s3) 0;position:relative;font-family:var(--pdp-display);font-size:19px;font-weight:600;color:var(--pdp-ink);transition:color .18s}
@media (hover:hover){.pdp-acc>details>summary:hover{color:var(--pdp-gold-deep)}}
.pdp-acc>details>summary::-webkit-details-marker{display:none}
.pdp-acc>details>summary::after{content:"";position:absolute;right:4px;top:50%;width:9px;height:9px;border-right:1.4px solid var(--pdp-gold);border-bottom:1.4px solid var(--pdp-gold);transform:translateY(-70%) rotate(45deg);transition:.2s}
.pdp-acc>details[open]>summary::after{transform:translateY(-30%) rotate(-135deg)}
.pdp-acc__body{padding:0 0 var(--pdp-s4)}
.pdp-acc__body p{font-size:14px;line-height:1.65;color:var(--pdp-charcoal)}
.pdp-acc__body p+p{margin-top:var(--pdp-s2)}
.pdp-acc__body a{color:var(--pdp-gold-deep)}

.pdp-spec{margin-top:var(--pdp-s2);border-radius:var(--pdp-r);overflow:hidden}
.pdp-spec__row{display:flex;gap:var(--pdp-s2);padding:var(--pdp-s2);font-size:13.5px}
.pdp-spec__row:nth-child(odd){background:var(--pdp-ivory)}
.pdp-spec__row .k{flex:0 0 42%;color:var(--pdp-charcoal-2)}
.pdp-spec__row .v{flex:1;color:var(--pdp-ink);font-weight:400;min-width:0;overflow-wrap:anywhere}
.pdp-verify{display:inline-flex;align-items:center;gap:6px;margin-left:var(--pdp-s1);font-family:var(--pdp-accent);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--pdp-gold-deep)!important;text-decoration:none!important}
.pdp-verify:hover{color:var(--pdp-ink)!important}
.pdp-clamp{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.pdp-clamp.is-open{display:block;-webkit-line-clamp:unset;overflow:visible}
.pdp-clamp__btn{display:inline-flex;align-items:center;margin-top:6px;padding:0;border:0;background:none;cursor:pointer;font-family:var(--pdp-accent);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--pdp-gold-deep)}
.pdp-clamp__btn:hover{color:var(--pdp-ink)}

.pdp-mantra{margin-top:var(--pdp-s2);background:var(--pdp-ivory);border-radius:var(--pdp-r);color:var(--pdp-ink);padding:var(--pdp-s3)}
.pdp-mantra .row{display:flex;justify-content:space-between;gap:var(--pdp-s2);padding:9px 0;font-size:13.5px}
.pdp-mantra .row+.row{border-top:1px solid rgba(176,141,79,.22)}
.pdp-mantra .row span{color:var(--pdp-charcoal-2);flex:0 0 40%}
.pdp-mantra .row b{font-weight:500;color:var(--pdp-ink);text-align:right;min-width:0;overflow-wrap:anywhere}
.pdp-mantra .row b em{display:block;font-style:italic;color:var(--pdp-charcoal-2);font-size:12.5px;font-weight:400}
.pdp-vidlinks{display:grid;gap:var(--pdp-s1);margin-top:var(--pdp-s2)}
.pdp-vidlink{display:flex;align-items:center;gap:var(--pdp-s2);background:var(--pdp-ivory);border-radius:var(--pdp-r);padding:var(--pdp-s2) var(--pdp-s3);font-size:13.5px;color:var(--pdp-ink)!important;transition:background .18s;text-decoration:none!important}
.pdp-vidlink:hover{background:var(--pdp-ivory-2)}
.pdp-vidlink svg{flex:0 0 auto;color:var(--pdp-gold-deep)}
.pdp-vidlink span{margin-left:auto;color:var(--pdp-charcoal-2)}

.pdp-faq details+details{border-top:1px solid var(--pdp-ivory-2)}
.pdp-faq summary{font-family:var(--pdp-body);font-size:14.5px;padding:13px 30px 13px 0;color:var(--pdp-ink);cursor:pointer;list-style:none;position:relative}
.pdp-faq summary::-webkit-details-marker{display:none}
.pdp-faq summary::after{content:"+";position:absolute;right:4px;top:12px;font-size:17px;color:var(--pdp-gold)}
.pdp-faq details[open] summary::after{content:"3"}
.pdp-faq p{padding:0 0 var(--pdp-s3);font-size:13.5px;color:var(--pdp-charcoal);line-height:1.7}

/* ── share ── */
.pdp-share{display:flex;align-items:center;gap:var(--pdp-s1);flex-wrap:wrap;padding:var(--pdp-s3) 0 0}
.pdp-share b{font-family:var(--pdp-accent);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink);margin-right:4px}
.pdp-share a,.pdp-share button{width:36px;height:36px;border:0;display:grid;place-items:center;color:var(--pdp-charcoal);transition:opacity .18s;background:none;cursor:pointer;padding:0;margin:0}
.pdp-share a:hover,.pdp-share button:hover{opacity:.72}
.pdp-share a[aria-label*="WhatsApp"]{color:#25D366}
.pdp-share a[aria-label*="Instagram"]{color:#E4405F}

.pdp-desc{font-size:14px;line-height:1.65;color:var(--pdp-charcoal)}
.pdp-desc p{margin:0 0 var(--pdp-s2)}

/* ── customiser section (collapsible, ivory) ── */
.pdp-custom{background:var(--pdp-ivory);font-family:var(--pdp-body);font-weight:400;font-size:var(--font-size-base,15px);line-height:1.6;color:var(--pdp-charcoal)}
.pdp-custom img{max-width:100%;display:block}
.pdp-custom h2{font-family:var(--pdp-display);font-weight:600;color:var(--pdp-ink);margin:0;font-size:clamp(20px,4.8vw,28px);line-height:1.2}
.pdp-custom p{margin:0}
.pdp-cert-block{background:var(--pdp-card);border-radius:var(--pdp-rl);box-shadow:var(--pdp-shadow-sm);padding:var(--pdp-s3);margin:var(--pdp-s4) 0 var(--pdp-s1)}
.pdp-custom__summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:var(--pdp-s2);background:var(--pdp-card);border:1px solid var(--pdp-gold);border-radius:var(--pdp-rl);box-shadow:var(--pdp-shadow-sm);padding:var(--pdp-s3);margin:var(--pdp-s2) 0 var(--pdp-s4)}
@media (hover:hover){.pdp-custom__summary:hover h2{color:var(--pdp-gold-deep)}}
.pdp-custom__summary::-webkit-details-marker{display:none}
.pdp-custom__icon{flex:0 0 auto;width:42px;height:42px;border-radius:50%;background:var(--pdp-ivory);display:grid;place-items:center;color:var(--pdp-gold-deep)}
.pdp-custom__heading{min-width:0;flex:1}
.pdp-custom__hint{margin-top:5px;font-size:12.5px;color:var(--pdp-charcoal-2)}
.pdp-custom__chev{flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:var(--pdp-ivory);position:relative;transition:background .2s;margin:0}
.pdp-custom__chev::after{content:"";position:absolute;left:50%;top:50%;width:9px;height:9px;border-right:1.6px solid var(--pdp-gold-deep);border-bottom:1.6px solid var(--pdp-gold-deep);transform:translate(-50%,-65%) rotate(45deg);transition:transform .2s}
@media (hover:hover){.pdp-custom__summary:hover .pdp-custom__chev{background:var(--pdp-ivory-2)}}
.pdp-custom__details[open] .pdp-custom__chev::after{transform:translate(-50%,-35%) rotate(-135deg)}
.pdp-custom__details[open] .pdp-custom__summary{margin-bottom:var(--pdp-s2)}
@media (max-width:639px){.pdp-custom__icon{display:none}}
.pdp-custom__body{padding-bottom:var(--pdp-s5)}
.pdp-custom__body>.pdp-step-label:first-child{margin-top:0}

.pdp-step-label{display:flex;align-items:baseline;gap:var(--pdp-s1);margin:var(--pdp-s4) 0 var(--pdp-s2);flex-wrap:wrap}
.pdp-step-label b{font-family:var(--pdp-accent);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink)}
.pdp-step-label .pdp-req{color:var(--pdp-gold-deep);font-size:11px}
.pdp-step-label .pdp-reset{margin-left:auto;font-family:var(--pdp-accent);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-gold-deep);cursor:pointer}
.pdp-step-label .pdp-reset:hover{color:var(--pdp-ink)}
.pdp-forms{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--pdp-s2)}
.pdp-tile{background:var(--pdp-card);border:0;border-radius:var(--pdp-r);box-shadow:var(--pdp-shadow-sm);padding:var(--pdp-s3) var(--pdp-s1);display:grid;place-items:center;gap:var(--pdp-s1);text-align:center;transition:outline-color .18s;cursor:pointer;margin:0;outline:1.5px solid transparent;outline-offset:1px}
.pdp-tile img{height:44px;width:auto;object-fit:contain}
@media (min-width:640px){.pdp-tile img{height:52px}}
.pdp-tile b{font-family:var(--pdp-accent);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--pdp-ink);font-weight:500}
.pdp-tile.is-active{outline-color:var(--pdp-gold)}
.pdp-advisory{margin-top:var(--pdp-s2);border-left:2px solid var(--pdp-gold);padding:10px var(--pdp-s2);background:var(--pdp-card);border-radius:0 var(--pdp-r) var(--pdp-r) 0;font-size:12.5px;color:var(--pdp-charcoal-2)}

.pdp-opts{display:grid;gap:var(--pdp-s2)}
@media (min-width:640px){.pdp-opts{grid-template-columns:1fr 1fr}}
.pdp-opt{display:flex;align-items:center;gap:var(--pdp-s2);background:var(--pdp-card);border:0;border-radius:var(--pdp-r);box-shadow:var(--pdp-shadow-sm);padding:var(--pdp-s2) var(--pdp-s3);cursor:pointer;transition:outline-color .16s;position:relative;min-width:0;outline:1.5px solid transparent;outline-offset:1px}
.pdp-opt input{position:absolute;opacity:0;pointer-events:none}
.pdp-opt .pdp-tick{flex:0 0 auto;width:16px;height:16px;border:1.4px solid var(--pdp-sand);border-radius:50%;display:grid;place-items:center}
.pdp-opt .pdp-tick::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--pdp-gold);transform:scale(0);transition:.16s}
.pdp-opt input:checked ~ .pdp-tick::after{transform:scale(1)}
.pdp-opt input:checked ~ .pdp-tick{border-color:var(--pdp-gold)}
.pdp-opt:has(input:checked){outline-color:var(--pdp-gold)}
.pdp-opt b{font-size:13.5px;font-weight:500;color:var(--pdp-ink)}
.pdp-opt .pdp-add{margin-left:auto;font-size:12.5px;color:var(--pdp-charcoal-2);text-align:right;flex-shrink:1}

.pdp-pills{display:flex;gap:var(--pdp-s1);flex-wrap:wrap}
.pdp-pill{background:var(--pdp-card);border:0;border-radius:20px;box-shadow:var(--pdp-shadow-sm);padding:10px var(--pdp-s3);font-family:var(--pdp-accent);font-size:12px;color:var(--pdp-charcoal-2);transition:.16s;cursor:pointer;margin:0;outline:1.5px solid transparent;outline-offset:1px}
.pdp-pill.is-active{color:var(--pdp-ink);outline-color:var(--pdp-gold)}
.pdp-grid2{display:grid;gap:var(--pdp-s1);margin-top:var(--pdp-s2)}
@media (min-width:640px){.pdp-grid2{grid-template-columns:1fr 1fr;align-items:end}}
.pdp-custom .pdp-field{margin-top:var(--pdp-s2)}
.pdp-custom .pdp-field label{font-family:var(--pdp-accent);font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--pdp-charcoal-2);font-weight:400}
.pdp-custom .pdp-field select,.pdp-custom .pdp-field input,.pdp-custom .pdp-field textarea{border:0;box-shadow:var(--pdp-shadow-sm)}
.pdp-size-err{margin-top:var(--pdp-s1);font-size:12.5px;color:#B4532E;display:none}

.pdp-empty{background:var(--pdp-card);border-radius:var(--pdp-r);padding:var(--pdp-s3);text-align:center;font-size:13.5px;color:var(--pdp-charcoal-2)}
/* design-grid skeleton loader */
.pdp-skel{border-radius:var(--pdp-r);background:var(--pdp-card);box-shadow:var(--pdp-shadow-sm);overflow:hidden}
.pdp-skel::before{content:"";display:block;aspect-ratio:1/1;background:linear-gradient(100deg,var(--pdp-ivory) 40%,var(--pdp-ivory-2) 50%,var(--pdp-ivory) 60%);background-size:200% 100%;animation:pdpShimmer 1.1s linear infinite}
.pdp-skel i{display:block;height:9px;margin:10px 12px 14px;border-radius:6px;background:var(--pdp-ivory)}
@keyframes pdpShimmer{to{background-position:-200% 0}}
@media (prefers-reduced-motion:reduce){.pdp-skel::before{animation:none}}
.pdp-custom .customize-design-grid,
#customize-design-grid-dynamic{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:var(--pdp-s2)}
/* design cards: kill product.css's old green accents, match Jewel Box */
.pdp-custom .customize-design-card{margin:0;background:var(--pdp-card);border:0;border-radius:var(--pdp-r);box-shadow:var(--pdp-shadow-sm);transition:outline-color .16s;padding:0 0 var(--pdp-s1);outline:1.5px solid transparent;outline-offset:1px;overflow:hidden}
.pdp-custom .customize-design-card:hover{border:0;background:var(--pdp-card)}
.pdp-custom .customize-design-card.is-active{border:0;background:var(--pdp-card);outline-color:var(--pdp-gold)}
.pdp-custom .customize-design-card:hover{outline-color:var(--pdp-gold)}
.pdp-custom .customize-design-card--add{background:var(--pdp-card);box-shadow:var(--pdp-shadow-sm)}
.pdp-custom .customize-design-card--add:hover{background:var(--pdp-card);outline-color:var(--pdp-gold)}
.pdp-custom .customize-design-card--add .cdc-add{aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:var(--pdp-ivory);color:#25D366}
.pdp-custom .customize-design-card__label{font-family:var(--pdp-accent);font-size:11px;font-weight:500;letter-spacing:.06em;color:var(--pdp-ink);background:none;padding:8px 8px 2px}
.pdp-custom .customize-design-card__metal-price{color:var(--pdp-gold-deep);background:none;padding:0 8px 6px}
/* gender pills: kill product.css's old dark-green active state */
.pdp-custom .customize-gender-btn{background:var(--pdp-card);color:var(--pdp-charcoal-2);border-radius:20px;border:0}
.pdp-custom .customize-gender-btn + .customize-gender-btn{border-left:0}
.pdp-custom .customize-gender-btn.is-active{background:var(--pdp-card);color:var(--pdp-ink);outline-color:var(--pdp-gold)}
.pdp-custom .customize-gender-btn:not(.is-active):hover{background:var(--pdp-ivory-2);color:var(--pdp-ink)}
/* native file input dressed as a Jewel Box control */
.pdp-custom input[type="file"]{padding:10px var(--pdp-s2)}
.pdp-custom input[type="file"]::file-selector-button{font-family:var(--pdp-accent);font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--pdp-ink);background:var(--pdp-ivory);border:0;border-radius:20px;padding:8px 14px;margin-right:12px;cursor:pointer}
.pdp-custom input[type="file"]::file-selector-button:hover{background:var(--pdp-ivory-2)}

/* ── ring size chart modal ── */
.pdp-modal{position:fixed;inset:0;z-index:100001;display:none}
.pdp-modal.is-open{display:block}
.pdp-modal__scrim{position:absolute;inset:0;background:rgba(35,31,32,.5)}
.pdp-modal__panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,calc(100vw - 28px));max-height:88vh;background:var(--pdp-card);border-radius:var(--pdp-rl);box-shadow:var(--pdp-shadow);display:flex;flex-direction:column;overflow:hidden}
.pdp-modal__head{display:flex;align-items:center;justify-content:space-between;gap:var(--pdp-s2);padding:var(--pdp-s3);border-bottom:1px solid var(--pdp-ivory-2)}
.pdp-modal__head b{font-family:var(--pdp-accent);font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink)}
.pdp-modal__head button{background:none;border:0;cursor:pointer;color:var(--pdp-ink);display:grid;place-items:center;padding:4px}
.pdp-modal__body{flex:1;overflow-y:auto;padding:var(--pdp-s3)}
.pdp-modal__body img{width:100%;height:auto;display:block}

/* ── recommendations: Jewel Box cards, centered partial rows ── */
#product-recs{background:var(--pdp-paper);padding:var(--pdp-s5) 0;overflow-x:clip;font-family:var(--pdp-body)}
#product-recs .pdp-recs-head{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--pdp-s3);margin-bottom:var(--pdp-s4)}
#product-recs .pdp-proc-eyebrow{margin:0 0 var(--pdp-s1)}
#product-recs .pdp-recs-title{font-family:var(--pdp-display);font-weight:600;color:var(--pdp-ink);font-size:clamp(20px,4.8vw,28px);margin:0;text-align:left}
#product-recs .pdp-recs-viewall{font-family:var(--pdp-accent);font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-gold-deep);text-decoration:none;white-space:nowrap;padding-bottom:4px}
#product-recs .pdp-recs-viewall:hover{color:var(--pdp-ink)}
#product-recs .product-recs__grid{display:flex;gap:var(--pdp-s2);margin:0;overflow-x:auto;scroll-snap-type:x mandatory;padding:2px 2px var(--pdp-s2);scrollbar-width:none;-webkit-overflow-scrolling:touch}
#product-recs .product-recs__grid::-webkit-scrollbar{display:none}
#product-recs .product-recs__grid .product-card{flex:0 0 min(64%,240px);scroll-snap-align:start;min-width:0}
@media (min-width:900px){
  #product-recs .product-recs__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,230px));justify-content:center;gap:var(--pdp-s4);overflow:visible;padding:0}
  #product-recs .product-recs__grid .product-card{flex:auto}
}
#product-recs .product-card{background:var(--pdp-card);border:0;border-radius:var(--pdp-rl);box-shadow:var(--pdp-shadow-sm);overflow:hidden;transition:box-shadow .18s,transform .18s;margin:0}
#product-recs .product-card:hover{box-shadow:var(--pdp-shadow);transform:translateY(-2px)}
#product-recs .product-card__info{padding:var(--pdp-s2) var(--pdp-s3) var(--pdp-s3)}
#product-recs .product-card__title{font-size:13.5px;font-weight:500;color:var(--pdp-ink);line-height:1.4}
#product-recs .product-card__specs{font-size:12px;color:var(--pdp-charcoal-2)}
#product-recs .product-card__price{font-family:var(--pdp-display);font-size:17px;font-weight:600;color:var(--pdp-ink)}
@media (prefers-reduced-motion:reduce){#product-recs .product-card:hover{transform:none}}

/* buying process (restored icon design): swipe carousel on mobile */
@media (max-width:899px){
  #pdp-buying-process .pdp-bp__grid{flex-direction:row;flex-wrap:nowrap;align-items:stretch;justify-content:flex-start;overflow-x:auto;scroll-snap-type:x mandatory;gap:var(--pdp-s3);padding:4px 4px var(--pdp-s2);scrollbar-width:none;-webkit-overflow-scrolling:touch}
  #pdp-buying-process .pdp-bp__grid::-webkit-scrollbar{display:none}
  #pdp-buying-process .pdp-bp__item{flex:0 0 74%;scroll-snap-align:center;min-width:0}
}

/* pdp-proc-eyebrow is reused by the recommendations header */
.pdp-proc-eyebrow{font-family:var(--pdp-accent);font-size:10.5px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--pdp-gold-deep);margin:0 0 var(--pdp-s1)}

/* ── sticky buy bar ── */
.pdp-stickybuy{position:fixed;left:0;right:0;bottom:0;z-index:70;background:var(--pdp-card);border-top:0;box-shadow:0 -10px 30px -14px rgba(120,96,58,.45);transform:translateY(105%);transition:transform .28s ease;padding:var(--pdp-s1) var(--pdp-gut);padding-bottom:calc(var(--pdp-s1) + env(safe-area-inset-bottom));font-family:var(--pdp-body)}
.pdp-stickybuy[data-show="true"]{transform:none}
.pdp-stickybuy__in{max-width:var(--pdp-wrap);margin:0 auto;display:flex;align-items:center;gap:var(--pdp-s2)}
.pdp-stickybuy img{width:42px;height:42px;object-fit:cover;background:var(--pdp-ivory);border-radius:var(--pdp-r);flex:0 0 auto;padding:0}
.pdp-stickybuy .txt{flex:1;min-width:0}
.pdp-stickybuy .txt b{display:block;font-size:12px;color:var(--pdp-charcoal);font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pdp-stickybuy .txt span{display:block;font-family:var(--pdp-display);font-size:15px;font-weight:600;color:var(--pdp-ink)}
.pdp-stickybuy .pdp-btn{width:auto;flex:0 0 auto;padding:13px var(--pdp-s3);font-size:11px}
@media (min-width:900px){.pdp-stickybuy .pdp-btn{padding:14px var(--pdp-s5)}}

@media (prefers-reduced-motion:reduce){
  .pdp-stickybuy{transition:none}
}
{% endstyle %}

<nav class="pdp-crumbs" aria-label="Breadcrumb">
  <div class="pdp-wrap">
    <a href="/">Home</a> ›
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> ›
    {%- endif -%}
    <span class="pdp-cur">{{ product.title }}</span>
  </div>
</nav>

<section class="pdp" id="product-{{ product.id }}">
  <div class="pdp-wrap">
    <div class="pdp-cols">

      <!-- ═══════════ GALLERY ═══════════ -->
      <div>
        <div class="pdp-media">
          <div class="pdp-gal">
            
            {%- comment -%} Slides: product media first, then metafield Vimeo videos {%- endcomment -%}
            {%- assign mf_vids = '' | split: ',' -%}
            {%- if mf.video != blank -%}
              {%- assign mf_vids = mf.video | split: ',' -%}
            {%- endif -%}
            {%- assign slide_total = product.media.size | plus: mf_vids.size -%}

            <div class="pdp-gal__track" id="galTrack-{{ section.id }}">
              {%- if product.media.size > 0 or mf_vids.size > 0 -%}
                {%- for media in product.media -%}
                  <div class="pdp-gal__slide">
                    {%- case media.media_type -%}
                      {%- when 'image' -%}
                        <img
                          src="{{ media | image_url: width: 1000 }}"
                          srcset="{{ media | image_url: width: 480 }} 480w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
                          sizes="(max-width: 899px) 100vw, 44vw"
                          alt="{{ media.alt | default: product.title | escape }}"
                          {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}
                        >
                      {%- when 'external_video' -%}
                        <div class="product-page__video-preview" data-video-type="external"
                          {%- if media.host == 'youtube' %} data-video-url="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1"{% endif -%}
                          {%- if media.host == 'vimeo' %} data-video-url="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&outro=nothing"{% endif -%}
                          onclick="openVideoPopup(this)">
                          <img src="{{ media.preview_image | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }} — video" loading="lazy">
                          <span class="pdp-gal__play" aria-hidden="true"><span><svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                        </div>
                      {%- when 'video' -%}
                        <div class="product-page__video-preview" data-video-type="native" onclick="openVideoPopup(this)">
                          <img src="{{ media.preview_image | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }} — video" loading="lazy">
                          <span class="pdp-gal__play" aria-hidden="true"><span><svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                          <video class="product-page__video-source" style="display:none;" preload="metadata">
                            {%- for source in media.sources -%}
                              <source src="{{ source.url }}" type="{{ source.mime_type }}">
                            {%- endfor -%}
                          </video>
                        </div>
                    {%- endcase -%}
                  </div>
                {%- endfor -%}
                {%- for mf_video_url in mf_vids -%}
                  {%- assign mf_video_url_clean = mf_video_url | strip -%}
                  {%- assign mf_vimeo_id = mf_video_url_clean | split: 'vimeo.com/' | last | split: '?' | first -%}
                  <div class="pdp-gal__slide">
                    <div class="product-page__video-preview" data-video-type="external" data-video-url="https://player.vimeo.com/video/{{ mf_vimeo_id }}?autoplay=1&outro=nothing" onclick="openVideoPopup(this)">
                      <img src="https://vumbnail.com/{{ mf_vimeo_id }}.jpg" alt="{{ product.title | escape }} — video" loading="lazy">
                      <span class="pdp-gal__play" aria-hidden="true"><span><svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="pdp-gal__slide">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1" style="margin:80px auto;display:block;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
            </div>

            {%- if slide_total > 1 -%}
              <div class="pdp-gal__dots" id="galDots-{{ section.id }}" aria-hidden="true">
                {%- for i in (1..slide_total) -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- if slide_total > 1 -%}
            <div class="pdp-thumbs" id="galThumbs-{{ section.id }}">
              {%- for media in product.media -%}
                <button class="pdp-thumb" {% if forloop.first %}aria-current="true"{% endif %} aria-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}">
                  {%- if media.media_type contains 'video' -%}
                    <span class="pdp-thumb__vid"><span><svg width="8" height="9" viewBox="0 0 16 18" fill="#fff"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                  {%- endif -%}
                  <img src="{{ media.preview_image | image_url: width: 120 }}" alt="" loading="lazy">
                </button>
              {%- endfor -%}
              {%- for mf_video_url in mf_vids -%}
                {%- assign mf_video_url_clean = mf_video_url | strip -%}
                {%- assign mf_vimeo_id_t = mf_video_url_clean | split: 'vimeo.com/' | last | split: '?' | first -%}
                <button class="pdp-thumb" aria-label="View video">
                  <span class="pdp-thumb__vid"><span><svg width="8" height="9" viewBox="0 0 16 18" fill="#fff"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                  <img src="https://vumbnail.com/{{ mf_vimeo_id_t }}.jpg" alt="" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>


        <!-- Share with a friend · wishlist + compare -->
        <div class="pdp-share">
          <b>Share with a friend</b>
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 16l1.2-3.6A6.8 6.8 0 1116 9a6.9 6.9 0 01-10.4 5.9z" stroke="currentColor" stroke-width="1.2"/><path d="M6.4 6.2c.4-.1.7 0 .9.4l.5 1c.1.3 0 .5-.2.7l-.3.3c.4.9 1.1 1.6 2 2l.3-.4c.2-.2.4-.3.7-.2l1 .5c.3.1.5.5.4.8-.2.7-.9 1.1-1.6 1-2.3-.3-4.1-2.1-4.4-4.4-.1-.7.2-1.4 1-1.7z" fill="currentColor"/></svg>
          </a>
          <a href="https://www.instagram.com/prec.iouscarats" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.2"/><circle cx="9" cy="9" r="3.4" stroke="currentColor" stroke-width="1.2"/><circle cx="13.2" cy="4.8" r="1" fill="currentColor"/></svg>
          </a>
          <span class="pdp-share__acts">
            <button
                class="pdp-gal__act"
                aria-label="Add to wishlist"
                data-wishlist-toggle
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ product.url }}"
                data-product-price="{{ product.price | money }}"
                data-variant-price="{{ current_variant.price }}"
                data-product-image="{{ product.featured_image | image_url: width: 600 }}"
                data-variant-id="{{ current_variant.id }}"
                onclick="event.preventDefault(); WishlistApp.toggle(this)"
              >
                <svg width="17" height="15" viewBox="0 0 21 19" fill="none" aria-hidden="true"><path d="M10.5 17.2S1.5 12 1.5 6.3A4.6 4.6 0 0110.5 4a4.6 4.6 0 019 2.3c0 5.7-9 10.9-9 10.9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              </button>
            <button
                type="button"
                class="pdp-gal__act product-page__compare-btn"
                aria-label="Add to compare"
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ product.url }}"
                data-product-price="{{ product.price | money }}"
                data-product-image="{{ product.featured_image | image_url: width: 600 }}"
                data-variant-id="{{ current_variant.id }}"
                data-product-type="{{ product.type | escape }}"
                data-product-vendor="{{ product.vendor | escape }}"
                data-gem-type="{{ mf.gem_type | default: product.type | escape }}"
                data-gem-origin="{{ mf.origin | escape }}"
                data-gem-weight-carats="{{ mf.weight_carats }}"
                data-gem-weight-ratti="{{ mf.weight_ratti }}"
                data-gem-shape-cut="{{ mf.shape_cut | escape }}"
                data-gem-cutting-style="{{ mf.cutting_style | escape }}"
                data-gem-transparency="{{ mf.transparency | escape }}"
                data-gem-color="{{ mf.color_description | escape }}"
                data-gem-planet="{{ mf.planetary_alignment | escape }}"
                data-gem-cert-lab="{{ mf.cert_lab | escape }}"
                data-gem-cert-number="{{ mf.cert_number | escape }}"
                data-gem-cert-link="{{ mf.cert_link | escape }}"
                data-gem-treatment="{{ mf.treatment_status | escape }}"
                data-gem-dimensions="{{ mf.dimensions | escape }}"
                data-gem-species="{{ mf.gems_title | escape }}"
                onclick="event.preventDefault(); CompareApp.toggle(this)"
              >
                <img src="{{ 'balance.svg' | asset_url }}" alt="" width="16" height="16">
              </button>
          </span>
        </div>

        <!-- Below Gallery Block Slot -->
        {%- assign _app_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'below_gallery' -%}
            <div class="product-page__custom-block" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
          {%- elsif block.type == '@app' -%}
            {%- assign _app_idx = _app_idx | plus: 1 -%}
            {%- if _app_idx == 1 -%}
              <div class="product-page__custom-block product-page__app-block--gallery" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- ═══════════ BUY COLUMN ═══════════ -->
      <div class="pdp-buy-col product-page__info">

        <div class="pdp-head">
          {%- assign _eyebrow = mf.gem_type | default: product.type -%}
          {%- if _eyebrow != blank -%}
            <p class="pdp-vendor">{{ _eyebrow }}{% if mf.planetary_alignment != blank %} &middot; {{ mf.planetary_alignment }}{% endif %}</p>
          {%- endif -%}
          <h1>{{ product.title }}{%- unless current_variant.available -%}<span class="pdp-soldflag">Sold Out</span>{%- endunless -%}</h1>

          <div class="pdp-metaline">
            {%- if mf.origin != blank -%}<span>Origin <b>{{ mf.origin }}</b></span>{%- endif -%}
            {%- if mf.weight_carats != blank -%}<span>Weight <b>{{ mf.weight_carats }} Carat</b></span>{%- endif -%}
            {%- if flag_treatment != blank -%}<span class="pdp-metaline__flag">{{ flag_treatment }}</span>{%- endif -%}
            {%- if mf.cert_lab != blank -%}<span class="pdp-metaline__flag">{{ mf.cert_lab }} certified</span>{%- endif -%}
          </div>

          <div class="pdp-price-zone product-page__price-wrap">
          <p class="pdp-price product-page__price-row">
            {%- if is_request_price -%}
              <b>Price on request</b>
            {%- else -%}
              {%- comment -%} product-page__price is the anchor Snapmint's EMI widget injects after — keep it on the visible price. {%- endcomment -%}
              <b class="product-page__price" data-pdp-price>{{ current_variant.price | money }}</b>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              <span>(MRP incl. of all taxes)</span>
            {%- endif -%}
          </p>
          <div class="product-page__price-widget" id="product-price-widget"></div>
          </div>
          <hr class="pdp-price-rule" aria-hidden="true">

          {%- if section.settings.payu_merchant_key != blank and is_request_price == false -%}
            <div id="payu-affordability-widget"></div>
          {%- endif -%}

          {%- if mf.tagline != blank or mf.tagline_hindi != blank -%}
            <div class="pdp-tagline">
              {% if mf.tagline %}<p>{{ mf.tagline }}</p>{% endif %}
              {% if mf.tagline_hindi %}<p>{{ mf.tagline_hindi }}</p>{% endif %}
            </div>
          {%- endif -%}
        </div>

        <div class="pdp-buy" id="buyBox-{{ section.id }}">


          <!-- Customization summary chip -->
          <div class="pdp-chip" id="customize-info-bar" style="display:none;">
            <span class="k">Customization selected</span>
            <span class="v" id="customize-summary-text">—</span>
            <button type="button" class="pdp-reset" onclick="CustomizeApp.reset()">Reset</button>
          </div>

          <!-- Below Certification Block Slot -->
          {%- assign _app_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'below_certification' -%}
              <div class="product-page__custom-block" {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </div>
            {%- elsif block.type == '@app' -%}
              {%- assign _app_idx = _app_idx | plus: 1 -%}
              {%- if _app_idx > 1 -%}
                <div class="product-page__custom-block" {{ block.shopify_attributes }}>
                  {%- render block -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          <!-- CTAs -->
          <div class="pdp-actions">
            {%- if current_variant.available == false -%}
              <button type="button" class="pdp-btn pdp-btn--line" disabled>Sold Out</button>
              <a href="https://wa.me/919908190811?text=Hi%2C%20I%20am%20interested%20in%20a%20gemstone%20similar%20to%20{{ product.title | url_encode }}%20which%20is%20sold%20out" class="pdp-soldout-note" target="_blank" rel="noopener">This gemstone has been sold. Contact us on WhatsApp for a similar gem.</a>
            {%- elsif is_request_price -%}
              <a href="https://wa.me/919908190811?text=Hi%2C%20I%20would%20like%20to%20know%20price%20of%20{{ product.title | url_encode }}" class="pdp-btn pdp-btn--solid" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 16l1.2-3.6A6.8 6.8 0 1116 9a6.9 6.9 0 01-10.4 5.9z" stroke="currentColor" stroke-width="1.2"/><path d="M6.4 6.2c.4-.1.7 0 .9.4l.5 1c.1.3 0 .5-.2.7l-.3.3c.4.9 1.1 1.6 2 2l.3-.4c.2-.2.4-.3.7-.2l1 .5c.3.1.5.5.4.8-.2.7-.9 1.1-1.6 1-2.3-.3-4.1-2.1-4.4-4.4-.1-.7.2-1.4 1-1.7z" fill="currentColor"/></svg>
                Request Price
              </a>
            {%- else -%}
              {%- form 'product', product, id: 'pdp-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <div class="pdp-actions product-page__cta-row" style="margin-top:0;">
                  <button type="submit" class="pdp-btn pdp-btn--solid product-page__btn-outline">Add to cart</button>
                  <div class="pdp-pair">
                    <div class="shopify-payment-button" style="display:contents;">
                      <button type="button" id="flo-buy-now-button" onclick="handleFloBuyNowBtn(event)" class="shopify-payment-button__button shopify-payment-button__button--unbranded" name="flo-buy-now-button">Buy it now</button>
                    </div>
                    <a href="#customise" class="pdp-btn pdp-btn--line" id="pdp-customize-cta" onclick="CustomizeApp.open(event)">Customize</a>
                  </div>
                </div>
              {%- endform -%}
            {%- endif -%}
          </div>

          <!-- Dispatch info -->
          {%- if is_purchasable -%}
            <p class="pdp-dispatch">
              <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7.4" stroke="currentColor" stroke-width="1.2"/><path d="M9 4.6V9l3 1.8" stroke="currentColor" stroke-width="1.2"/></svg>
              <span>Estimated dispatch date: <b id="dispatch-date-{{ section.id }}">&mdash;</b></span>
            </p>
          {%- endif -%}

          <!-- Assurance -->
          <ul class="pdp-assure">
            <li>
              <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 1.5l6.5 2.8v4.4c0 4.4-2.6 7.2-6.5 8.8-3.9-1.6-6.5-4.4-6.5-8.8V4.3z" stroke="currentColor" stroke-width="1.2"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.2"/></svg>
              {% if mf.cert_lab != blank %}{{ mf.cert_lab }}-certified natural gemstone{% else %}Lab-certified natural gemstone{% endif %}
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 13.5 4.5 9 9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 9H14a5.5 5.5 0 0 1 0 11h-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              10-day returns &amp; money back
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.2"/><path d="M2 9h14M9 2c2 2.3 3 4.7 3 7s-1 4.7-3 7c-2-2.3-3-4.7-3-7s1-4.7 3-7z" stroke="currentColor" stroke-width="1.1"/></svg>
              Worldwide shipping, everywhere you are
            </li>
          </ul>
        </div>

        <!-- ═══════════ CONTENT ACCORDIONS ═══════════ -->
        <div class="pdp-acc">

          <details open>
            <summary>About this Gem</summary>
            <div class="pdp-acc__body">
              <p>This {{ gem_type_label }}{% if mf.sku_number != blank %} ({{ mf.sku_number }}){% endif %}{% if mf.weight_carats != blank %} weighs {{ mf.weight_carats }} ct{% if mf.weight_ratti != blank %} and {{ mf.weight_ratti | times: 1.0 | round: 2 }} ratti{% endif %}{% endif %}.{% if mf.treatment_status != blank %} This gem is {{ mf.treatment_status | downcase }}.{% endif %}{% if mf.planetary_alignment != blank %} It can be useful for {{ mf.planetary_alignment }} remedy for astrological purposes and can also be used for jewellery.{% else %} It can be used for astrological purposes as well as jewellery.{% endif %}</p>

              <div class="pdp-spec">
                <div class="pdp-spec__row"><span class="k">Gem Type</span><span class="v">{{ mf.gem_type | default: product.type }}</span></div>
                {%- if mf.origin != blank -%}
                  <div class="pdp-spec__row"><span class="k">Origin</span><span class="v">{{ mf.origin }}</span></div>
                {%- endif -%}
                {%- if mf.weight_carats != blank -%}
                  <div class="pdp-spec__row"><span class="k">Weight</span><span class="v">{{ mf.weight_carats }} Carat{% if mf.weight_ratti != blank %} / {{ mf.weight_ratti | times: 1.0 | round: 2 }} Ratti{% endif %}</span></div>
                {%- endif -%}
                {%- if mf.shape_cut != blank or mf.cutting_style != blank -%}
                  <div class="pdp-spec__row"><span class="k">Shape / Cut</span><span class="v">{{ mf.shape_cut }}{% if mf.cutting_style != blank %} ({{ mf.cutting_style }}){% endif %}</span></div>
                {%- endif -%}
                {%- if mf.shape_description != blank -%}
                  <div class="pdp-spec__row"><span class="k">Shape Description</span><span class="v">{{ mf.shape_description }}</span></div>
                {%- endif -%}
                {%- if mf.transparency != blank -%}
                  <div class="pdp-spec__row"><span class="k">Transparency</span><span class="v">{{ mf.transparency }}</span></div>
                {%- endif -%}
                {%- if mf.color_description != blank -%}
                  <div class="pdp-spec__row"><span class="k">Color</span><span class="v">{{ mf.color_description }}</span></div>
                {%- endif -%}
                {%- if mf.cert_lab != blank -%}
                  <div class="pdp-spec__row"><span class="k">Certification</span><span class="v">{{ mf.cert_lab }}{% if mf.cert_number != blank %} : {{ mf.cert_number }}{% endif %}
                    {%- if mf.cert_link != blank -%}
                      <a class="pdp-verify" href="{{ mf.cert_link }}">Verify
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 1h7v7M11 1L3.5 8.5" stroke="currentColor" stroke-width="1.2"/><path d="M8 11H1V4" stroke="currentColor" stroke-width="1.2"/></svg>
                      </a>
                    {%- endif -%}
                  </span></div>
                {%- endif -%}
                {%- if mf.planetary_alignment != blank -%}
                  <div class="pdp-spec__row"><span class="k">Planet</span><span class="v">{{ mf.planetary_alignment }}</span></div>
                {%- endif -%}
              </div>
            </div>
          </details>

          {%- if product.price >= 50000000 -%}
            <details>
              <summary>Why this gem is special</summary>
              <div class="pdp-acc__body">
                {%- if mf.wow_factor != blank -%}
                  <p>{{ mf.wow_factor | newline_to_br }}</p>
                {%- else -%}
                  <p>This premium gemstone is among the top 1% of its kind. Its exceptional saturation, rare origin, and master-grade cut make it a truly unique investment and a powerful spiritual tool.</p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
          <details>
            <summary>Know your gem</summary>
            <div class="pdp-acc__body">
              <div class="pdp-spec" style="margin-top:0;">
                <div class="pdp-spec__row"><span class="k">Species &amp; Variety</span><span class="v">{{ mf.gems_title | default: product.title }}</span></div>
                {%- if mf.refractive_index != blank -%}
                  <div class="pdp-spec__row"><span class="k">Refractive Index (RI)</span><span class="v">{{ mf.refractive_index }}</span></div>
                {%- endif -%}
                {%- if mf.specific_gravity != blank -%}
                  <div class="pdp-spec__row"><span class="k">Specific Gravity (SG)</span><span class="v">{{ mf.specific_gravity }}</span></div>
                {%- endif -%}
                {%- if mf.clarity_description != blank -%}
                  <div class="pdp-spec__row"><span class="k">Internal Characteristics</span><span class="v">{%- assign clar_len = mf.clarity_description | size -%}{%- if clar_len > 180 -%}<span class="pdp-clamp" id="pdp-clamp-clarity">{{ mf.clarity_description }}</span><button type="button" class="pdp-clamp__btn" aria-expanded="false" aria-controls="pdp-clamp-clarity" onclick="pdpClampToggle(this)">Read more</button>{%- else -%}{{ mf.clarity_description }}{%- endif -%}</span></div>
                {%- endif -%}
                {%- if mf.dimensions != blank -%}
                  <div class="pdp-spec__row"><span class="k">Dimensions</span><span class="v">{{ mf.dimensions }} mm</span></div>
                {%- endif -%}
                {%- if mf.origin != blank -%}
                  <div class="pdp-spec__row"><span class="k">Origin</span><span class="v">{{ mf.origin }}</span></div>
                {%- endif -%}
                {%- if mf.treatment_status != blank -%}
                  <div class="pdp-spec__row"><span class="k">Treatment Status</span><span class="v">{{ mf.treatment_status }}</span></div>
                {%- endif -%}
              </div>
            </div>
          </details>

          <details>
            <summary>Planetary Alignment</summary>
            <div class="pdp-acc__body">
              {%- render 'planetary-alignment', product: product -%}
            </div>
          </details>

          {%- comment -%} ── FAQs ── {%- endcomment -%}
          {%- assign faq_gem_type = gem_type_label -%}
          {%- assign faq_cert_lab = mf.cert_lab | default: '' -%}
          {%- assign faq_cert_number = mf.cert_number | default: '' -%}
          {%- assign faq_cert_date = mf.cert_date | default: '' -%}
          {%- assign faq_origin = mf.origin | default: '' -%}
          {%- assign faq_carats = mf.weight_carats | default: 0 -%}
          {%- assign faq_carats_grams = faq_carats | times: 0.2 | round: 3 -%}
          {%- assign faq_dimensions = mf.dimensions | default: '' -%}
          {%- assign faq_shape = mf.shape_cut | default: '' -%}
          {%- assign faq_treatment_raw = mf.treatment_status | default: '' -%}
          {%- assign faq_treatment_label = faq_treatment_raw | downcase -%}

          {%- comment -%} Answers captured once — rendered in the accordion AND emitted as FAQPage JSON-LD {%- endcomment -%}
          {%- capture faq_a1 -%}This {{ faq_gem_type }} is {{ faq_treatment_label }}, as disclosed on the {{ faq_cert_lab }} certificate. Treatment status is permanent and does not change over time.{%- endcapture -%}
          {%- capture faq_a2 -%}This {{ faq_gem_type }} is certified by {{ faq_cert_lab }}{% if faq_cert_number != blank %}, report number {{ faq_cert_number }}{% endif %}{% if faq_cert_date != blank %}, issued on {{ faq_cert_date }}{% endif %}. The full certificate is included with the stone and is available for verification.{%- endcapture -%}
          {%- if faq_origin != blank -%}
            {%- capture faq_a3 -%}A {{ faq_carats }} carat {{ faq_gem_type }}, believed to be of {{ faq_origin }} origin. This origin opinion is based on a combination of our sourcing knowledge, visible features, internal characteristics, and, where available, certifying authority opinion.{%- endcapture -%}
          {%- else -%}
            {%- capture faq_a3 -%}A {{ faq_carats }} carat {{ faq_gem_type }}. Origin has not been tested or cannot be reliably determined for this gemstone. For many gems, origin testing is not always commercially meaningful; we focus instead on accurate disclosure of identity, treatment status, appearance, and certification.{%- endcapture -%}
          {%- endif -%}
          {%- capture faq_a4 -%}This {{ faq_gem_type }} weighs {{ faq_carats }} carats ({{ faq_carats_grams }} grams){% if faq_dimensions != blank %}, with dimensions of {{ faq_dimensions }} mm{% endif %}{% if faq_shape != blank %}, cut in a {{ faq_shape }} shape{% endif %}.{%- endcapture -%}

          {%- assign faq_a5 = '' -%}
          {%- case faq_treatment_raw -%}
            {%- when 'No oil' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically suitable. A no oil emerald is considered the most structurally stable and no treatment has been done on the emerald.' -%}
            {%- when 'Insignificant Oil', 'Minor oil', 'Moderate oil', 'Colourless Oiling Only' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically suitable. Oiling of emeralds is a common trade practice.' -%}
            {%- when 'Minor natural Resin' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically suitable. Columbian emeralds are generally treated with natural resin. The treatment is permanent and does not deteriorate over time. No artificial Polymers are used for this treatment.' -%}
            {%- when 'Unheated and Untreated – No indications of treatment observed' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically acceptable as no treatment of any sort has been done on this gem.' -%}
            {%- when 'Heated', 'Beryllium Treated' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically acceptable. The treatment is permanent and does not deteriorate over time. However, please consult your astrologer once before purchase.' -%}
            {%- when 'Diffusion Treated (Colour surface modification)', 'Glass-Filled (Fracture-filled to improve clarity)', 'Resin-Filled / Dyed', 'Wax Filled' -%}
              {%- assign faq_a5 = 'This gem is generally not considered astrologically suitable and more suited for jewellery purposes. However please consult your astrologer if you wish to buy this gem.' -%}
            {%- when 'Ethiopian Opals' -%}
              {%- assign faq_a5 = 'This gem is generally not suitable for astrological purposes and more suited for jewellery purposes, as ethiopian opals lose their natural colour when exposed to water.' -%}
          {%- endcase -%}

          {%- assign faq_a6 = 'Yes. Every gemstone is photographed and filmed individually. The gemstone shown is the exact gemstone you will receive, matched by SKU, certificate, and internal records. Slight colour or brightness variation may occur due to lighting, camera, or screen settings.' -%}
          {%- assign faq_a7 = 'Yes. Loose gemstones can be returned within 10 days of delivery, subject to inspection and quality check. The gemstone must be in the same condition as received, and must not be worn, altered, damaged, or replaced. The certificate, packaging, and tags must also be returned intact. Customized and made-to-order jewellery is not returnable.' -%}

          <details>
            <summary>Frequently Asked Questions</summary>
            <div class="pdp-acc__body pdp-faq">
