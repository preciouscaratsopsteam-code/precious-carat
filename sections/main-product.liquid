{%- comment -%}
  Main Product Section — editorial PDP.
  Customization is an open on-page section (#customise), not a modal.
  Business logic preserved: certification fees, customization fee product line
  (+ Shopflo reconciler nudge), dispatch estimate, CDN design probing,
  wishlist/compare, recommendations.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_request_price = false -%}
{%- if product.price > 100000000 -%}{%- assign is_request_price = true -%}{%- endif -%}
{%- assign is_purchasable = false -%}
{%- if current_variant.available and is_request_price == false -%}{%- assign is_purchasable = true -%}{%- endif -%}

{%- assign mf = product.metafields.custom -%}
{%- assign gem_type_label = mf.gem_type | default: product.type | default: 'gemstone' -%}

{%- comment -%} Short flag labels for the gallery {%- endcomment -%}
{%- assign flag_treatment = mf.treatment_status | split: '–' | first | split: '(' | first | strip -%}

{{ 'product.css' | asset_url | stylesheet_tag }}

{% style %}
/* ═══════════ PDP redesign (scoped: pdp-) ═══════════ */
:root{
  --pdp-ink:#231F20; --pdp-ink-deep:#17130F; --pdp-ink-soft:#3B322A;
  --pdp-gold:#B08D4F; --pdp-gold-soft:#C9AE7A;
  --pdp-charcoal:#33302C; --pdp-charcoal-2:#7A7268;
  --pdp-paper:#fff; --pdp-mist:#FAF6F0; --pdp-mist-2:#F1E9DD; --pdp-line:#E6DDCF;
  --pdp-display:'Cormorant Garamond',Georgia,serif;
  --pdp-body:'Outfit','Inter',Arial,sans-serif;
  --pdp-wrap:1220px; --pdp-gut:16px;
  --pdp-facet:polygon(10px 0,calc(100% - 10px) 0,100% 10px,100% calc(100% - 10px),calc(100% - 10px) 100%,10px 100%,0 calc(100% - 10px),0 10px);
  --pdp-sticky-h:0px;
}
@media (min-width:900px){:root{--pdp-gut:32px}}
body{padding-bottom:var(--pdp-sticky-h)}
#customise{scroll-margin-top:96px}

.pdp-wrap{max-width:var(--pdp-wrap);margin:0 auto;padding:0 var(--pdp-gut)}
.pdp *,.pdp *::before,.pdp *::after,
.pdp-custom *,.pdp-proc-section *,.pdp-uspband *,.pdp-stickybuy *{box-sizing:border-box}
.pdp{font-family:var(--pdp-body);font-weight:300;font-size:15px;line-height:1.6;color:var(--pdp-charcoal);padding-bottom:34px}
.pdp img{max-width:100%;display:block}
.pdp a{color:inherit;text-decoration:none}
.pdp button{background:none;border:0;cursor:pointer;font:inherit;color:inherit}
.pdp h1,.pdp h2,.pdp h3,.pdp h4{font-family:var(--pdp-display);font-weight:500;color:var(--pdp-ink);margin:0;line-height:1.15}
.pdp p{margin:0}

/* ── breadcrumb ── */
.pdp-crumbs{border-bottom:1px solid var(--pdp-line);background:var(--pdp-paper);font-family:var(--pdp-body)}
.pdp-crumbs .pdp-wrap{display:flex;gap:8px;align-items:center;overflow-x:auto;white-space:nowrap;padding-top:10px;padding-bottom:10px;font-size:11.5px;color:var(--pdp-charcoal-2);scrollbar-width:none}
.pdp-crumbs .pdp-wrap::-webkit-scrollbar{display:none}
.pdp-crumbs a{color:inherit;text-decoration:none}
.pdp-crumbs a:hover{color:var(--pdp-gold)}
.pdp-crumbs .pdp-cur{color:var(--pdp-ink)}

/* ── layout ── */
@media (min-width:900px){
  .pdp .pdp-cols{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:start;padding-top:26px}
  .pdp-buy-col{position:sticky;top:100px}
}

/* ── gallery ── */
.pdp-gal{position:relative;margin:0 calc(var(--pdp-gut) * -1)}
@media (min-width:900px){.pdp-gal{margin:0}}
.pdp-gal__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.pdp-gal__track::-webkit-scrollbar{display:none}
.pdp-gal__slide{flex:0 0 100%;scroll-snap-align:center;background:var(--pdp-mist);position:relative}
.pdp-gal__slide img{width:100%;height:min(42vh,380px);object-fit:contain;padding:12px}
@media (min-width:900px){.pdp-gal__slide img{height:520px;padding:26px}}
.pdp-gal__slide .product-page__video-preview{cursor:pointer;position:relative}
.pdp-gal__play{position:absolute;inset:0;display:grid;place-items:center;color:#fff;pointer-events:none}
.pdp-gal__play span{width:58px;height:58px;border-radius:50%;background:rgba(35,31,32,.82);display:grid;place-items:center}
.pdp-gal__flags{position:absolute;top:12px;left:12px;z-index:2;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.pdp-flag{background:var(--pdp-ink);color:#fff;font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;padding:5px 9px}
.pdp-flag--out{background:var(--pdp-paper);color:var(--pdp-ink);border:1px solid var(--pdp-line)}
.pdp-gal__acts{position:absolute;top:12px;right:12px;z-index:2;display:flex;flex-direction:column;gap:7px}
.pdp-gal__act{width:36px;height:36px;display:grid;place-items:center;background:rgba(255,255,255,.94);border:1px solid var(--pdp-line);color:var(--pdp-ink);cursor:pointer;padding:0}
.pdp-gal__act img{width:16px;height:16px;padding:0}
.pdp-gal__act.is-active,.pdp-gal__act.is-wishlisted{background:var(--pdp-ink);color:#fff}
.pdp-gal__act.is-active img,.pdp-gal__act.is-wishlisted img{filter:invert(1)}
.pdp-gal__dots{position:absolute;bottom:10px;left:0;right:0;display:flex;justify-content:center;gap:6px;z-index:2;pointer-events:none}
.pdp-gal__dots i{width:22px;height:2px;background:rgba(35,31,32,.25)}
.pdp-gal__dots i.on{background:var(--pdp-ink)}
.pdp-thumbs{display:flex;gap:8px;overflow-x:auto;padding:12px var(--pdp-gut) 0;scrollbar-width:none}
.pdp-thumbs::-webkit-scrollbar{display:none}
.pdp-thumb{flex:0 0 auto;width:62px;height:62px;border:1px solid var(--pdp-line);background:var(--pdp-mist);padding:4px;transition:.18s;position:relative;cursor:pointer}
.pdp-thumb img{width:100%;height:100%;object-fit:contain;padding:0}
.pdp-thumb[aria-current="true"]{border-color:var(--pdp-ink)}
.pdp-thumb__vid{position:absolute;inset:0;display:grid;place-items:center;color:#fff}
.pdp-thumb__vid span{width:20px;height:20px;border-radius:50%;background:rgba(35,31,32,.75);display:grid;place-items:center}
@media (min-width:900px){
  .pdp-media{display:flex;gap:12px;align-items:flex-start}
  .pdp-media .pdp-gal{flex:1;min-width:0;order:2}
  .pdp-thumbs{order:1;flex:0 0 74px;flex-direction:column;padding:0;gap:8px;max-height:520px;overflow-y:auto;overscroll-behavior:contain}
  .pdp-thumb{width:74px;height:74px}
}

/* ── title / price ── */
.pdp-head{padding-top:14px}
.pdp-head .pdp-vendor{font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--pdp-charcoal-2)}
.pdp-head h1{font-size:clamp(24px,6.4vw,34px);margin:8px 0 10px}
.pdp-soldflag{display:inline-block;vertical-align:middle;margin-left:10px;background:var(--pdp-ink);color:#fff;font-family:var(--pdp-body);font-size:10px;letter-spacing:.14em;text-transform:uppercase;padding:4px 8px}
.pdp-metaline{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.pdp-metaline span{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--pdp-charcoal-2);border:1px solid var(--pdp-line);padding:5px 9px}
.pdp-metaline span b{color:var(--pdp-ink);font-weight:500}
.pdp-price{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.pdp-price b{font-family:var(--pdp-display);font-size:30px;font-weight:600;color:var(--pdp-ink)}
.pdp-price s{font-size:15px;color:var(--pdp-charcoal-2)}
.pdp-price span{font-size:11.5px;color:var(--pdp-charcoal-2)}
.pdp-tagline{margin-top:12px;padding:12px 14px;background:var(--pdp-mist);clip-path:var(--pdp-facet)}
.pdp-tagline p{font-size:14.5px;color:var(--pdp-ink);line-height:1.5}
.pdp-tagline p+p{margin-top:6px;font-size:13.5px;color:var(--pdp-charcoal-2)}

/* ── buy box ── */
.pdp-buy{margin-top:18px}
.pdp-field{display:grid;gap:7px}
.pdp-field label{font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink)}
.pdp-field label .pdp-req{color:var(--pdp-charcoal-2);font-weight:400;letter-spacing:0;text-transform:none}
.pdp-field select,.pdp-field input,.pdp-field textarea{width:100%;border:1px solid var(--pdp-line);background:var(--pdp-paper);padding:13px;font:inherit;font-size:14px;color:var(--pdp-ink);border-radius:0;-webkit-appearance:none;appearance:none}
.pdp-field select{background-image:linear-gradient(45deg,transparent 50%,var(--pdp-ink) 50%),linear-gradient(135deg,var(--pdp-ink) 50%,transparent 50%);background-position:calc(100% - 19px) 21px,calc(100% - 13px) 21px;background-size:6px 6px;background-repeat:no-repeat;cursor:pointer}
.pdp-hint{font-size:11.5px;color:var(--pdp-charcoal-2)}

.pdp-chip{margin-top:14px;border:1px solid var(--pdp-line);padding:12px 13px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pdp-chip .k{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-charcoal-2)}
.pdp-chip .v{font-size:13.5px;color:var(--pdp-ink)}
.pdp-chip .pdp-reset{margin-left:auto;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-ink);border-bottom:1px solid var(--pdp-line);cursor:pointer}

.pdp-actions{display:grid;gap:9px;margin-top:16px}
.pdp-btn{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:15px 20px;font-family:var(--pdp-body);font-size:12.5px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;border:1px solid var(--pdp-ink);transition:.18s;text-align:center;cursor:pointer;border-radius:0}
.pdp-btn--solid{background:var(--pdp-ink);color:#fff}
.pdp-btn--solid:hover{background:var(--pdp-ink-soft)}
.pdp-btn--ghost{background:transparent;color:var(--pdp-ink)}
.pdp-btn--ghost:hover{background:var(--pdp-ink);color:#fff}
.pdp-btn--line{border-color:var(--pdp-line);color:var(--pdp-ink);background:transparent}
.pdp-btn--line:hover{border-color:var(--pdp-ink)}
.pdp-btn[disabled]{opacity:.5;cursor:not-allowed}
.pdp-actions .pdp-pair{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.pdp .shopify-payment-button__button--unbranded{all:unset;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:15px 20px;font-family:var(--pdp-body);font-size:12.5px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;border:1px solid var(--pdp-ink);background:transparent;color:var(--pdp-ink);transition:.18s;cursor:pointer;text-align:center}
.pdp .shopify-payment-button__button--unbranded:hover{background:var(--pdp-ink);color:#fff}
.pdp-soldout-note{display:block;margin-top:8px;font-size:12.5px;color:var(--pdp-charcoal-2);text-decoration:underline}
.pdp-dispatch{margin-top:12px;font-size:12.5px;color:var(--pdp-charcoal-2);display:flex;align-items:center;gap:9px}
.pdp-dispatch b{color:var(--pdp-ink);font-weight:500}

/* ── accordions ── */
.pdp-acc{border-top:1px solid var(--pdp-line);margin-top:26px}
.pdp-acc>details{border-bottom:1px solid var(--pdp-line)}
.pdp-acc>details>summary{list-style:none;cursor:pointer;padding:18px 40px 18px 0;position:relative;font-family:var(--pdp-display);font-size:19px;color:var(--pdp-ink)}
.pdp-acc>details>summary::-webkit-details-marker{display:none}
.pdp-acc>details>summary::after{content:"";position:absolute;right:6px;top:50%;width:9px;height:9px;border-right:1px solid var(--pdp-ink);border-bottom:1px solid var(--pdp-ink);transform:translateY(-70%) rotate(45deg);transition:.2s}
.pdp-acc>details[open]>summary::after{transform:translateY(-30%) rotate(-135deg)}
.pdp-acc__body{padding:0 0 22px}
.pdp-acc__body p{font-size:14px;line-height:1.65;color:var(--pdp-charcoal-2)}
.pdp-acc__body p+p{margin-top:12px}
.pdp-acc__body a{color:var(--pdp-ink)}

.pdp-spec{border:1px solid var(--pdp-line);margin-top:14px}
.pdp-spec__row{display:flex;gap:14px;padding:11px 14px;border-bottom:1px solid var(--pdp-line);font-size:13.5px}
.pdp-spec__row:last-child{border-bottom:0}
.pdp-spec__row:nth-child(odd){background:var(--pdp-mist)}
.pdp-spec__row .k{flex:0 0 45%;color:var(--pdp-charcoal-2)}
.pdp-spec__row .v{flex:1;color:var(--pdp-ink);font-weight:400;min-width:0;overflow-wrap:anywhere}
.pdp-verify{display:inline-flex;align-items:center;gap:6px;margin-left:8px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--pdp-gold)!important;border-bottom:1px solid var(--pdp-gold);padding-bottom:1px;text-decoration:none!important}

.pdp-mantra{margin-top:14px;background:var(--pdp-ink);color:#fff;padding:16px}
.pdp-mantra .row{display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.16);font-size:13.5px}
.pdp-mantra .row:last-child{border-bottom:0}
.pdp-mantra .row span{color:rgba(255,255,255,.6);flex:0 0 40%}
.pdp-mantra .row b{font-weight:400;color:#fff;text-align:right}
.pdp-mantra .row b em{display:block;font-style:italic;color:rgba(255,255,255,.66);font-size:12.5px}
.pdp-vidlinks{display:grid;gap:8px;margin-top:14px}
.pdp-vidlink{display:flex;align-items:center;gap:11px;border:1px solid var(--pdp-line);padding:12px 13px;font-size:13.5px;color:var(--pdp-ink)!important;transition:.18s;text-decoration:none!important}
.pdp-vidlink:hover{border-color:var(--pdp-ink);background:var(--pdp-mist)}
.pdp-vidlink svg{flex:0 0 auto}
.pdp-vidlink span{margin-left:auto;color:var(--pdp-charcoal-2)}

.pdp-faq details{border-bottom:1px solid var(--pdp-line)}
.pdp-faq details:last-child{border-bottom:0}
.pdp-faq summary{font-family:var(--pdp-body);font-size:14.5px;padding:15px 34px 15px 0;color:var(--pdp-ink);cursor:pointer;list-style:none;position:relative}
.pdp-faq summary::-webkit-details-marker{display:none}
.pdp-faq summary::after{content:"+";position:absolute;right:6px;top:14px;font-size:17px;color:var(--pdp-ink)}
.pdp-faq details[open] summary::after{content:"\2013"}
.pdp-faq p{padding:0 0 18px;font-size:13.5px;color:var(--pdp-charcoal-2);line-height:1.7}

/* ── share ── */
.pdp-share{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:22px 0}
.pdp-share b{font-family:var(--pdp-body);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink);margin-right:4px}
.pdp-share a,.pdp-share button{width:40px;height:40px;border:1px solid var(--pdp-line);display:grid;place-items:center;color:var(--pdp-ink);transition:.18s;background:none;cursor:pointer;padding:0}
.pdp-share a:hover,.pdp-share button:hover{background:var(--pdp-ink);color:#fff;border-color:var(--pdp-ink)}
.pdp-share--desktop{display:none}
@media (min-width:900px){
  .pdp-share--desktop{display:flex}
  .pdp-share--mobile{display:none}
}
.pdp-desc{font-size:14px;line-height:1.65;color:var(--pdp-charcoal-2)}
.pdp-desc p{margin:0 0 12px}

/* ── customiser section ── */
.pdp-custom{padding:34px 0;border-top:1px solid var(--pdp-line);background:var(--pdp-mist);font-family:var(--pdp-body);font-weight:300;font-size:15px;line-height:1.6;color:var(--pdp-charcoal)}
.pdp-custom img{max-width:100%;display:block}
.pdp-custom h2{font-family:var(--pdp-display);font-weight:500;color:var(--pdp-ink);margin:0;font-size:clamp(22px,5.4vw,30px);line-height:1.15}
.pdp-custom p{margin:0}
.pdp-custom button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
.pdp-step-label{display:flex;align-items:baseline;gap:9px;margin:24px 0 11px;flex-wrap:wrap}
.pdp-step-label b{font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink)}
.pdp-step-label .pdp-req{color:var(--pdp-charcoal-2);font-size:11px}
.pdp-step-label .pdp-reset{margin-left:auto;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pdp-ink);border-bottom:1px solid var(--pdp-line);cursor:pointer}
.pdp-forms{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.pdp-tile{border:1px solid var(--pdp-line);background:var(--pdp-paper);padding:16px 10px;display:grid;place-items:center;gap:9px;text-align:center;transition:.18s;cursor:pointer}
.pdp-tile img{height:52px;width:auto;object-fit:contain}
.pdp-tile b{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--pdp-ink);font-weight:500}
.pdp-tile.is-active{border-color:var(--pdp-ink);background:var(--pdp-mist)}
.pdp-selnote{margin-top:11px;font-size:12px;color:var(--pdp-charcoal-2);line-height:1.55}
.pdp-selnote b{color:var(--pdp-ink);font-weight:500}
.pdp-selnote button{color:var(--pdp-ink);border-bottom:1px solid var(--pdp-line);padding:0}
.pdp-advisory{margin-top:11px;border-left:2px solid var(--pdp-ink);padding:10px 13px;background:var(--pdp-paper);font-size:12.5px;color:var(--pdp-charcoal-2)}

.pdp-opts{display:grid;gap:7px}
@media (min-width:640px){.pdp-opts{grid-template-columns:1fr 1fr}}
.pdp-opt{display:flex;align-items:center;gap:11px;border:1px solid var(--pdp-line);background:var(--pdp-paper);padding:12px 13px;cursor:pointer;transition:.16s;position:relative}
.pdp-opt:hover{border-color:var(--pdp-ink)}
.pdp-opt input{position:absolute;opacity:0;pointer-events:none}
.pdp-opt .pdp-tick{flex:0 0 auto;width:16px;height:16px;border:1px solid var(--pdp-charcoal-2);border-radius:50%;display:grid;place-items:center}
.pdp-opt .pdp-tick::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--pdp-ink);transform:scale(0);transition:.16s}
.pdp-opt input:checked ~ .pdp-tick::after{transform:scale(1)}
.pdp-opt input:checked ~ .pdp-tick{border-color:var(--pdp-ink)}
.pdp-opt:has(input:checked){border-color:var(--pdp-ink);background:var(--pdp-mist)}
.pdp-opt b{font-size:13.5px;font-weight:400;color:var(--pdp-ink)}
.pdp-opt .pdp-add{margin-left:auto;font-size:12.5px;color:var(--pdp-charcoal-2);white-space:nowrap;text-align:right}

.pdp-pills{display:flex;gap:7px;flex-wrap:wrap}
.pdp-pill{border:1px solid var(--pdp-line);background:var(--pdp-paper);padding:10px 16px;font-size:12.5px;color:var(--pdp-charcoal-2);transition:.16s;cursor:pointer}
.pdp-pill.is-active{background:var(--pdp-ink);border-color:var(--pdp-ink);color:#fff}
.pdp-grid2{display:grid;gap:9px;margin-top:11px}
@media (min-width:640px){.pdp-grid2{grid-template-columns:1fr 1fr;align-items:end}}
.pdp-custom .pdp-field{margin-top:11px}
.pdp-custom .pdp-field label{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--pdp-charcoal-2);font-weight:400}
.pdp-size-err{margin-top:8px;font-size:12.5px;color:#c94a4a;display:none}

.pdp-empty{border:1px dashed var(--pdp-line);background:var(--pdp-paper);padding:18px;text-align:center;font-size:13.5px;color:var(--pdp-charcoal-2)}
.pdp-upload{margin-top:24px;border:1px solid var(--pdp-line);background:var(--pdp-paper);padding:16px}
.pdp-upload h3{font-family:var(--pdp-body);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;margin:0 0 4px;color:var(--pdp-ink)}
.pdp-custom .customize-design-grid,
#customize-design-grid-dynamic{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}

/* ── ring size chart modal ── */
.pdp-modal{position:fixed;inset:0;z-index:100001;display:none}
.pdp-modal.is-open{display:block}
.pdp-modal__scrim{position:absolute;inset:0;background:rgba(23,19,15,.55)}
.pdp-modal__panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,calc(100vw - 28px));max-height:88vh;background:var(--pdp-paper);border:1px solid var(--pdp-line);display:flex;flex-direction:column}
.pdp-modal__head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px;border-bottom:1px solid var(--pdp-line)}
.pdp-modal__head b{font-family:var(--pdp-body);font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--pdp-ink)}
.pdp-modal__head button{background:none;border:0;cursor:pointer;color:var(--pdp-ink);display:grid;place-items:center;padding:4px}
.pdp-modal__body{flex:1;overflow-y:auto;padding:16px}
.pdp-modal__body img{width:100%;height:auto;display:block}

/* ── buying process ── */
.pdp-proc-section{padding:34px 0;border-top:1px solid var(--pdp-line);font-family:var(--pdp-body)}
.pdp-proc-section h2{font-family:var(--pdp-display);font-weight:500;color:var(--pdp-ink);margin:0;font-size:clamp(22px,5.4vw,30px)}
.pdp-proc-section .pdp-lede{font-size:13.5px;color:var(--pdp-charcoal-2);margin:9px 0 0}
.pdp-proc{display:grid;gap:9px;margin-top:22px}
@media (min-width:760px){.pdp-proc{grid-template-columns:repeat(5,1fr)}}
.pdp-proc__step{border:1px solid var(--pdp-line);background:var(--pdp-paper);padding:18px 16px;display:flex;gap:13px;align-items:flex-start}
@media (min-width:760px){.pdp-proc__step{flex-direction:column;gap:10px}}
.pdp-proc__step .n{font-family:var(--pdp-display);font-size:13px;letter-spacing:.18em;color:var(--pdp-charcoal-2);flex:0 0 auto}
.pdp-proc__step h3{font-family:var(--pdp-body);font-size:12px;font-weight:500;letter-spacing:.13em;text-transform:uppercase;color:var(--pdp-ink);margin:0}
.pdp-proc__step p{font-size:12.5px;color:var(--pdp-charcoal-2);line-height:1.5;margin:5px 0 0}

/* ── usp band ── */
.pdp-uspband{background:var(--pdp-mist);border-top:1px solid var(--pdp-line);overflow:hidden;font-family:var(--pdp-body)}
.pdp-uspband__track{display:flex;width:max-content;animation:pdpUspScroll 44s linear infinite}
.pdp-uspband:hover .pdp-uspband__track{animation-play-state:paused}
.pdp-uspband a{flex:0 0 auto;width:172px;padding:22px 14px;display:flex;flex-direction:column;align-items:center;gap:11px;text-align:center;text-decoration:none}
.pdp-uspband .ico{width:56px;height:56px;border-radius:50%;background:var(--pdp-paper);border:1px solid var(--pdp-line);display:grid;place-items:center;color:var(--pdp-ink);transition:.2s}
.pdp-uspband a:hover .ico{background:var(--pdp-ink);color:#fff;border-color:var(--pdp-ink)}
.pdp-uspband b{font-size:10.5px;font-weight:500;letter-spacing:.13em;text-transform:uppercase;color:var(--pdp-ink);line-height:1.45}
@keyframes pdpUspScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── sticky buy bar ── */
.pdp-stickybuy{position:fixed;left:0;right:0;bottom:0;z-index:70;background:var(--pdp-paper);border-top:1px solid var(--pdp-line);box-shadow:0 -10px 30px -18px rgba(23,19,15,.5);transform:translateY(105%);transition:transform .28s ease;padding:9px var(--pdp-gut);padding-bottom:calc(9px + env(safe-area-inset-bottom));font-family:var(--pdp-body)}
.pdp-stickybuy[data-show="true"]{transform:none}
.pdp-stickybuy__in{max-width:var(--pdp-wrap);margin:0 auto;display:flex;align-items:center;gap:11px}
.pdp-stickybuy img{width:44px;height:44px;object-fit:contain;background:var(--pdp-mist);flex:0 0 auto;padding:3px}
.pdp-stickybuy .txt{flex:1;min-width:0}
.pdp-stickybuy .txt b{display:block;font-size:12.5px;color:var(--pdp-ink);font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pdp-stickybuy .txt span{display:block;font-family:var(--pdp-display);font-size:16px;font-weight:600;color:var(--pdp-ink)}
.pdp-stickybuy .pdp-btn{width:auto;flex:0 0 auto;padding:14px 18px;font-size:11.5px}
@media (min-width:900px){.pdp-stickybuy .txt b{white-space:normal}.pdp-stickybuy .pdp-btn{padding:14px 30px}}

@media (prefers-reduced-motion:reduce){
  .pdp-uspband__track{animation:none;flex-wrap:wrap;width:auto}
  .pdp-stickybuy{transition:none}
}
{% endstyle %}

<nav class="pdp-crumbs" aria-label="Breadcrumb">
  <div class="pdp-wrap">
    <a href="/">Home</a> ›
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> ›
    {%- endif -%}
    <span class="pdp-cur">{{ product.title }}</span>
  </div>
</nav>

<section class="pdp" id="product-{{ product.id }}">
  <div class="pdp-wrap">
    <div class="pdp-cols">

      <!-- ═══════════ GALLERY ═══════════ -->
      <div>
        <div class="pdp-media">
          <div class="pdp-gal">
            <div class="pdp-gal__flags">
              {%- unless current_variant.available -%}
                <span class="pdp-flag">Sold Out</span>
              {%- endunless -%}
              {%- if flag_treatment != blank -%}
                <span class="pdp-flag{% unless current_variant.available %} pdp-flag--out{% endunless %}">{{ flag_treatment }}</span>
              {%- endif -%}
              {%- if mf.cert_lab != blank -%}
                <span class="pdp-flag pdp-flag--out">{{ mf.cert_lab }} certified</span>
              {%- endif -%}
            </div>

            <div class="pdp-gal__acts">
              <button
                class="pdp-gal__act"
                aria-label="Add to wishlist"
                data-wishlist-toggle
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ product.url }}"
                data-product-price="{{ product.price | money }}"
                data-variant-price="{{ current_variant.price }}"
                data-product-image="{{ product.featured_image | image_url: width: 600 }}"
                data-variant-id="{{ current_variant.id }}"
                onclick="event.preventDefault(); WishlistApp.toggle(this)"
              >
                <svg width="17" height="15" viewBox="0 0 21 19" fill="none" aria-hidden="true"><path d="M10.5 17.2S1.5 12 1.5 6.3A4.6 4.6 0 0110.5 4a4.6 4.6 0 019 2.3c0 5.7-9 10.9-9 10.9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              </button>
              <button
                type="button"
                class="pdp-gal__act product-page__compare-btn"
                aria-label="Add to compare"
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ product.url }}"
                data-product-price="{{ product.price | money }}"
                data-product-image="{{ product.featured_image | image_url: width: 600 }}"
                data-variant-id="{{ current_variant.id }}"
                data-product-type="{{ product.type | escape }}"
                data-product-vendor="{{ product.vendor | escape }}"
                data-gem-type="{{ mf.gem_type | default: product.type | escape }}"
                data-gem-origin="{{ mf.origin | escape }}"
                data-gem-weight-carats="{{ mf.weight_carats }}"
                data-gem-weight-ratti="{{ mf.weight_ratti }}"
                data-gem-shape-cut="{{ mf.shape_cut | escape }}"
                data-gem-cutting-style="{{ mf.cutting_style | escape }}"
                data-gem-transparency="{{ mf.transparency | escape }}"
                data-gem-color="{{ mf.color_description | escape }}"
                data-gem-planet="{{ mf.planetary_alignment | escape }}"
                data-gem-cert-lab="{{ mf.cert_lab | escape }}"
                data-gem-cert-number="{{ mf.cert_number | escape }}"
                data-gem-cert-link="{{ mf.cert_link | escape }}"
                data-gem-treatment="{{ mf.treatment_status | escape }}"
                data-gem-dimensions="{{ mf.dimensions | escape }}"
                data-gem-species="{{ mf.gems_title | escape }}"
                onclick="event.preventDefault(); CompareApp.toggle(this)"
              >
                <img src="{{ 'balance.svg' | asset_url }}" alt="" width="16" height="16">
              </button>
              <button class="pdp-gal__act" aria-label="Share" onclick="copyToClipboard(window.location.href, this)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </div>

            {%- comment -%} Slides: product media first, then metafield Vimeo videos {%- endcomment -%}
            {%- assign mf_vids = '' | split: ',' -%}
            {%- if mf.video != blank -%}
              {%- assign mf_vids = mf.video | split: ',' -%}
            {%- endif -%}
            {%- assign slide_total = product.media.size | plus: mf_vids.size -%}

            <div class="pdp-gal__track" id="galTrack-{{ section.id }}">
              {%- if product.media.size > 0 or mf_vids.size > 0 -%}
                {%- for media in product.media -%}
                  <div class="pdp-gal__slide">
                    {%- case media.media_type -%}
                      {%- when 'image' -%}
                        <img
                          src="{{ media | image_url: width: 1000 }}"
                          srcset="{{ media | image_url: width: 480 }} 480w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
                          sizes="(max-width: 899px) 100vw, 44vw"
                          alt="{{ media.alt | default: product.title | escape }}"
                          {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}
                        >
                      {%- when 'external_video' -%}
                        <div class="product-page__video-preview" data-video-type="external"
                          {%- if media.host == 'youtube' %} data-video-url="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1"{% endif -%}
                          {%- if media.host == 'vimeo' %} data-video-url="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&outro=nothing"{% endif -%}
                          onclick="openVideoPopup(this)">
                          <img src="{{ media.preview_image | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }} — video" loading="lazy">
                          <span class="pdp-gal__play" aria-hidden="true"><span><svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                        </div>
                      {%- when 'video' -%}
                        <div class="product-page__video-preview" data-video-type="native" onclick="openVideoPopup(this)">
                          <img src="{{ media.preview_image | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }} — video" loading="lazy">
                          <span class="pdp-gal__play" aria-hidden="true"><span><svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                          <video class="product-page__video-source" style="display:none;" preload="metadata">
                            {%- for source in media.sources -%}
                              <source src="{{ source.url }}" type="{{ source.mime_type }}">
                            {%- endfor -%}
                          </video>
                        </div>
                    {%- endcase -%}
                  </div>
                {%- endfor -%}
                {%- for mf_video_url in mf_vids -%}
                  {%- assign mf_video_url_clean = mf_video_url | strip -%}
                  {%- assign mf_vimeo_id = mf_video_url_clean | split: 'vimeo.com/' | last | split: '?' | first -%}
                  <div class="pdp-gal__slide">
                    <div class="product-page__video-preview" data-video-type="external" data-video-url="https://player.vimeo.com/video/{{ mf_vimeo_id }}?autoplay=1&outro=nothing" onclick="openVideoPopup(this)">
                      <img src="https://vumbnail.com/{{ mf_vimeo_id }}.jpg" alt="{{ product.title | escape }} — video" loading="lazy">
                      <span class="pdp-gal__play" aria-hidden="true"><span><svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="pdp-gal__slide">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1" style="margin:80px auto;display:block;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
            </div>

            {%- if slide_total > 1 -%}
              <div class="pdp-gal__dots" id="galDots-{{ section.id }}" aria-hidden="true">
                {%- for i in (1..slide_total) -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- if slide_total > 1 -%}
            <div class="pdp-thumbs" id="galThumbs-{{ section.id }}">
              {%- for media in product.media -%}
                <button class="pdp-thumb" {% if forloop.first %}aria-current="true"{% endif %} aria-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}">
                  {%- if media.media_type contains 'video' -%}
                    <span class="pdp-thumb__vid"><span><svg width="8" height="9" viewBox="0 0 16 18" fill="#fff"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                  {%- endif -%}
                  <img src="{{ media.preview_image | image_url: width: 120 }}" alt="" loading="lazy">
                </button>
              {%- endfor -%}
              {%- for mf_video_url in mf_vids -%}
                {%- assign mf_video_url_clean = mf_video_url | strip -%}
                {%- assign mf_vimeo_id_t = mf_video_url_clean | split: 'vimeo.com/' | last | split: '?' | first -%}
                <button class="pdp-thumb" aria-label="View video">
                  <span class="pdp-thumb__vid"><span><svg width="8" height="9" viewBox="0 0 16 18" fill="#fff"><path d="M0 0l16 9-16 9z"/></svg></span></span>
                  <img src="https://vumbnail.com/{{ mf_vimeo_id_t }}.jpg" alt="" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Share with a friend (desktop) -->
        <div class="pdp-share pdp-share--desktop">
          <b>Share with a friend</b>
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 16l1.2-3.6A6.8 6.8 0 1116 9a6.9 6.9 0 01-10.4 5.9z" stroke="currentColor" stroke-width="1.2"/><path d="M6.4 6.2c.4-.1.7 0 .9.4l.5 1c.1.3 0 .5-.2.7l-.3.3c.4.9 1.1 1.6 2 2l.3-.4c.2-.2.4-.3.7-.2l1 .5c.3.1.5.5.4.8-.2.7-.9 1.1-1.6 1-2.3-.3-4.1-2.1-4.4-4.4-.1-.7.2-1.4 1-1.7z" fill="currentColor"/></svg>
          </a>
          <a href="https://www.instagram.com/prec.iouscarats" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.2"/><circle cx="9" cy="9" r="3.4" stroke="currentColor" stroke-width="1.2"/><circle cx="13.2" cy="4.8" r="1" fill="currentColor"/></svg>
          </a>
          <a href="mailto:?subject={{ product.title | url_encode }}&body=Check%20out%20this%20gem%3A%20{{ shop.url }}{{ product.url }}" aria-label="Share by email">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="1.5" y="3.5" width="15" height="11" stroke="currentColor" stroke-width="1.2"/><path d="M1.5 4.5L9 10l7.5-5.5" stroke="currentColor" stroke-width="1.2"/></svg>
          </a>
          <button type="button" aria-label="Copy link" onclick="copyShareLink(event)">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7.5 10.5a3 3 0 004.2 0l2.6-2.6a3 3 0 10-4.2-4.2l-.8.8" stroke="currentColor" stroke-width="1.2"/><path d="M10.5 7.5a3 3 0 00-4.2 0L3.7 10a3 3 0 104.2 4.3l.8-.8" stroke="currentColor" stroke-width="1.2"/></svg>
          </button>
        </div>

        <!-- Below Gallery Block Slot -->
        {%- assign _app_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'below_gallery' -%}
            <div class="product-page__custom-block" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
          {%- elsif block.type == '@app' -%}
            {%- assign _app_idx = _app_idx | plus: 1 -%}
            {%- if _app_idx == 1 -%}
              <div class="product-page__custom-block product-page__app-block--gallery" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- ═══════════ BUY COLUMN ═══════════ -->
      <div class="pdp-buy-col">

        <div class="pdp-head">
          {%- if product.vendor -%}<p class="pdp-vendor">{{ product.vendor }}</p>{%- endif -%}
          <h1>{{ product.title }}{%- unless current_variant.available -%}<span class="pdp-soldflag">Sold Out</span>{%- endunless -%}</h1>

          <div class="pdp-metaline">
            {%- if mf.sku_number != blank -%}<span>SKU <b>{{ mf.sku_number }}</b></span>{%- endif -%}
            {%- if mf.origin != blank -%}<span>Origin <b>{{ mf.origin }}</b></span>{%- endif -%}
            {%- if mf.weight_carats != blank -%}<span>Weight <b>{{ mf.weight_carats }} Carat</b></span>{%- endif -%}
          </div>

          <p class="pdp-price">
            {%- if is_request_price -%}
              <b>Price on request</b>
            {%- else -%}
              <b data-pdp-price>{{ current_variant.price | money }}</b>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              <span>(MRP incl. of all taxes)</span>
            {%- endif -%}
          </p>

          {%- if section.settings.payu_merchant_key != blank and is_request_price == false -%}
            <div id="payu-affordability-widget"></div>
          {%- endif -%}

          {%- if mf.tagline != blank or mf.tagline_hindi != blank -%}
            <div class="pdp-tagline">
              {% if mf.tagline %}<p>{{ mf.tagline }}</p>{% endif %}
              {% if mf.tagline_hindi %}<p>{{ mf.tagline_hindi }}</p>{% endif %}
            </div>
          {%- endif -%}
        </div>

        <div class="pdp-buy" id="buyBox-{{ section.id }}">

          {%- if is_purchasable -%}
            <!-- Certification -->
            <div class="pdp-field" style="margin-top:0;">
              <label for="CertificationField-{{ section.id }}">Certification <span class="pdp-req">· Required</span></label>
              <select id="CertificationField-{{ section.id }}" class="pdp-cert-select" onchange="updateCertFee(this)">
                <option value="Free Lab Certificate" data-fee="0" data-days="0">Free Lab Certificate — included</option>
                <option value="Lab Certificate - IIGJ (Extra 5 days)" data-fee="130000" data-days="5">Lab Certificate — IIGJ (extra 5 days) +Rs. 1,300</option>
                <option value="Lab Certificate - IIGJ Origin (Extra 5 days)" data-fee="280000" data-days="5">Lab Certificate — IIGJ Origin (extra 5 days) +Rs. 2,800</option>
                <option value="Lab Certificate - IGI (Extra 10 days)" data-fee="354000" data-days="10">Lab Certificate — IGI (extra 10 days) +Rs. 3,540</option>
              </select>
              <span class="pdp-hint" id="cert-fee-note-{{ section.id }}">Certificate included at no extra cost. Dispatch unaffected.</span>
            </div>
          {%- endif -%}

          <!-- Customization summary chip -->
          <div class="pdp-chip" id="customize-info-bar" style="display:none;">
            <span class="k">Customization selected</span>
            <span class="v" id="customize-summary-text">—</span>
            <button type="button" class="pdp-reset" onclick="CustomizeApp.reset()">Reset</button>
          </div>

          <!-- Below Certification Block Slot -->
          {%- assign _app_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'below_certification' -%}
              <div class="product-page__custom-block" {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </div>
            {%- elsif block.type == '@app' -%}
              {%- assign _app_idx = _app_idx | plus: 1 -%}
              {%- if _app_idx > 1 -%}
                <div class="product-page__custom-block" {{ block.shopify_attributes }}>
                  {%- render block -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          <!-- CTAs -->
          <div class="pdp-actions">
            {%- if current_variant.available == false -%}
              <button type="button" class="pdp-btn pdp-btn--line" disabled>Sold Out</button>
              <a href="https://wa.me/919908190811?text=Hi%2C%20I%20am%20interested%20in%20a%20gemstone%20similar%20to%20{{ product.title | url_encode }}%20which%20is%20sold%20out" class="pdp-soldout-note" target="_blank" rel="noopener">This gemstone has been sold. Contact us on WhatsApp for a similar gem.</a>
            {%- elsif is_request_price -%}
              <a href="https://wa.me/919908190811?text=Hi%2C%20I%20would%20like%20to%20know%20price%20of%20{{ product.title | url_encode }}" class="pdp-btn pdp-btn--solid" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 16l1.2-3.6A6.8 6.8 0 1116 9a6.9 6.9 0 01-10.4 5.9z" stroke="currentColor" stroke-width="1.2"/><path d="M6.4 6.2c.4-.1.7 0 .9.4l.5 1c.1.3 0 .5-.2.7l-.3.3c.4.9 1.1 1.6 2 2l.3-.4c.2-.2.4-.3.7-.2l1 .5c.3.1.5.5.4.8-.2.7-.9 1.1-1.6 1-2.3-.3-4.1-2.1-4.4-4.4-.1-.7.2-1.4 1-1.7z" fill="currentColor"/></svg>
                Request Price
              </a>
            {%- else -%}
              {%- form 'product', product, id: 'pdp-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <div class="pdp-actions" style="margin-top:0;">
                  <button type="submit" class="pdp-btn pdp-btn--solid">Add to cart</button>
                  <div class="pdp-pair">
                    <div class="shopify-payment-button" style="display:contents;">
                      <button type="button" id="flo-buy-now-button" onclick="handleFloBuyNowBtn(event)" class="shopify-payment-button__button shopify-payment-button__button--unbranded" name="flo-buy-now-button">Buy it now</button>
                    </div>
                    <a href="#customise" class="pdp-btn pdp-btn--line" id="pdp-customize-cta" onclick="CustomizeApp.open(event)">Customize</a>
                  </div>
                </div>
              {%- endform -%}
            {%- endif -%}
          </div>

          <!-- Dispatch info -->
          {%- if is_purchasable -%}
            <p class="pdp-dispatch">
              <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7.4" stroke="currentColor" stroke-width="1.2"/><path d="M9 4.6V9l3 1.8" stroke="currentColor" stroke-width="1.2"/></svg>
              <span>Estimated dispatch date: <b id="dispatch-date-{{ section.id }}">&mdash;</b></span>
            </p>
          {%- endif -%}
        </div>

        <!-- ═══════════ CONTENT ACCORDIONS ═══════════ -->
        <div class="pdp-acc">

          <details open>
            <summary>About this Gem</summary>
            <div class="pdp-acc__body">
              {%- if mf.editorial != blank -%}
                <p>{{ mf.editorial | newline_to_br }}</p>
              {%- elsif product.description != blank -%}
                <div class="pdp-desc">{{ product.description }}</div>
              {%- else -%}
                <p>Discover the unique story and origin of this natural {{ gem_type_label }}. Each piece in our collection is handpicked for its exceptional clarity, vibrant color, and sacred energy.</p>
              {%- endif -%}

              <div class="pdp-spec">
                <div class="pdp-spec__row"><span class="k">Gem Type</span><span class="v">{{ mf.gem_type | default: product.type }}</span></div>
                {%- if mf.origin != blank -%}
                  <div class="pdp-spec__row"><span class="k">Origin</span><span class="v">{{ mf.origin }}</span></div>
                {%- endif -%}
                {%- if mf.weight_carats != blank -%}
                  <div class="pdp-spec__row"><span class="k">Weight</span><span class="v">{{ mf.weight_carats }} Carat{% if mf.weight_ratti != blank %} / {{ mf.weight_ratti | times: 1.0 | round: 2 }} Ratti{% endif %}</span></div>
                {%- endif -%}
                {%- if mf.shape_cut != blank or mf.cutting_style != blank -%}
                  <div class="pdp-spec__row"><span class="k">Shape / Cut</span><span class="v">{{ mf.shape_cut }}{% if mf.cutting_style != blank %} ({{ mf.cutting_style }}){% endif %}</span></div>
                {%- endif -%}
                {%- if mf.shape_description != blank -%}
                  <div class="pdp-spec__row"><span class="k">Shape Description</span><span class="v">{{ mf.shape_description }}</span></div>
                {%- endif -%}
                {%- if mf.transparency != blank -%}
                  <div class="pdp-spec__row"><span class="k">Transparency</span><span class="v">{{ mf.transparency }}</span></div>
                {%- endif -%}
                {%- if mf.color_description != blank -%}
                  <div class="pdp-spec__row"><span class="k">Color</span><span class="v">{{ mf.color_description }}</span></div>
                {%- endif -%}
                {%- if mf.cert_lab != blank -%}
                  <div class="pdp-spec__row"><span class="k">Certification</span><span class="v">{{ mf.cert_lab }}{% if mf.cert_number != blank %} : {{ mf.cert_number }}{% endif %}
                    {%- if mf.cert_link != blank -%}
                      <a class="pdp-verify" href="{{ mf.cert_link }}" target="_blank" rel="noopener noreferrer">Verify
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 1h7v7M11 1L3.5 8.5" stroke="currentColor" stroke-width="1.2"/><path d="M8 11H1V4" stroke="currentColor" stroke-width="1.2"/></svg>
                      </a>
                    {%- endif -%}
                  </span></div>
                {%- endif -%}
                {%- if mf.planetary_alignment != blank -%}
                  <div class="pdp-spec__row"><span class="k">Planet</span><span class="v">{{ mf.planetary_alignment }}</span></div>
                {%- endif -%}
                {%- if mf.wow_factor != blank -%}
                  <div class="pdp-spec__row"><span class="k">Special Features</span><span class="v">{{ mf.wow_factor | newline_to_br }}</span></div>
                {%- endif -%}
              </div>
            </div>
          </details>

          <details>
            <summary>Know your gem</summary>
            <div class="pdp-acc__body">
              <div class="pdp-spec" style="margin-top:0;">
                <div class="pdp-spec__row"><span class="k">Species &amp; Variety</span><span class="v">{{ mf.gems_title | default: product.title }}</span></div>
                {%- if mf.refractive_index != blank -%}
                  <div class="pdp-spec__row"><span class="k">Refractive Index (RI)</span><span class="v">{{ mf.refractive_index }}</span></div>
                {%- endif -%}
                {%- if mf.specific_gravity != blank -%}
                  <div class="pdp-spec__row"><span class="k">Specific Gravity (SG)</span><span class="v">{{ mf.specific_gravity }}</span></div>
                {%- endif -%}
                {%- if mf.clarity_description != blank -%}
                  <div class="pdp-spec__row"><span class="k">Internal Characteristics</span><span class="v">{{ mf.clarity_description }}</span></div>
                {%- endif -%}
                {%- if mf.dimensions != blank -%}
                  <div class="pdp-spec__row"><span class="k">Dimensions</span><span class="v">{{ mf.dimensions }} mm</span></div>
                {%- endif -%}
                {%- if mf.origin != blank -%}
                  <div class="pdp-spec__row"><span class="k">Origin</span><span class="v">{{ mf.origin }}</span></div>
                {%- endif -%}
                {%- if mf.treatment_status != blank -%}
                  <div class="pdp-spec__row"><span class="k">Treatment Status</span><span class="v">{{ mf.treatment_status }}</span></div>
                {%- endif -%}
              </div>
            </div>
          </details>

          <details>
            <summary>Planetary Alignment</summary>
            <div class="pdp-acc__body">
              {%- render 'planetary-alignment', product: product -%}
            </div>
          </details>

          {%- comment -%} ── FAQs ── {%- endcomment -%}
          {%- assign faq_gem_type = gem_type_label -%}
          {%- assign faq_cert_lab = mf.cert_lab | default: '' -%}
          {%- assign faq_cert_number = mf.cert_number | default: '' -%}
          {%- assign faq_cert_date = mf.cert_date | default: '' -%}
          {%- assign faq_origin = mf.origin | default: '' -%}
          {%- assign faq_carats = mf.weight_carats | default: 0 -%}
          {%- assign faq_carats_grams = faq_carats | times: 0.2 | round: 3 -%}
          {%- assign faq_dimensions = mf.dimensions | default: '' -%}
          {%- assign faq_shape = mf.shape_cut | default: '' -%}
          {%- assign faq_treatment_raw = mf.treatment_status | default: '' -%}
          {%- assign faq_treatment_label = faq_treatment_raw | downcase -%}

          {%- comment -%} Answers captured once — rendered in the accordion AND emitted as FAQPage JSON-LD {%- endcomment -%}
          {%- capture faq_a1 -%}This {{ faq_gem_type }} is {{ faq_treatment_label }}, as disclosed on the {{ faq_cert_lab }} certificate. Treatment status is permanent and does not change over time.{%- endcapture -%}
          {%- capture faq_a2 -%}This {{ faq_gem_type }} is certified by {{ faq_cert_lab }}{% if faq_cert_number != blank %}, report number {{ faq_cert_number }}{% endif %}{% if faq_cert_date != blank %}, issued on {{ faq_cert_date }}{% endif %}. The full certificate is included with the stone and is available for verification.{%- endcapture -%}
          {%- if faq_origin != blank -%}
            {%- capture faq_a3 -%}A {{ faq_carats }} carat {{ faq_gem_type }}, believed to be of {{ faq_origin }} origin. This origin opinion is based on a combination of our sourcing knowledge, visible features, internal characteristics, and, where available, certifying authority opinion.{%- endcapture -%}
          {%- else -%}
            {%- capture faq_a3 -%}A {{ faq_carats }} carat {{ faq_gem_type }}. Origin has not been tested or cannot be reliably determined for this gemstone. For many gems, origin testing is not always commercially meaningful; we focus instead on accurate disclosure of identity, treatment status, appearance, and certification.{%- endcapture -%}
          {%- endif -%}
          {%- capture faq_a4 -%}This {{ faq_gem_type }} weighs {{ faq_carats }} carats ({{ faq_carats_grams }} grams){% if faq_dimensions != blank %}, with dimensions of {{ faq_dimensions }} mm{% endif %}{% if faq_shape != blank %}, cut in a {{ faq_shape }} shape{% endif %}.{%- endcapture -%}

          {%- assign faq_a5 = '' -%}
          {%- case faq_treatment_raw -%}
            {%- when 'No oil' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically suitable. A no oil emerald is considered the most structurally stable and no treatment has been done on the emerald.' -%}
            {%- when 'Insignificant Oil', 'Minor oil', 'Moderate oil', 'Colourless Oiling Only' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically suitable. Oiling of emeralds is a common trade practice.' -%}
            {%- when 'Minor natural Resin' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically suitable. Columbian emeralds are generally treated with natural resin. The treatment is permanent and does not deteriorate over time. No artificial Polymers are used for this treatment.' -%}
            {%- when 'Unheated and Untreated – No indications of treatment observed' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically acceptable as no treatment of any sort has been done on this gem.' -%}
            {%- when 'Heated', 'Beryllium Treated' -%}
              {%- assign faq_a5 = 'This gem is considered astrologically acceptable. The treatment is permanent and does not deteriorate over time. However, please consult your astrologer once before purchase.' -%}
            {%- when 'Diffusion Treated (Colour surface modification)', 'Glass-Filled (Fracture-filled to improve clarity)', 'Resin-Filled / Dyed', 'Wax Filled' -%}
              {%- assign faq_a5 = 'This gem is generally not considered astrologically suitable and more suited for jewellery purposes. However please consult your astrologer if you wish to buy this gem.' -%}
            {%- when 'Ethiopian Opals' -%}
              {%- assign faq_a5 = 'This gem is generally not suitable for astrological purposes and more suited for jewellery purposes, as ethiopian opals lose their natural colour when exposed to water.' -%}
          {%- endcase -%}

          {%- assign faq_a6 = 'Yes. Every gemstone is photographed and filmed individually. The gemstone shown is the exact gemstone you will receive, matched by SKU, certificate, and internal records. Slight colour or brightness variation may occur due to lighting, camera, or screen settings.' -%}
          {%- assign faq_a7 = 'Yes. Loose gemstones can be returned within 10 days of delivery, subject to inspection and quality check. The gemstone must be in the same condition as received, and must not be worn, altered, damaged, or replaced. The certificate, packaging, and tags must also be returned intact. Customized and made-to-order jewellery is not returnable.' -%}

          <details>
            <summary>Frequently Asked Questions</summary>
            <div class="pdp-acc__body pdp-faq">
              {%- if faq_treatment_raw != blank and faq_cert_lab != blank -%}
                <details><summary>Is this gem treated?</summary><p>{{ faq_a1 }}</p></details>
              {%- endif -%}
              {%- if faq_cert_lab != blank -%}
                <details><summary>Which lab has certified this gem?</summary><p>{{ faq_a2 }}</p></details>
              {%- endif -%}
              <details><summary>Where is this gem from?</summary><p>{{ faq_a3 }}</p></details>
              {%- if faq_carats != 0 and faq_carats != blank -%}
                <details><summary>What is the weight of this gem?</summary><p>{{ faq_a4 }}</p></details>
              {%- endif -%}
              {%- if faq_a5 != '' -%}
                <details><summary>Is this gem astrologically suitable?</summary><p>{{ faq_a5 }}</p></details>
              {%- endif -%}
              <details><summary>Will I get the same gemstone as shown?</summary><p>{{ faq_a6 }}</p></details>
              <details><summary>If I don't like the gemstone after receiving it, can I return it?</summary><p>{{ faq_a7 }}</p></details>
            </div>
          </details>

          {%- if product.price >= 50000000 -%}
            <details>
              <summary>Why this gem is special</summary>
              <div class="pdp-acc__body">
                {%- if mf.wow_factor != blank -%}
                  <p>{{ mf.wow_factor | newline_to_br }}</p>
                {%- else -%}
                  <p>This premium gemstone is among the top 1% of its kind. Its exceptional saturation, rare origin, and master-grade cut make it a truly unique investment and a powerful spiritual tool.</p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        </div>

        <!-- Share with a friend (mobile) -->
        <div class="pdp-share pdp-share--mobile">
          <b>Share with a friend</b>
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 16l1.2-3.6A6.8 6.8 0 1116 9a6.9 6.9 0 01-10.4 5.9z" stroke="currentColor" stroke-width="1.2"/><path d="M6.4 6.2c.4-.1.7 0 .9.4l.5 1c.1.3 0 .5-.2.7l-.3.3c.4.9 1.1 1.6 2 2l.3-.4c.2-.2.4-.3.7-.2l1 .5c.3.1.5.5.4.8-.2.7-.9 1.1-1.6 1-2.3-.3-4.1-2.1-4.4-4.4-.1-.7.2-1.4 1-1.7z" fill="currentColor"/></svg>
          </a>
          <a href="https://www.instagram.com/prec.iouscarats" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.2"/><circle cx="9" cy="9" r="3.4" stroke="currentColor" stroke-width="1.2"/><circle cx="13.2" cy="4.8" r="1" fill="currentColor"/></svg>
          </a>
          <a href="mailto:?subject={{ product.title | url_encode }}&body=Check%20out%20this%20gem%3A%20{{ shop.url }}{{ product.url }}" aria-label="Share by email">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="1.5" y="3.5" width="15" height="11" stroke="currentColor" stroke-width="1.2"/><path d="M1.5 4.5L9 10l7.5-5.5" stroke="currentColor" stroke-width="1.2"/></svg>
          </a>
          <button type="button" aria-label="Copy link" onclick="copyShareLink(event)">
            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7.5 10.5a3 3 0 004.2 0l2.6-2.6a3 3 0 10-4.2-4.2l-.8.8" stroke="currentColor" stroke-width="1.2"/><path d="M10.5 7.5a3 3 0 00-4.2 0L3.7 10a3 3 0 104.2 4.3l.8-.8" stroke="currentColor" stroke-width="1.2"/></svg>
          </button>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- ═══════════ CUSTOMISER (open on-page section) ═══════════ -->
{%- if is_purchasable -%}
{%- assign _custom_gem = mf.gem_type | default: product.type | handleize -%}
<section
  class="pdp-custom"
  id="customise"
  data-product-gem="{{ _custom_gem }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ shop.url }}{{ product.url }}"
>
  <div class="pdp-wrap">
    <h2>Customize Your Jewellery With This Gemstone.</h2>

    <!-- 1. Jewellery type -->
    <div class="pdp-step-label">
      <b>1. Select for ring / pendant / bracelet</b><span class="pdp-req">*</span>
      <button type="button" class="pdp-reset" onclick="CustomizeApp.reset()">Reset</button>
    </div>
    <div class="pdp-forms">
      <button type="button" class="pdp-tile is-active" data-opt="type" data-val="Ring" onclick="CustomizeApp.set('type', 'Ring', this, 0)">
        <img src="{{ 'ring.png' | asset_url }}" alt="" loading="lazy">
        <b>Ring</b>
      </button>
      <button type="button" class="pdp-tile" data-opt="type" data-val="Pendant" onclick="CustomizeApp.set('type', 'Pendant', this, 0)">
        <img src="{{ 'pendant.png' | asset_url }}" alt="" loading="lazy">
        <b>Pendant</b>
      </button>
      <button type="button" class="pdp-tile" data-opt="type" data-val="Bracelet" onclick="CustomizeApp.set('type', 'Bracelet', this, 0)">
        <img src="{{ 'bracelet.png' | asset_url }}" alt="" loading="lazy">
        <b>Bracelet</b>
      </button>
    </div>
    <p class="pdp-selnote">You have selected <b id="selected-type-text">Ring</b>. <button type="button" onclick="CustomizeApp.resetStep('type')">Click here</button> to change your preference — you can opt to have your gemstone in a ring, pendant or a bracelet.</p>
    <p class="pdp-advisory">For gold and platinum jewellery, the displayed amount is an advance payment only. Exact quotation will be shared via WhatsApp.</p>

    <!-- 2. Metal -->
    <div class="pdp-step-label"><b>2. Metal</b><span class="pdp-req">*</span></div>
    <div class="pdp-opts" id="customize-metal-opts">
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Panchdhatu" data-fee="300000" data-flat="0" checked onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Panchdhatu</b><span class="pdp-add">+Rs. 3,000</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Copper" data-fee="300000" data-flat="0" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Copper</b><span class="pdp-add">+Rs. 3,000</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Silver (925)" data-fee="400000" data-flat="0" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Silver (925)</b><span class="pdp-add">+Rs. 4,000</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Gold (14K)" data-fee="0" data-flat="3500000" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Gold (14K)</b><span class="pdp-add">Rs. 35,000 advance</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Gold (18K)" data-fee="0" data-flat="3500000" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Gold (18K)</b><span class="pdp-add">Rs. 35,000 advance</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Gold (22K)" data-fee="0" data-flat="3500000" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Gold (22K)</b><span class="pdp-add">Rs. 35,000 advance</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="White Gold (18K)" data-fee="0" data-flat="3500000" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>White Gold (18K)</b><span class="pdp-add">Rs. 35,000 advance</span></label>
      <label class="pdp-opt"><input type="radio" name="pdp-metal" value="Platinum (950)" data-fee="0" data-flat="3500000" onchange="CustomizeApp.setMetalFromRadio(this)"><span class="pdp-tick" aria-hidden="true"></span><b>Platinum (950)</b><span class="pdp-add">Rs. 35,000 advance</span></label>
    </div>

    <!-- 2b. Wearing for -->
    <div id="customize-gender-step">
      <div class="pdp-step-label"><b>2b. Wearing for</b></div>
      <div class="pdp-pills">
        <button type="button" class="pdp-pill customize-gender-btn is-active" data-gender="female" onclick="CustomizeApp.setGender('female', this)">Female</button>
        <button type="button" class="pdp-pill customize-gender-btn" data-gender="male" onclick="CustomizeApp.setGender('male', this)">Male</button>
      </div>
    </div>

    <!-- 2c. Ring size -->
    <div id="customize-ring-size-step">
      <div class="pdp-step-label"><b>2c. Ring size</b><span class="pdp-req">*</span>
        <button type="button" class="pdp-reset" onclick="openRingSizeChart()" aria-haspopup="dialog">Check your ring size</button>
      </div>
      <div class="pdp-pills" id="ring-size-system-pills">
        <button type="button" class="pdp-pill is-active" data-system="indian" onclick="CustomizeApp.onRingSizeSystemChange('indian', this)">Indian ring size system</button>
        <button type="button" class="pdp-pill" data-system="us" onclick="CustomizeApp.onRingSizeSystemChange('us', this)">US ring size system</button>
        <button type="button" class="pdp-pill" data-system="inner" onclick="CustomizeApp.onRingSizeSystemChange('inner', this)">Inner circumference (mm)</button>
        <button type="button" class="pdp-pill" data-system="later" onclick="CustomizeApp.onRingSizeSystemChange('later', this)">Later / don't know</button>
      </div>

      <div id="modal-ring-size-panel-indian" class="pdp-field">
        <label for="modal-ring-size-indian">Ring size (Indian)</label>
        <select id="modal-ring-size-indian" onchange="CustomizeApp.setRingSize(this.value)">
          <option value="">Select ring size</option>
          {%- for n in (1..40) -%}
            <option value="Indian size {{ n }}">Indian size {{ n }}</option>
          {%- endfor -%}
        </select>
      </div>
      <div id="modal-ring-size-panel-us" class="pdp-field" style="display:none;">
        <label for="modal-ring-size-us">Ring size (US)</label>
        <select id="modal-ring-size-us" onchange="CustomizeApp.setRingSize(this.value)">
          <option value="">Select ring size</option>
          {%- assign us_sizes = "3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8,8.5,9,9.5,10,10.5,11,11.5,12,12.5,13" | split: "," -%}
          {%- for s in us_sizes -%}
            <option value="US size {{ s }}">US size {{ s }}</option>
          {%- endfor -%}
        </select>
      </div>
      <div id="modal-ring-size-panel-inner" class="pdp-field" style="display:none;">
        <label for="modal-ring-size-inner">Inner circumference (mm)</label>
        <input type="number" id="modal-ring-size-inner" min="1" max="999" step="0.1" placeholder="e.g. 54.5" inputmode="decimal" oninput="CustomizeApp.setRingSize(this.value ? this.value + ' mm (inner circ.)' : '')">
      </div>
      <p class="pdp-size-err" id="pdp-ring-size-error">Please select a ring size.</p>
    </div>

    <!-- 2c. Bracelet size (shown for Bracelet) -->
    <div id="customize-bracelet-size-step" style="display:none;">
      <div class="pdp-step-label"><b>2c. Bracelet size</b><span class="pdp-req">*</span></div>
      <div class="pdp-field" style="margin-top:0;">
        <label for="modal-bracelet-size">Bracelet size (inches)</label>
        <select id="modal-bracelet-size" onchange="CustomizeApp.setBraceletSize(this.value)">
          <option value="">Select bracelet size</option>
          {%- assign bracelet_sizes = "5.5,6,6.5,7,7.5,8,8.5,9,9.5,10" | split: "," -%}
          {%- for s in bracelet_sizes -%}
            <option value="{{ s }} inches">{{ s }} inches</option>
          {%- endfor -%}
          <option value="Later / Don't Know">Later / Don't Know</option>
        </select>
      </div>
      <p class="pdp-size-err" id="pdp-bracelet-size-error">Please select a bracelet size.</p>
    </div>

    <!-- 3. Designs -->
    <div id="customize-design-step">
      <div class="pdp-step-label"><b>3. Designs</b></div>
      <div class="customize-design-grid" id="customize-design-grid-dynamic"></div>
