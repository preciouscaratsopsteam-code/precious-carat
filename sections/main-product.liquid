        <span data-pdp-price>{{ current_variant.price | money }}</span>
      {%- endif -%}
    </span>
    {%- if is_request_price -%}
      <a href="https://wa.me/919908190811?text=Hi%2C%20I%20would%20like%20to%20know%20price%20of%20{{ product.title | url_encode }}" class="pdp-btn pdp-btn--solid" target="_blank" rel="noopener">Request price</a>
    {%- else -%}
      <button type="button" class="pdp-btn pdp-btn--solid" onclick="pdpStickyAddToCart(this)">Add to cart</button>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

