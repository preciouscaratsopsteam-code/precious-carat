<script>
  // ═══════════ Gallery: scroll-snap track + thumbs + dots ═══════════
  (function() {
    var track = document.getElementById('galTrack-{{ section.id }}');
    if (!track) return;
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('#galThumbs-{{ section.id }} .pdp-thumb'));
    var dots = Array.prototype.slice.call(document.querySelectorAll('#galDots-{{ section.id }} i'));

    function setActive(i) {
      thumbs.forEach(function(t, k) { t.setAttribute('aria-current', String(k === i)); });
      dots.forEach(function(d, k) { d.classList.toggle('on', k === i); });
      var active = thumbs[i];
      if (active && active.scrollIntoView) {
        active.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    }
    thumbs.forEach(function(t, i) {
      t.addEventListener('click', function() {
        track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
        setActive(i);
      });
    });
    var raf;
    track.addEventListener('scroll', function() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function() {
        setActive(Math.round(track.scrollLeft / track.clientWidth));
      });
    }, { passive: true });
  })();

  // ═══════════ Sticky buy bar ═══════════
  function pdpStickyAddToCart(btn) {
    var form = document.getElementById('pdp-form');
    if (!form) return;
    if (form.requestSubmit) form.requestSubmit();
    else form.submit();
  }
  (function() {
    var buyBox = document.getElementById('buyBox-{{ section.id }}');
    var sticky = document.getElementById('pdp-stickybuy');
    if (!buyBox || !sticky) return;

    function measure() {
      document.documentElement.style.setProperty('--pdp-sticky-h',
        sticky.getAttribute('data-show') === 'true' ? sticky.offsetHeight + 'px' : '0px');
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          // Only show after the buy box has scrolled ABOVE the viewport
          var below = !e.isIntersecting && e.boundingClientRect.top < 0;
          sticky.setAttribute('data-show', String(below));
          measure();
        });
      }, { threshold: 0 }).observe(buyBox);
    }
    window.addEventListener('resize', measure);
  })();

  // ═══════════ Ring size chart modal ═══════════
  function openRingSizeChart() {
    var o = document.getElementById('ring-size-chart-overlay');
    if (o) { o.classList.add('is-open'); o.setAttribute('aria-hidden', 'false'); }
  }
  function closeRingSizeChart() {
    var o = document.getElementById('ring-size-chart-overlay');
    if (o) { o.classList.remove('is-open'); o.setAttribute('aria-hidden', 'true'); }
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeRingSizeChart();
  });

  // ═══════════ Certification fee ═══════════
  function updateCertFee(select) {
    const option = select.options[select.selectedIndex];
    const feeInPaise = parseInt(option.getAttribute('data-fee')) || 0;
    const days = parseInt(option.getAttribute('data-days')) || 0;
    const note = document.getElementById('cert-fee-note-{{ section.id }}');

    if (note) {
      if (feeInPaise > 0) {
        note.textContent = 'Adds Rs. ' + (feeInPaise / 100).toLocaleString('en-IN') + ' and ' + days + ' days to dispatch.';
      } else {
        note.textContent = 'Certificate included at no extra cost. Dispatch unaffected.';
      }
    }

    CustomizeApp.state.certFee = feeInPaise;
    CustomizeApp.updateTotalPrice();
    updateDispatchDate();
  }

  // ---- Estimated dispatch date ----
  // Rules: T = today.
  //   Normal order            -> T + 1
  //   Any customisation       -> T + 4
  //   Any gold customisation  -> T + 5
  //   Certificate selected    -> adds the certificate's stated extra days
  function getCertExtraDays() {
    const sel = document.getElementById('CertificationField-{{ section.id }}');
    if (!sel || sel.selectedIndex < 0) return 0;
    const opt = sel.options[sel.selectedIndex];
    return parseInt(opt && opt.getAttribute('data-days')) || 0;
  }

  function updateDispatchDate() {
    const el = document.getElementById('dispatch-date-{{ section.id }}');
    if (!el) return;
    const st = CustomizeApp.state;

    let baseDays = 1;
    if (st.customized) {
      const isGold = /gold/i.test(st.metal || '');
      baseDays = isGold ? 5 : 4;
    }

    const totalDays = baseDays + getCertExtraDays();
    const d = new Date();
    d.setDate(d.getDate() + totalDays);
    el.textContent = d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  document.addEventListener('DOMContentLoaded', updateDispatchDate);

  // The page-level ring-sizing widget was removed; ring sizes are captured in
  // the customizer. These stubs keep the cart interceptor and the Shopflo
  // Buy-It-Now wrapper (below) working unchanged.
  window.getProductRingSizingCartProperties = function() { return {}; };
  window.validateProductRingSizing = function() { return true; };
  window.syncProductRingSizingToProductForms = function() {};

  // Wrap Shopflo's Buy It Now so the fee reconciler attaches the customization
  // fee line before the customer finishes paying in the overlay.
  document.addEventListener('DOMContentLoaded', function() {
    var tries = 0;
    var timer = setInterval(function() {
      tries++;
      if (typeof window.handleFloBuyNowBtn === 'function' && !window.__pcFloBuyNowWrapped) {
        window.__pcFloBuyNowWrapped = true;
        clearInterval(timer);
        var orig = window.handleFloBuyNowBtn;
        window.handleFloBuyNowBtn = function(ev) {
          if (window.PCFeeReconcile) {
            [2000, 5000, 10000].forEach(function(delay) {
              setTimeout(function() { window.PCFeeReconcile(); }, delay);
            });
          }
          return orig.apply(this, arguments);
        };
      }
      if (tries > 50) clearInterval(timer);
    }, 200);
  });

  // ═══════════ Add to Cart interceptor: properties + fee product line ═══════════
  document.addEventListener('DOMContentLoaded', function() {
    const productForms = document.querySelectorAll('form[action^="/cart/add"]');

    productForms.forEach(form => {
      form.addEventListener('submit', function(e) {
        const certSelect = document.getElementById('CertificationField-{{ section.id }}');
        const certVal = certSelect ? certSelect.value : 'None';

        if (e.cancelable) e.preventDefault();
        const itemsToCart = [];

        const variantIdInput = form.querySelector('[name="id"]');
        if (!variantIdInput) return;

        // Fees mirror confirm(): only confirmed customizations count, flat
        // "advance" metals (gold/platinum) take precedence over per-metal fees.
        const st = CustomizeApp.state;
        const confirmedMetalFee = st.customized
          ? (st.confMetalFlat > 0 ? st.confMetalFlat : st.confMetalFee)
          : 0;
        const totalFeeRaw = confirmedMetalFee + (st.customized ? st.confStyleFee : 0) + st.certFee;

        const itemProperties = {
          {% if mf.weight_carats != blank %}
          'Weight': '{{ mf.weight_carats | escape }} Carat',
          {% elsif mf.weight_ratti != blank %}
          'Weight (Ratti)': '{{ mf.weight_ratti | times: 1.0 | round: 2 | escape }} Ratti',
          {% endif %}
          'Origin': '{{ mf.origin | default: "Ceylon / Sri Lanka" | escape }}',
          'Gem Type': '{{ mf.gem_type | default: product.type | escape }}',
          'Certification': certVal,
          '_certification_lab': '{{ mf.cert_lab | escape }}',
          'Shape / Cut': '{{ mf.shape_cut | escape }}',
          'Treatment': '{{ mf.treatment_status | escape }}',
          '_customization_fee_raw': totalFeeRaw,
          '_master_id': Date.now()
        };

        if (st.customized) {
          itemProperties['Jewelry Type'] = st.type || 'None';
          itemProperties['Metal'] = st.metal || 'None';
          itemProperties['Style'] = st.style || 'None';
          if (st.ringSize) itemProperties['Ring Size'] = st.ringSize;
          if (st.braceletSize) itemProperties['Bracelet Size'] = st.braceletSize;
        }
        if (totalFeeRaw > 0) {
          itemProperties['Customization Fee'] = 'Rs. ' + (totalFeeRaw / 100).toLocaleString('en-IN');
        }

        itemsToCart.push({
          id: variantIdInput.value,
          quantity: 1,
          properties: itemProperties
        });

        {% assign fee_cfg_product = section.settings.fee_product | default: settings.fee_product %}
        {% assign fee_variant = fee_cfg_product.selected_or_first_available_variant %}
        /* Fee product line — the only way the fee is actually charged at
           checkout. Quantity = fee / fee-product unit price, linked to the gem
           via _master_id so removing the gem also removes its fee. No Liquid
           whitespace trimming here: a trimming tag glues the next JS line onto
           the preceding one — with a // comment above, the const vanished into
           it and every submit threw ReferenceError. */
        const FEE_VARIANT_ID = {{ fee_variant.id | default: 'null' }};
        const FEE_UNIT_PAISE = {{ fee_variant.price | default: 0 }};
        if (FEE_VARIANT_ID && FEE_UNIT_PAISE > 0 && totalFeeRaw > 0) {
          const feeQty = Math.round(totalFeeRaw / FEE_UNIT_PAISE);
          if (feeQty > 0) {
            itemsToCart.push({
              id: FEE_VARIANT_ID,
              quantity: feeQty,
              properties: {
                'For': {{ product.title | json }},
                '_fee_line': 'yes',
                '_master_id': itemProperties['_master_id']
              }
            });
          }
        }

        const isBuyNow = e.submitter && (e.submitter.hasAttribute('data-buy-now') || e.submitter.name === 'checkout');

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsToCart })
        })
        .then(res => {
          if (res.ok) return res.json();
          // A rejected fee line (unavailable fee product, sold-out oversell)
          // must not block the gem sale — retry with the gem alone.
          if (itemsToCart.length > 1) {
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [itemsToCart[0]] })
            }).then(res2 => {
              if (!res2.ok) throw new Error('cart add failed: ' + res2.status);
              return res2.json();
            });
          }
          throw new Error('cart add failed: ' + res.status);
        })
        .then(() => {
          const btn = form.querySelector('button[type="submit"]');
          if (btn && !isBuyNow) {
            const originalText = btn.innerHTML;
            btn.innerHTML = '✓ Added to cart';
            btn.style.backgroundColor = '#27ae60';
            btn.style.borderColor = '#27ae60';
            setTimeout(() => {
              btn.innerHTML = originalText;
              btn.style.backgroundColor = '';
              btn.style.borderColor = '';
              window.location.href = '/cart';
            }, 1000);
          } else {
            window.location.href = isBuyNow ? '/checkout' : '/cart';
          }
        })
        .catch(err => {
          console.error("Cart Error:", err);
          form.submit();
        });
      });
    });
  });

  // ── Ring design discovery: dynamic CDN probing ────────────────────
  // Files follow: ring_{metal}_{gender}_{gem}_{PREFIX}{nn}_{VIEW}.{ext}
  // PREFIX encodes metal+gender so the store admin can upload new designs
  // and they appear automatically without any data-file updates.
  const METAL_GENDER_PREFIX = {
    'copper|female':     'COFL', 'copper|male':      'COML',
    'gold|female':       'GLFL', 'gold|male':        'GLML',
    'panchdhatu|female': 'PDFL', 'panchdhatu|male':  'PDML',
    'platinum|female':   'PLFL', 'platinum|male':    'PLML',
    'silver|female':     'SLFL', 'silver|male':      'SLML',
    'white-gold|female': 'WGFL', 'white-gold|male':  'WGML',
  };
  // white-gold filenames are inconsistent across old uploads; try all variants
  const WHITE_GOLD_VARIANTS = ['white-gold', 'whitegold', 'white_gold'];
  const RING_EXTS = ['webp', 'jpeg', 'jpg', 'png'];
  var _rcCache = {};

  function _headOk(url) {
    return fetch(url, { method: 'HEAD' }).then(function(r) { return r.ok; }).catch(function() { return false; });
  }

  // Probe one view for a given design, trying all ext variants in parallel.
  function _probeView(base, metal, gender, gem, code, view) {
    var metals = metal === 'white-gold' ? WHITE_GOLD_VARIANTS : [metal];
    var candidates = [];
    metals.forEach(function(m) {
      RING_EXTS.forEach(function(ext) {
        candidates.push('ring_' + m + '_' + gender + '_' + gem + '_' + code + '_' + view + '.' + ext);
      });
    });
    return Promise.all(candidates.map(function(fname) {
      return _headOk(base + fname).then(function(ok) { return ok ? fname : null; });
    })).then(function(results) {
      return results.find(function(r) { return r !== null; }) || null;
    });
  }

  // Main probe function: discovers all designs for a metal/gender/gem combo.
  // Results are sessionStorage-cached so repeat lookups are instant.
  function probeRingDesigns(metal, gender, gem, base, onDone) {
    var key = 'rc:' + metal + '|' + gender + '|' + gem;
    if (_rcCache[key]) { onDone(_rcCache[key]); return; }
    try {
      var stored = sessionStorage.getItem(key);
      if (stored) { _rcCache[key] = JSON.parse(stored); onDone(_rcCache[key]); return; }
    } catch(e) {}

    var prefix = METAL_GENDER_PREFIX[metal + '|' + gender];
    if (!prefix) { onDone([]); return; }

    // Probe each design's views. A design counts as present if ANY view
    // exists. We accept BOTH design-code styles: {PREFIX}{nn} or D{n}.
    // Views tried, in display order: F (front), T (top), B (back), L (left).
    var RING_VIEWS = ['F', 'T', 'B', 'L'];
    var BATCH = 8, MAX = 120, found = [];
    function probeDesign(id) {
      var codes = [prefix + String(id).padStart(2, '0'), 'D' + id, String(id)];
      return Promise.all(RING_VIEWS.map(function(view) {
        return Promise.all(codes.map(function(code) {
          return _probeView(base, metal, gender, gem, code, view);
        })).then(function(hits) { return hits.find(Boolean) || null; });
      })).then(function(views) {
        var files = views.filter(Boolean);
        return files.length ? { id: String(id), files: files } : null;
      });
    }
    function nextBatch(start) {
      var probes = [];
      for (var i = start; i < start + BATCH && i <= MAX; i++) probes.push(probeDesign(i));
      Promise.all(probes).then(function(hits) {
        hits = hits.filter(Boolean);
        found = found.concat(hits);
        if (hits.length > 0 && start + BATCH <= MAX) {
          nextBatch(start + BATCH);
        } else {
          found.sort(function(a, b) { return parseInt(a.id) - parseInt(b.id); });
          // Only cache non-empty results, so newly-uploaded designs appear on
          // the next navigation instead of being masked by a cached "empty".
          if (found.length) {
            _rcCache[key] = found;
            try { sessionStorage.setItem(key, JSON.stringify(found)); } catch(e) {}
          }
          onDone(found);
        }
      });
    }
    nextBatch(1);
  }

  // ── Pendant design discovery: dynamic CDN probing ─────────────────
  // Files follow: pendant_{metal}_{gem}_{PREFIX}{nn}.{ext}, numbered
  // contiguously from 01. One image per design (no F/T/B views).
  const PENDANT_METAL_PREFIX = {
    copper:     'CO', gold:        'GL', silver:     'SL',
    platinum:   'PL', 'white-gold': 'WG', panchdhatu: 'PN',
  };
  const PENDANT_EXTS = ['webp', 'jpeg', 'jpg', 'png'];

  function _probePendant(base, metal, gem, prefix, id) {
    var codes = [prefix + String(id).padStart(2, '0'), 'D' + id, String(id)];
    var candidates = [];
    codes.forEach(function(code) {
      PENDANT_EXTS.forEach(function(ext) {
        candidates.push('pendant_' + metal + '_' + gem + '_' + code + '.' + ext);
      });
    });
    return Promise.all(candidates.map(function(fname) {
      return _headOk(base + fname).then(function(ok) { return ok ? fname : null; });
    })).then(function(results) {
      return results.find(function(r) { return r !== null; }) || null;
    });
  }

  function probePendantDesigns(metal, gem, base, onDone) {
    var key = 'pc:' + metal + '|' + gem;
    if (_rcCache[key]) { onDone(_rcCache[key]); return; }
    try {
      var stored = sessionStorage.getItem(key);
      if (stored) { _rcCache[key] = JSON.parse(stored); onDone(_rcCache[key]); return; }
    } catch(e) {}

    var prefix = PENDANT_METAL_PREFIX[metal];
    if (!prefix) { onDone([]); return; }

    var BATCH = 12, MAX = 120, found = [];
    function nextBatch(start) {
      var probes = [];
      for (var i = start; i < start + BATCH && i <= MAX; i++) {
        probes.push((function(id) {
          return _probePendant(base, metal, gem, prefix, id).then(function(f) {
            return f ? { id: id, file: f } : null;
          });
        })(i));
      }
      Promise.all(probes).then(function(hits) {
        hits = hits.filter(Boolean);
        found = found.concat(hits);
        if (hits.length > 0 && start + BATCH <= MAX) {
          nextBatch(start + BATCH);
        } else {
          found.sort(function(a, b) { return a.id - b.id; });
          var files = found.map(function(h) { return h.file; });
          if (files.length) {
            _rcCache[key] = files;
            try { sessionStorage.setItem(key, JSON.stringify(files)); } catch(e) {}
          }
          onDone(files);
        }
      });
    }
    nextBatch(1);
  }

  // ── Bracelet design discovery: dynamic CDN probing ────────────────
  // Files follow: bracelet_{metal}_{gender}_{gem}_{PREFIX}{nn}.webp.
  // Design ids are NOT contiguous, so we always scan the whole 1..MAX range.
  const BRACELET_METAL_PREFIX = {
    copper:     'CO', gold:        'GL', silver:     'SL',
    platinum:   'PL', 'white-gold': 'WG', panchdhatu: 'PD',
  };
  // bracelet filenames use "whitegold" (no hyphen), unlike ring files
  const BRACELET_METAL_SLUG = { 'white-gold': 'whitegold' };

  function _probeBracelet(base, metalSlug, gender, gem, codes, id) {
    var candidates = codes.map(function(code) {
      return 'bracelet_' + metalSlug + '_' + gender + '_' + gem + '_' + code + String(id).padStart(2, '0') + '.webp';
    });
    return Promise.all(candidates.map(function(fname) {
      return _headOk(base + fname).then(function(ok) { return ok ? fname : null; });
    })).then(function(results) {
      return results.find(function(r) { return r !== null; }) || null;
    });
  }

  function probeBraceletDesigns(metal, gender, gem, base, onDone) {
    var key = 'bc:' + metal + '|' + gender + '|' + gem;
    if (_rcCache[key]) { onDone(_rcCache[key]); return; }
    try {
      var stored = sessionStorage.getItem(key);
      if (stored) { _rcCache[key] = JSON.parse(stored); onDone(_rcCache[key]); return; }
    } catch(e) {}

    var prefix = BRACELET_METAL_PREFIX[metal];
    if (!prefix) { onDone([]); return; }
    var metalSlug = BRACELET_METAL_SLUG[metal] || metal;
    // a chunk of panchdhatu files use a lowercase "pd" design code
    var codes = metal === 'panchdhatu' ? [prefix, prefix.toLowerCase()] : [prefix];

    var BATCH = 15, MAX = 99, found = [];
    function nextBatch(start) {
      var probes = [];
      for (var i = start; i < start + BATCH && i <= MAX; i++) {
        probes.push((function(id) {
          return _probeBracelet(base, metalSlug, gender, gem, codes, id).then(function(f) {
            return f ? { id: id, file: f } : null;
          });
        })(i));
      }
      Promise.all(probes).then(function(hits) {
        found = found.concat(hits.filter(Boolean));
        if (start + BATCH <= MAX) {
          nextBatch(start + BATCH);   // ids are sparse — no early stop
        } else {
          found.sort(function(a, b) { return a.id - b.id; });
          if (found.length) {
            _rcCache[key] = found;
            try { sessionStorage.setItem(key, JSON.stringify(found)); } catch(e) {}
          }
          onDone(found);
        }
      });
    }
    nextBatch(1);
  }

  // Metal value → asset key
  const METAL_TO_FOLDER = {
    'Panchdhatu':            'panchdhatu',
    'Copper':                'copper',
    'Silver (925)':          'silver',
    'Platinum (950)':        'platinum',
    'White Gold (18K)':      'white-gold',
    'Gold (14K)':            'gold',
    'Gold (18K)':            'gold',
    'Gold (22K)':            'gold'
  };

  // ═══════════ CustomizeApp — inline on-page customizer ═══════════
  const CustomizeApp = {
    basePrice: {{ product.price }},
    _assetBase: null,
    _inited: false,
    state: {
      type: 'Ring',
      gender: 'female',
      metal: 'Panchdhatu',
      style: 'None',
      ringSize: '',
      braceletSize: '',
      customized: false,
      certFee: 0,
      metalFee: 0,
      metalFlat: 0,
      styleFee: 0,
      // Snapshot of the fees locked in at "Confirm" time. The page price is
      // computed ONLY from these (plus the page-level certFee), so selecting
      // options never moves the price until confirmed.
      confMetalFee: 0,
      confMetalFlat: 0,
      confStyleFee: 0
    },

    root: function() {
      return document.getElementById('customise');
    },

    getAssetBase: function() {
      if (!this._assetBase) {
        const known = '{{ "ring_gold_female_blue-sapphire_D1_1.jpeg" | asset_url }}';
        this._assetBase = known.split('?')[0].replace('ring_gold_female_blue-sapphire_D1_1.jpeg', '');
      }
      return this._assetBase;
    },

    _flagSizeError: function(stepId, errId, msg) {
      var step = document.getElementById(stepId);
      if (step) {
        step.scrollIntoView({ behavior: 'smooth', block: 'center' });
        step.style.outline = '2px solid #c94a4a';
        step.style.outlineOffset = '6px';
        setTimeout(function() { step.style.outline = ''; step.style.outlineOffset = ''; }, 2500);
      }
      var err = document.getElementById(errId);
      if (err) {
        err.style.display = 'block';
        setTimeout(function() { err.style.display = 'none'; }, 4000);
      } else if (msg) {
        alert(msg);
      }
    },

    whatsapp: function(e, intro) {
      if (e) e.preventDefault();
      var s = this.state;
      if (s.type === 'Ring' && !s.ringSize) {
        this._flagSizeError('customize-ring-size-step', 'pdp-ring-size-error', 'Please select a Ring Size before sending to WhatsApp.');
        return;
      }
      if (s.type === 'Bracelet' && !s.braceletSize) {
        this._flagSizeError('customize-bracelet-size-step', 'pdp-bracelet-size-error', 'Please select a Bracelet Size before sending to WhatsApp.');
        return;
      }
      var root = this.root();
      var lines = [intro || 'Hi, I want this design'];
      if (root && root.dataset.productTitle) lines.push('Product: ' + root.dataset.productTitle);
      if (s.type) lines.push('Type: ' + s.type);
      if (s.metal) lines.push('Metal: ' + s.metal);
      if (s.gender) lines.push('Wearing for: ' + s.gender);
      if (s.style && s.style !== 'None') lines.push('Design: ' + s.style);
      if (s.ringSize) lines.push('Ring size: ' + s.ringSize);
      if (s.braceletSize) lines.push('Bracelet size: ' + s.braceletSize);
      if (root && root.dataset.productUrl) lines.push(root.dataset.productUrl);
      var url = 'https://wa.me/919908190811?text=' + encodeURIComponent(lines.join('\n'));
      window.open(url, '_blank', 'noopener');
    },

    showOwnDesign: function() {
      var panel = document.getElementById('own-design-panel');
      if (!panel) return;
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      var phone = document.getElementById('odp-phone');
      if (phone) setTimeout(function() { phone.focus({ preventScroll: true }); }, 400);
    },

    closeOwnDesign: function() {},

    previewOwnDesign: function(input) {
      var file = input.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(e) {
        var img = document.getElementById('odp-preview');
        var box = document.getElementById('odp-preview-box');
        if (img) img.src = e.target.result;
        if (box) box.style.display = 'block';
      };
      reader.readAsDataURL(file);
    },

    _uploadToImgBB: async function(file) {
      var base64 = await new Promise(function(res, rej) {
        var r = new FileReader();
        r.onload = function() { res(r.result.split(',')[1]); };
        r.onerror = rej;
        r.readAsDataURL(file);
      });
      var form = new FormData();
      form.append('key', '4a8c5c3eab96a1de8a5f90e1e8bb6bfa');
      form.append('image', base64);
      var resp = await fetch('https://api.imgbb.com/1/upload', { method: 'POST', body: form });
      var data = await resp.json();
      if (!data.success) throw new Error('Image upload failed: ' + (data.error && data.error.message || 'unknown error'));
      return data.data.url;
    },

    _setOdpStatus: function(msg, type) {
      var el = document.getElementById('odp-status');
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';
      el.className = 'odp-status odp-status--' + (type || 'info');
    },

    sendOwnDesign: async function() {
      var WORKER_URL = 'https://YOUR-WORKER-NAME.workers.dev'; // ← replace after deploying worker
      var phone   = (document.getElementById('odp-phone')   || {}).value.trim();
      var fileEl  = document.getElementById('odp-file');
      var file    = fileEl && fileEl.files[0];
      var note    = (document.getElementById('odp-caption') || {}).value.trim();
      var btn     = document.getElementById('odp-send-btn');

      if (!phone || phone.length < 10) {
        this._setOdpStatus('Please enter a valid WhatsApp number with country code.', 'error');
        return;
      }
      if (this.state.type === 'Ring' && !this.state.ringSize) {
        this._setOdpStatus('Please select a Ring Size before sending.', 'error');
        this._flagSizeError('customize-ring-size-step', 'pdp-ring-size-error');
        return;
      }
      if (!file) {
        this._setOdpStatus('Please select a design image to upload.', 'error');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        this._setOdpStatus('Image too large — maximum 5 MB.', 'error');
        return;
      }

      if (btn) btn.disabled = true;
      this._setOdpStatus('Uploading your design image...', 'info');

      try {
        var imageUrl = await this._uploadToImgBB(file);
        this._setOdpStatus('Sending to WhatsApp...', 'info');

        var root = this.root();
        var s = this.state;
        var parts = [note || 'Custom design enquiry from Precious Carats'];
        if (root && root.dataset.productTitle) parts.push('Product: ' + root.dataset.productTitle);
        if (s.metal) parts.push('Metal: ' + s.metal);
        if (s.gender) parts.push('For: ' + s.gender);
        if (s.ringSize) parts.push('Ring size: ' + s.ringSize);
        var caption = parts.join(' | ');

        var resp = await fetch(WORKER_URL + '/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone: phone, imageUrl: imageUrl, caption: caption })
        });
        var data = await resp.json();

        if (data.status === 'submitted' || data.messageId) {
          this._setOdpStatus('Your design was sent! Check your WhatsApp.', 'success');
          if (fileEl) fileEl.value = '';
          var pb = document.getElementById('odp-preview-box');
          if (pb) pb.style.display = 'none';
        } else {
          throw new Error(data.message || JSON.stringify(data));
        }
      } catch(err) {
        this._setOdpStatus('Error: ' + err.message, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    },

    // Reads the currently-selected metal option (radio cards).
    getMetalOption: function() {
      return document.querySelector('#customize-metal-opts input[name="pdp-metal"]:checked');
    },

    setMetalFromRadio: function(input) {
      this.set('metal', input.value, input.closest('.pdp-opt'), input.dataset.fee, input.dataset.flat);
    },

    syncMetalFromChecked: function() {
      const opt = this.getMetalOption();
      if (!opt) return;
      this.state.metal = opt.value;
      this.state.metalFee = parseInt(opt.dataset.fee) || 0;
      this.state.metalFlat = parseInt(opt.dataset.flat) || 0;
    },

    renderDesigns: function() {
      const grid = document.getElementById('customize-design-grid-dynamic');
      const emptyEl = document.getElementById('customize-design-empty');
      if (!grid) return;

      const root = this.root();
      const gem = (root && root.dataset.productGem) || 'blue-sapphire';
      const gender = this.state.gender;
      const metalKey = METAL_TO_FOLDER[this.state.metal] || 'panchdhatu';
      const isPendant = this.state.type === 'Pendant';
      const isBracelet = this.state.type === 'Bracelet';

      // Guard against stale async probe callbacks: every render bumps this
      // sequence number; a probe that resolves after the user changed
      // type/metal/gem is ignored.
      var seq = (this._renderSeq = (this._renderSeq || 0) + 1);

      grid.innerHTML = '';
      this.state.style = 'None';
      this.state.styleFee = 0;

      const base = this.getAssetBase();

      // Price of the currently selected metal — shown beside every design.
      var metalPrice = '';
      var mOpt = this.getMetalOption();
      if (mOpt) {
        var mFlat = parseInt(mOpt.dataset.flat) || 0;
        var mFee = parseInt(mOpt.dataset.fee) || 0;
        if (mFlat > 0) metalPrice = 'Rs. ' + (mFlat / 100).toLocaleString('en-IN') + ' advance';
        else if (mFee > 0) metalPrice = '+Rs. ' + (mFee / 100).toLocaleString('en-IN');
      }

      if (isPendant) {
        grid.innerHTML = '<p class="customize-design-loading" style="padding:16px;color:#888;font-size:13px;">Loading designs…</p>';
        if (emptyEl) emptyEl.style.display = 'none';

        probePendantDesigns(metalKey, gem, base, function(pendantFiles) {
          if (seq !== CustomizeApp._renderSeq) return;   // stale probe — user moved on
          grid.innerHTML = '';

          if (!pendantFiles.length) {
            if (emptyEl) { emptyEl.textContent = 'No pendant designs available for this combination.'; emptyEl.style.display = ''; }
            return;
          }
          if (emptyEl) emptyEl.style.display = 'none';

          pendantFiles.forEach(function(fname, idx) {
            var label = 'Design ' + (idx + 1);

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'customize-design-card';
            btn.setAttribute('data-opt', 'style');
            btn.setAttribute('data-val', label);

            btn.innerHTML =
              '<div class="customize-design-card__img">' +
                '<img src="' + base + fname + '" alt="' + label + '" loading="lazy">' +
              '</div>' +
              '<span class="customize-design-card__label">' + label + '</span>' +
              (metalPrice ? '<span class="customize-design-card__metal-price">' + metalPrice + '</span>' : '');

            btn.addEventListener('click', function() {
              CustomizeApp.set('style', label, btn, 0);
            });
            grid.appendChild(btn);
          });
        });

      } else if (isBracelet) {
        grid.innerHTML = '<p class="customize-design-loading" style="padding:16px;color:#888;font-size:13px;">Loading designs…</p>';
        if (emptyEl) emptyEl.style.display = 'none';

        probeBraceletDesigns(metalKey, gender, gem, base, function(designs) {
          if (seq !== CustomizeApp._renderSeq) return;   // stale probe — user moved on
          grid.innerHTML = '';

          if (!designs.length) {
            if (emptyEl) { emptyEl.textContent = 'No bracelet designs available for this combination.'; emptyEl.style.display = ''; }
            return;
          }
          if (emptyEl) emptyEl.style.display = 'none';

          designs.forEach(function(design) {
            var label = 'Design ' + design.id;

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'customize-design-card';
            btn.setAttribute('data-opt', 'style');
            btn.setAttribute('data-val', label);

            btn.innerHTML =
              '<div class="customize-design-card__img">' +
                '<img src="' + base + design.file + '" alt="' + label + '" loading="lazy">' +
              '</div>' +
              '<span class="customize-design-card__label">' + label + '</span>' +
              (metalPrice ? '<span class="customize-design-card__metal-price">' + metalPrice + '</span>' : '');

            btn.addEventListener('click', function() {
              CustomizeApp.set('style', label, btn, 0);
            });
            grid.appendChild(btn);
          });
        });

      } else {
        grid.innerHTML = '<p class="customize-design-loading" style="padding:16px;color:#888;font-size:13px;">Loading designs…</p>';
        if (emptyEl) emptyEl.style.display = 'none';

        probeRingDesigns(metalKey, gender, gem, base, function(designs) {
          if (seq !== CustomizeApp._renderSeq) return;   // stale probe — user moved on
          grid.innerHTML = '';

          if (!designs.length) {
            if (emptyEl) { emptyEl.textContent = 'No ring designs available for this combination.'; emptyEl.style.display = ''; }
          } else {
            if (emptyEl) emptyEl.style.display = 'none';

            designs.forEach(function(design) {
              var id = design.id;
              var files = design.files;
              var label = 'Design ' + id;

              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'customize-design-card';
              btn.setAttribute('data-opt', 'style');
              btn.setAttribute('data-val', label);

              var slides = files.map(function(fname, i) {
                return '<div class="cdc-slide"><img src="' + base + fname + '" alt="' + label + ' view ' + (i+1) + '" loading="lazy"></div>';
              }).join('');

              var dots = files.length > 1 ? files.map(function(_, i) {
                return '<button class="cdc-dot' + (i === 0 ? ' is-active' : '') + '" data-idx="' + i + '" type="button"></button>';
              }).join('') : '';

              var prevBtn = files.length > 1
                ? '<button class="cdc-nav cdc-nav--prev" type="button" aria-label="Previous"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>'
                : '';
              var nextBtn = files.length > 1
                ? '<button class="cdc-nav cdc-nav--next" type="button" aria-label="Next"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>'
                : '';

              btn.innerHTML =
                '<div class="customize-design-card__img cdc-carousel">' +
                  '<div class="cdc-track">' + slides + '</div>' +
                  prevBtn + nextBtn +
                  (dots ? '<div class="cdc-dots">' + dots + '</div>' : '') +
                '</div>' +
                '<span class="customize-design-card__label">' + label + '</span>' +
                (metalPrice ? '<span class="customize-design-card__metal-price">' + metalPrice + '</span>' : '');

              if (files.length > 1) {
                (function(fileCount) {
                  var cur = 0;
                  var track = btn.querySelector('.cdc-track');
                  var dotEls = btn.querySelectorAll('.cdc-dot');
                  function goTo(idx) {
                    cur = (idx + fileCount) % fileCount;
                    track.style.transform = 'translateX(-' + (cur * 100) + '%)';
                    dotEls.forEach(function(d, i) { d.classList.toggle('is-active', i === cur); });
                  }
                  btn.querySelector('.cdc-nav--prev').addEventListener('click', function(e) { e.stopPropagation(); goTo(cur - 1); });
                  btn.querySelector('.cdc-nav--next').addEventListener('click', function(e) { e.stopPropagation(); goTo(cur + 1); });
                  dotEls.forEach(function(d) {
                    d.addEventListener('click', function(e) { e.stopPropagation(); goTo(parseInt(d.dataset.idx)); });
                  });
                })(files.length);
              }

              btn.addEventListener('click', function() {
                CustomizeApp.set('style', label, btn, 0);
              });
              grid.appendChild(btn);
            });
          }

          // "Add my own design" card — always last
          var addCard = document.createElement('button');
          addCard.type = 'button';
          addCard.className = 'customize-design-card customize-design-card--add';
          addCard.innerHTML =
            '<div class="customize-design-card__img cdc-add">' +
              '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>' +
            '</div>' +
            '<span class="customize-design-card__label">Add my own design</span>';
          addCard.addEventListener('click', function() { CustomizeApp.showOwnDesign(); });
          grid.appendChild(addCard);
        });
        return; // grid is populated asynchronously above
      }
    },

    setGender: function(gender, el) {
      this.state.gender = gender;
      document.querySelectorAll('.customize-gender-btn').forEach(function(b) {
        b.classList.remove('is-active');
      });
      if (el) el.classList.add('is-active');
      this.renderDesigns();
    },

    // Lazy init: designs are probed from the CDN, so only start when the
    // customizer is actually reached (scrolled to or "Customize" clicked).
    init: function() {
      if (this._inited) return;
      if (!this.root()) return;
      this._inited = true;
      this.syncMetalFromChecked();
      this.renderDesigns();
    },

    // "Customize" CTA — the customizer is an on-page section now; scroll to it.
    open: function(e) {
      var root = this.root();
      if (!root) return;
      if (e) e.preventDefault();
      this.init();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    },

    close: function() {},

    set: function(cat, val, el, fee = 0, flat = 0) {
      this.state[cat] = val;
      if (cat === 'metal') {
        this.state.metalFee = parseInt(fee) || 0;
        this.state.metalFlat = parseInt(flat) || 0;
      }
      if (cat === 'style') this.state.styleFee = parseInt(fee) || 0;

      // UI update (radio metals style themselves via :checked)
      if (el && cat !== 'metal') {
        const container = el.closest('#customise') || document;
        container.querySelectorAll('[data-opt="' + cat + '"]').forEach(function(s) { s.classList.remove('is-active'); });
        el.classList.add('is-active');
      }

      if (cat === 'type') {
        const typeText = document.getElementById('selected-type-text');
        if (typeText) typeText.innerText = val;
        const isRing = val === 'Ring';
        const isPendant = val === 'Pendant';
        const isBracelet = val === 'Bracelet';
        // Gender for Ring and Bracelet (their design images are gendered)
        const genderStep = document.getElementById('customize-gender-step');
        if (genderStep) genderStep.style.display = (isRing || isBracelet) ? '' : 'none';
        // Ring size only for Ring
        const ringSizeStep = document.getElementById('customize-ring-size-step');
        if (ringSizeStep) ringSizeStep.style.display = isRing ? '' : 'none';
        if (!isRing) this.state.ringSize = '';
        // Bracelet size only for Bracelet
        const braceletSizeStep = document.getElementById('customize-bracelet-size-step');
        if (braceletSizeStep) braceletSizeStep.style.display = isBracelet ? '' : 'none';
        if (!isBracelet) this.state.braceletSize = '';
        this.renderDesigns();
      }

      // Refresh design images when metal changes
      if (cat === 'metal') this.renderDesigns();

      // Note: page price is intentionally NOT updated here — it only changes
      // when the user clicks "Confirm customization" (see confirm()).
    },

    setRingSize: function(val) {
      this.state.ringSize = val || '';
      var err = document.getElementById('pdp-ring-size-error');
      if (err && val) err.style.display = 'none';
    },

    setBraceletSize: function(val) {
      this.state.braceletSize = val || '';
      var err = document.getElementById('pdp-bracelet-size-error');
      if (err && val) err.style.display = 'none';
    },

    onRingSizeSystemChange: function(system, el) {
      if (el) {
        var pills = document.querySelectorAll('#ring-size-system-pills .pdp-pill');
        pills.forEach(function(p) { p.classList.toggle('is-active', p === el); });
      }
      ['indian','us','inner'].forEach(function(s) {
        const panel = document.getElementById('modal-ring-size-panel-' + s);
        if (panel) panel.style.display = (s === system) ? '' : 'none';
      });
      this.state.ringSize = system === 'later' ? 'Later / Don\'t Know' : '';
      const indianSel = document.getElementById('modal-ring-size-indian');
      const usSel = document.getElementById('modal-ring-size-us');
      const innerInp = document.getElementById('modal-ring-size-inner');
      if (indianSel) indianSel.value = '';
      if (usSel) usSel.value = '';
      if (innerInp) innerInp.value = '';
    },

    resetStep: function(cat) {
      document.querySelectorAll('#customise [data-opt="' + cat + '"]').forEach(function(s) { s.classList.remove('is-active'); });
      this.state[cat] = 'None';
      if (cat === 'metal') { this.state.metalFee = 0; this.state.metalFlat = 0; }
      if (cat === 'style') this.state.styleFee = 0;
      // Page price only changes on confirm; nothing to update here.
    },

    updateTotalPrice: function() {
      if (this.basePrice > 100000000) return;
      // Price uses ONLY the confirmed-fee snapshot (confMetal*/confStyleFee),
      // never the live selection, so toggling options does not move the page
      // price until "Confirm" copies them in. certFee applies immediately.
      const totalPaise = this.state.confMetalFlat > 0
        ? this.state.confMetalFlat + this.state.certFee + this.state.confStyleFee
        : this.basePrice + this.state.certFee + this.state.confMetalFee + this.state.confStyleFee;
      const formattedPrice = (totalPaise / 100).toLocaleString('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 0
      });
      document.querySelectorAll('[data-pdp-price]').forEach(el => {
        el.innerText = formattedPrice;
      });
    },

    confirm: function() {
      this.syncMetalFromChecked();

      if (this.state.type === 'Ring' && !this.state.ringSize) {
        this._flagSizeError('customize-ring-size-step', 'pdp-ring-size-error', 'Please select a Ring Size before confirming.');
        return;
      }
      if (this.state.type === 'Bracelet' && !this.state.braceletSize) {
        this._flagSizeError('customize-bracelet-size-step', 'pdp-bracelet-size-error', 'Please select a Bracelet Size before confirming.');
        return;
      }

      let summary = this.state.type;
      if (this.state.metal && this.state.metal !== 'None') summary += ' / ' + this.state.metal;
      if (this.state.style && this.state.style !== 'None') summary += ' / ' + this.state.style;
      if (this.state.ringSize) summary += ' / Size: ' + this.state.ringSize;
      if (this.state.braceletSize) summary += ' / Size: ' + this.state.braceletSize;

      const summaryEl = document.getElementById('customize-summary-text');
      if (summaryEl) summaryEl.innerText = summary;

      // Hidden form inputs for cart properties
      const forms = document.querySelectorAll('form[action^="/cart/add"]');
      forms.forEach(form => {
        this.setHiddenProperty(form, 'Jewelry Type', this.state.type);
        this.setHiddenProperty(form, 'Metal', this.state.metal);
        this.setHiddenProperty(form, 'Style', this.state.style);
        if (this.state.ringSize) this.setHiddenProperty(form, 'Ring Size', this.state.ringSize);
        if (this.state.braceletSize) this.setHiddenProperty(form, 'Bracelet Size', this.state.braceletSize);

        const effectiveMetalFee = this.state.metalFlat > 0 ? this.state.metalFlat : this.state.metalFee;
        const totalFee = (effectiveMetalFee + this.state.styleFee + this.state.certFee) / 100;
        this.setHiddenProperty(form, 'Customization Fee', 'Rs. ' + totalFee.toLocaleString('en-IN'));
        this.setHiddenProperty(form, '_customization_fee_raw', effectiveMetalFee + this.state.styleFee + this.state.certFee);
      });

      const infoBar = document.getElementById('customize-info-bar');
      if (infoBar) infoBar.style.display = 'flex';
      const cta = document.getElementById('pdp-customize-cta');
      if (cta) cta.textContent = 'Edit customization';

      this.state.customized = true;
      // Lock in the selected fees, then reflect them in the page price.
      this.state.confMetalFee  = this.state.metalFee;
      this.state.confMetalFlat = this.state.metalFlat;
      this.state.confStyleFee  = this.state.styleFee;
      this.updateTotalPrice();
      updateDispatchDate();

      // Bring the buyer back to the price + CTAs they just changed.
      const buyBox = document.getElementById('buyBox-{{ section.id }}');
      if (buyBox) buyBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    },

    setHiddenProperty: function(form, name, value) {
      let input = form.querySelector('input[name="properties[' + name + ']"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'properties[' + name + ']';
        form.appendChild(input);
      }
      input.value = value;
    },

    reset: function() {
      this.state.type = 'Ring';
      this.state.metal = 'Panchdhatu';
      this.state.gender = 'female';
      this.state.style = 'None';
      this.state.ringSize = '';
      this.state.braceletSize = '';
      this.state.customized = false;
      this.state.certFee = 0;
      this.state.metalFee = 0;
      this.state.metalFlat = 0;
      this.state.styleFee = 0;
      this.state.confMetalFee = 0;
      this.state.confMetalFlat = 0;
      this.state.confStyleFee = 0;

      // Type tiles
      document.querySelectorAll('#customise [data-opt="type"]').forEach(function(b) {
        b.classList.toggle('is-active', b.dataset.val === 'Ring');
      });
      const typeText = document.getElementById('selected-type-text');
      if (typeText) typeText.innerText = 'Ring';
      const genderStep = document.getElementById('customize-gender-step');
      if (genderStep) genderStep.style.display = '';
      const ringSizeStep = document.getElementById('customize-ring-size-step');
      if (ringSizeStep) ringSizeStep.style.display = '';
      const braceletSizeStep = document.getElementById('customize-bracelet-size-step');
      if (braceletSizeStep) braceletSizeStep.style.display = 'none';
      const braceletSel = document.getElementById('modal-bracelet-size');
      if (braceletSel) braceletSel.value = '';

      // Metal radios → back to the first option, re-sync fee into state
      const metalRadios = document.querySelectorAll('#customize-metal-opts input[name="pdp-metal"]');
      if (metalRadios.length) metalRadios[0].checked = true;
      this.syncMetalFromChecked();

      // Ring size system → Indian
      const sysPill = document.querySelector('#ring-size-system-pills .pdp-pill[data-system="indian"]');
      this.onRingSizeSystemChange('indian', sysPill);

      // Gender → female
      document.querySelectorAll('.customize-gender-btn').forEach(function(b) {
        b.classList.toggle('is-active', b.dataset.gender === 'female');
      });

      // Revert confirmed UI
      const infoBar = document.getElementById('customize-info-bar');
      if (infoBar) infoBar.style.display = 'none';
      const cta = document.getElementById('pdp-customize-cta');
      if (cta) cta.textContent = 'Customize';

      // Clear hidden form properties
      document.querySelectorAll('form[action^="/cart/add"]').forEach(form => {
        ['Jewelry Type','Metal','Style','Ring Size','Bracelet Size','Customization Fee','_customization_fee_raw'].forEach(name => {
          const inp = form.querySelector('input[name="properties[' + name + ']"]');
          if (inp) inp.remove();
        });
      });

      // Certification back to the free option
      const certSelect = document.getElementById('CertificationField-{{ section.id }}');
      if (certSelect) { certSelect.selectedIndex = 0; updateCertFee(certSelect); }

      if (this._inited) this.renderDesigns();
      this.updateTotalPrice();
      updateDispatchDate();
    }
  };

  // Kick the customizer off when it scrolls into view (or via the CTA).
  document.addEventListener('DOMContentLoaded', function() {
    var root = document.getElementById('customise');
    if (!root) return;
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            CustomizeApp.init();
            io.disconnect();
          }
        });
      }, { rootMargin: '400px 0px' });
      io.observe(root);
    } else {
      CustomizeApp.init();
    }
  });

  // ═══════════ Video popup ═══════════
  function openVideoPopup(el) {
    var overlay = document.getElementById('video-popup-overlay');
    var content = document.getElementById('video-popup-content');
    var type = el.getAttribute('data-video-type');

    if (type === 'external') {
      var url = el.getAttribute('data-video-url');
      content.innerHTML = '<iframe src="' + url + '" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
    } else {
      var sourceEl = el.querySelector('.product-page__video-source');
      if (sourceEl) {
        var video = sourceEl.cloneNode(true);
        video.style.display = 'block';
        video.setAttribute('controls', '');
        video.setAttribute('autoplay', '');
        video.setAttribute('loop', '');
        content.innerHTML = '';
        content.appendChild(video);
      }
    }

    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeVideoPopup() {
    var overlay = document.getElementById('video-popup-overlay');
    var content = document.getElementById('video-popup-content');
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(function() { content.innerHTML = ''; }, 300);
  }

  function copyShareLink(e) {
    e.preventDefault();
    const url = window.location.href;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url);
    } else {
      const tmp = document.createElement('input');
      document.body.appendChild(tmp);
      tmp.value = url;
      tmp.select();
      document.execCommand('copy');
      document.body.removeChild(tmp);
    }
    const btn = e.currentTarget;
    btn.style.background = '#27ae60';
    btn.style.borderColor = '#27ae60';
    btn.style.color = '#fff';
    setTimeout(() => { btn.style.background = ''; btn.style.borderColor = ''; btn.style.color = ''; }, 1200);
  }

  function copyToClipboard(text, btn) {
    if (navigator.share) {
      navigator.share({ title: document.title, url: text });
      return;
    }
    const temp = document.createElement('input');
    document.body.appendChild(temp);
    temp.value = text;
    temp.select();
    document.execCommand('copy');
    document.body.removeChild(temp);

    const icon = btn.innerHTML;
    btn.innerHTML = '<span style="font-size:9px;font-weight:600;">COPIED</span>';
    setTimeout(() => { btn.innerHTML = icon; }, 2000);
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeVideoPopup();
  });
</script>

