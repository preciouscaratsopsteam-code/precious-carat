{%- comment -%}
  Hero Banner — center-mode carousel (Tanishq-style).
  The active slide sits centered as a rounded card with the previous/next
  slides peeking in at both edges. Infinite loop via one Liquid-rendered
  clone at each end, transform-based sliding, touch swipe, dots below,
  autoplay only while the section is in the viewport.
  Each block = one slide. Supports asset_name, subtitle, heading, description, button.
{%- endcomment -%}

<section class="hero-carousel" id="hero-banner">
  <div class="hero-carousel__viewport">
    {%- assign n = section.blocks.size -%}
    {%- if n > 1 -%}
      {%- assign loop_end = n | plus: 1 -%}
    {%- else -%}
      {%- assign loop_end = n | minus: 1 -%}
    {%- endif -%}
    <div class="hero-carousel__track{% if n > 1 %} hero-carousel__track--multi{% else %} hero-carousel__track--single{% endif %}" id="heroCarouselTrack">
      {%- for i in (0..loop_end) -%}
        {%- liquid
          assign is_clone = false
          if n > 1 and i == 0
            assign bi = n | minus: 1
            assign is_clone = true
          elsif n > 1 and i == loop_end
            assign bi = 0
            assign is_clone = true
          elsif n > 1
            assign bi = i | minus: 1
          else
            assign bi = i
          endif
          assign block = section.blocks[bi]
        -%}
        <div
          class="hero-carousel__slide{% if bi == 0 and is_clone == false %} is-active{% endif %}"
          {% if is_clone %}data-clone aria-hidden="true"{% else %}{{ block.shopify_attributes }}{% endif %}
        >
          <div class="hero-carousel__media">
            {%- if block.settings.asset_name != blank -%}
              {%- comment -%} Shopify CDN resizes theme assets via the width query param — serve phones ~750px instead of the full 2000px original. {%- endcomment -%}
              {%- assign _slide_src = block.settings.asset_name | asset_url -%}
              {%- if _slide_src contains '?' -%}{%- assign _slide_sep = '&' -%}{%- else -%}{%- assign _slide_sep = '?' -%}{%- endif -%}
              <img
                src="{{ _slide_src }}{{ _slide_sep }}width=2000"
                srcset="{{ _slide_src }}{{ _slide_sep }}width=750 750w, {{ _slide_src }}{{ _slide_sep }}width=1100 1100w, {{ _slide_src }}{{ _slide_sep }}width=1500 1500w, {{ _slide_src }}{{ _slide_sep }}width=2000 2000w"
                sizes="(max-width: 768px) 88vw, 86vw"
                alt="{{ block.settings.heading | default: section.settings.heading | escape }}"
                width="2000"
                height="800"
                {% if bi == 0 and is_clone == false %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}
              >
            {%- else -%}
              <div class="hero-carousel__placeholder"></div>
            {%- endif -%}
          </div>
          <div class="hero-carousel__overlay"></div>
          <div class="hero-carousel__content">
            {%- if block.settings.subtitle != blank -%}
              <p class="hero-carousel__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- comment -%} Only the first real slide's heading is the page h1 — one h1 per page; clones use a plain div. {%- endcomment -%}
              {%- if is_clone -%}
                <div class="hero-carousel__title">{{ block.settings.heading }}</div>
              {%- elsif bi == 0 -%}
                <h1 class="hero-carousel__title">{{ block.settings.heading }}</h1>
              {%- else -%}
                <h2 class="hero-carousel__title">{{ block.settings.heading }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="hero-carousel__description">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.button_text != blank -%}
              <a href="{{ block.settings.button_url | default: '/collections' }}" class="hero-carousel__btn"{% if is_clone %} tabindex="-1"{% endif %}>
                {{ block.settings.button_text }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if n > 1 -%}
      <button class="hero-carousel__arrow hero-carousel__arrow--prev" aria-label="Previous slide">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="hero-carousel__arrow hero-carousel__arrow--next" aria-label="Next slide">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    {%- endif -%}
  </div>

  {%- if n > 1 -%}
    <div class="hero-carousel__dots">
      {%- for block in section.blocks -%}
        <button class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    padding-top: 14px;
    background: transparent;
  }

  .hero-carousel__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero-carousel__track {
    display: flex;
    width: 100%;
    touch-action: pan-y;
    will-change: transform;
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Pre-JS/no-JS position: center the first real slide (index 1 — a clone of
     the last slide sits before it). Must match the slide width + margins below:
     offset = 86% + 24px − (100% − 86%)/2 = 79% + 24px. JS overrides inline. */
  .hero-carousel__track--multi {
    transform: translateX(calc(-79% - 24px));
  }
  .hero-carousel__track--single {
    justify-content: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__track { transition: none; }
  }

  .hero-carousel__slide {
    flex: 0 0 86%;
    margin: 0 8px;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 5 / 2;
    min-height: 420px;
    max-height: 580px;
    border-radius: 10px;
    overflow: hidden;
    background: #1a1008;
  }

  .hero-carousel__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-carousel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-carousel__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2c1810 0%, #4a3728 30%, #6b5a4e 60%, #8b7355 80%, #c9a96e 100%);
  }

  .hero-carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 60%, rgba(0,0,0,0.1) 100%);
    z-index: 1;
  }

  .hero-carousel__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 48px 56px;
    color: #fff;
    text-align: center;
  }

  .hero-carousel__subtitle {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
    margin: 0 0 16px;
  }

  .hero-carousel__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    color: #fff;
    margin: 0 0 20px;
  }

  .hero-carousel__description {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    margin: 0 0 32px;
  }

  .hero-carousel__btn {
    display: inline-block;
    padding: 14px 32px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.7);
    color: #fff;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .hero-carousel__btn:hover {
    background: #fff;
    border-color: #fff;
    color: #1a1008;
  }

  /* Arrows — float over the peeking side slides */
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(26,16,8,0.35);
    border: 1px solid rgba(255,255,255,0.35);
    color: #fff;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
  }
  .hero-carousel__arrow:hover {
    background: rgba(26,16,8,0.6);
  }
  .hero-carousel__arrow--prev { left: calc(7% - 21px); }
  .hero-carousel__arrow--next { right: calc(7% - 21px); }

  /* Dots — below the banner, on the page background */
  .hero-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 16px 0 4px;
  }
  .hero-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(26,16,8,0.18);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .hero-carousel__dot.is-active {
    background: var(--color-gold, #c9a96e);
    transform: scale(1.35);
  }

  @media screen and (max-width: 768px) {
    .hero-carousel { padding-top: 10px; }
    .hero-carousel__slide {
      flex-basis: 88%;
      margin: 0 5px;
      aspect-ratio: auto;
      min-height: 460px;
      max-height: none;
      border-radius: 10px;
    }
    /* offset = 88% + 15px − (100% − 88%)/2 = 82% + 15px */
    .hero-carousel__track--multi {
      transform: translateX(calc(-82% - 15px));
    }
    .hero-carousel__content { padding: 40px 20px 44px; }
    .hero-carousel__arrow { display: none; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('hero-banner');
  var track = document.getElementById('heroCarouselTrack');
  if (!root || !track) return;

  var slides = [].slice.call(track.children);
  var total = slides.filter(function (s) { return !s.hasAttribute('data-clone'); }).length;
  if (total <= 1) return;

  var dots = [].slice.call(root.querySelectorAll('.hero-carousel__dot'));
  var prevB = root.querySelector('.hero-carousel__arrow--prev');
  var nextB = root.querySelector('.hero-carousel__arrow--next');
  var viewport = root.querySelector('.hero-carousel__viewport');

  var pos = 1;        /* index into slides[]; 0 and last are clones */
  var current = 0;    /* real index, drives the dots */
  var timer = null, inView = true, animating = false, animGuard = null;

  function offsetFor(i) {
    var s = slides[i];
    return s.offsetLeft - (viewport.clientWidth - s.offsetWidth) / 2;
  }

  function apply(instant) {
    if (instant) track.style.transition = 'none';
    track.style.transform = 'translate3d(' + (-offsetFor(pos)) + 'px,0,0)';
    if (instant) { void track.offsetWidth; track.style.transition = ''; }
  }

  function setDots(i) {
    if (dots[current]) dots[current].classList.remove('is-active');
    current = i;
    if (dots[current]) dots[current].classList.add('is-active');
  }

  function goTo(p) {
    if (animating) return;
    animating = true;
    clearTimeout(animGuard);
    animGuard = setTimeout(function () { animating = false; }, 750); /* fallback if transitionend never fires */
    pos = Math.max(0, Math.min(slides.length - 1, p));
    apply(false);
    setDots((pos - 1 + total) % total);
  }

  track.addEventListener('transitionend', function (e) {
    if (e.target !== track) return;
    animating = false;
    clearTimeout(animGuard);
    /* teleport off the clones for the infinite loop */
    if (pos === 0) { pos = total; apply(true); }
    else if (pos === slides.length - 1) { pos = 1; apply(true); }
  });

  /* ── autoplay: only while visible and page focused ── */
  function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }
  function startAuto() {
    stopAuto();
    timer = setInterval(function () {
      if (inView && !document.hidden) goTo(pos + 1);
    }, 5000);
  }

  if (prevB) prevB.addEventListener('click', function () { goTo(pos - 1); startAuto(); });
  if (nextB) nextB.addEventListener('click', function () { goTo(pos + 1); startAuto(); });
  dots.forEach(function (d, i) {
    d.addEventListener('click', function () { goTo(i + 1); startAuto(); });
  });

  root.addEventListener('mouseenter', stopAuto);
  root.addEventListener('mouseleave', startAuto);

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      inView = entries[0].isIntersecting;
    }, { threshold: 0.25 }).observe(root);
  }

  /* ── touch swipe (vertical scroll stays native via touch-action: pan-y) ── */
  var startX = 0, startY = 0, dragging = false, locked = false, base = 0;

  track.addEventListener('touchstart', function (e) {
    if (e.touches.length !== 1) return;
    stopAuto();
    /* user takes over mid-animation: cancel the guard and, if the interrupted
       move landed on a clone, teleport to its real twin first */
    animating = false;
    clearTimeout(animGuard);
    if (pos === 0) { pos = total; apply(true); }
    else if (pos === slides.length - 1) { pos = 1; apply(true); }
    dragging = true; locked = false;
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    base = -offsetFor(pos);
    track.style.transition = 'none';
  }, { passive: true });

  track.addEventListener('touchmove', function (e) {
    if (!dragging) return;
    var dx = e.touches[0].clientX - startX;
    var dy = e.touches[0].clientY - startY;
    if (!locked) {
      if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
      if (Math.abs(dy) > Math.abs(dx)) { /* vertical scroll — release */
        dragging = false;
        track.style.transition = '';
        apply(false);
        return;
      }
      locked = true;
    }
    track.style.transform = 'translate3d(' + (base + dx) + 'px,0,0)';
  }, { passive: true });

  track.addEventListener('touchend', function (e) {
    if (!dragging) { startAuto(); return; }
    dragging = false;
    track.style.transition = '';
    var dx = e.changedTouches[0].clientX - startX;
    if (locked && Math.abs(dx) > 48) goTo(pos + (dx < 0 ? 1 : -1));
    else apply(false);
    startAuto();
  }, { passive: true });

  window.addEventListener('resize', function () { apply(true); }, { passive: true });

  apply(true);
  window.addEventListener('load', function () { apply(true); });
  startAuto();
})();
</script>

{% schema %}
{
  "name": "Hero Banner",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "asset_name",
          "label": "Image filename (e.g. home_1.jpg)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
