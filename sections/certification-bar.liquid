{%- comment -%}
  Certification Bar Section
  Dark bar showcasing lab certifications
{%- endcomment -%}

<section class="cert-bar reveal" id="cert-bar">
  <div class="page-width">
    <div class="cert-bar__wrapper">
      <h2 class="cert-bar__text">{{ section.settings.heading }}</h2>

      <div class="cert-bar__logos">
        <div class="cert-bar__logo">
          <img
            src="{{ 'igi.png' | asset_img_url: 'x112' }}"
            srcset="{{ 'igi.png' | asset_img_url: 'x112' }} 1x, {{ 'igi.png' | asset_img_url: 'x224' }} 2x"
            width="281"
            height="112"
            alt="International Gemological Institute (IGI)"
            loading="lazy">
        </div>
        <div class="cert-bar__logo">
          <img
            src="{{ 'iigj.png' | asset_img_url: 'x112' }}"
            srcset="{{ 'iigj.png' | asset_img_url: 'x112' }} 1x, {{ 'iigj.png' | asset_img_url: 'x224' }} 2x"
            width="255"
            height="112"
            alt="Indian Institute of Gems &amp; Jewellery (IIGJ)"
            loading="lazy">
        </div>
        <div class="cert-bar__logo">
          <img
            src="{{ 'grs.png' | asset_img_url: 'x112' }}"
            srcset="{{ 'grs.png' | asset_img_url: 'x112' }} 1x, {{ 'grs.png' | asset_img_url: 'x224' }} 2x"
            width="348"
            height="112"
            alt="GRS GemResearch Swisslab"
            loading="lazy">
        </div>
        <div class="cert-bar__logo">
          <img
            src="{{ 'gublin.png' | asset_img_url: 'x112' }}"
            srcset="{{ 'gublin.png' | asset_img_url: 'x112' }} 1x, {{ 'gublin.png' | asset_img_url: 'x224' }} 2x"
            width="324"
            height="112"
            alt="Gübelin Gem Lab"
            loading="lazy">
        </div>
      </div>

      {%- if section.settings.button_text != blank -%}
        <div class="cert-bar__btn">
          <a href="/pages/certified-by-12-world-class-labs" class="btn btn--secondary">
            {{ section.settings.button_text }}
          </a>
        </div>
        
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Certification Bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our gems are certified by 12 world-class labs"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Lab Logo",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Lab name",
          "default": "GIA"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Lab logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Certification Bar",
      "blocks": [
        { "type": "logo", "settings": { "name": "GIA" } },
        { "type": "logo", "settings": { "name": "IGI" } },
        { "type": "logo", "settings": { "name": "GRS" } },
        { "type": "logo", "settings": { "name": "AIGS" } }
      ]
    }
  ]
}
{% endschema %}
