</footer>

<script>
(function () {
  // Footer groups: accordion on phones (first one open), always open above 640px.
  var groups = document.querySelectorAll('#site-footer .pcf__group');
  if (!groups.length) return;
  var mq = window.matchMedia('(max-width:640px)');
  function sync() {
    groups.forEach(function (g, i) {
      if (mq.matches) { if (i !== 0) g.removeAttribute('open'); }
      else g.setAttribute('open', '');
    });
  }
  sync();
  if (mq.addEventListener) mq.addEventListener('change', sync); else window.addEventListener('resize', sync);
})();
</script>

{% schema %}
{
  "name": "Site footer",
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Natural, independently certified gemstones with every treatment disclosed — sold direct, so the price reflects the gem and nothing else." },
    { "type": "checkbox", "id": "show_contact", "label": "Show contact details (from Theme settings → Business details)", "default": true },
    { "type": "text", "id": "hours", "label": "Opening hours line", "info": "e.g. Mon–Sat, 10am – 7pm IST. Leave blank to hide." },
    { "type": "link_list", "id": "help_menu", "label": "Help menu (optional)" },
    { "type": "link_list", "id": "company_menu", "label": "Company menu (optional)" },
    { "type": "blog", "id": "journal_blog", "label": "Journal blog", "info": "Defaults to /blogs/gems." },
    { "type": "text", "id": "payment_methods", "label": "Payment methods (comma separated)", "default": "UPI, Visa, Mastercard, RuPay, Net banking, EMI, COD" },
    { "type": "text", "id": "tagline", "label": "Legal bar tagline", "default": "Jo dikhta hai, wohi milega." },
    { "type": "paragraph", "content": "Link groups: without blocks the footer shows the SEO brief's eight groups (Navratna Gems, Upratnas, Sapphires, Gems by Rashi, Gems by Origin, Birthstones, Gems by Weight, Shop & Learn). Links to collections that are not yet published are hidden automatically. Add 'Link group' blocks to replace them with Shopify menus." }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Link group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "select", "id": "column", "label": "Column", "default": "1", "options": [
          { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
        ] }
      ]
    }
  ]
}
{% endschema %}
