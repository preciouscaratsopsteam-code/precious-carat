        {%- for col in ft_cols -%}
          {%- capture ft_col -%}
            {%- assign ft_gs = col | strip | split: '####' -%}
            {%- for g in ft_gs -%}
              {%- assign g_parts = g | strip | split: ';;' -%}
              {%- assign g_head = g_parts[0] | strip -%}
              {%- capture ft_links -%}
                {%- assign g_links = g_parts[1] | strip | split: ',' -%}
                {%- for lk in g_links -%}
                  {%- assign lk_f = lk | strip | split: '|' -%}
                  {%- render 'nav-link', tag: 'li', url: lk_f[0], label: lk_f[1], hin: lk_f[2] -%}
                {%- endfor -%}
