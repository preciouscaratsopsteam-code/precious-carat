    {%- endcapture -%}
    {%- assign ft_groups = ft_groups | strip -%}
    {%- if ft_groups != blank -%}
      <nav class="pcf__grid" aria-label="Footer">{{ ft_groups }}</nav>
    {%- endif -%}

    <div class="pcf__bar">
      {%- if section.settings.tagline != blank -%}<span><em>{{ section.settings.tagline }}</em></span>{%- endif -%}
      <span class="pcf__legal">&copy; {{ ft_year }} {{ ft_legal }}{% if settings.business_gstin != blank %} &nbsp;&middot;&nbsp; GSTIN {{ settings.business_gstin }}{% endif %}{% if settings.business_cin != blank %} &nbsp;&middot;&nbsp; CIN {{ settings.business_cin }}{% endif %}</span>
