{%- comment -%}
  Author page for the Journal (SEO brief I2 / H5 / Appendix I.8).
  Create a page in admin with handle "our-gemmologists" and template
  "page.our-gemmologists", then add one "Gemmologist" block per author in the
  theme editor. Each block renders a profile card and a Person node; article
  bylines link to /pages/our-gemmologists#<author-handle>, so the block's
  name must match the author name used on the blog posts.
{%- endcomment -%}
{%- assign gm_brand = settings.business_brand_name | default: shop.name -%}
<section class="gemmo page-section section-padding">
  <div class="page-width page-width--narrow">
    <header class="gemmo__head">
      <h1 class="section-heading">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="gemmo__intro">{{ section.settings.intro }}</p>
      {%- elsif page.content != blank -%}
        <div class="gemmo__intro">{{ page.content }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="gemmo__grid">
        {%- for block in section.blocks -%}
          {%- if block.type != 'author' or block.settings.name == blank -%}{%- continue -%}{%- endif -%}
          {%- assign gm_handle = block.settings.name | handleize -%}
          <article class="gemmo__card" id="{{ gm_handle }}" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              <img class="gemmo__photo" src="{{ block.settings.photo | image_url: width: 320 }}" srcset="{{ block.settings.photo | image_url: width: 160 }} 160w, {{ block.settings.photo | image_url: width: 320 }} 320w" sizes="160px" width="160" height="160" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
            <div class="gemmo__body">
              <h2 class="gemmo__name">{{ block.settings.name }}</h2>
              <p class="gemmo__role">{{ block.settings.job_title | default: 'Gemmologist' }}{% if block.settings.credential != blank %} · {{ block.settings.credential }}{% endif %}{% if block.settings.recognized_by != blank %} ({{ block.settings.recognized_by }}){% endif %}</p>
              {%- if block.settings.bio != blank -%}<div class="gemmo__bio">{{ block.settings.bio }}</div>{%- endif -%}
              <p class="gemmo__links">
                {%- if block.settings.linkedin != blank -%}<a href="{{ block.settings.linkedin }}" target="_blank" rel="noopener me">LinkedIn</a>{%- endif -%}
                {%- if block.settings.blog != blank -%}<a href="{{ block.settings.blog.url }}">Articles</a>{%- endif -%}
              </p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="gemmo__empty">Add a "Gemmologist" block for each author in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
      ]
    }
    {%- for block in section.blocks -%}
      {%- if block.type != 'author' or block.settings.name == blank -%}{%- continue -%}{%- endif -%}
      {%- assign gm_handle = block.settings.name | handleize -%},
    {
      "@type": "Person",
      "@id": "{{ shop.url }}{{ page.url }}#{{ gm_handle }}",
      "name": {{ block.settings.name | json }},
      "url": "{{ shop.url }}{{ page.url }}#{{ gm_handle }}",
      "jobTitle": {{ block.settings.job_title | default: 'Gemmologist' | json }},
      "worksFor": { "@type": "Organization", "@id": "{{ shop.url }}/#organization", "name": {{ gm_brand | json }} }
      {%- if block.settings.photo != blank %},
      "image": {{ block.settings.photo | image_url: width: 640 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}
      {%- endif %}
      {%- if block.settings.bio != blank %},
      "description": {{ block.settings.bio | strip_html | strip | json }}
      {%- endif %}
      {%- if block.settings.credential != blank %},
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": {{ block.settings.credential | json }}
        {%- if block.settings.recognized_by != blank %},
        "recognizedBy": { "@type": "Organization", "name": {{ block.settings.recognized_by | json }} }
        {%- endif %}
      }
      {%- endif %}
      {%- if block.settings.linkedin != blank %},
      "sameAs": [{{ block.settings.linkedin | json }}]
      {%- endif %}
    }
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<style>
  .gemmo__head { margin-bottom: var(--space-xl); }
  .gemmo__intro { font-family: var(--font-body); font-size: 15px; line-height: 1.8; color: #4a443d; max-width: 62ch; }
  .gemmo__grid { display: grid; gap: var(--space-lg); }
  .gemmo__card { display: grid; grid-template-columns: 120px 1fr; gap: var(--space-lg); align-items: start; padding: var(--space-lg); background: #fff; border: 1px solid #E6DDCF; border-radius: 6px; }
  .gemmo__photo { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; background: #F6EFE4; }
  .gemmo__name { font-family: var(--font-heading); font-size: 26px; font-weight: 500; margin: 0 0 4px; color: #231F20; }
  .gemmo__role { font-family: var(--font-body); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #96733A; margin: 0 0 12px; }
  .gemmo__bio { font-family: var(--font-body); font-size: 14.5px; line-height: 1.75; color: #33302C; }
  .gemmo__bio p { margin: 0 0 10px; }
  .gemmo__links { display: flex; gap: 16px; margin: 12px 0 0; font-family: var(--font-body); font-size: 13px; }
  .gemmo__links a { color: #231F20; text-decoration: underline; text-underline-offset: 3px; }
  .gemmo__empty { font-family: var(--font-body); color: #7A7268; }
  @media (max-width: 600px) { .gemmo__card { grid-template-columns: 1fr; } .gemmo__photo { width: 96px; height: 96px; } }
</style>

{% schema %}
{
  "name": "Our gemmologists",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our gemmologists" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The people who grade, photograph and write about every gem we sell. Each Journal article carries its author's name." }
  ],
  "blocks": [
    {
      "type": "author",
      "name": "Gemmologist",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "info": "Must match the author name on the blog posts." },
        { "type": "text", "id": "job_title", "label": "Job title", "default": "Gemmologist" },
        { "type": "text", "id": "credential", "label": "Credential", "info": "e.g. Graduate Gemologist diploma" },
        { "type": "text", "id": "recognized_by", "label": "Awarding body", "info": "e.g. GIA / IGI / GII" },
        { "type": "richtext", "id": "bio", "label": "Short bio" },
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "url", "id": "linkedin", "label": "LinkedIn profile URL" },
        { "type": "blog", "id": "blog", "label": "Blog to link as 'Articles'" }
      ]
    }
  ],
  "presets": [{ "name": "Our gemmologists" }]
}
{% endschema %}
