<script>
(function () {
  'use strict';
  var drawer = document.getElementById('drawer');
  var burger = document.getElementById('burgerBtn');
  var body = drawer ? drawer.querySelector('[data-drawer-body]') : null;

  // The drawer is built from the server-rendered mega menu links, so there is
  // exactly one crawlable copy of every menu link in the HTML (brief D4).
  function buildDrawer() {
    if (!body || body.getAttribute('data-built')) return;
    body.setAttribute('data-built', '1');
    document.querySelectorAll('#nav-bar .pc-nav__item').forEach(function (item) {
      var top = item.querySelector('.pc-nav__link');
      if (!top) return;
      var det = document.createElement('details');
      var sum = document.createElement('summary');
      sum.textContent = top.textContent.trim();
      det.appendChild(sum);
      var ul = document.createElement('ul');
      var seen = {};
      var all = document.createElement('li');
      var allA = document.createElement('a');
      allA.href = top.getAttribute('href');
      allA.innerHTML = '<b>All ' + top.textContent.trim() + '</b>';
      all.appendChild(allA);
      ul.appendChild(all);
      seen[allA.getAttribute('href')] = true;
      item.querySelectorAll('.pc-mega a[href]').forEach(function (a) {
        var href = a.getAttribute('href');
        if (!href || seen[href] || a.closest('.pc-spec__img')) return;
        seen[href] = true;
        var li = document.createElement('li');
        var c = document.createElement('a');
        c.href = href;
        c.innerHTML = a.innerHTML.replace(/<svg[\s\S]*?<\/svg>/g, '').replace(/→/g, '').trim();
        li.appendChild(c);
        ul.appendChild(li);
      });
      det.appendChild(ul);
      body.appendChild(det);
    });
  }

  function setDrawer(open) {
    if (!drawer) return;
    if (open) buildDrawer();
    drawer.setAttribute('data-open', String(open));
    if (burger) burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }
  if (burger) burger.addEventListener('click', function () { setDrawer(drawer.getAttribute('data-open') !== 'true'); });
  if (drawer) drawer.querySelectorAll('[data-close]').forEach(function (el) { el.addEventListener('click', function () { setDrawer(false); }); });

  var overlay = document.getElementById('searchOverlay');
  var searchBtn = document.getElementById('searchBtn');
  var input = document.getElementById('header-search');
  function setSearch(open) {
    if (!overlay) return;
    overlay.setAttribute('data-open', String(open));
    if (searchBtn) searchBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open && input) setTimeout(function () { input.focus(); }, 60);
  }
  if (searchBtn) searchBtn.addEventListener('click', function () { setSearch(overlay.getAttribute('data-open') !== 'true'); });
  if (overlay) overlay.querySelectorAll('[data-search-close]').forEach(function (el) { el.addEventListener('click', function () { setSearch(false); }); });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (drawer && drawer.getAttribute('data-open') === 'true') setDrawer(false);
    if (overlay && overlay.getAttribute('data-open') === 'true') setSearch(false);
  });
})();
</script>

