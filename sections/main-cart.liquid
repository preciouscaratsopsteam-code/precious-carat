{%- comment -%}Cart Page Section{%- endcomment -%}

{%- comment -%}
  Fee lines are real fee-product items added alongside a customized gem and
  linked to it by _master_id — they are what checkout actually charges. A gem
  whose fee line is present must not also count its _customization_fee_raw
  property (that would double-count); property-only fees remain as display
  fallback for carts created before the fee product was configured.
{%- endcomment -%}
{%- assign fee_line_total = 0 -%}
{%- assign fee_masters = '' -%}
{%- for item in cart.items -%}
  {%- if item.properties['_fee_line'] -%}
    {%- assign fee_line_total = fee_line_total | plus: item.final_line_price -%}
    {%- assign fee_masters = fee_masters | append: '|' | append: item.properties['_master_id'] -%}
  {%- endif -%}
{%- endfor -%}

{%- assign property_fee_total = 0 -%}
{%- for item in cart.items -%}
  {%- if item.properties['_fee_line'] == blank and item.properties['_customization_fee_raw'] -%}
    {%- assign mid = item.properties['_master_id'] | append: '' -%}
    {%- assign has_fee_line = false -%}
    {%- if mid != '' and fee_masters contains mid -%}
      {%- assign has_fee_line = true -%}
    {%- endif -%}
    {%- unless has_fee_line -%}
      {%- assign fee = item.properties['_customization_fee_raw'] | plus: 0 -%}
      {%- assign property_fee_total = property_fee_total | plus: fee -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}

<!-- Breadcrumb -->
<div class="cart-breadcrumb">
  <div class="page-width">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__sep">›</span>
      {%- assign first_item = blank -%}
      {%- for item in cart.items -%}
        {%- unless item.properties['_fee_line'] -%}
          {%- assign first_item = item -%}
          {%- break -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if first_item != blank -%}
        {%- if first_item.product.collections.first -%}
          <a href="{{ first_item.product.collections.first.url }}">{{ first_item.product.collections.first.title }}</a>
          <span class="breadcrumb__sep">›</span>
        {%- endif -%}
        <a href="{{ first_item.product.url }}">{{ first_item.product.title }}</a>
        <span class="breadcrumb__sep">›</span>
      {%- endif -%}
      <span>Shopping Cart</span>
    </nav>
  </div>
</div>

<section class="cart-page" id="cart-page">
  <div class="page-width">

    {%- if cart.item_count > 0 -%}
      {%- comment -%} per-gem making charge: "|master_id:paise" pairs built from the fee lines {%- endcomment -%}
      {%- assign fee_pairs = '' -%}
      {%- for item in cart.items -%}
        {%- if item.properties['_fee_line'] -%}
          {%- assign fee_pairs = fee_pairs | append: '|' | append: item.properties['_master_id'] | append: ':' | append: item.final_line_price -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign fee_pair_list = fee_pairs | split: '|' -%}
      {%- assign gem_count = 0 -%}
      {%- for item in cart.items -%}{%- unless item.properties['_fee_line'] -%}{%- assign gem_count = gem_count | plus: item.quantity -%}{%- endunless -%}{%- endfor -%}
      {%- assign gems_subtotal = cart.total_price | minus: fee_line_total -%}
      {%- assign making_total = fee_line_total | plus: property_fee_total -%}
      {%- assign grand_total = cart.total_price | plus: property_fee_total -%}

      {%- comment -%} WhatsApp share text: every gem with weight, price, making charge and link, the total, and a cart permalink that rebuilds the gems for the recipient {%- endcomment -%}
      {%- capture nl %}
{% endcapture -%}
      {%- capture total_txt -%}{% render 'price-inr', amount: grand_total %}{%- endcapture -%}
      {%- assign share_text = 'Precious Carats — my cart (' | append: gem_count | append: ' gem' -%}
      {%- if gem_count != 1 -%}{%- assign share_text = share_text | append: 's' -%}{%- endif -%}
      {%- assign share_text = share_text | append: ')' | append: nl -%}
      {%- assign permalink = '' -%}
      {%- assign n = 0 -%}
      {%- for item in cart.items -%}
        {%- if item.properties['_fee_line'] -%}{%- continue -%}{%- endif -%}
        {%- assign n = n | plus: 1 -%}
        {%- assign smid = item.properties['_master_id'] | append: '' -%}
        {%- assign sfee = 0 -%}
        {%- if smid != '' -%}{%- for pair in fee_pair_list -%}{%- assign sp = pair | split: ':' -%}{%- if sp[0] == smid and sp[1] != blank -%}{%- assign sfee = sp[1] | plus: 0 -%}{%- endif -%}{%- endfor -%}{%- endif -%}
        {%- if sfee == 0 and item.properties['_customization_fee_raw'] -%}{%- assign sfee = item.properties['_customization_fee_raw'] | plus: 0 -%}{%- endif -%}
        {%- assign smf = item.product.metafields.custom -%}
        {%- capture gem_price -%}{% render 'price-inr', amount: item.final_line_price %}{%- endcapture -%}
        {%- capture fee_price -%}{% render 'price-inr', amount: sfee %}{%- endcapture -%}
        {%- assign share_text = share_text | append: nl | append: n | append: '. ' | append: item.product.title -%}
        {%- if smf.weight_carats != blank -%}{%- assign share_text = share_text | append: ' — ' | append: smf.weight_carats | append: ' ct' -%}{%- if smf.weight_ratti != blank -%}{%- assign rt = smf.weight_ratti | times: 1.0 | round: 2 -%}{%- assign share_text = share_text | append: ' / ' | append: rt | append: ' ratti' -%}{%- endif -%}{%- endif -%}
        {%- if smf.origin != blank -%}{%- assign share_text = share_text | append: ', ' | append: smf.origin -%}{%- endif -%}
        {%- if smf.cert_lab != blank -%}{%- assign share_text = share_text | append: ', ' | append: smf.cert_lab | append: ' certified' -%}{%- endif -%}
        {%- assign share_text = share_text | append: nl | append: '   ' | append: gem_price | strip_html -%}
        {%- if sfee > 0 -%}{%- assign fee_clean = fee_price | strip_html | strip -%}{%- assign share_text = share_text | append: ' + making charge ' | append: fee_clean -%}{%- endif -%}
        {%- for property in item.properties -%}
          {%- assign fc = property.first | slice: 0 -%}
          {%- if fc != '_' and property.last != blank and property.first != 'Weight' and property.first != 'Weight (Ratti)' and property.first != 'Origin' and property.first != 'Certification' -%}
            {%- unless property.last contains '/uploads/' -%}{%- assign share_text = share_text | append: nl | append: '   ' | append: property.first | append: ': ' | append: property.last -%}{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign share_text = share_text | append: nl | append: '   ' | append: shop.url | append: item.url -%}
        {%- if permalink != '' -%}{%- assign permalink = permalink | append: ',' -%}{%- endif -%}
        {%- assign permalink = permalink | append: item.variant_id | append: ':' | append: item.quantity -%}
      {%- endfor -%}
      {%- assign total_clean = total_txt | strip_html | strip -%}
      {%- assign share_text = share_text | append: nl | append: nl | append: 'Total: ' | append: total_clean | append: ' (incl. of all taxes)' -%}
      {%- assign share_text = share_text | append: nl | append: 'Open this cart: ' | append: shop.url | append: '/cart/' | append: permalink -%}

      <header class="cart-head">
        <h1>Your cart</h1>
        <span class="cart-head__count">{{ gem_count }} {% if gem_count == 1 %}gem{% else %}gems{% endif %}</span>
      </header>

      <div class="cart-page__wrapper">

        <!-- Cart Items: one card per gem, with its own price and making charge -->
        <div class="cart-page__items">
          {%- for item in cart.items -%}
            {%- if item.properties['_fee_line'] -%}{%- continue -%}{%- endif -%}
            {%- assign mid = item.properties['_master_id'] | append: '' -%}
            {%- assign line_fee = 0 -%}
            {%- assign fee_source = '' -%}
            {%- if mid != '' -%}
              {%- for pair in fee_pair_list -%}
                {%- assign parts = pair | split: ':' -%}
                {%- if parts[0] == mid and parts[1] != blank -%}{%- assign line_fee = parts[1] | plus: 0 -%}{%- assign fee_source = 'line' -%}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if fee_source == '' and item.properties['_customization_fee_raw'] -%}
              {%- assign line_fee = item.properties['_customization_fee_raw'] | plus: 0 -%}
              {%- assign fee_source = 'property' -%}
            {%- endif -%}
            {%- assign line_total = item.final_line_price | plus: line_fee -%}
            {%- assign mf = item.product.metafields.custom -%}
            {%- assign has_custom = false -%}
            {%- for property in item.properties -%}
              {%- assign fc = property.first | slice: 0 -%}
              {%- if fc != '_' and property.last != blank and property.first != 'Weight' and property.first != 'Weight (Ratti)' and property.first != 'Origin' and property.first != 'Certification' -%}{%- assign has_custom = true -%}{%- endif -%}
            {%- endfor -%}

            <article class="cart-card" id="cart-item-{{ item.key }}">
              <a href="{{ item.url }}" class="cart-card__img" aria-hidden="true" tabindex="-1">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
                {%- else -%}
                  <span class="cart-card__img-placeholder"></span>
                {%- endif -%}
              </a>
              <div class="cart-card__main">
                <div class="cart-card__top">
                  <div class="cart-card__id">
                    {%- assign eyebrow = mf.gem_type | default: item.product.type -%}
                    {%- if eyebrow != blank -%}<p class="cart-card__eyebrow">{{ eyebrow }}{% if mf.planetary_alignment != blank %} · {{ mf.planetary_alignment }}{% endif %}</p>{%- endif -%}
                    <h3 class="cart-card__title"><a href="{{ item.url }}">{{ item.product.title }}{% if item.variant.title != 'Default Title' %} — {{ item.variant.title }}{% endif %}</a></h3>
                    <p class="cart-card__meta">
                      {%- if mf.weight_carats != blank -%}<span>{{ mf.weight_carats }} ct{% if mf.weight_ratti != blank %} · {{ mf.weight_ratti | times: 1.0 | round: 2 }} ratti{% endif %}</span>{%- elsif item.properties['Weight'] -%}<span>{{ item.properties['Weight'] }}</span>{%- elsif item.properties['Weight (Ratti)'] -%}<span>{{ item.properties['Weight (Ratti)'] }}</span>{%- endif -%}
                      {%- if mf.origin != blank -%}<span>{{ mf.origin }}</span>{%- elsif item.properties['Origin'] -%}<span>{{ item.properties['Origin'] }}</span>{%- endif -%}
                      {%- if mf.treatment_status != blank -%}<span>{{ mf.treatment_status }}</span>{%- endif -%}
                      {%- if mf.cert_lab != blank -%}<span class="cart-card__lab">{{ mf.cert_lab }} certified</span>{%- elsif item.properties['Certification'] -%}<span class="cart-card__lab">{{ item.properties['Certification'] }}</span>{%- endif -%}
                      <span class="cart-card__sku">{{ item.variant.sku | default: item.product.id }}</span>
                    </p>
                  </div>
                  <div class="cart-card__price">
                    <b>{% render 'price-inr', amount: line_total %}</b>
                    {%- if item.quantity > 1 -%}<small>{{ item.quantity }} × {% render 'price-inr', amount: item.final_price %}</small>{%- elsif line_fee > 0 -%}<small>gem + making charge</small>{%- endif -%}
                  </div>
                </div>

                {%- if has_custom -%}
                <div class="cart-card__custom">
                  <p class="cart-card__custom-title">Customised jewellery</p>
                  <ul class="cart-card__chips">
                    {%- for property in item.properties -%}
                      {%- assign fc = property.first | slice: 0 -%}
                      {%- if fc != '_' and property.last != blank -%}
                        {%- if property.first == 'Weight' or property.first == 'Weight (Ratti)' or property.first == 'Origin' or property.first == 'Certification' -%}{%- continue -%}{%- endif -%}
                        <li><span>{{ property.first }}</span>{% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>{% else %}<b>{{ property.last }}</b>{% endif %}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
                {%- endif -%}

                {%- if line_fee > 0 -%}
                <dl class="cart-card__breakdown">
                  <div><dt>Gemstone</dt><dd>{% render 'price-inr', amount: item.final_line_price %}</dd></div>
                  <div><dt>Making charge</dt><dd>{% render 'price-inr', amount: line_fee %}</dd></div>
                </dl>
                {%- endif -%}

                <div class="cart-card__actions">
                  <a href="{{ item.url }}" class="cart-card__edit">{% if has_custom %}Edit customisation{% else %}View gem{% endif %}</a>
                  <a
                    href="/cart/change?id={{ item.key }}&quantity=0"
                    class="cart-card__delete"
                    data-line-key="{{ item.key }}"
                    data-master-id="{{ item.properties['_master_id'] }}"
                    aria-label="Remove {{ item.title | escape }}"
                  >Remove</a>
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <!-- Order Summary -->
        <aside class="cart-page__summary">
          <div class="cart-summary">
            <h2 class="cart-summary__title">Order summary</h2>

            <div class="cart-summary__row">
              <span>Gemstones ({{ gem_count }})</span>
              <span class="cart-summary__amount">{% render 'price-inr', amount: gems_subtotal %}</span>
            </div>
            {%- if making_total > 0 -%}
            <div class="cart-summary__row">
              <span>Making charges</span>
              <span class="cart-summary__amount">{% render 'price-inr', amount: making_total %}</span>
            </div>
            {%- endif -%}
            <div class="cart-summary__row">
              <span>Shipping</span>
              <span class="cart-summary__amount cart-summary__amount--muted">Calculated at checkout</span>
            </div>
            <div class="cart-summary__row cart-summary__row--total">
              <span>Total <small>incl. of all taxes</small></span>
              <span class="cart-summary__amount">{% render 'price-inr', amount: grand_total %}</span>
            </div>

            {%- if cart.total_price > 100000000 -%}
              <a href="mailto:{{ shop.email }}?subject=Price Inquiry for Cart Items" class="cart-summary__contact-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                Contact us for price
              </a>
            {%- else -%}
              <form action="/cart" method="post" id="cart-form" onsubmit="if (typeof window.oaiqCheckoutStarted === 'function') window.oaiqCheckoutStarted();">
                <button type="submit" name="checkout" class="cart-summary__checkout-btn">
                  Checkout
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              </form>
            {%- endif -%}

            <ul class="cart-summary__trust">
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>Independently certified, every treatment disclosed</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>10-day returns on loose gems</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Secure checkout · UPI, cards, EMI, COD</li>
            </ul>

            <div class="cart-summary__links">
              <a href="/collections/all">← Continue shopping</a>
              <a class="cart-summary__share-btn" href="https://wa.me/?text={{ share_text | url_encode }}" target="_blank" rel="noopener" aria-label="Share this cart on WhatsApp">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 19.2L4 20z"/><path d="M9.3 9.2c.2 2.6 2.7 5.1 5.4 5.4l1.1-1.5-1.7-1-.9.6c-.9-.4-1.6-1.1-2-2l.6-.9-1-1.7z"/></svg>
                Share cart on WhatsApp
              </a>
            </div>
          </div>
        </aside>

      </div>

      <!-- Bottom tagline -->
      <p class="cart-page__tagline">— Quality, Value &amp; Heart —</p>

    {%- else -%}
      <div class="cart-page__empty">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1" style="margin-bottom:20px;">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <h2>Your cart is empty</h2>
        <p class="cart-page__empty-text">Looks like you haven't added any gems yet.</p>
        <a href="/collections/all" class="btn btn--primary">START SHOPPING</a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  // Deleting a customized gem also removes its linked fee line (_master_id).
  document.querySelectorAll('.cart-card__delete').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var masterId = a.dataset.masterId;
      if (!masterId) return; // plain item — let the normal link handle it
      e.preventDefault();
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var updates = {};
          updates[a.dataset.lineKey] = 0;
          cart.items.forEach(function(it) {
            if (it.properties && it.properties['_fee_line'] && String(it.properties['_master_id']) === String(masterId)) {
              updates[it.key] = 0;
            }
          });
          return fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ updates: updates })
          });
        })
        .then(function() { window.location.reload(); })
        .catch(function() { window.location.href = a.href; });
    });
  });
</script>

<style>
  /* Cart — redesigned 24 Oct 2026: each gem shows its own price with the making charge itemised, palette tokens */
  .cart-breadcrumb{padding:10px 0;background:#FDFBF7;border-bottom:1px solid #E6DDCF}
  .cart-breadcrumb .breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:11.5px;color:#7A7268}
  .cart-breadcrumb .breadcrumb a{color:#7A7268;text-decoration:none}
  .cart-breadcrumb .breadcrumb a:hover{color:#231F20}
  .cart-breadcrumb .breadcrumb__sep{color:#C9BFAF}
  .cart-page{--c-ink:#231F20;--c-char:#4A443D;--c-char2:#7A7268;--c-gold:#B08D4F;--c-gold-deep:#96733A;--c-line:#E6DDCF;--c-ivory:#F6EFE4;--c-ivory2:#EFE5D2;--c-card:#fff;--c-accent:var(--font-accent,'Outfit','Helvetica Neue',sans-serif);--c-body:var(--font-body,'Inter','Helvetica Neue',sans-serif);--c-display:var(--font-heading,'Cormorant Garamond',Georgia,serif);padding:20px 0 56px;font-family:var(--c-body);color:var(--c-ink)}
  .cart-head{display:flex;align-items:baseline;gap:14px;margin:4px 0 20px}
  .cart-head h1{font-family:var(--c-display);font-size:clamp(28px,4vw,38px);font-weight:500;line-height:1.1;margin:0;color:var(--c-ink)}
  .cart-head__count{font-family:var(--c-accent);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--c-char2)}
  .cart-page__wrapper{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:28px;align-items:start}
  .cart-page__items{display:grid;gap:14px}
  .cart-card{display:grid;grid-template-columns:112px minmax(0,1fr);gap:18px;padding:18px;background:var(--c-card);border:1px solid var(--c-line);border-radius:8px}
  .cart-card__img{display:block;width:112px;height:112px;border-radius:6px;background:var(--c-ivory);overflow:hidden;padding:6px;box-sizing:border-box}
  .cart-card__img img{display:block;width:100%;height:100%;object-fit:contain}
  .cart-card__img-placeholder{display:block;width:100%;height:100%;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff 0,var(--c-line) 70%)}
  .cart-card__main{display:grid;gap:12px;min-width:0}
  .cart-card__top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
  .cart-card__id{min-width:0}
  .cart-card__eyebrow{font-family:var(--c-accent);font-size:10.5px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--c-gold-deep);margin:0 0 4px}
  .cart-card__title{font-family:var(--c-display);font-size:21px;font-weight:500;line-height:1.2;margin:0 0 6px;color:var(--c-ink)}
  .cart-card__title a{color:inherit;text-decoration:none}
  .cart-card__title a:hover{color:var(--c-gold-deep)}
  .cart-card__meta{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;margin:0;font-size:12.5px;color:var(--c-char2)}
  .cart-card__meta span+span::before{content:"·";margin-right:10px;color:#C9BFAF}
  .cart-card__lab{font-family:var(--c-accent);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--c-gold-deep)}
  .cart-card__sku{font-family:var(--c-accent);font-size:11px;letter-spacing:.04em}
  .cart-card__price{flex:0 0 auto;text-align:right}
  .cart-card__price b{display:block;font-size:20px;font-weight:600;color:var(--c-ink);white-space:nowrap;line-height:1.2}
  .cart-card__price b .price-inr__sym{font-size:.85em;font-weight:500;margin-right:1px}
  .cart-card__price small{display:block;margin-top:2px;font-size:11.5px;color:var(--c-char2)}
  .cart-card__custom{background:var(--c-ivory);border-radius:6px;padding:12px 14px}
  .cart-card__custom-title{font-family:var(--c-accent);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--c-gold-deep);margin:0 0 8px}
  .cart-card__chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
