  .cart-summary__links a,.cart-summary__share-btn{display:inline-flex;align-items:center;gap:6px;color:var(--c-char2);background:none;border:0;padding:0;cursor:pointer;font:inherit;letter-spacing:inherit;text-transform:inherit;text-decoration:none;transition:color .18s}
