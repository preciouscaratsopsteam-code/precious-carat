{%- comment -%}
  Header Section — with dropdown support (styled as vertical dropdown)
{%- endcomment -%}

<header class="site-header" id="site-header">
  <div class="header__wrapper page-width">
    <!-- Mobile Menu Toggle -->
    <button class="header__menu-toggle" id="mobile-menu-toggle" aria-label="Menu">
      {% render 'icon', name: 'menu' %}
    </button>

    <!-- Logo -->
    <div class="header__logo">
      <a href="/" class="header__logo-link" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="eager"
            class="header__logo-image"
          >
        {% else %}
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="eager"
            class="header__logo-image"
          >
        {% endif %}
      </a>
    </div>

    <!-- Search -->
    <div class="header__search">
      <form class="header__search-form" action="/search" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <span class="header__search-icon">
          {% render 'icon', name: 'search' %}
        </span>
        <input
          type="search"
          name="q"
          id="header-search"
          class="header__search-input snize-input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search for...' }}"
          autocomplete="off"
        >
      </form>
    </div>

    <!-- Header Icons -->
    <div class="header__icons">
      <a href="/pages/compare" class="header__icon-btn" aria-label="Compare Products">
        <img src="{{ 'balance.svg' | asset_url }}">
        <span class="header__compare-count" id="header-compare-count" style="display:none;">0</span>
      </a>
      <a href="/account" class="header__icon-btn" aria-label="Account">
        {% render 'icon', name: 'user' %}
      </a>
      <a href="/pages/wishlist" class="header__icon-btn" aria-label="Wishlist">
        {% render 'icon', name: 'heart' %}
        <span class="header__wishlist-count" id="header-wishlist-count" style="display:none;">0</span>
      </a>
      <a href="/cart" class="header__icon-btn" aria-label="Cart">
        {% render 'icon', name: 'cart' %}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count flo-cart-icon-bubble">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>

  <!-- Mobile Search (Dedicated Row) -->
  <div class="header__search-mobile hide-desktop">
    <div class="page-width">
      <form class="header__search-form" action="/search" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <span class="header__search-icon">
          {% render 'icon', name: 'search' %}
        </span>
        <input
          type="search"
          name="q"
          class="header__search-input snize-input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search for...' }}"
          autocomplete="off"
        >
      </form>
    </div>
  </div>

  <!-- Navigation Bar -->
  <nav class="nav-bar" id="nav-bar" aria-label="Main navigation">
    <div class="nav-bar__wrapper page-width">
      {% for block in section.blocks %}
        {% if block.type == 'nav_link' %}
          {%- assign nav_url = '#' -%}
          {%- if block.settings.collection != blank -%}
            {%- assign nav_url = block.settings.collection.url -%}
          {%- elsif block.settings.custom_url != blank -%}
            {%- assign nav_url = block.settings.custom_url -%}
          {%- else -%}
            {%- assign handle = block.settings.label | handle -%}
            {%- assign nav_url = '/collections/' | append: handle -%}
          {%- endif -%}

          {%- assign has_dropdown = block.settings.has_dropdown -%}
          {%- assign nav_label = block.settings.label -%}

          {%- comment -%} Check schema dropdown items {%- endcomment -%}
          {%- assign schema_items_count = 0 -%}
          {%- for item_block in section.blocks -%}
            {%- if item_block.type == 'dropdown_item' -%}
              {%- assign parent_label = item_block.settings.parent_label | strip -%}
              {%- if parent_label == nav_label -%}
                {%- assign schema_items_count = schema_items_count | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {% if has_dropdown or schema_items_count > 0 %}
            <div class="nav-item nav-item--has-dropdown" {{ block.shopify_attributes }}>
              <a href="{{ nav_url }}" class="nav-bar__link">
                {{ nav_label }}
                {% render 'icon', name: 'chevron-down', class: 'nav-bar__chevron' %}
              </a>

              {%- assign item_count = 0 -%}
              {%- for item_block in section.blocks -%}
                {%- if item_block.type == 'dropdown_item' -%}
                  {%- if item_block.settings.parent_label == nav_label -%}
                    {%- assign item_count = item_count | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              <div
                class="mega-menu {% if item_count > 6 %}mega-menu--multi{% endif %}"
                role="region"
                aria-label="{{ nav_label }} submenu"
              >
                {% if block.settings.dropdown_heading != blank %}
                  <h4 class="mega-menu__heading">{{ block.settings.dropdown_heading }}</h4>
                {% endif %}

                {%- if block.settings.gem_type_source != blank -%}
                  {%- comment -%} Auto-built dropdown: distinct gem types from a collection {%- endcomment -%}
                  {%- assign _gts_src = block.settings.gem_type_source -%}
                  {%- comment -%} Gem types to exclude from the auto-built dropdown (comma-separated, handleized match) {%- endcomment -%}
                  {%- assign _gt_excl = '' -%}
                  {%- if block.settings.gem_type_exclude != blank -%}
                    {%- assign _gt_excl_raw = block.settings.gem_type_exclude | split: ',' -%}
                    {%- for _ex in _gt_excl_raw -%}
                      {%- assign _gt_excl = _gt_excl | append: _ex | handleize | append: '||' -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- assign _gt_list = '' -%}
                  {%- for product in collections[_gts_src].products -%}
                    {%- assign _gt = product.metafields.custom.gem_type | default: '' | strip -%}
                    {%- if _gt != blank -%}
                      {%- assign _gt_ex_tok = _gt | handleize | append: '||' -%}
                      {%- if _gt_excl contains _gt_ex_tok -%}{%- continue -%}{%- endif -%}
                      {%- assign _gt_tok = _gt | append: '||' -%}
                      {%- unless _gt_list contains _gt_tok -%}
                        {%- assign _gt_list = _gt_list | append: _gt_tok -%}
                      {%- endunless -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign _gem_types = _gt_list | split: '||' -%}
                  <ul class="mega-menu__list">
                    {%- for gt in _gem_types -%}
                      {%- if gt == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign _gt_handle = gt | handleize -%}
                      {%- assign _gt_coll = collections[_gt_handle] -%}
                      {%- comment -%} Link to the gem's own collection (e.g. /collections/amethyst); fall back to the filtered source collection if it doesn't exist {%- endcomment -%}
                      {%- if _gt_coll != empty and _gt_coll.id -%}
                        {%- assign _gt_url = '/collections/' | append: _gt_handle -%}
                      {%- else -%}
                        {%- assign _gt_enc = gt | url_encode -%}
                        {%- assign _gt_url = '/collections/' | append: _gts_src | append: '?filter.p.m.custom.gem_type=' | append: _gt_enc -%}
                      {%- endif -%}
                      <li class="mega-menu__item-wrapper">
                        {%- comment -%} Use the gem's dropdown-item asset image (same as Upratnas), not the collection image {%- endcomment -%}
                        {%- assign _gt_asset = '' -%}
                        {%- for _ib in section.blocks -%}
                          {%- if _ib.type == 'dropdown_item' and _ib.settings.asset_name != blank -%}
                            {%- assign _ib_handle = _ib.settings.label | handle -%}
                            {%- if _ib_handle == _gt_handle -%}
                              {%- assign _gt_asset = _ib.settings.asset_name -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <a href="{{ _gt_url }}" class="mega-menu__item">
                          <div class="mega-menu__icon mega-menu__icon--{{ _gt_handle }}">
                            {%- if _gt_asset != blank -%}
                              <img src="{{ _gt_asset | asset_url }}" alt="{{ gt }}" loading="lazy">
                            {%- elsif _gt_coll.products.first.featured_image -%}
                              <img src="{{ _gt_coll.products.first.featured_image | image_url: width: 80 }}" alt="{{ gt }}" loading="lazy">
                            {%- endif -%}
                          </div>
                          <span class="mega-menu__label">{{ gt }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                    <li class="mega-menu__item-wrapper">
                      <a href="{{ nav_url }}" class="mega-menu__item mega-menu__item--view-all">
                        <div class="mega-menu__icon" style="background: #f9f9f9; display: flex; align-items: center; justify-content: center; font-size: 18px;">→</div>
                        <span class="mega-menu__label" style="font-weight: 700; color: var(--color-gold);">VIEW ALL {{ nav_label -}}</span>
                      </a>
                    </li>
                  </ul>
                {%- else -%}
                {%- comment -%} Detect labeled sub-groups (column_heading) for this nav {%- endcomment -%}
                {%- assign mm_group_keys = '' -%}
                {%- for item_block in section.blocks -%}
                  {%- if item_block.type == 'dropdown_item' and item_block.settings.parent_label == nav_label and item_block.settings.column_heading != blank -%}
                    {%- assign _ch = item_block.settings.column_heading | strip -%}
                    {%- unless mm_group_keys contains _ch -%}
                      {%- assign mm_group_keys = mm_group_keys | append: _ch | append: '||' -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign mm_groups = mm_group_keys | split: '||' -%}

                {%- if mm_groups.size > 0 -%}
                  {%- comment -%} Grouped layout: one labelled column per column_heading {%- endcomment -%}
                  <div class="mega-menu__groups">
                    {%- for grp in mm_groups -%}
                      {%- if grp != blank -%}
                      <div class="mega-menu__group">
                        <h5 class="mega-menu__group-heading">{{ grp }}</h5>
                        <ul class="mega-menu__group-list">
                          {%- for item_block in section.blocks -%}
                            {%- if item_block.type == 'dropdown_item' -%}
                              {%- assign parent_label = item_block.settings.parent_label | strip -%}
                              {%- assign _item_ch = item_block.settings.column_heading | strip -%}
                              {%- if parent_label == nav_label and _item_ch == grp -%}
                                {%- assign _se_item_href = item_block.settings.url | default: '/pages/coming-soon' -%}
                                {%- if parent_label == 'SACRED ESSENTIALS' -%}
                                  {%- unless _se_item_href contains 'sacred-essentials' -%}
                                  {%- if _se_item_href contains '?' -%}
                                    {%- assign _se_item_href = _se_item_href | append: '&filter.v.price.lte=50000' -%}
                                  {%- else -%}
                                    {%- assign _se_item_href = _se_item_href | append: '?filter.v.price.lte=50000' -%}
                                  {%- endif -%}
                                  {%- endunless -%}
                                {%- endif -%}
                                <li class="mega-menu__item-wrapper">
                                  <a href="{{ _se_item_href }}" class="mega-menu__item">
                                    <div class="mega-menu__icon mega-menu__icon--{{ item_block.settings.label | handle }}">
                                      {%- if item_block.settings.asset_name != blank -%}
                                        <img src="{{ item_block.settings.asset_name | asset_url }}" alt="{{ item_block.settings.label }}" loading="lazy">
                                      {%- elsif item_block.settings.image != blank -%}
                                        {{ item_block.settings.image | image_url: width: 80 | image_tag: loading: 'lazy' }}
                                      {%- endif -%}
                                    </div>
                                    <span class="mega-menu__label">{{ item_block.settings.label }}</span>
                                  </a>
                                </li>
                              {%- endif -%}
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </div>
                      {%- endif -%}
                    {%- endfor -%}
                    <a href="{{ nav_url }}" class="mega-menu__groups-viewall">VIEW ALL {{ nav_label }} →</a>
                  </div>
                {%- else -%}
                <ul class="mega-menu__list">
                  {%- if nav_label == 'SANCTUM' -%}
                    {%- for product in collections.sanctum.products limit: 11 -%}
                      <li class="mega-menu__item-wrapper">
                        <a href="{{ product.url }}" class="mega-menu__item">
                          <div class="mega-menu__icon">
                            <img
                              src="{{ product.featured_image | image_url: width: 80 }}"
                              alt="{{ product.title }}"
                              loading="lazy"
                            >
                          </div>
                          <span class="mega-menu__label">{{ product.title }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                    <li class="mega-menu__item-wrapper">
                      <a href="/collections/sanctum" class="mega-menu__item mega-menu__item--view-all">
                        <div
                          class="mega-menu__icon"
                          style="background: #f9f9f9; display: flex; align-items: center; justify-content: center; font-size: 18px;"
                        >
                          →
                        </div>
                        <span class="mega-menu__label" style="font-weight: 700; color: var(--color-gold);"
                          >View All Sanctum Gems</span
                        >
                      </a>
                    </li>
                  {%- else -%}
                    {%- for item_block in section.blocks -%}
                      {%- if item_block.type == 'dropdown_item' -%}
                        {%- assign parent_label = item_block.settings.parent_label | strip -%}
                        {%- if parent_label == nav_label -%}
                          {%- comment -%} Sacred Essentials sub-items carry a soft ≤₹50K price cap into the gem collection {%- endcomment -%}
                          {%- assign _se_item_href = item_block.settings.url | default: '/pages/coming-soon' -%}
                          {%- if parent_label == 'SACRED ESSENTIALS' -%}
                            {%- unless _se_item_href contains 'sacred-essentials' -%}
                            {%- if _se_item_href contains '?' -%}
                              {%- assign _se_item_href = _se_item_href | append: '&filter.v.price.lte=50000' -%}
                            {%- else -%}
                              {%- assign _se_item_href = _se_item_href | append: '?filter.v.price.lte=50000' -%}
                            {%- endif -%}
                            {%- endunless -%}
                          {%- endif -%}
                          <li class="mega-menu__item-wrapper">
                            <a href="{{ _se_item_href }}" class="mega-menu__item">
                              {%- unless parent_label == 'CURATED COLLECTIONS' -%}
                                <div class="mega-menu__icon mega-menu__icon--{{ item_block.settings.label | handle }}">
                                  {%- if item_block.settings.asset_name != blank -%}
                                    <img
                                      src="{{ item_block.settings.asset_name | asset_url }}"
                                      alt="{{ item_block.settings.label }}"
                                      loading="lazy"
                                    >
                                  {%- elsif item_block.settings.image != blank -%}
                                    {{ item_block.settings.image | image_url: width: 80 | image_tag: loading: 'lazy' }}
                                  {%- endif -%}
                                </div>
                              {%- endunless -%}
                              <span class="mega-menu__label">{{ item_block.settings.label }}</span>
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <li class="mega-menu__item-wrapper">
                      <a href="{{ nav_url }}" class="mega-menu__item mega-menu__item--view-all">
                        <div
                          class="mega-menu__icon"
                          style="background: #f9f9f9; display: flex; align-items: center; justify-content: center; font-size: 18px;"
                        >
                          →
                        </div>
                        <span class="mega-menu__label" style="font-weight: 700; color: var(--color-gold);"
                          >VIEW ALL {{ nav_label -}}
                        </span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
                {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {% else %}
            <a href="{{ nav_url }}" class="nav-bar__link" {{ block.shopify_attributes }}>
              {{ nav_label }}
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}

      <!-- Mobile Utility Links -->
      <div class="mobile-utils hide-desktop">
        <a href="/pages/compare" class="nav-bar__link">
          <img src="{{ 'balance.svg' | asset_url }}">
          <span>Product Comparison</span>
        </a>
        <a href="/account" class="nav-bar__link">
          {% render 'icon', name: 'user' %}
          <span>Account</span>
        </a>
        <a href="/collections" class="nav-bar__link">
          {% render 'icon', name: 'gem' %}
          <span>Collections</span>
        </a>
        <a href="/pages/wishlist" class="nav-bar__link">
          {% render 'icon', name: 'heart' %}
          <span>Wishlist</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile: tap on dropdown nav items toggles sub-menu
    document.querySelectorAll('.nav-item--has-dropdown .nav-bar__link').forEach((link) => {
      link.addEventListener('click', function (e) {
        if (window.innerWidth <= 992) {
          e.preventDefault();
          const navItem = this.closest('.nav-item--has-dropdown');
          navItem.classList.toggle('is-open');
        }
      });
    });

    // Close menu on outside click
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav-item--has-dropdown')) {
        document.querySelectorAll('.nav-item--has-dropdown.is-open').forEach((el) => el.classList.remove('is-open'));
      }
    });
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "label": "Logo width (px)"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder text",
      "default": "Search for..."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Navigation Label",
          "default": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Or Custom URL"
        },
        {
          "type": "checkbox",
          "id": "has_dropdown",
          "label": "Show dropdown",
          "default": false
        },
        {
          "type": "text",
          "id": "dropdown_heading",
          "label": "Dropdown Heading (optional)",
          "info": "e.g. ZODIAC STONES (RASHI RATNA)"
        },
        {
          "type": "text",
          "id": "gem_type_source",
          "label": "Auto-build dropdown from collection (gem types)",
          "info": "Collection handle, e.g. crush-worthy-delights. When set, the dropdown lists the distinct gem types found in that collection."
        },
        {
          "type": "text",
          "id": "gem_type_exclude",
          "label": "Exclude gem types",
          "info": "Comma-separated gem type names to hide from the auto-built dropdown, e.g. Chalcedony."
        }
      ]
    },
    {
      "type": "dropdown_item",
      "name": "Dropdown Item",
      "settings": [
        {
          "type": "text",
          "id": "parent_label",
          "label": "Parent Nav Label (must match exactly)",
          "info": "e.g. NAVRATNA"
        },
        {
          "type": "text",
          "id": "column_heading",
          "label": "Column Heading (optional grouping)",
          "info": "Leave blank for a flat list. Set the same heading on several items to group them under one labelled column."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Item Label",
          "default": "Gemstone"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Item URL"
        },
        {
          "type": "text",
          "id": "asset_name",
          "label": "Icon image asset name (e.g. nav-ruby.png)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "nav_link",
          "settings": { "label": "NAVRATNA", "has_dropdown": true, "custom_url": "/collections/navratana" }
        },
        { "type": "nav_link", "settings": { "label": "UPRATNAS", "has_dropdown": true } },
        {
          "type": "nav_link",
          "settings": { "label": "SACRED ESSENTIALS", "custom_url": "/collections/sacred-essentials" }
        },
        { "type": "nav_link", "settings": { "label": "SANCTUM", "custom_url": "/collections/sanctum" } },
        { "type": "nav_link", "settings": { "label": "CURATED COLLECTIONS", "custom_url": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
